//Conta a quantidade de entradas de um programa

PREFIX programa: <http://secti.pe.gov.br/indicador_cti/vocabulary/programa#>
PREFIX canvas: <http://secti.pe.gov.br/indicador_cti/vocabulary/canvas#>
PREFIX base: <http://secti.pe.gov.br/indicador_cti/vocabulary/base#>
SELECT ?entradaLabel (COUNT(?entrada) AS ?quantidade)
WHERE {
  ?programa a programa:programaCTI ;
            base:nome "Programa: Espaços Cria " ;
            programa:recebeEntradas ?entrada .

  OPTIONAL { ?entrada base:nome ?entradaLabel }
}
GROUP BY ?entradaLabel
ORDER BY ?entradaLabel
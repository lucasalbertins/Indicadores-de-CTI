# ============================================================================
# Q19 - PA1.ME1: valor apurado x meta pactuada (semaforo de gestao)
# ============================================================================
# Estudo de caso: PA1.ME1 - PBPG "Taxa de Titulacao".
# Liga o plano de avaliacao (questao PA1, sua metrica, meta e finalidade) ao
# valor efetivamente apurado sobre as cotas do semestre. E a leitura de gestao
# de mais alto nivel: a meta do ciclo foi cumprida?
#
# ATENCAO A UNIDADE: metricas:valorMeta e metricas:valorAtual estao gravados
# como FRACAO (0.80 e 0.90) em PA-PBPG e em metricasPBPG/PA1.ME1, enquanto a
# formula da metrica multiplica a divisao por 100 e devolve PERCENTUAL. A
# consulta normaliza tudo para percentual (valores <= 1 sao multiplicados por
# 100) antes de comparar; o ideal e uniformizar a unidade na ontologia.
# ============================================================================

PREFIX xsd:      <http://www.w3.org/2001/XMLSchema#>
PREFIX base:     <http://secti.pe.gov.br/indicador_cti/vocabulary/base#>
PREFIX plano:    <http://secti.pe.gov.br/indicador_cti/vocabulary/DesignAvaliacao/planoAvaliacao#>
PREFIX met:      <http://secti.pe.gov.br/indicador_cti/vocabulary/DesignAvaliacao/metricas#>
PREFIX bolsista: <http://secti.pe.gov.br/indicador_cti/vocabulary/AvaliacaoProgramas/PBPG/bolsista#>

SELECT ?questaoAvaliacao ?metrica ?finalidade
       ?semestre ?cotasEncerradas ?titulados
       ?taxaApuradaPct ?metaPct ?valorDeclaradoPct ?status
WHERE {
  # --- lado do plano de avaliacao -----------------------------------------
  ?qa a plano:questaoAvaliacao ;
      base:id   "PA1 - PBPG" ;
      base:nome ?questaoAvaliacao ;
      plano:temMetrica ?m .
  ?m base:nome        ?metrica ;
     met:valorMeta    ?vm .
  FILTER( CONTAINS(?metrica, "Taxa Titula") )
  OPTIONAL { ?m met:valorAtual ?va }
  OPTIONAL { ?m met:finalidade ?finalidade }

  # --- lado dos dados: taxa do semestre ------------------------------------
  {
    SELECT ?semestre
           (COUNT(DISTINCT ?b)  AS ?cotasEncerradas)
           (SUM(?ehTitulado)    AS ?titulados)
    WHERE {
      # Semestre de referencia do ciclo avaliado: ajuste aqui para outro ciclo.
      VALUES ?semestre { "2025.2" }
      ?b a bolsista:bolsista ;
         bolsista:dt_fim_bolsa ?semestre .
      OPTIONAL { ?b bolsista:id_semestre_titulacao ?sTitulacao }
      BIND(IF(BOUND(?sTitulacao) && ?sTitulacao = ?semestre, 1, 0) AS ?ehTitulado)
    }
    GROUP BY ?semestre
  }

  BIND( ROUND(10000 * xsd:decimal(?titulados) / ?cotasEncerradas) / 100 AS ?taxaApuradaPct )
  BIND( IF(xsd:decimal(?vm) <= 1, xsd:decimal(?vm) * 100, xsd:decimal(?vm)) AS ?metaPct )
  BIND( IF(!BOUND(?va), "n/d",
        STR(IF(xsd:decimal(?va) <= 1, xsd:decimal(?va) * 100, xsd:decimal(?va)))) AS ?valorDeclaradoPct )

  BIND(
    IF( ?finalidade = "Minimizar",
        IF(?taxaApuradaPct <= ?metaPct, "META ATINGIDA", "META NAO ATINGIDA"),
        IF(?taxaApuradaPct >= ?metaPct, "META ATINGIDA", "META NAO ATINGIDA") )
    AS ?status )
}

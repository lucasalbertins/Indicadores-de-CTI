# ============================================================================
# Q15 - Dominio das dimensoes de desagregacao da PA1.ME1 (Taxa de Titulacao)
# ============================================================================
# Estudo de caso: PA1.ME1 - PBPG "Taxa de Titulacao".
# Fonte dos dados: description .../PBPG/calculo-metricas-PBPG (109 cotas do
# semestre 2025.2, editais FACEPE 10/2021-PBPG e 12/2023-PBPG).
#
# Reproduz o bloco DOMINIO da planilha "Repositorio Avaliacao PBPG":
#   VV1.SEM  = semestre de encerramento da cota   (bolsista:dt_fim_bolsa)
#   VV2.MOD  = modalidade                         (bolsista:nm_modalidade)
#   VV3.AREA = grande area do conhecimento FACEPE (projeto:nm_area_conhecimento)
#   VV4.RDE  = regiao de desenvolvimento          (projeto:nm_rde)
# Alem dos valores admissiveis, devolve quantas cotas do ciclo caem em cada um,
# de modo que o gestor confira a cobertura antes de ler a taxa.
#
# NOTA DE MODELAGEM: nesta descricao bolsista:dt_fim_bolsa carrega o SEMESTRE
# de encerramento ("2025.2"), e nao uma data - o vocabulario nao tem uma
# propriedade id_semestre_bolsa_fim, presente na planilha de origem.
# ============================================================================

PREFIX bolsista: <http://secti.pe.gov.br/indicador_cti/vocabulary/AvaliacaoProgramas/PBPG/bolsista#>
PREFIX projeto:  <http://secti.pe.gov.br/indicador_cti/vocabulary/AvaliacaoProgramas/PBPG/projeto#>

SELECT ?dimensao ?valor (COUNT(DISTINCT ?b) AS ?cotasEncerradas)
WHERE {
  # Semestre de referencia do ciclo avaliado: ajuste aqui para outro ciclo.
  VALUES ?semestre { "2025.2" }

  ?b a bolsista:bolsista ;
     bolsista:dt_fim_bolsa ?semestre .

  {
    BIND("VV1.SEM" AS ?dimensao)
    ?b bolsista:dt_fim_bolsa ?valor .
  } UNION {
    BIND("VV2.MOD"  AS ?dimensao)
    ?b bolsista:nm_modalidade ?valor .
  } UNION {
    BIND("VV3.AREA" AS ?dimensao)
    ?b bolsista:desenvolve/projeto:nm_area_conhecimento ?valor .
  } UNION {
    BIND("VV4.RDE"  AS ?dimensao)
    ?b bolsista:desenvolve/projeto:nm_rde ?valor .
  }
}
GROUP BY ?dimensao ?valor
ORDER BY ?dimensao ?valor

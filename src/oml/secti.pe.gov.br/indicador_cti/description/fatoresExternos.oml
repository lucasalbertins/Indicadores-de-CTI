description <http://secti.pe.gov.br/indicador_cti/description/fatoresExternos#> as fatoresExternos {
	
	uses <http://secti.pe.gov.br/indicador_cti/vocabulary/base#> as base
	uses <http://secti.pe.gov.br/indicador_cti/vocabulary/canvas#> as canvas
	
	instance FE1 : canvas:Oportunidade [
		base:nome "Parcerias eventuais com Governo e Indústria para financiamento ou complemento da bolsa"
	]
	instance FE2 : canvas:Oportunidade [
		base:nome "Maior reconhecimento da importância das atividades de CT&I para as atividades produtivas e sociedade no geral"
	]
	instance FE3 : canvas:Oportunidade [
		base:nome "Aprimoramento do arcabouço legal de inovação"
	]
	instance FE4 : canvas:Oportunidade [
		base:nome "Potencial nº de articuladores de CT&I vinculados a ICTs"
	]
	instance FE5 : canvas:Oportunidade [
		base:nome "Crescimento do nº de startups e ambientes de inovação no Estado"
	]
	instance FE6 : canvas:Oportunidade [
		base:nome "Projeção de internacionalização das redes"
	]
	instance FE7 : canvas:Oportunidade [
		base:nome "Parcerias com empresas para programas de imersão e maratonas de desenvolvimento"
	]
	instance FE8 : canvas:Oportunidade [
		base:nome "Engajamento dos estudantes ativos nos Espaços CRIA aos grandes eventos de tecnologia (Campus Party, Rec´n play, Eli Summit…)"
	]
	instance FE9 : canvas:Oportunidade [
		base:nome "Participação em competições locais, interestaduais e internacionais"
	]
	instance FE10 : canvas:Oportunidade [
		base:nome "Progressão das ETEs e EREMs com Espaços CRIA para um modelo de incubação de novos negócios"
	]
	instance FE11 : canvas:Oportunidade [
		base:nome "Reconhecimento do potencial inovador e criativo  dos alunos da Escola Pública para resolução de problemas da sociedade "
	]
	instance ExpansaoDemanda : canvas:Oportunidade [
	base:nome "Expansão da demanda por Ensino Superior no interior, ampliando alcance e impacto social do PROUPE."
	]
instance ValorizacaoAreasSTEM : canvas:Oportunidade [
	base:nome "Valorização das áreas STEM e das licenciaturas, fortalecendo a relevância estratégica do Programa."
	]
instance IntegracaoPoliticasFederais : canvas:Oportunidade [
	base:nome "Integração com políticas federais de educação e ciência, potencializando resultados e recursos."
	]
instance CrescimentoMercadoTrabalho : canvas:Oportunidade [
	base:nome "Crescimento do mercado de trabalho qualificado, aumentando a empregabilidade dos bolsistas, principalmente nas áreas STEM."
	]
instance ReconhecimentoPublico : canvas:Oportunidade [
	base:nome "Reconhecimento público e fortalecimento institucional, consolidando o PROUPE como política de referência."
	]

	instance CortesContingenciamento : canvas:Ameaca [
		base:nome "Cortes e contingenciamento de recursos estaduais para CT&I"
	]
	instance MercadoAquecido : canvas:Ameaca [
		base:nome "Mercado de trabalho aquecido"
	]
	instance BaixaAtratividadeBolsas : canvas:Ameaca [
		base:nome "Baixa atratividade das bolsas"
	]
	instance EstruturadeSuporte : canvas:Ameaca [
		base:nome "Estrutura administrativa de suporte insuficiente"
	]
	instance EvasaoEstudantes : canvas:Ameaca [
		base:nome "Evasão dos estudantes"
	]
	instance FE17 : canvas:Ameaca [
		base:nome "Falta de aderência das dissertações e teses com desafios e problemas relevantes do estado de Pernambuco"
	]
	instance FE18 : canvas:Ameaca [
		base:nome "Envolvimento tímido do setor empresarial"
	]
	instance FE19 : canvas:Ameaca [
		base:nome "Prazo insuficiente para tornar as redes autossustentáveis"
	]
	instance FE20 : canvas:Ameaca [
		base:nome "Restrições apresentadas pelo arcabouço legal"
	]
	instance MorosidadeTED : canvas:Ameaca [
		base:nome "Morosidade na celebração de Termo de Execução Descentralizada (TED) com periodicidade anual"
	]
	instance EvasaoporTED : canvas:Ameaca [
		base:nome "Evasão estudantil por lacunas de continuidade entre as celebrações de TED e lançamento de novos editais"
	]
	instance PerdadeAdesao : canvas:Ameaca [
		base:nome "Perda de adesão do corpo docente aos programas de capacitação correlatos"
	]
	instance FaltaRH : canvas:Ameaca [
		base:nome "Falta de recursos humanos capacitados para operacionalizar e monitorar as ações"
	]
	instance FaltaPerenidade : canvas:Ameaca [
		base:nome "Falta de perenidade nas políticas de manutenção e aprimoramento dos ECRIA"
	]
	instance FaltaPriorizacao : canvas:Ameaca [
		base:nome "Falta de priorização da política de estímulo a STEM+C em mudanças de gestão"
	]
	instance ValidacaoInscricoes : canvas:Ameaca [
	base:nome "Validação equivocada das inscrições pelas Autarquias Municipais de Ensino Superior, sem observância dos requisitos legais, o que pode gerar questionamentos jurídicos e comprometer a credibilidade do Programa."
	]
	
	instance DificuldadeCumprimentoProporcaoLegal : canvas:Ameaca [
	base:nome "Dificuldades no cumprimento da proporção legal prevista na Lei nº 17.945/2022, que estabelece, prioritariamente: 70% das bolsas para estudantes com renda per capita de até 1,5 salário-mínimo; 30% das bolsas para estudantes com renda per capita entre 1,5 e 4 salários-mínimos. Esse cenário levou a uma distribuição em que o maior percentual de bolsas não é destinado a estudantes matriculados em Licenciaturas e cursos STEM (Ciência, Tecnologia, Engenharia e Matemática)."
	]
instance DescumprimentoContrapartida : canvas:Ameaca [
	base:nome "Descumprimento da contrapartida obrigatória por parte de bolsistas que abandonam, desistem ou trancam o curso, dificultando o retorno social esperado do Programa em atividades educativas, de extensão ou científicas e tecnológicas, podendo gerar passivos de processos administrativos."
	]
instance ProblemasSistemaGerenciamento : canvas:Ameaca [
	base:nome "Problemas de gestão com o sistema de gerenciamento do PROUPE, limitando a execução e acompanhamento do programa pela SECTI e gerando riscos de continuidade, segurança e sustentabilidade do PROUPE, diante da dificuldade de contratação de recursos humanos com habilidades e competências específicas para atendimento às peculiaridades do sistema."
	]
}
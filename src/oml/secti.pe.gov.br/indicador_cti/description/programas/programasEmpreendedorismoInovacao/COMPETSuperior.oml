description <http://secti.pe.gov.br/indicador_cti/description/programas/programasEmpreendedorismoInovacao/COMPETSuperior#> as COMPETSuperior {
	
	extends <http://secti.pe.gov.br/indicador_cti/description/parceirosChave#> as parceiroChave
	extends <http://secti.pe.gov.br/indicador_cti/description/fatoresExternos#> as fatorExterno
	extends <http://secti.pe.gov.br/indicador_cti/description/entradas#> as entrada
	extends <http://secti.pe.gov.br/indicador_cti/description/atividadesChave#> as atividadeChave
	extends <http://secti.pe.gov.br/indicador_cti/description/saidas#> as saida
	extends <http://secti.pe.gov.br/indicador_cti/description/resultados#> as resultado
	extends <http://secti.pe.gov.br/indicador_cti/description/publicoAlvo#> as publicoAlvo
	
	uses <http://secti.pe.gov.br/indicador_cti/vocabulary/base#> as base
	uses <http://secti.pe.gov.br/indicador_cti/vocabulary/canvas#> as canvas
	uses <http://secti.pe.gov.br/indicador_cti/vocabulary/programa#> as programa
	
	instance COMPETSuperior : programa:programaCTI [
		base:nome "Programa: COMPET Superior"
		base:descricao "Foi criado com o objetivo de apoiar a formação de estudantes de nível superior 
por meio de extensão tecnológica"
		programa:possuiParceiros parceiroChave:ICTsIntegrantes, parceiroChave:EmpresasIntegrantes, 
		parceiroChave:OrgaosPublicos
		programa:condicionadoPor fatorExterno:FE2, fatorExterno:FE3, fatorExterno:FE13, fatorExterno:FE18, 
		fatorExterno:FE21
		programa:recebeEntradas entrada:OrcamentoEstadual, entrada:EN2, entrada:EN3, entrada:EN4, 
		entrada:EN6, entrada:EN7, entrada:EN8, entrada:EN9
		programa:executa atividadeChave:AC1, atividadeChave:AC2, atividadeChave:AC3, atividadeChave:AC4, 
		atividadeChave:AC6, atividadeChave:AC7
		programa:geraSaidas saida:OUT1, saida:OUT2, saida:OUT3, saida:OUT4, saida:OUT6, saida:OUT7
		programa:produzResultados resultado:RES8, resultado:RES47, resultado:RES48, resultado:RES43, 
		resultado:RES44
		programa:direcionadoA publicoAlvo:PA26, publicoAlvo:PA2, publicoAlvo:PA5, publicoAlvo:PA6, 
		publicoAlvo:PA7, publicoAlvo:PA8, publicoAlvo:PA11, publicoAlvo:PA12, publicoAlvo:PA13, 
		publicoAlvo:PA17, publicoAlvo:PA18, publicoAlvo:PA20
		programa:buscaAtingir1 OBJGeral
		programa:buscaAtingir2 OBJEspecifico1, OBJEspecifico2, OBJEspecifico3
	]
	
	instance OBJGeral : canvas:ObjetivoGeral [
		base:nome "Apoiar jornadas formativas por extensão tecnológica que contribuam para a formação de 
recursos humanos qualificados em nível de graduação, mediante parcerias entre ICTs, empresas, 
cooperativas, órgãos de governo, associações ou demais organizações do terceiro setor, no Estado de 
Pernambuco"
	]
	instance OBJEspecifico1 : canvas:ObjetivoEspecifico [
		base:nome "Promover a formação de recursos humanos por extensão tecnológica, com enfoque em 
desafios tecnológicos aderentes à estrutura produtiva e social do Estado, inclusive no interior"
	]
	instance OBJEspecifico2 : canvas:ObjetivoEspecifico [
		base:nome "Incentivar a empregabilidade de recursos humanos qualificados"
	]
	instance OBJEspecifico3 : canvas:ObjetivoEspecifico [
		base:nome "Impulsionar a formação de parcerias entre ICTs e demais agentes do ecossistema de 
inovação"
	]
}
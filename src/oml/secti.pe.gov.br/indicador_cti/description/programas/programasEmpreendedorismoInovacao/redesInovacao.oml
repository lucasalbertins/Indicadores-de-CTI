description <http://secti.pe.gov.br/indicador_cti/description/programas/programasEmpreendedorismoInovacao/redesInovacao#> as redesInovacao {
	extends <http://secti.pe.gov.br/indicador_cti/description/parceirosChave#> as parceiroChave
	extends <http://secti.pe.gov.br/indicador_cti/description/fatoresExternos#> as fatorExterno
	extends <http://secti.pe.gov.br/indicador_cti/description/entradas#> as entrada
	extends <http://secti.pe.gov.br/indicador_cti/description/atividadesChave#> as atividadeChave
	extends <http://secti.pe.gov.br/indicador_cti/description/saidas#> as saida
	extends <http://secti.pe.gov.br/indicador_cti/description/resultados#> as resultado
	extends <http://secti.pe.gov.br/indicador_cti/description/publicoAlvo#> as publicoAlvo
	
	uses <http://secti.pe.gov.br/indicador_cti/vocabulary/base#> as base
	uses <http://secti.pe.gov.br/indicador_cti/vocabulary/canvas#> as canvas
	uses <http://secti.pe.gov.br/indicador_cti/vocabulary/programa#> as programa
	
	instance RedesDeInovacao : programa:programaCTI [
		base:nome "Programa: Redes de Inovação"
		base:descricao "Foi criado para fomentar a criação e o fortalecimento de redes de colaboração entre diferentes instituições e 
setores, com o objetivo de impulsionar atividades de pesquisa, desenvolvimento e inovação em Pernambuco"
		programa:possuiParceiros parceiroChave:Inovar-PE, parceiroChave:AGE, parceiroChave:Adepe
		programa:condicionadoPor fatorExterno:FE2, fatorExterno:FE3, fatorExterno:FE4, fatorExterno:FE5, fatorExterno:FE6, 
		fatorExterno:FE12, fatorExterno:FE18, fatorExterno:FE19, fatorExterno:FE20
		programa:recebeEntradas entrada:EN1, entrada:EN2, entrada:EN3, entrada:EN4, entrada:EN6, entrada:EN7, entrada:EN8, entrada:EN9
		programa:executa atividadeChave:AC1, atividadeChave:AC3, atividadeChave:AC4, atividadeChave:AC6, atividadeChave:AC7
		programa:geraSaidas saida:OUT1, saida:OUT2, saida:OUT3, saida:OUT4, saida:OUT6, saida:OUT7
		programa:produzResultados resultado:RES6, resultado:RES7, resultado:RES8, resultado:RES9, resultado:RES15, resultado:RES16, 
		resultado:RES18, resultado:RES21, resultado:RES22, resultado:RES23, resultado:RES24
		programa:direcionadoA publicoAlvo:PA4, publicoAlvo:PA5, publicoAlvo:PA6, publicoAlvo:PA7, publicoAlvo:PA8, publicoAlvo:PA16, 
		publicoAlvo:PA17, publicoAlvo:PA18, publicoAlvo:PA19, publicoAlvo:PA20
		programa:buscaAtingir1 OBJGeral
		programa:buscaAtingir2 OBJEspecifico1, OBJEspecifico2, OBJEspecifico3, OBJEspecifico4, 
		OBJEspecifico5, OBJEspecifico6, OBJEspecifico7, OBJEspecifico8
	]
	
	instance OBJGeral : canvas:ObjetivoGeral [
		base:nome "Incentivar a criação e o fortalecimento de redes autossustentáveis que promovam e articulem atividades de inovação 
e integrem ICTs e demais agentes do ecossistema, em consonância com as RDs do Estado, visando o fortalecimento de seus ecossistemas"
	]
	instance OBJEspecifico1 : canvas:ObjetivoEspecifico [
		base:nome "Promover atividades de CT&I de impacto, aderentes às RDs do Estado"
	]
	instance OBJEspecifico2 : canvas:ObjetivoEspecifico [
		base:nome "Impulsionar cooperações de CT&I e parcerias entre agentes do ecossistema de inovação, em redes autossustentáveis"
	]
	instance OBJEspecifico3 : canvas:ObjetivoEspecifico [
		base:nome "Estimular ações de inovação aberta"
	]
	instance OBJEspecifico4 : canvas:ObjetivoEspecifico [
		base:nome "Apoiar a realização de eventos de CT&I"
	]
	instance OBJEspecifico5 : canvas:ObjetivoEspecifico [
		base:nome "Incentivar o desenvolvimento de projetos de CT&I"
	]
	instance OBJEspecifico6 : canvas:ObjetivoEspecifico [
		base:nome "Estimular a transferência tecnológica"
	]
	instance OBJEspecifico7 : canvas:ObjetivoEspecifico [
		base:nome "Promover a geração de novos negócios inovadores"
	]
	instance OBJEspecifico8 : canvas:ObjetivoEspecifico [
		base:nome "Apoiar articuladores que conectem o ecossistema às demais políticas de CT&I do Estado"
	]
}

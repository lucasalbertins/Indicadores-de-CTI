description <http://secti.pe.gov.br/indicador_cti/description/programas/programasEmpreendedorismoInovacao/RedesInovacao/RedesInovacao#> as RedesInovacao {
	
	extends <http://secti.pe.gov.br/indicador_cti/description/programas/programasEmpreendedorismoInovacao/RedesInovacao/PA_RedesInovacao#> as PA_RedesInovacao
	extends <http://secti.pe.gov.br/indicador_cti/description/parceirosChave/parceirosGoverno#> as parceirosGoverno
	extends <http://secti.pe.gov.br/indicador_cti/description/parceirosChave/parceirosAgenciasFomento#> as parceirosAgenciasFomento
 	extends <http://secti.pe.gov.br/indicador_cti/description/fatoresExternos#> as fatorExterno
 	extends <http://secti.pe.gov.br/indicador_cti/description/entradas/entradasOrcamentoFinanciamento#> as entradasOrcamentoFinanciamento
 	extends <http://secti.pe.gov.br/indicador_cti/description/entradas/entradasDadosSistemasPlataformas#> as entradasDadosSistemasPlataformas
 	extends <http://secti.pe.gov.br/indicador_cti/description/entradas/entradasCapitalHumano#> as entradasCapitalHumano
 	extends <http://secti.pe.gov.br/indicador_cti/description/entradas/entradasInstrumentosLegaisNormativos#> as entradasInstrumentosLegaisNormativos
	extends <http://secti.pe.gov.br/indicador_cti/description/atividadesChave#> as atividadeChave
	extends <http://secti.pe.gov.br/indicador_cti/description/saidas#> as saida
	extends <http://secti.pe.gov.br/indicador_cti/description/publicosAlvo/publicosAcademiaICTs#> as publicosAcademiaICTs
	extends <http://secti.pe.gov.br/indicador_cti/description/publicosAlvo/publicosGovernoInstituicoesPublicas#> as publicosGovernoInstituicoesPublicas
	extends <http://secti.pe.gov.br/indicador_cti/description/publicosAlvo/publicosEmpresasEmpreendedores#> as publicosEmpresasEmpreendedores
	extends <http://secti.pe.gov.br/indicador_cti/description/publicosAlvo/publicosAmbientesInovacao#> as publicosAmbientesInovacao
	extends <http://secti.pe.gov.br/indicador_cti/description/publicosAlvo/publicosSociedadeTerceiroSetor#> as publicosSociedadeTerceiroSetor
	uses <http://secti.pe.gov.br/indicador_cti/vocabulary/base#> as base
	uses <http://secti.pe.gov.br/indicador_cti/vocabulary/DesignAvaliacao/canvas#> as canvas
	uses <http://secti.pe.gov.br/indicador_cti/vocabulary/programa#> as programa
	
	instance PR3 : programa:programaCTI [
		base:nome "Redes de Inovação"
		base:descricao "Foi criado para fomentar a criação e o fortalecimento de redes de colaboração entre diferentes instituições e setores, com o objetivo de 
impulsionar atividades de pesquisa, desenvolvimento e inovação em Pernambuco"
		base:id "PR3"
		programa:possuiParceiros parceirosAgenciasFomento:PC2.2, parceirosAgenciasFomento:PC2.3, parceirosAgenciasFomento:PC2.4, parceirosGoverno:PC1.11
		programa:condicionadoPor fatorExterno:FE.OP8, fatorExterno:FE.OP9, fatorExterno:FE.OP10, fatorExterno:FE.OP11, fatorExterno:FE.OP12, fatorExterno:FE.AM15, 
		fatorExterno:FE.AM16, fatorExterno:FE.AM17, fatorExterno:FE.AM18
		programa:recebeEntradas entradasOrcamentoFinanciamento:EN1.4, entradasOrcamentoFinanciamento:EN1.5, entradasDadosSistemasPlataformas:EN2.1, 
		entradasCapitalHumano:EN3.1, entradasCapitalHumano:EN3.5, entradasInstrumentosLegaisNormativos:EN5.1
		programa:executa atividadeChave:AC1, atividadeChave:AC3, atividadeChave:AC4, atividadeChave:AC6, atividadeChave:AC7
		programa:geraSaidas saida:SA1, saida:SA2, saida:SA3, saida:SA4, saida:SA6, saida:SA7
		programa:produzResultados RE.CP1, RE.CP2, RE.MP1, RE.MP2, RE.LP1, RE.LP2, RE.LP3, RE.LP4
		programa:buscaAtingirGeral OB.GE
		programa:buscaAtingirEspecifico OB.ES1, OB.ES2, OB.ES3, OB.ES4, OB.ES5, OB.ES6, OB.ES7
		programa:avaliadoPor PA_RedesInovacao:PA1, PA_RedesInovacao:PA2, PA_RedesInovacao:PA3, PA_RedesInovacao:PA4, PA_RedesInovacao:PA5, PA_RedesInovacao:PA6, 
		PA_RedesInovacao:PA7, PA_RedesInovacao:PA8, PA_RedesInovacao:PA9
	]
	
	// Relações Redes de Inovação --> Público-Alvo
	relation instance PR3.direcionadoA.PA1.7 : programa:direcionadoA [
		from PR3
		to publicosAcademiaICTs:PA1.7
		base:tipo "direto"
	]
	relation instance PR3.direcionadoA.PA1.12 : programa:direcionadoA [
		from PR3
		to publicosAcademiaICTs:PA1.12
		base:tipo "indireto"
	]
	relation instance PR3.direcionadoA.PA1.13 : programa:direcionadoA [
		from PR3
		to publicosAcademiaICTs:PA1.13
		base:tipo "direto"
	]
	relation instance PR3.direcionadoA.PA2.2 : programa:direcionadoA [
		from PR3
		to publicosGovernoInstituicoesPublicas:PA2.2
		base:tipo "direto"
	]
	relation instance PR3.direcionadoA.PA2.3 : programa:direcionadoA [
		from PR3
		to publicosGovernoInstituicoesPublicas:PA2.3
		base:tipo "direto"
	]
	relation instance PR3.direcionadoA.PA3.2 : programa:direcionadoA [
		from PR3
		to publicosEmpresasEmpreendedores:PA3.2
		base:tipo "direto"
	]
	relation instance PR3.direcionadoA.PA3.5 : programa:direcionadoA [
		from PR3
		to publicosEmpresasEmpreendedores:PA3.5
		base:tipo "indireto"
	]
	relation instance PR3.direcionadoA.PA4.1 : programa:direcionadoA [
		from PR3
		to publicosAmbientesInovacao:PA4.1
		base:tipo "indireto"
	]
	relation instance PR3.direcionadoA.PA4.6 : programa:direcionadoA [
		from PR3
		to publicosAmbientesInovacao:PA4.6
		base:tipo "indireto"
	]
	relation instance PR3.direcionadoA.PA4.7 : programa:direcionadoA [
		from PR3
		to publicosAmbientesInovacao:PA4.7
		base:tipo "indireto"
	]
	relation instance PR3.direcionadoA.PA4.8 : programa:direcionadoA [
		from PR3
		to publicosAmbientesInovacao:PA4.8
		base:tipo "indireto"
	]
	relation instance PR3.direcionadoA.PA5.2 : programa:direcionadoA [
		from PR3
		to publicosSociedadeTerceiroSetor:PA5.2
		base:tipo "direto"
	]
	
	// Objetivo Geral
	instance OB.GE : canvas:ObjetivoGeral [
		base:nome "Incentivar a criação e o fortalecimento de redes autossustentáveis que promovam e articulem atividades de inovação e integrem ICTs e demais 
agentes do ecossistema, em consonância com as RDs do Estado, visando o fortalecimento de seus ecossistemas"
		base:id "OB.GE - RedesInovacao"
	]
	
	// Objetivos Específicos
	instance OB.ES1 : canvas:ObjetivoEspecifico [
		base:nome "Impulsionar cooperações de CT&I e parcerias entre agentes do ecossistema de inovação, em redes autossustentáveis, aderentes às RDs do Estado"
		base:id "OB.ES1 - RedesInovacao"
		canvas:buscaAtingir RE.LP3, RE.LP4
	]
	instance OB.ES2 : canvas:ObjetivoEspecifico [
		base:nome "Estimular ações de inovação aberta aderentes às RDs do Estado"
		base:id "OB.ES2 - RedesInovacao"
		canvas:buscaAtingir RE.MP1
	]
	instance OB.ES3 : canvas:ObjetivoEspecifico [
		base:nome "Apoiar a realização de eventos de CT&I, aderentes às RDs do Estado"
		base:id "OB.ES3 - RedesInovacao"
		canvas:buscaAtingir RE.CP1
	]
	instance OB.ES4 : canvas:ObjetivoEspecifico [
		base:nome "Incentivar o desenvolvimento de projetos de CT&I, aderentes às RDs do Estado"
		base:id "OB.ES4 - RedesInovacao"
		canvas:buscaAtingir RE.CP2
	]
	instance OB.ES5 : canvas:ObjetivoEspecifico [
		base:nome "Estimular a transferência tecnológica realizadas no estado"
		base:id "OB.ES5 - RedesInovacao"
		canvas:buscaAtingir RE.LP1
	]
	instance OB.ES6 : canvas:ObjetivoEspecifico [
		base:nome "Promover a geração de startups e negócios, aderentes às RDs do Estado"
		base:id "OB.ES6 - RedesInovacao"
		canvas:buscaAtingir RE.MP2, RE.LP2
	]
	instance OB.ES7 : canvas:ObjetivoEspecifico [
		base:nome "Apoiar articuladores que conectem o ecossistema às demais políticas de CT&I do Estado"
		base:id "OB.ES7 - RedesInovacao"
	]
	
	// Resultados Esperados
	
	// Curto Prazo
	instance RE.CP1 : canvas:ResultadoEsperado [
		base:nome "Indução de eventos de CT&I realizados pela rede  em todo o Estado, aderentes às RDs do Estado"
		base:id "RE.CP1 - RedesInovacao"
		canvas:prazo "curto"
	]
	instance RE.CP2 : canvas:ResultadoEsperado [
		base:nome "Indução de projetos de CT&I aderentes às RD pelas redes fomentadas em todo o Estado"
		base:id "RE.CP2 - RedesInovacao"
		canvas:prazo "curto"
	]
	
	// Médio Prazo
	instance RE.MP1 : canvas:ResultadoEsperado [
		base:nome "Ampliação do nº de ações de inovação aberta realizadas em todo o Estado"
		base:id "RE.MP1 - RedesInovacao"
		canvas:prazo "médio"
	]
	instance RE.MP2 : canvas:ResultadoEsperado [
		base:nome "Ampliação do nº de startups ativas em todo o Estado"
		base:id "RE.MP2 - RedesInovacao"
		canvas:prazo "médio"
	]
	
	// Longo Prazo
	instance RE.LP1 : canvas:ResultadoEsperado [
		base:nome "Ampliação do nº de transferências tecnológicas realizadas no Estado"
		base:id "RE.LP1 - RedesInovacao"
		canvas:prazo "longo"
	]
	instance RE.LP2 : canvas:ResultadoEsperado [
		base:nome "Ampliação do faturamento das empresas participantes da rede"
		base:id "RE.LP2 - RedesInovacao"
		canvas:prazo "longo"
	]
	instance RE.LP3 : canvas:ResultadoEsperado [
		base:nome "Ampliação do nº de redes de inovação ativas e autossustentáveis em todo Estado"
		base:id "RE.LP3 - RedesInovacao"
		canvas:prazo "longo"
	]
	instance RE.LP4 : canvas:ResultadoEsperado [
		base:nome "Ampliação da produção de CT&I de grupos de pesquisa vinculados às redes apoiadas"
		base:id "RE.LP4 - RedesInovacao"
		canvas:prazo "longo"
	]
}
description <http://secti.pe.gov.br/indicador_cti/description/programas/programasEmpreendedorismoInovacao/RedesInovacao/PA_RedesInovacao#> as PA_RedesInovacao {
	
	extends <http://secti.pe.gov.br/indicador_cti/description/fontesInformacao/fontesDadosPrimarios#> as fontesDadosPrimarios
	extends <http://secti.pe.gov.br/indicador_cti/description/fontesInformacao/fontesSistemasBasesGovernamentais#> as fontesSistemasBasesGovernamentais
	extends <http://secti.pe.gov.br/indicador_cti/description/fontesInformacao/fontesInfraestruturaAtivosCTI#> as fontesInfraestruturaAtivosCTI
	extends <http://secti.pe.gov.br/indicador_cti/description/programas/programasEmpreendedorismoInovacao/RedesInovacao/RedesInovacao#> as RedesInovacao
	uses <http://secti.pe.gov.br/indicador_cti/vocabulary/base#> as base
	uses <http://secti.pe.gov.br/indicador_cti/vocabulary/DesignAvaliacao/planoAvaliacao#> as planoAvaliacao
	uses <http://secti.pe.gov.br/indicador_cti/vocabulary/DesignAvaliacao/metricas#> as metricas
	uses <http://www.w3.org/2001/XMLSchema#> as xsd
	
	
	instance PAV1 : planoAvaliacao:planoAvaliacao[
		base:nome "Plano de Avaliação do Programa Redes de Inovação"
		base:id "PA-PR3"
		base:versao "V1-Homologado"
		base:dataCriacao "2026-06-25T00:00:00Z"^^xsd:dateTime
		planoAvaliacao:temQuestaoAvaliacao PA_RedesInovacao:PA1, PA_RedesInovacao:PA2, PA_RedesInovacao:PA3, PA_RedesInovacao:PA4, PA_RedesInovacao:PA5, PA_RedesInovacao:PA6, 
		PA_RedesInovacao:PA7, PA_RedesInovacao:PA8, PA_RedesInovacao:PA9
	]
	
	instance PA1 : planoAvaliacao:questaoAvaliacao [
		base:nome "Quantos eventos e ações de inovação aberta (hackathons, maratonas, match days, workshops de ideação, entre outros) foram realizadas?"
		base:id "PA1 - RedesInovacao"
		planoAvaliacao:custo "Baixo"
		planoAvaliacao:risco "Alto"
		planoAvaliacao:temMetrica PA1.ME1, PA1.ME2, PA1.ME3
		planoAvaliacao:temEscopo PA1.ES
		planoAvaliacao:temMetodologia PA1.MA1
		planoAvaliacao:temLimitacao LIM1
		planoAvaliacao:alinhaComResultado RedesInovacao:RE.CP1, RedesInovacao:RE.MP1
	]
	instance PA2 : planoAvaliacao:questaoAvaliacao [
		base:nome "A rede induziu o aumento de projetos de CT&I nas suas respectivas áreas?"
		base:id "PA2 - RedesInovacao"
		planoAvaliacao:custo "Médio"
		planoAvaliacao:risco "Alto"
		planoAvaliacao:temMetrica PA2.ME1, PA2.ME2
		planoAvaliacao:temEscopo PA2.ES
		planoAvaliacao:temMetodologia PA2.MA1
		planoAvaliacao:temLimitacao LIM2, LIM3
		planoAvaliacao:alinhaComResultado RedesInovacao:RE.CP2
	]
	instance PA3 : planoAvaliacao:questaoAvaliacao [
		base:nome "A rede contribuiu para a geração de startups?"
		base:id "PA3 - RedesInovacao"
		planoAvaliacao:custo "Baixo"
		planoAvaliacao:risco "Alto"
		planoAvaliacao:temMetrica PA3.ME1, PA3.ME2
		planoAvaliacao:temEscopo PA3.ES
		planoAvaliacao:temMetodologia PA3.MA1
		planoAvaliacao:temLimitacao LIM1, LIM4, LIM5
		planoAvaliacao:alinhaComResultado RedesInovacao:RE.MP2
	]
	instance PA4 : planoAvaliacao:questaoAvaliacao [
		base:nome "Como evoluiu a diversidade de atores (startups, indústria, ICTs, órgãos públicos, organizações civis, etc) nas redes após o programa?"
		base:id "PA4 - RedesInovacao"
		planoAvaliacao:custo "Baixo"
		planoAvaliacao:risco "Alto"
		planoAvaliacao:temMetrica PA4.ME1, PA4.ME2
		planoAvaliacao:temEscopo PA4.ES
		planoAvaliacao:temMetodologia PA4.MA1
		planoAvaliacao:temLimitacao LIM1
		planoAvaliacao:alinhaComResultado RedesInovacao:RE.LP3
	]
	instance PA5 : planoAvaliacao:questaoAvaliacao [
		base:nome "Qual a taxa de conversão de projetos em transferências tecnológicas/licenciamentos?"
		base:id "PA5 - RedesInovacao"
		planoAvaliacao:custo "Alto"
		planoAvaliacao:risco "Alto"
		planoAvaliacao:temMetrica PA5.ME1
		planoAvaliacao:temEscopo PA5.ES
		planoAvaliacao:temMetodologia PA5.MA1
		planoAvaliacao:temLimitacao LIM6
		planoAvaliacao:alinhaComResultado RedesInovacao:RE.LP1
	]
	instance PA6 : planoAvaliacao:questaoAvaliacao [
		base:nome "Quantas inovações (produtos/processos) foram implantadas com impacto mensurável em produtividade?"
		base:id "PA6 - RedesInovacao"
		planoAvaliacao:custo "Alto"
		planoAvaliacao:risco "Alto"
		planoAvaliacao:temMetrica PA6.ME1
		planoAvaliacao:temEscopo PA6.ES
		planoAvaliacao:temMetodologia PA6.MA1
		planoAvaliacao:temLimitacao LIM7, LIM8
		planoAvaliacao:alinhaComResultado RedesInovacao:RE.LP1
	]
	instance PA7 : planoAvaliacao:questaoAvaliacao [
		base:nome "Houve aumento da produção de CT&I dos grupos associados aos projetos?"
		base:id "PA7 - RedesInovacao"
		planoAvaliacao:custo "Alto"
		planoAvaliacao:risco "Alto"
		planoAvaliacao:temMetrica PA7.ME1, PA7.ME2
		planoAvaliacao:temEscopo PA7.ES
		planoAvaliacao:temMetodologia PA7.MA1
		planoAvaliacao:temLimitacao LIM1, LIM9
		planoAvaliacao:alinhaComResultado RedesInovacao:RE.LP4
	]
	instance PA8 : planoAvaliacao:questaoAvaliacao [
		base:nome "Qual o percentual de redes que alcançaram a autossustentabilidade financeira após 2 anos de apoio?"
		base:id "PA8 - RedesInovacao"
		planoAvaliacao:custo "Médio"
		planoAvaliacao:risco "Alto"
		planoAvaliacao:temMetrica PA8.ME1, PA8.ME2, PA8.ME3
		planoAvaliacao:temEscopo PA8.ES
		planoAvaliacao:temMetodologia PA8.MA1
		planoAvaliacao:temLimitacao LIM1, LIM10
		planoAvaliacao:alinhaComResultado RedesInovacao:RE.LP3
	]
	instance PA9 : planoAvaliacao:questaoAvaliacao [
		base:nome "Houve crescimento do faturamento de empresas participantes nas redes?"
		base:id "PA9 - RedesInovacao"
		planoAvaliacao:custo "Alto"
		planoAvaliacao:risco "Alto"
		planoAvaliacao:temMetrica PA9.ME1, PA9.ME2
		planoAvaliacao:temEscopo PA9.ES
		planoAvaliacao:temMetodologia PA9.MA1
		planoAvaliacao:temLimitacao LIM4
		planoAvaliacao:alinhaComResultado RedesInovacao:RE.LP2
	]
	
	//Métricas	
	instance PA1.ME1 : metricas:metrica [
		base:descricao "Número de ações de inovação aberta por edital, por tipo"
		base:id "PA1.ME1 - RedesInovacao"
		metricas:temFonte fontesDadosPrimarios:FI1.1
	]
	instance PA1.ME2 : metricas:metrica [
		base:descricao "Número de participantes por evento"
		base:id "PA1.ME2 - RedesInovacao"
		metricas:temFonte fontesDadosPrimarios:FI1.1
	]
	instance PA1.ME3 : metricas:metrica [
		base:descricao "Número de produtos que foram gerados em decorrência dos eventos por edital (POC, MVP, ou soluções)"
		base:id "PA1.ME3 - RedesInovacao"
		metricas:temFonte fontesDadosPrimarios:FI1.1
	]
	
	instance PA2.ME1 : metricas:metrica [
		base:descricao "Número de projetos de CT&I alavancados pelas redes apoiadas no edital"
		base:id "PA2.ME1 - RedesInovacao"
		metricas:temFonte fontesSistemasBasesGovernamentais:FI2.1
	]
	instance PA2.ME2 : metricas:metrica [
		base:descricao "Valor alavancado pelas redes apoiadas no edital"
		base:id "PA2.ME2 - RedesInovacao"
		metricas:temFonte fontesDadosPrimarios:FI1.1
	]
	
	instance PA3.ME1 : metricas:metrica [
		base:descricao "Número de startups geradas em função das redes apoiadas no edital"
		base:id "PA3.ME1 - RedesInovacao"
		metricas:temFonte fontesDadosPrimarios:FI1.1
	]
	instance PA3.ME2 : metricas:metrica [
		base:descricao "Número de startups geradas que já tiveram contratos e faturamento"
		base:id "PA3.ME2 - RedesInovacao"
		metricas:temFonte fontesDadosPrimarios:FI1.1
	]

	instance PA4.ME1 : metricas:metrica [
		base:descricao "Número de atores (startup, indústria, ICTs, órgãos públicos, organizações civis, etc) em cada rede, na submissão por modalidade e por setor 
econômico"
		base:id "PA4.ME1 - RedesInovacao"
		metricas:temFonte fontesDadosPrimarios:FI1.1
	]
	instance PA4.ME2 : metricas:metrica [
		base:descricao "Número de atores (startup, indústria, ICTs, órgãos públicos, organizações civis, etc) em cada rede, ao final do projeto por modalidade e 
por setor econômico"
		base:id "PA4.ME2 - RedesInovacao"
		metricas:temFonte fontesDadosPrimarios:FI1.1
	]
	
	instance PA5.ME1 : metricas:metrica [
		base:descricao "Número de transferências de tecnologia ou licenciamentos que foram realizadas em cada projeto"
		base:id "PA5.ME1 - RedesInovacao"
		metricas:temFonte fontesDadosPrimarios:FI1.1, fontesInfraestruturaAtivosCTI:FI4.2
	]
	
	instance PA6.ME1 : metricas:metrica [
		base:descricao "Número de inovações que foram incorporadas nos processos produtivos"
		base:id "PA6.ME1 - RedesInovacao"
		metricas:temFonte fontesDadosPrimarios:FI1.1
	]
	
	instance PA7.ME1 : metricas:metrica [
		base:descricao "Número de artigos ao longo do projeto"
		base:id "PA7.ME1 - RedesInovacao"
		metricas:temFonte fontesDadosPrimarios:FI1.1
	]
	instance PA7.ME2 : metricas:metrica [
		base:descricao "Número de PI (patentes e softwares) ao longo do projeto"
		base:id "PA7.ME2 - RedesInovacao"
		metricas:temFonte fontesDadosPrimarios:FI1.1
	]
	
	instance PA8.ME1 : metricas:metrica [
		base:descricao "Valor dos recursos captados por rede junto à órgãos de fomento"
		base:id "PA8.ME1 - RedesInovacao"
		metricas:temFonte fontesDadosPrimarios:FI1.1
	]
	instance PA8.ME2 : metricas:metrica [
		base:descricao "Valor dos recursos captados por rede em acordos de parceria"
		base:id "PA8.ME2 - RedesInovacao"
		metricas:temFonte fontesDadosPrimarios:FI1.1
	]
	instance PA8.ME3 : metricas:metrica [
		base:descricao "Valor dos recursos captados por treinamentos, eventos e ações da rede"
		base:id "PA8.ME3 - RedesInovacao"
		metricas:temFonte fontesDadosPrimarios:FI1.1
	]
	
	instance PA9.ME1 : metricas:metrica [
		base:descricao "Valor do faturamento das empresas no começo do projeto"
		base:id "PA9.ME1 - RedesInovacao"
		metricas:temFonte fontesDadosPrimarios:FI1.1, fontesSistemasBasesGovernamentais:FI2.2, fontesSistemasBasesGovernamentais:FI2.8
	]
	instance PA9.ME2 : metricas:metrica [
		base:descricao "Valor do faturamento das empresas ao final do projeto"
		base:id "PA9.ME2 - RedesInovacao"
		metricas:temFonte fontesDadosPrimarios:FI1.1, fontesSistemasBasesGovernamentais:FI2.2, fontesSistemasBasesGovernamentais:FI2.8
	]
	
	// Escopos e Métodos de Avaliação
	instance PA1.ES : planoAvaliacao:escopo [
		base:descricao "Espera-se identificar a efetiva contribuição do Programa Redes de Inovação para a ampliação da realização de ações de inovação aberta no 
Estado, considerando a diversidade de formatos (hackathons, maratonas, match days, workshops etc.). A comparação será longitudinal (ao longo dos anos) do próprio 
Redes de Inovação"
		base:id "PA1.ES - RedesInovacao"
	]
	instance PA1.MA1 : planoAvaliacao:metodoAvaliacao [
		base:descricao "Análise descritiva"
		base:id "PA1.MA1 - RedesInovacao"
	]
	
	instance PA2.ES : planoAvaliacao:escopo [
		base:descricao "Espera-se identificar a contribuição das Redes de Inovação para a ampliação da geração e da captação de projetos de CT&I nas áreas 
estratégicas apoiadas. A comparação será longitudinal entre os editais do próprio programa"
		base:id "PA2.ES - RedesInovacao"
	]
	instance PA2.MA1 : planoAvaliacao:metodoAvaliacao [
		base:descricao "Análise descritiva"
		base:id "PA2.MA1 - RedesInovacao"
	]
	
	instance PA3.ES : planoAvaliacao:escopo [
		base:descricao "Espera-se identificar a contribuição das redes apoiadas para a geração de startups no estado de Pernambuco. A análise considerará a 
evolução desse indicador ao longo das edições do programa"
		base:id "PA3.ES - RedesInovacao"
	]
	instance PA3.MA1 : planoAvaliacao:metodoAvaliacao [
		base:descricao "Análise descritiva"
		base:id "PA3.MA1 - RedesInovacao"
	]
	
	instance PA4.ES : planoAvaliacao:escopo [
		base:descricao "Espera-se avaliar se o Programa Redes de Inovação contribuiu para a ampliação e diversificação dos atores participantes das redes 
(ICTs, startups, indústrias, órgãos públicos, organizações civis e outros), fortalecendo a articulação dos ecossistemas. A comparação será feita entre o momento da 
submissão e o final do projeto, além da análise longitudinal entre editais"
		base:id "PA4.ES - RedesInovacao"
	]
	instance PA4.MA1 : planoAvaliacao:metodoAvaliacao [
		base:descricao "Análise descritiva"
		base:id "PA4.MA1 - RedesInovacao"
	]
	
	instance PA5.ES : planoAvaliacao:escopo [
		base:descricao "Espera-se identificar a contribuição das redes apoiadas para a transformação de resultados de projetos de CT&I em transferências 
tecnológicas e licenciamentos. A análise observará a evolução desse indicador ao longo das edições do programa"
		base:id "PA5.ES - RedesInovacao"
	]
	instance PA5.MA1 : planoAvaliacao:metodoAvaliacao [
		base:descricao "Análise descritiva"
		base:id "PA5.MA1 - RedesInovacao"
	]
	
	instance PA6.ES : planoAvaliacao:escopo [
		base:descricao "Espera-se identificar a contribuição das Redes de Inovação para a incorporação de inovações nos processos produtivos das organizações 
envolvidas, com potencial impacto em produtividade. A comparação será longitudinal entre os editais do programa"
		base:id "PA6.ES - RedesInovacao"
	]
	instance PA6.MA1 : planoAvaliacao:metodoAvaliacao [
		base:descricao "Análise descritiva"
		base:id "PA6.MA1 - RedesInovacao"
	]
	
	instance PA7.ES : planoAvaliacao:escopo [
		base:descricao "Espera-se avaliar se o programa contribuiu para o fortalecimento da produção científica e tecnológica dos grupos de pesquisa vinculados às 
redes apoiadas. A análise considerará a variação antes e após o apoio, além da evolução entre edições do programa"
		base:id "PA7.ES - RedesInovacao"
	]
	instance PA7.MA1 : planoAvaliacao:metodoAvaliacao [
		base:descricao "Análise descritiva"
		base:id "PA7.MA1 - RedesInovacao"
	]
	
	instance PA8.ES : planoAvaliacao:escopo [
		base:descricao "Espera-se identificar a contribuição do Programa Redes de Inovação para o fortalecimento da sustentabilidade financeira das redes apoiadas, 
considerando sua capacidade de captar recursos após o período de apoio. A comparação será longitudinal entre as redes apoiadas em diferentes editais"
		base:id "PA8.ES - RedesInovacao"
	]
	instance PA8.MA1 : planoAvaliacao:metodoAvaliacao [
		base:descricao "Análise descritiva"
		base:id "PA8.MA1 - RedesInovacao"
	]
	
	instance PA9.ES : planoAvaliacao:escopo [
		base:descricao "Espera-se avaliar se a participação nas Redes de Inovação contribuiu para o fortalecimento econômico das empresas envolvidas, observado por 
meio da evolução do faturamento ao longo do tempo. A análise considerará a variação do faturamento antes e após a participação das empresas no próprio programa, em 
cada edição"
		base:id "PA9.ES - RedesInovacao"
	]
	instance PA9.MA1 : planoAvaliacao:metodoAvaliacao [
		base:descricao "Análise descritiva"
		base:id "PA9.MA1 - RedesInovacao"
	]

	//Limitações
	instance LIM1 : planoAvaliacao:limitacao [
		base:descricao "Dependência dos respondentes para obtenção das informações"
	]
	instance LIM2 : planoAvaliacao:limitacao [
		base:descricao "Nem todos os projetos iniciados podem ter sido cadastrados no AgilFAP"
	]
	instance LIM3 : planoAvaliacao:limitacao [
		base:descricao "Difícil de atribuir a causalidade da criação do projeto"
	]
	instance LIM4 : planoAvaliacao:limitacao [
		base:descricao "Influência de fatores externos dificulta a análise de causalidade"
	]
	instance LIM5 : planoAvaliacao:limitacao [
		base:descricao "O tempo para a spinoff começar a ter faturamento pode ultrapassar o tempo do programa"
	]
	instance LIM6 : planoAvaliacao:limitacao [
		base:descricao "O tempo de licenciamento pode ultrapassar a duração do projeto"
	]
	instance LIM7 : planoAvaliacao:limitacao [
		base:descricao "Diversos fatores podem impactar na produtividade"
	]
	instance LIM8 : planoAvaliacao:limitacao [
		base:descricao "Difícil de avaliar a causalidade"
	]
	instance LIM9 : planoAvaliacao:limitacao [
		base:descricao "Acesso aos dados"
	]
	instance LIM10 : planoAvaliacao:limitacao [
		base:descricao "Autosustentabilidade é um conceito relativo e pode haver divergências de interpretação"
	]
}
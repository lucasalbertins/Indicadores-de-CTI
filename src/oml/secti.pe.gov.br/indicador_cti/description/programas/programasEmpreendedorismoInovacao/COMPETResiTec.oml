description <http://secti.pe.gov.br/indicador_cti/description/programas/programasEmpreendedorismoInovacao/COMPETResiTec#> as COMPETResiTec {
	
	extends <http://secti.pe.gov.br/indicador_cti/description/parceirosChave#> as parceiroChave
	extends <http://secti.pe.gov.br/indicador_cti/description/fatoresExternos#> as fatorExterno
	extends <http://secti.pe.gov.br/indicador_cti/description/entradas#> as entrada
	extends <http://secti.pe.gov.br/indicador_cti/description/atividadesChave#> as atividadeChave
	extends <http://secti.pe.gov.br/indicador_cti/description/saidas#> as saida
	extends <http://secti.pe.gov.br/indicador_cti/description/resultados#> as resultado
	extends <http://secti.pe.gov.br/indicador_cti/description/publicoAlvo#> as publicoAlvo
	
	uses <http://secti.pe.gov.br/indicador_cti/vocabulary/base#> as base
	uses <http://secti.pe.gov.br/indicador_cti/vocabulary/canvas#> as canvas
	uses <http://secti.pe.gov.br/indicador_cti/vocabulary/programa#> as programa
	
	instance COMPETResiTec : programa:programaCTI [
		base:nome "Programa: COMPET Residência Tecnológica"
		base:descricao "Foi criado com o objetivo de promover a integração e fixação de talentos 
altamente qualificados no ecossistema de ciência, tecnologia e inovação (CT&I) em Pernambuco"
		programa:possuiParceiros parceiroChave:ICTsIntegrantes, parceiroChave:EmpresasIntegrantes, 
		parceiroChave:FundacoesApoio
		programa:condicionadoPor fatorExterno:FE2, fatorExterno:FE3, fatorExterno:FE14, fatorExterno:FE18, 
		fatorExterno:FE21
		programa:recebeEntradas entrada:OrcamentoEstadual, entrada:EN2, entrada:EN3, entrada:EN4, 
		entrada:EN6, entrada:EN7, entrada:EN8, entrada:EN9
		programa:executa atividadeChave:AC1, atividadeChave:AC2, atividadeChave:AC3, atividadeChave:AC4, 
		atividadeChave:AC6, atividadeChave:AC7
		programa:geraSaidas saida:OUT1, saida:OUT2, saida:OUT3, saida:OUT4, saida:OUT6, saida:OUT7
		programa:produzResultados resultado:RES8, resultado:RES43, resultado:RES44, resultado:RES50, 
		resultado:RES51, resultado:RES18
		programa:direcionadoA publicoAlvo:PA1, publicoAlvo:PA2, publicoAlvo:PA5, publicoAlvo:PA6, 
		publicoAlvo:PA28, publicoAlvo:PA11, publicoAlvo:PA12, publicoAlvo:PA13, publicoAlvo:PA17, 
		publicoAlvo:PA18, publicoAlvo:PA20
		programa:buscaAtingir1 OBJGeral
		programa:buscaAtingir2 OBJEspecifico1, OBJEspecifico2, OBJEspecifico3, OBJEspecifico4
	]
	
	instance OBJGeral : canvas:ObjetivoGeral [
		base:nome "Apoiar a execução de Cursos de Residência Tecnológica que contribuam para a formação 
de recursos humanos qualificados em nível de pós-graduação lato sensu, mediante parcerias entre ICTs e 
médias e grandes empresas pernambucanas"
	]
	instance OBJEspecifico1 : canvas:ObjetivoEspecifico [
		base:nome "Promover a formação de recursos humanos em nível de pós-graduação lato sensu, com 
enfoque em desafios tecnológicos aderentes aos ambientes produtivos do Estado"
	]
	instance OBJEspecifico2 : canvas:ObjetivoEspecifico [
		base:nome "Estimular conhecimentos e capacidades técnicas que incrementem a competitividade dos 
ambientes produtivos, inclusive no interior do Estado"
	]
	instance OBJEspecifico3 : canvas:ObjetivoEspecifico [
		base:nome "Incentivar a empregabilidade de recursos humanos qualificados em médias e grandes 
empresas pernambucanas"
	]
	instance OBJEspecifico4 : canvas:ObjetivoEspecifico [
		base:nome "Impulsionar a formação de parcerias entre ICTs e o setor privado"
	]
}
	instance OBJGeral : canvas:ObjetivoGeral [
		base:nome "Apoiar MPEs pernambucanas em projetos de desenvolvimento e implantação de produtos, 
serviços e/ou processos inovadores que contemplem desafios de empresas, cooperativas e associações do 
Estado, com vistas ao incremento da competitividade territorial de Pernambuco"
		base:id "5"
	]
	instance OBJEspecifico1 : canvas:ObjetivoEspecifico [
		base:nome "Incentivar o desenvolvimento de projetos de PD&I aplicados a desafios de empresas, 

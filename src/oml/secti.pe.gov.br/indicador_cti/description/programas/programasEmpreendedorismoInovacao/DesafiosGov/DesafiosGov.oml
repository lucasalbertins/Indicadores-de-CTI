description <http://secti.pe.gov.br/indicador_cti/description/programas/programasEmpreendedorismoInovacao/DesafiosGov/DesafiosGov#> as DesafiosGov {
	
	extends <http://secti.pe.gov.br/indicador_cti/description/programas/programasEmpreendedorismoInovacao/DesafiosGov/PA_DesafiosGov#> as PA_DesafiosGov
	extends <http://secti.pe.gov.br/indicador_cti/description/parceirosChave/parceirosGoverno#> as parceirosGoverno
	extends <http://secti.pe.gov.br/indicador_cti/description/parceirosChave/parceirosAgenciasFomento#> as parceirosAgenciasFomento
	extends <http://secti.pe.gov.br/indicador_cti/description/parceirosChave/parceirosEmpresas#> as parceirosEmpresas
	extends <http://secti.pe.gov.br/indicador_cti/description/parceirosChave/parceirosAmbientesInovacao#> as parceirosAmbientesInovacao
	extends <http://secti.pe.gov.br/indicador_cti/description/fatoresExternos#> as fatorExterno
	extends <http://secti.pe.gov.br/indicador_cti/description/entradas#> as entrada
	extends <http://secti.pe.gov.br/indicador_cti/description/atividadesChave#> as atividadeChave
	extends <http://secti.pe.gov.br/indicador_cti/description/saidas#> as saida
	extends <http://secti.pe.gov.br/indicador_cti/description/publicoAlvo#> as publicoAlvo
	uses <http://secti.pe.gov.br/indicador_cti/vocabulary/base#> as base
	uses <http://secti.pe.gov.br/indicador_cti/vocabulary/DesignAvaliacao/canvas#> as canvas
	uses <http://secti.pe.gov.br/indicador_cti/vocabulary/programa#> as programa
	
	instance PR7 : programa:programaCTI [
		base:nome "Desafios.gov"
		base:descricao "Foi criado com o objetivo de apoiar micro e pequenas empresas (especialmente startups) a desenvolverem soluções inovadoras para desafios 
da gestão pública do estado de Pernambuco"
		base:id "PR7"
		programa:possuiParceiros parceirosAgenciasFomento:PC2.2, parceirosAgenciasFomento:PC2.3, parceirosGoverno:PC1.11, parceirosEmpresas:PC4.1, 
		parceirosEmpresas:PC4.2, parceirosAmbientesInovacao:PC5.9
		programa:condicionadoPor fatorExterno:FE.OP8, fatorExterno:FE.OP9, fatorExterno:FE.OP11, fatorExterno:FE.OP13, fatorExterno:FE.AM15, fatorExterno:FE.AM19
		programa:recebeEntradas entrada:EN1, entrada:EN2, entrada:EN3, entrada:EN4, entrada:EN6, entrada:EN5
		programa:executa atividadeChave:AC1, atividadeChave:AC3, atividadeChave:AC4, atividadeChave:AC6, atividadeChave:AC7
		programa:geraSaidas saida:SA1, saida:SA2, saida:SA3, saida:SA4, saida:SA6, saida:SA7
		programa:produzResultados RE.CP1, RE.MP1, RE.LP1, RE.LP2
		programa:direcionadoA publicoAlvo:PU.DI18, publicoAlvo:PU.DI19, publicoAlvo:PU.IN14, publicoAlvo:PU.IN15, publicoAlvo:PU.IN16
		programa:buscaAtingirGeral OB.GE
		programa:buscaAtingirEspecifico OB.ES1, OB.ES3, OB.ES4, OB.ES5, OB.ES6
		programa:avaliadoPor PA_DesafiosGov:PA1, PA_DesafiosGov:PA2, PA_DesafiosGov:PA3, PA_DesafiosGov:PA4, PA_DesafiosGov:PA5
	]
	
	// Objetivo Geral
	instance OB.GE : canvas:ObjetivoGeral [
		base:nome "Apoiar MPEs em projetos de desenvolvimento e implantação de produtos, serviços e/ou processos inovadores que contemplem desafios de órgãos 
públicos do Estado"
		base:id "OB.GE - DesafiosGov"
	]
	
	// Objetivos Específicos
	instance OB.ES1 : canvas:ObjetivoEspecifico [
		base:nome "Incentivar o desenvolvimento de projetos de PD&I aplicados a desafios de órgãos públicos do Estado em parceria com empresas de base tecnológica"
		base:id "OB.ES1 - DesafiosGov"
		canvas:buscaAtingir RE.CP1
	]
	instance OB.ES3 : canvas:ObjetivoEspecifico [
		base:nome "Promover a consolidação de empresas de base tecnológica especializadas em soluções de aprimoramento dos serviços públicos, inclusive no interior 
do Estado"
		base:id "OB.ES3 - DesafiosGov"
		canvas:buscaAtingir RE.MP1, RE.LP1, RE.LP2
	]
	instance OB.ES4 : canvas:ObjetivoEspecifico [
		base:nome "Impulsionar a formação de parcerias entre o setor público e o setor privado"
		base:id "OB.ES4 - DesafiosGov"
		canvas:buscaAtingir RE.CP1
	]
	instance OB.ES5 : canvas:ObjetivoEspecifico [
		base:nome "Estimular a transferência tecnológica e de conhecimentos, inclusive para o setor público"
		base:id "OB.ES5 - DesafiosGov"
		canvas:buscaAtingir RE.MP1
	]
	instance OB.ES6 : canvas:ObjetivoEspecifico [
		base:nome "Estimular oportunidades relacionadas ao Marco Legal de CT&I e às compras públicas de soluções inovadoras"
		base:id "OB.ES6 - DesafiosGov"
		canvas:buscaAtingir RE.MP1, RE.LP1
	]
	
	// Resultados Esperados
	
	// Curto Prazo
	instance RE.CP1 : canvas:ResultadoEsperado [
		base:nome "Indução do nº de projetos de PD&I ativos que envolvam órgãos públicos da esfera estadual em parceria com empresas pernambucanas de base 
tecnológica"
		base:id "RE.CP1 - DesafiosGov"
		canvas:prazo "curto"
	]
	
	// Médio Prazo
	instance RE.MP1 : canvas:ResultadoEsperado [
		base:nome "Absorção de soluções inovadoras por órgãos públicos do Estado de Pernambuco"
		base:id "RE.MP1 - DesafiosGov"
		canvas:prazo "médio"
	]
	
	// Longo Prazo
	instance RE.LP1 : canvas:ResultadoEsperado [
		base:nome "Ampliação do nº de contratações por órgãos públicos do Estado de Pernambuco"
		base:id "RE.LP1 - DesafiosGov"
		canvas:prazo "longo"
	]
	instance RE.LP2 : canvas:ResultadoEsperado [
		base:nome "Ampliação do nº de empregos, do portfólio, do faturamento obtido, das PIs e software registrados por empresas pernambucanas de base tecnológica 
especializadas em soluções de aprimoramento dos serviços públicos, inclusive no interior"
		base:id "RE.LP2 - DesafiosGov"
		canvas:prazo "longo"
	]
}
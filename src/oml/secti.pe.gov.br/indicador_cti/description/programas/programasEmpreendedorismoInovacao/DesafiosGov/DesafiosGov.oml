description <http://secti.pe.gov.br/indicador_cti/description/programas/programasEmpreendedorismoInovacao/DesafiosGov/DesafiosGov#> as DesafiosGov {
	
	extends <http://secti.pe.gov.br/indicador_cti/description/programas/programasEmpreendedorismoInovacao/DesafiosGov/PA_DesafiosGov#> as PA_DesafiosGov
	extends <http://secti.pe.gov.br/indicador_cti/description/parceirosChave/parceirosGoverno#> as parceirosGoverno
	extends <http://secti.pe.gov.br/indicador_cti/description/parceirosChave/parceirosAgenciasFomento#> as parceirosAgenciasFomento
	extends <http://secti.pe.gov.br/indicador_cti/description/parceirosChave/parceirosEmpresas#> as parceirosEmpresas
	extends <http://secti.pe.gov.br/indicador_cti/description/parceirosChave/parceirosAmbientesInovacao#> as parceirosAmbientesInovacao
	extends <http://secti.pe.gov.br/indicador_cti/description/fatoresExternos/fatoresCenarioEconomico#> as fatoresCenarioEconomico
	extends <http://secti.pe.gov.br/indicador_cti/description/fatoresExternos/fatoresCenarioInstitucionalLegal#> as fatoresCenarioInstitucionalLegal
	extends <http://secti.pe.gov.br/indicador_cti/description/fatoresExternos/fatoresCenarioSocialEducacional#> as fatoresCenarioSocialEducacional
	extends <http://secti.pe.gov.br/indicador_cti/description/fatoresExternos/fatoresDinamicaEcossistema#> as fatoresDinamicaEcossistema
	extends <http://secti.pe.gov.br/indicador_cti/description/entradas/entradasOrcamentoFinanciamento#> as entradasOrcamentoFinanciamento
	extends <http://secti.pe.gov.br/indicador_cti/description/entradas/entradasDadosSistemasPlataformas#> as entradasDadosSistemasPlataformas
	extends <http://secti.pe.gov.br/indicador_cti/description/entradas/entradasCapitalHumano#> as entradasCapitalHumano
	extends <http://secti.pe.gov.br/indicador_cti/description/entradas/entradasInstrumentosLegaisNormativos#> as entradasInstrumentosLegaisNormativos
	extends <http://secti.pe.gov.br/indicador_cti/description/atividadesChave#> as atividadeChave
	extends <http://secti.pe.gov.br/indicador_cti/description/saidas#> as saida
	extends <http://secti.pe.gov.br/indicador_cti/description/publicosAlvo/publicosGovernoInstituicoesPublicas#> as publicosGovernoInstituicoesPublicas
	extends <http://secti.pe.gov.br/indicador_cti/description/publicosAlvo/publicosEmpresasEmpreendedores#> as publicosEmpresasEmpreendedores
	extends <http://secti.pe.gov.br/indicador_cti/description/publicosAlvo/publicosAmbientesInovacao#> as publicosAmbientesInovacao
	extends <http://secti.pe.gov.br/indicador_cti/description/publicosAlvo/publicosSociedadeTerceiroSetor#> as publicosSociedadeTerceiroSetor
	uses <http://secti.pe.gov.br/indicador_cti/vocabulary/base#> as base
	uses <http://secti.pe.gov.br/indicador_cti/vocabulary/DesignAvaliacao/canvas#> as canvas
	uses <http://secti.pe.gov.br/indicador_cti/vocabulary/programa#> as programa
	uses <http://www.w3.org/2001/XMLSchema#> as xsd
	
	instance CanvasPR7 : canvas:canvas [
		base:nome "Canvas do Programa Desafios.gov"
		base:id "C-PR7"
		base:versao "V1-Homologado"
		base:dataCriacao "2026-06-25T00:00:00"^^xsd:dateTime
		canvas:possuiParceiros parceirosGoverno:PC1.12, parceirosAgenciasFomento:PC2.2, parceirosAgenciasFomento:PC2.3, parceirosEmpresas:PC4.11, 
		parceirosAmbientesInovacao:PC5.9
		canvas:condicionadoPor fatoresCenarioInstitucionalLegal:FE2.OP1, fatoresCenarioSocialEducacional:FE4.OP1, fatoresDinamicaEcossistema:FE5.OP1, 
		fatoresDinamicaEcossistema:FE5.OP8, fatoresCenarioEconomico:FE1.AM1, fatoresCenarioInstitucionalLegal:FE2.AM1
		canvas:recebeEntradas entradasOrcamentoFinanciamento:EN1.4, entradasOrcamentoFinanciamento:EN1.5, entradasDadosSistemasPlataformas:EN2.1, 
		entradasCapitalHumano:EN3.1, entradasCapitalHumano:EN3.5, entradasInstrumentosLegaisNormativos:EN5.1
		canvas:executa atividadeChave:AC1, atividadeChave:AC3, atividadeChave:AC4, atividadeChave:AC6, atividadeChave:AC7
		canvas:geraSaidas saida:SA1, saida:SA2, saida:SA3, saida:SA4, saida:SA6, saida:SA7
		canvas:produzResultados RE.CP1, RE.MP1, RE.LP1, RE.LP2
		canvas:buscaAtingirGeral OB.GE
		canvas:buscaAtingirEspecifico OB.ES1, OB.ES3, OB.ES4, OB.ES5, OB.ES6
	]
	
	instance PR7 : programa:programaCTI [
		base:nome "Desafios.gov"
		base:descricao "Foi criado com o objetivo de apoiar micro e pequenas empresas (especialmente startups) a desenvolverem soluções inovadoras para desafios 
da gestão pública do estado de Pernambuco"
		base:id "PR7"
		programa:temCanvas CanvasPR7
		programa:temPlanoAvaliacao PA_DesafiosGov:PAV1
		
	]
	
	// Relações Desafios.gov --> Público-Alvo
	relation instance PR7.direcionadoA.PU2.2 : canvas:direcionadoA [
		from CanvasPR7
		to publicosGovernoInstituicoesPublicas:PU2.2
		base:tipo "direto"
	]
	relation instance PR7.direcionadoA.PU2.3 : canvas:direcionadoA [
		from CanvasPR7
		to publicosGovernoInstituicoesPublicas:PU2.3
		base:tipo "indireto"
	]
	relation instance PR7.direcionadoA.PU3.2 : canvas:direcionadoA [
		from CanvasPR7
		to publicosEmpresasEmpreendedores:PU3.2
		base:tipo "indireto"
	]
	relation instance PR7.direcionadoA.PU3.5 : canvas:direcionadoA [
		from CanvasPR7
		to publicosEmpresasEmpreendedores:PU3.5
		base:tipo "direto"
	]
	relation instance PR7.direcionadoA.PU4.1 : canvas:direcionadoA [
		from CanvasPR7
		to publicosAmbientesInovacao:PU4.1
		base:tipo "indireto"
	]
	relation instance PR7.direcionadoA.PU4.6 : canvas:direcionadoA [
		from CanvasPR7
		to publicosAmbientesInovacao:PU4.6
		base:tipo "indireto"
	]
	relation instance PR7.direcionadoA.PU4.7 : canvas:direcionadoA [
		from CanvasPR7
		to publicosAmbientesInovacao:PU4.7
		base:tipo "indireto"
	]
	relation instance PR7.direcionadoA.PU4.8 : canvas:direcionadoA [
		from CanvasPR7
		to publicosAmbientesInovacao:PU4.8
		base:tipo "indireto"
	]
	relation instance PR7.direcionadoA.PU5.1 : canvas:direcionadoA [
		from CanvasPR7
		to publicosSociedadeTerceiroSetor:PU5.1
		base:tipo "indireto"
	]
	relation instance PR7.direcionadoA.PU5.2 : canvas:direcionadoA [
		from CanvasPR7
		to publicosSociedadeTerceiroSetor:PU5.2
		base:tipo "indireto"
	]
	
	// Objetivo Geral
	instance OB.GE : canvas:ObjetivoGeral [
		base:nome "Apoiar MPEs em projetos de desenvolvimento e implantação de produtos, serviços e/ou processos inovadores que contemplem desafios de órgãos 
públicos do Estado"
		base:id "OB.GE - DesafiosGov"
	]
	
	// Objetivos Específicos
	instance OB.ES1 : canvas:ObjetivoEspecifico [
		base:nome "Incentivar o desenvolvimento de projetos de PD&I aplicados a desafios de órgãos públicos do Estado em parceria com empresas de base tecnológica"
		base:id "OB.ES1 - DesafiosGov"
		canvas:buscaAtingir RE.CP1
	]
	instance OB.ES3 : canvas:ObjetivoEspecifico [
		base:nome "Promover a consolidação de empresas de base tecnológica especializadas em soluções de aprimoramento dos serviços públicos, inclusive no interior 
do Estado"
		base:id "OB.ES3 - DesafiosGov"
		canvas:buscaAtingir RE.MP1, RE.LP1, RE.LP2
	]
	instance OB.ES4 : canvas:ObjetivoEspecifico [
		base:nome "Impulsionar a formação de parcerias entre o setor público e o setor privado"
		base:id "OB.ES4 - DesafiosGov"
		canvas:buscaAtingir RE.CP1
	]
	instance OB.ES5 : canvas:ObjetivoEspecifico [
		base:nome "Estimular a transferência tecnológica e de conhecimentos, inclusive para o setor público"
		base:id "OB.ES5 - DesafiosGov"
		canvas:buscaAtingir RE.MP1
	]
	instance OB.ES6 : canvas:ObjetivoEspecifico [
		base:nome "Estimular oportunidades relacionadas ao Marco Legal de CT&I e às compras públicas de soluções inovadoras"
		base:id "OB.ES6 - DesafiosGov"
		canvas:buscaAtingir RE.MP1, RE.LP1
	]
	
	// Resultados Esperados
	
	// Curto Prazo
	instance RE.CP1 : canvas:ResultadoEsperado [
		base:nome "Indução do nº de projetos de PD&I ativos que envolvam órgãos públicos da esfera estadual em parceria com empresas pernambucanas de base 
tecnológica"
		base:id "RE.CP1 - DesafiosGov"
		canvas:prazo "curto"
	]
	
	// Médio Prazo
	instance RE.MP1 : canvas:ResultadoEsperado [
		base:nome "Absorção de soluções inovadoras por órgãos públicos do Estado de Pernambuco"
		base:id "RE.MP1 - DesafiosGov"
		canvas:prazo "médio"
	]
	
	// Longo Prazo
	instance RE.LP1 : canvas:ResultadoEsperado [
		base:nome "Ampliação do nº de contratações por órgãos públicos do Estado de Pernambuco"
		base:id "RE.LP1 - DesafiosGov"
		canvas:prazo "longo"
	]
	instance RE.LP2 : canvas:ResultadoEsperado [
		base:nome "Ampliação do nº de empregos, do portfólio, do faturamento obtido, das PIs e software registrados por empresas pernambucanas de base tecnológica 
especializadas em soluções de aprimoramento dos serviços públicos, inclusive no interior"
		base:id "RE.LP2 - DesafiosGov"
		canvas:prazo "longo"
	]
}
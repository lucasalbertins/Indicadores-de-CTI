description <http://secti.pe.gov.br/indicador_cti/description/programas/programasInfraestrutura/eCRIA/eCRIA#> as eCRIA {
	
	extends <http://secti.pe.gov.br/indicador_cti/description/parceirosChave#> as parceiroChave
	extends <http://secti.pe.gov.br/indicador_cti/description/fatoresExternos#> as fatorExterno
	extends <http://secti.pe.gov.br/indicador_cti/description/entradas#> as entrada
	extends <http://secti.pe.gov.br/indicador_cti/description/atividadesChave#> as atividadeChave
	extends <http://secti.pe.gov.br/indicador_cti/description/saidas#> as saida
	extends <http://secti.pe.gov.br/indicador_cti/description/publicoAlvo#> as publicoAlvo
	uses <http://secti.pe.gov.br/indicador_cti/vocabulary/base#> as base
	uses <http://secti.pe.gov.br/indicador_cti/vocabulary/DesignAvaliacao/canvas#> as canvas
	uses <http://secti.pe.gov.br/indicador_cti/vocabulary/programa#> as programa
	
	instance PR5 : programa:programaCTI [
		base:nome "Espaços CRIA"
		base:descricao "Foi criado para fomentar a cultura da inovação e do empreendedorismo criativo entre estudantes da rede pública estadual de ensino médio e 
técnico de Pernambuco, através da criação de ambientes de aprendizagem colaborativos e inovadores"
		base:id "PR5"
		programa:possuiParceiros parceiroChave:PC11, parceiroChave:PC16, parceiroChave:PC4, parceiroChave:PC17, parceiroChave:PC18
		programa:condicionadoPor fatorExterno:FE.OP14, fatorExterno:FE.OP15, fatorExterno:FE.OP16, fatorExterno:FE.OP17, fatorExterno:FE.OP18, 
		fatorExterno:FE.AM20, fatorExterno:FE.AM21, fatorExterno:FE.AM22, fatorExterno:FE.AM23, fatorExterno:FE.AM24, fatorExterno:FE.AM25
		programa:recebeEntradas entrada:EN2, entrada:EN3, entrada:EN4, entrada:EN6, entrada:EN12, entrada:EN13, entrada:EN14
		programa:executa atividadeChave:AC8, atividadeChave:AC9, atividadeChave:AC10, atividadeChave:AC11, atividadeChave:AC12, atividadeChave:AC13, 
		atividadeChave:AC14, atividadeChave:AC15, atividadeChave:AC16, atividadeChave:AC17, atividadeChave:AC18
		programa:geraSaidas saida:SA12, saida:SA13, saida:SA14, saida:SA15, saida:SA16, saida:SA17
		programa:produzResultados RE.CP1, RE.CP2, RE.CP3, RE.CP4, RE.MP1, RE.MP2, RE.MP3, RE.MP4, RE.MP5, RE.LP1, RE.LP3, RE.LP4, RE.LP5, RE.LP8
		programa:direcionadoA publicoAlvo:PU.DI20, publicoAlvo:PU.DI21, publicoAlvo:PU.IN17, publicoAlvo:PU.IN18, publicoAlvo:PU.IN19, publicoAlvo:PU.IN20, 
		publicoAlvo:PU.IN21
		programa:buscaAtingirGeral OB.GE
		programa:buscaAtingirEspecifico OB.ES0, OB.ES1, OB.ES3, OB.ES4, OB.ES5, OB.ES7, OB.ES8, OB.ES11
	]
	
	// Objetivo Geral
	instance OB.GE : canvas:ObjetivoGeral [
		base:nome "Implantação de Espaços de Criação, Inovação e Aprendizagem, através da estruturação de centros de inovação para promover o fortalecimento dos 
ecossistemas de indústria 4.0 e cultura maker, economia criativa, economia circular e negócios 4.0, nas diferentes regiões de desenvolvimento do Estado, com foco 
na formação de habilidades portadoras de futuro e no empreendedorismo inovador"
		base:id "OB.GE - eCRIA"
	]
	
	// Objetivos Específicos
	instance OB.ES0 : canvas:ObjetivoEspecifico [
		base:nome "Implantar espaços e garantir estrutura física e equipamentos para permitir a execução do programa"
		base:id "OB.ES0 - eCRIA"
		canvas:buscaAtingir RE.CP1, RE.LP8
	]
	instance OB.ES1 : canvas:ObjetivoEspecifico [
		base:nome "Estimular a criatividade, soft skills e o protagonismo estudantil através da resolução de desafios cotidianos"
		base:id "OB.ES1 - eCRIA"
		canvas:buscaAtingir RE.CP2, RE.LP8
	]
	instance OB.ES3 : canvas:ObjetivoEspecifico [
		base:nome "Estimular projetos e formação na área de STEM+C"
		base:id "OB.ES3 - eCRIA"
		canvas:buscaAtingir RE.CP2, RE.CP4, RE.MP1, RE.MP3, RE.LP3, RE.LP4, RE.LP5
	]
	instance OB.ES4 : canvas:ObjetivoEspecifico [
		base:nome "Estimular o empreendedorismo inovador"
		base:id "OB.ES4 - eCRIA"
		canvas:buscaAtingir RE.CP4, RE.MP3, RE.MP5, RE.LP3
	]
	instance OB.ES5 : canvas:ObjetivoEspecifico [
		base:nome "Capacitar o corpo docente em novas tecnologias habilitadoras"
		base:id "OB.ES5 - eCRIA"
		canvas:buscaAtingir RE.MP1, RE.LP1
	]
	instance OB.ES7 : canvas:ObjetivoEspecifico [
		base:nome "Mitigar a evasão escolar"
		base:id "OB.ES7 - eCRIA"
		canvas:buscaAtingir RE.CP3
	]
	instance OB.ES8 : canvas:ObjetivoEspecifico [
		base:nome "Melhorar os indicadores de educação"
		base:id "OB.ES8 - eCRIA"
		canvas:buscaAtingir RE.MP4
	]
	instance OB.ES11 : canvas:ObjetivoEspecifico [
		base:nome "Estimular o ingresso em cursos de nível superior na área de STEM+C"
		base:id "OB.ES11 - eCRIA"
		canvas:buscaAtingir RE.MP2, RE.LP5
	]
	
	// Resultados Esperados
	
	// Curto Prazo
	instance RE.CP1 : canvas:ResultadoEsperado [
		base:nome "Espaços implantados com equipamentos promovendo a cultura Maker e de indústria 4.0, desenvolvendo competências portadoras de futuro"
		base:id "RE.CP1 - eCRIA"
		canvas:prazo "curto"
	]
	instance RE.CP2 : canvas:ResultadoEsperado [
		base:nome "Novos produtos/protótipos criativos gerados"
		base:id "RE.CP2 - eCRIA"
		canvas:prazo "curto"
	]
	instance RE.CP3 : canvas:ResultadoEsperado [
		base:nome "Maior permanência dos alunos nas escolas com espaços CRIA"
		base:id "RE.CP3 - eCRIA"
		canvas:prazo "curto"
	]
	instance RE.CP4 : canvas:ResultadoEsperado [
		base:nome "Promoção da cultura Maker e de indústria 4.0, desenvolvendo competências portadoras de futuro"
		base:id "RE.CP4 - eCRIA"
		canvas:prazo "curto"
	]
	
	// Médio Prazo
	instance RE.MP1 : canvas:ResultadoEsperado [
		base:nome "Mais pessoas capacitadas em competências portadoras de futuro"
		base:id "RE.MP1 - eCRIA"
		canvas:prazo "médio"
	]
	instance RE.MP2 : canvas:ResultadoEsperado [
		base:nome "Maior ingresso de estudantes da rede pública em cursos superiores STEM+C"
		base:id "RE.MP2 - eCRIA"
		canvas:prazo "médio"
	]
	instance RE.MP3 : canvas:ResultadoEsperado [
		base:nome "Aumento da empregabilidade e trabalhabilidade de pessoas na área de STEM+C em áreas prioritárias para o Estado"
		base:id "RE.MP3 - eCRIA"
		canvas:prazo "médio"
	]
	instance RE.MP4 : canvas:ResultadoEsperado [
		base:nome "Melhores índices educacionais das escolas do Estado com Espaços CRIA"
		base:id "RE.MP4 - eCRIA"
		canvas:prazo "médio"
	]
	instance RE.MP5 : canvas:ResultadoEsperado [
		base:nome "Maior número de startups por egressos das escolas com espaços CRIA"
		base:id "RE.MP5 - eCRIA"
		canvas:prazo "médio"
	]
	
	// Longo Prazo
	instance RE.LP1 : canvas:ResultadoEsperado [
		base:nome "Mais professores capazes de formar recursos humanos em STEM+C"
		base:id "RE.LP1 - eCRIA"
		canvas:prazo "longo"
	]
	instance RE.LP3 : canvas:ResultadoEsperado [
		base:nome "Maior competitividade das empresas e entidades pernambucanas"
		base:id "RE.LP3 - eCRIA"
		canvas:prazo "longo"
	]
	instance RE.LP4 : canvas:ResultadoEsperado [
		base:nome "Mais recursos humanos desenvolvendo soluções baseadas em CT&I em todo o território pernambucano promovendo transformação social"
		base:id "RE.LP4 - eCRIA" 
		canvas:prazo "longo"
	]
	instance RE.LP5 : canvas:ResultadoEsperado [
		base:nome "Mais estudantes formados em cursos superiores nas áreas de STEM+C"
		base:id "RE.LP5 - eCRIA"
		canvas:prazo "longo"
	]
	instance RE.LP8 : canvas:ResultadoEsperado [
		base:nome "Promoção da modernização das escolas e práticas para atividades curriculares"
		base:id "RE.LP8 - eCRIA"
		canvas:prazo "longo"
	]
}
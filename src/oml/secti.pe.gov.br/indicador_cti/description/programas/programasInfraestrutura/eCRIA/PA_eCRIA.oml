		planoAvaliacao:temMetrica PA8.ME1
		planoAvaliacao:temEscopo PA8.ES
		planoAvaliacao:temMetodologia PA8.MA1
		planoAvaliacao:temRisco R10
		planoAvaliacao:temLimitacao LIM8
		planoAvaliacao:alinhaComResultado eCRIA:RE.MP1, eCRIA:RE.CP4
	]
	
	instance PA9 : planoAvaliacao:questaoAvaliacao [
		base:nome "Quantos protótipos/ produtos novos foram criados pelos alunos, com potencial de comercialização?"
		base:id "PA9 - eCRIA"
		planoAvaliacao:custo "Alto"
		planoAvaliacao:temMetrica PA9.ME1
		planoAvaliacao:temEscopo PA9.ES
		planoAvaliacao:temMetodologia PA9.MA1, PA9.MA2, PA9.MA3, PA9.MA4
		planoAvaliacao:temRisco R11
		planoAvaliacao:temLimitacao LIM9
		planoAvaliacao:alinhaComResultado eCRIA:RE.CP2, eCRIA:RE.MP5
	]
	
	instance PA10 : planoAvaliacao:questaoAvaliacao [
		base:nome "Quantas startups ou iniciativas empreendedoras foram criadas por egressos do programa?"
		base:id "PA10 - eCRIA"
		planoAvaliacao:custo "Alto"
		planoAvaliacao:temMetrica PA10.ME1, PA10.ME2
		planoAvaliacao:temEscopo PA10.ES
		planoAvaliacao:temMetodologia PA10.MA1, PA10.MA2, PA10.MA3, PA10.MA4, PA10.MA5
		planoAvaliacao:temRisco R11
		planoAvaliacao:temLimitacao LIM10
		planoAvaliacao:alinhaComResultado eCRIA:RE.MP5, eCRIA:RE.LP2
	]
	
	instance PA11 : planoAvaliacao:questaoAvaliacao [
		base:nome "Como o programa beneficiou comunidades em situação de vulnerabilidade?"
		base:id "PA11 - eCRIA"
		planoAvaliacao:custo "Baixo"
		planoAvaliacao:temMetrica PA11.ME1, PA11.ME2, PA11.ME3, PA11.ME4
		planoAvaliacao:temEscopo PA11.ES
		planoAvaliacao:temMetodologia PA11.MA1
		planoAvaliacao:temRisco R11
		planoAvaliacao:temLimitacao LIM11
		planoAvaliacao:alinhaComResultado eCRIA:RE.LP3
	]
	
	instance PA12 : planoAvaliacao:questaoAvaliacao [
		base:nome "Qual o aumento na participação de mulheres em atividades STEM+C nos espaços?"
		base:id "PA12 - eCRIA"
		planoAvaliacao:custo "Moderado"
		planoAvaliacao:temMetrica PA12.ME1, PA12.ME2, PA12.ME3
		planoAvaliacao:temEscopo PA12.ES
		planoAvaliacao:temMetodologia PA12.MA1, PA12.MA2, PA12.MA3, PA12.MA4, PA12.MA5
		planoAvaliacao:temRisco R2
		planoAvaliacao:temLimitacao LIM12
		planoAvaliacao:alinhaComResultado eCRIA:RE.MP3
	]
	
	instance PA13 : planoAvaliacao:questaoAvaliacao [
		base:nome "Como evoluiu a empregabilidade de egressos em áreas tecnológicas prioritárias para o Estado?"
		base:id "PA13 - eCRIA"
		planoAvaliacao:custo "Alto"
		planoAvaliacao:temMetrica PA13.ME1
		planoAvaliacao:temEscopo PA13.ES
		planoAvaliacao:temMetodologia PA13.MA1, PA13.MA2, PA13.MA3
		planoAvaliacao:temRisco R12
		planoAvaliacao:temLimitacao LIM13
		planoAvaliacao:alinhaComResultado eCRIA:RE.MP3, eCRIA:RE.LP2, eCRIA:RE.LP3
	]
	
	instance PA14 : planoAvaliacao:questaoAvaliacao [
		base:nome "Existem evidências de impacto do programa na competitividade empresarial regional?"
		base:id "PA14 - eCRIA"
		planoAvaliacao:custo "Baixo"
		planoAvaliacao:temMetrica PA14.ME1, PA14.ME2
		planoAvaliacao:temEscopo PA14.ES

	// Escopos e Métodos de Avaliação
	
	instance PA1.ES : planoAvaliacao:escopo [
		base:descricao "Espera-se identificar a progressão no processo de implantação de ECRIA por RD, tipo de escola e por faixa de IDHM."
		base:id "PA1.ES - eCRIA"
	]
	
	instance PA1.MA1 : planoAvaliacao:metodoAvaliacao [
		base:descricao "Acessar a F1 para obter informações  sobre o processo de planejamento e implantação dos ECRIAs para extrair P1.M1, P1.M2 e P1.M3"
		base:id "PA1.MA1 - eCRIA"
	]
	
	instance PA1.MA2 : planoAvaliacao:metodoAvaliacao [
		base:descricao "Acessar FI19 para obter informações  sobre o IDHM dos municípios em que os ECRIAs estão inseridos"
		base:id "PA1.MA2 - eCRIA"
	]
	
	instance PA1.MA3 : planoAvaliacao:metodoAvaliacao [
		base:descricao "Acessar F20 para obter informações  sobre a RD em que os ECRIAs estão inseridos"
		base:id "PA1.MA3 - eCRIA"
	]
	
	instance PA1.MA4 : planoAvaliacao:metodoAvaliacao [
		base:descricao "Definir faixas de IDHM como baixo, médio e alto"
		base:id "PA1.MA4 - eCRIA"
	]
	
	instance PA1.MA5 : planoAvaliacao:metodoAvaliacao [
		base:descricao "Estratificar P1.M1, P1.M2 e P1.M3  de acordo com o tipo de escola (ETEs, EREMs) (FI18),  faixa de IDHM (FI19) e a RD (FI20)"
		base:id "PA1.MA5 - eCRIA"
	]
	
	instance PA1.MA6 : planoAvaliacao:metodoAvaliacao [
		base:descricao "Comparar P1.M1 com P1.M1.VE"
		base:id "PA1.MA6 - eCRIA"
	]
	
	instance PA1.MA7 : planoAvaliacao:metodoAvaliacao [
		base:descricao "Comparar P1.M2 com P1.M2.VE"
		base:id "PA1.MA7 - eCRIA"
	]
	
	instance PA1.MA8 : planoAvaliacao:metodoAvaliacao [
		base:descricao "Comparar P1.M3 com P1.M3.VE"
		base:id "PA1.MA8 - eCRIA"
	]
	
	instance PA1.MA9 : planoAvaliacao:metodoAvaliacao [
		base:descricao ") Aplicar o método de regressão de dados em painel para comparação transversal"
		base:id "PA1.MA9 - eCRIA"
	]
	
	instance PA2.ES : planoAvaliacao:escopo [
		base:descricao "Espera-se identificar se os ECRIAs e os equipamentos (GL: Ativos tangíveis) estão sendo usados com frequência e por um número diverso de pessoas"
		base:id "PA2.ES - eCRIA"
	]
	
	instance PA2.MA1 : planoAvaliacao:metodoAvaliacao [
		base:descricao "Acessar FI21 para obter informações sobre uso do ECRIA"
		base:id "PA2.MA1 - eCRIA"
	]
	
	instance PA2.MA2 : planoAvaliacao:metodoAvaliacao [
		base:descricao "Calcular P2.M1 e comparar com P2.M1.VE"

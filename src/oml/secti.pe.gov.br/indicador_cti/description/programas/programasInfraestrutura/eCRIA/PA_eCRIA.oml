		planoAvaliacao:temRisco R11
		planoAvaliacao:temLimitacao LIM14
		planoAvaliacao:alinhaComResultado eCRIA:RE.LP2, eCRIA:RE.LP3
	]
	
	//Métricas
	instance PA1.ME1 : metricas:metrica [
		base:nome "Número de espaços planejado"
		base:id "PA1.ME1 - eCRIA"
		metricas:temFonte fonte:FI18, fonte:FI19, fonte:FI20
		
	]
	

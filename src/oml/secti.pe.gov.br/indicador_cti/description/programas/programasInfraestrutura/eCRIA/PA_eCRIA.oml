	// Limitações
	instance LIM1 : planoAvaliacao:limitacao [
		base:descricao "Os valores P1.M1.VE, P1.M2.VE, P1.M3.VE  podem variar com planos de governo e com disponibilidade financeira"
	]
	instance LIM2 : planoAvaliacao:limitacao [
		base:descricao " Alguns ECRIAs podem ter restrições de horário e ou de disponibilidade de pessoas"
	]
	instance LIM3 : planoAvaliacao:limitacao [
		base:descricao "Morosidade no processo de aquisição e contratação do estado"
	]
	instance LIM4 : planoAvaliacao:limitacao [
		base:descricao "Imprecisão no conceito de evasão escolar, podendo incluir alunos que estão matriculados mas não frequentam a escola ou não se dedicam às atividades."
	]
	instance LIM5 : planoAvaliacao:limitacao [ 
		base:descricao "Dificuldade em mapear todas as matrículas em nível superior"
	]
	instance LIM6 : planoAvaliacao:limitacao [
		base:descricao "Dificuldade em definir de forma justa o grupo de controle"
	]
	instance LIM7 : planoAvaliacao:limitacao [
		base:descricao "Limitação de mapeamento fora de capacititação específica para ECRIA ou providas pela EGAPE"
	]
	instance LIM8 : planoAvaliacao:limitacao [
		base:descricao "Necessidade de especialistas para delinear e acompanhar FI28."
	]
	instance LIM9 : planoAvaliacao:limitacao [
		base:descricao "Compreensão limitada do que é um protótipo/produto inovador."
	]
	
	instance LIM10 : planoAvaliacao:limitacao [
		base:descricao "Dificuldade em manter informações de startups criadas ao longo dos anos."
	]
	
	instance LIM11 : planoAvaliacao:limitacao [
		base:descricao "Dificuldade em mapear todas as pessoas beneficiadas em situação de vulnerabilidade por ser uma questão relacionada com autodeclaração."
	]
	
	instance LIM12 : planoAvaliacao:limitacao [
		base:descricao "Falta de registro de gênero em projetos inovadores"
	]
	
	instance LIM13 : planoAvaliacao:limitacao [
		base:descricao "Não incluir pessoas empreendedoras ou que não estão nestas bases de dados mas atuam em carreiras STEM+C"
	]
	
	instance LIM14 : planoAvaliacao:limitacao [
		base:descricao "Algumas das colaborações com empresas podem não ser formalizadas"
	]

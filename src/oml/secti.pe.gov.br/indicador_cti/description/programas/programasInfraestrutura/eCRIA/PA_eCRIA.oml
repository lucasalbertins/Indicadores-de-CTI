description <http://secti.pe.gov.br/indicador_cti/description/programas/programasInfraestrutura/eCRIA/PA_eCRIA#> as PA_eCRIA {
	
	extends <http://secti.pe.gov.br/indicador_cti/description/fontesInformacao#> as fonte
	extends <http://secti.pe.gov.br/indicador_cti/description/programas/programasInfraestrutura/eCRIA/eCRIA#> as eCRIA
	uses <http://secti.pe.gov.br/indicador_cti/vocabulary/base#> as base
	uses <http://secti.pe.gov.br/indicador_cti/vocabulary/DesignAvaliacao/planoAvaliacao#> as planoAvaliacao
	uses <http://secti.pe.gov.br/indicador_cti/vocabulary/DesignAvaliacao/metricas#> as metricas
	
	instance PA1 : planoAvaliacao:questaoAvaliacao [
		base:nome "Quantos Espaços Cria foram implantados, com distribuição por região de desenvolvimento (RD), tipo de escola e faixa de IDHM?"
		base:id "PA1 - eCRIA"
		planoAvaliacao:custo "Moderado"
		planoAvaliacao:temMetrica PA1.ME1, PA1.ME2, PA1.ME3
		planoAvaliacao:temEscopo PA1.ES
		planoAvaliacao:temMetodologia PA1.MA1, PA1.MA2, PA1.MA3, PA1.MA4, PA1.MA5, PA1.MA6, PA1.MA7, PA1.MA8, PA1.MA9
		planoAvaliacao:temRisco R1, R2
		planoAvaliacao:temLimitacao LIM1
		planoAvaliacao:alinhaComResultado eCRIA:RE.CP1, eCRIA:RE.LP5
	]
	
	instance PA2 : planoAvaliacao:questaoAvaliacao [
		base:nome "Qual o nível de utilização dos equipamentos (impressoras 3D, kits IoT, etc.) por alunos e professores e tipo de utilização (capacitação)?"
		base:id "PA2 - eCRIA"
		planoAvaliacao:custo "Alto"
		planoAvaliacao:temMetrica PA2.ME1, PA2.ME2, PA2.ME3
		planoAvaliacao:temEscopo PA2.ES
		planoAvaliacao:temMetodologia PA2.MA1, PA2.MA2, PA2.MA3, PA2.MA4, PA2.MA5, PA2.MA6
		planoAvaliacao:temRisco R3
		planoAvaliacao:temLimitacao LIM2
		planoAvaliacao:alinhaComResultado eCRIA:RE.CP1, eCRIA:RE.LP5
	]
	
	instance PA3 : planoAvaliacao:questaoAvaliacao [
		base:nome "Quais as principais barreiras para a operação dos espaços (manutenção, capacitação, conectividade)?"
		base:id "PA3 - eCRIA"
		planoAvaliacao:custo "Moderado"
		planoAvaliacao:temMetrica PA3.ME1, PA3.ME2, PA3.ME3, PA3.ME4, PA3.ME5
		planoAvaliacao:temEscopo PA3.ES
		planoAvaliacao:temMetodologia PA3.MA1, PA3.MA2, PA3.MA3, PA3.MA4, PA3.MA5, PA3.MA6, PA3.MA7
		planoAvaliacao:temRisco R3, R4, R5, R6
		planoAvaliacao:temLimitacao LIM3
		planoAvaliacao:alinhaComResultado eCRIA:RE.CP1
	]
	
	instance PA4 : planoAvaliacao:questaoAvaliacao [
	  base:nome "Como evoluiu a taxa de evasão escolar nas instituições com Espaços CRIA vs. escolas sem o programa por RD?"
	  base:id "PA4 - eCRIA"
	  planoAvaliacao:custo "Alto"
	  planoAvaliacao:temMetrica PA4.ME1, PA4.ME2, PA4.ME3
	  planoAvaliacao:temEscopo PA4.ES
	  planoAvaliacao:temMetodologia PA4.MA1
	  planoAvaliacao:temRisco R7
	  planoAvaliacao:temLimitacao LIM4
	  planoAvaliacao:alinhaComResultado eCRIA:RE.CP3, eCRIA:RE.MP4, eCRIA:RE.LP3
	]
	
	instance PA5 : planoAvaliacao:questaoAvaliacao [
	  base:nome "Qual o aumento no interesse dos alunos nas áreas de conhecimento relacionadas com STEM+C mediante participação no programa?"
	  base:id "PA5 - eCRIA"
	  planoAvaliacao:custo "Alto"
	  planoAvaliacao:temMetrica PA5.ME1, PA5.ME2, PA5.ME3, PA5.ME4
	  planoAvaliacao:temEscopo PA5.ES
	  planoAvaliacao:temMetodologia PA5.MA1
	  planoAvaliacao:temRisco R3, R8
	  planoAvaliacao:temLimitacao LIM5
	  planoAvaliacao:alinhaComResultado eCRIA:RE.CP4, eCRIA:RE.MP2, eCRIA:RE.MP3, eCRIA:RE.LP4
	]
	
	instance PA6 : planoAvaliacao:questaoAvaliacao [
	  base:nome "Como o programa impactou os indicadores educacionais (IDEB, SAEPE) das escolas participantes?"
	  base:id "PA6 - eCRIA"
	  planoAvaliacao:custo "Moderado"
	  planoAvaliacao:temMetrica PA6.ME1
	  planoAvaliacao:temEscopo PA6.ES
	  planoAvaliacao:temMetodologia PA6.MA1
	  planoAvaliacao:temRisco R7
	  planoAvaliacao:temLimitacao LIM6
	  planoAvaliacao:alinhaComResultado eCRIA:RE.MP4
	]
	
	instance PA7 : planoAvaliacao:questaoAvaliacao [
		base:nome "Quantos professores foram capacitados em tecnologias 4.0 e metodologias ativas por RD?"
		base:id "PA7 - eCRIA"
		planoAvaliacao:custo "Baixo"
		planoAvaliacao:temMetrica PA7.ME1, PA7.ME2, PA7.ME3
		planoAvaliacao:temEscopo PA7.ES
		planoAvaliacao:temMetodologia PA7.MA1
		planoAvaliacao:temRisco R9
		planoAvaliacao:temLimitacao LIM7
		planoAvaliacao:alinhaComResultado eCRIA:RE.LP1
	]
	
	instance PA8 : planoAvaliacao:questaoAvaliacao [
		base:nome "Qual o percentual de alunos que desenvolveram soft skills (trabalho em equipe, criatividade)?"
		base:id "PA8 - eCRIA"

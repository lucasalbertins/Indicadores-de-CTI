description <http://secti.pe.gov.br/indicador_cti/description/programas/programasInfraestrutura/PortoDigital/PortoDigital#> as PortoDigital {
	
	extends <http://secti.pe.gov.br/indicador_cti/description/parceirosChave/parceirosGoverno#> as parceirosGoverno 
	extends <http://secti.pe.gov.br/indicador_cti/description/parceirosChave/parceirosEmpresas#> as parceirosEmpresas 
	extends <http://secti.pe.gov.br/indicador_cti/description/parceirosChave/parceirosAcademiaICTs#> as parceirosAcademiaICTs
	extends <http://secti.pe.gov.br/indicador_cti/description/parceirosChave/parceirosAmbientesInovacao#> as parceirosAmbientesInovacao
	extends <http://secti.pe.gov.br/indicador_cti/description/parceirosChave/parceirosAgenciasFomento#> as parceirosAgenciasFomento
	extends <http://secti.pe.gov.br/indicador_cti/description/publicosAlvo/publicosEmpresasEmpreendedores#> as publicosEmpresasEmpreendedores
	extends <http://secti.pe.gov.br/indicador_cti/description/publicosAlvo/publicosAcademiaICTs#> as publicosAcademiaICTs 
	extends <http://secti.pe.gov.br/indicador_cti/description/publicosAlvo/publicosAmbientesInovacao#> as publicosAmbientesInovacao
	extends <http://secti.pe.gov.br/indicador_cti/description/entradas/entradasCapitalHumano#> as entradasCapitalHumano 
	extends <http://secti.pe.gov.br/indicador_cti/description/entradas/entradasDadosSistemasPlataformas#> as entradasDadosSistemasPlataformas
	extends <http://secti.pe.gov.br/indicador_cti/description/entradas/entradasInfraestruturaFisica#> as entradasInfraestruturaFisica
	extends <http://secti.pe.gov.br/indicador_cti/description/entradas/entradasOrcamentoFinanciamento#> as entradasOrcamentoFinanciamento
	extends <http://secti.pe.gov.br/indicador_cti/description/entradas/entradasInstrumentosLegaisNormativos#> as entradasInstrumentosLegaisNormativos 
	extends <http://secti.pe.gov.br/indicador_cti/description/fatoresExternos/fatoresDinamicaEcossistema#> as fatoresDinamicaEcossistema 
	extends <http://secti.pe.gov.br/indicador_cti/description/fatoresExternos/fatoresCenarioEconomico#> as fatoresCenarioEconomico 
	extends <http://secti.pe.gov.br/indicador_cti/description/fatoresExternos/fatoresCenarioTecnologico#> as fatoresCenarioTecnologico 
	extends <http://secti.pe.gov.br/indicador_cti/description/fatoresExternos/fatoresCenarioInstitucionalLegal#> as fatoresCenarioInstitucionalLegal
	extends <http://secti.pe.gov.br/indicador_cti/description/atividadesChave#> as atividadeChave 
	extends <http://secti.pe.gov.br/indicador_cti/description/saidas#> as saida 
	uses <http://secti.pe.gov.br/indicador_cti/vocabulary/base#> as base 
	uses <http://secti.pe.gov.br/indicador_cti/vocabulary/DesignAvaliacao/canvas#> as canvas 
	uses <http://secti.pe.gov.br/indicador_cti/vocabulary/programa#> as programa 
	
	
	instance CanvasPR13 : canvas:canvas [ 
		base:nome "Programa Estratégico Porto Digital" 		
		base:id "C-PR13" 
		canvas:possuiParceiros parceirosGoverno:PC1.10, parceirosGoverno:PC1.11, parceirosAgenciasFomento:PC2.1, parceirosAgenciasFomento:PC2.5,
		parceirosAgenciasFomento:PC2.8, parceirosAcademiaICTs:PC3.2, parceirosAcademiaICTs:PC3.5, parceirosEmpresas:PC4.5, parceirosEmpresas:PC4.7,
		parceirosAmbientesInovacao:PC5.2, parceirosAmbientesInovacao:PC5.5, parceirosAmbientesInovacao:PC5.6, parceirosAmbientesInovacao:PC5.7,
		parceirosAmbientesInovacao:PC5.8
		canvas:recebeEntradas entradasInstrumentosLegaisNormativos:EN5.5, entradasCapitalHumano:EN3.4, entradasDadosSistemasPlataformas:EN2.3,
		entradasInfraestruturaFisica:EN4.3, entradasOrcamentoFinanciamento:EN1.5
		canvas:condicionadoPor fatoresDinamicaEcossistema:FE5.AM1, fatoresDinamicaEcossistema:FE5.OP2, fatoresDinamicaEcossistema:FE5.OP3, fatoresCenarioTecnologico:FE3.OP1, fatoresCenarioTecnologico:FE3.OP4, fatoresCenarioEconomico:FE1.AM1, fatoresCenarioInstitucionalLegal:FE2.AM2, fatoresDinamicaEcossistema:FE5.AM1 
		canvas:executa atividadeChave:AC1, atividadeChave:AC2, atividadeChave:AC3, atividadeChave:AC4, atividadeChave:AC5, atividadeChave:AC6, atividadeChave:AC7, atividadeChave:AC8, atividadeChave:AC9, atividadeChave:AC10, atividadeChave:AC11, atividadeChave:AC12 
		canvas:geraSaidas saida:SA1, saida:SA2, saida:SA3, saida:SA4, saida:SA5, saida:SA6, saida:SA7, saida:SA8, saida:SA9, saida:SA10, saida:SA11, saida:SA12 
	]
	
	instance PR13 : programa:programaCTI [
		base:nome "Porto Digital"
		base:descricao "Programa voltado ao fortalecimento do ecossistema de inovação e empreendedorismo inovador em Pernambuco." 
		base:id PR13
		programa:temCanvas CanvasPR13
		//programa:temPlanoAvaliacao PA_PortoDigital:
		
	]
		
	relation instance PR13.direcionadoA.PU4.5 : canvas:direcionadoA [
		from CanvasPR13
		to publicosAmbientesInovacao:PU4.5
		base:tipo "direto"
	]
	
	relation instance PR13.direcionadoA.PU3.5 :canvas:direcionadoA [
		from CanvasPR13
		to publicosEmpresasEmpreendedores:PU3.5
		base:tipo "direto"
	]
	
	relation instance PR13.direcionadoA.PU4.9 : canvas:direcionadoA [
		from CanvasPR13
		to publicosAmbientesInovacao:PU4.9
		base:tipo "direto"
	]
	
	relation instance PR13.direcionadoA.PU1.8 : canvas:direcionadoA [
		from CanvasPR13
		to publicosAcademiaICTs:PU1.8
		base:tipo "direto"
	]
	
	relation instance PR13.direcionadoA.PU1.7 : canvas:direcionadoA [
		from CanvasPR13
		to publicosAcademiaICTs:PU1.7
		base:tipo "direto"
	]
	
	relation instance PR13.direcionadoA.PU3.6 : canvas:direcionadoA [
		from CanvasPR13
		to publicosEmpresasEmpreendedores:PU3.6
		base:tipo "direto"
	]
	
	relation instance PR13.direcionadoA.PU3.2 : canvas:direcionadoA [
		from CanvasPR13
		to publicosEmpresasEmpreendedores:PU3.2
		base:tipo "direto"
	]
	
	// Objetivo Geral
	instance OB.GE : canvas:ObjetivoGeral [
		base:nome "Fortalecer o ecossistema de inovação, empreendedorismo e economia digital em Pernambuco por meio da integração entre governo, academia, empresas e sociedade."
		base:id "OB.GE - PortoDigital"
	]
	
	// Objetivos Específicos
	
	instance OB.ES1 : canvas:ObjetivoEspecifico [
		base:nome "Efetuar o mapeamento e articulação dos atores do ecossistema de inovação para direcionar as estratégias das demais ações. O desenvolvimento de uma plataforma digital 
	para disseminação de estudos e sistematização de informações de inteligência de mercado que suportem tomadas de decisão, articulação e promoção de integração entre os stakeholders envolvidos no processo de fomento ao 
	empreendedorismo inovador. "
		base:id "OB.ES1 - PortoDigital"
		canvas:buscaAtingir RE.CP5, RE.CP6, RE.MP6, RE.LP4, RE.LP5
	]
	instance OB.ES2 : canvas:ObjetivoEspecifico [
		base:nome " Realizar ações de mobilização e integração, como eventos, capacitações e atividades de sensibilização para gerar a conexão entre os atores do 
		ecossistema, em vistas a geração de legitimidade, desenvolvimento e fortalecimento do ecossistema de inovação em Pernambuco. "
		base:id "OB.ES2 - PortoDigital"
		canvas:buscaAtingir RE.CP1, RE.CP2, RE.MP1, RE.LP1
	]
	instance OB.ES3 : canvas:ObjetivoEspecifico [
		base:nome " Realizar ações de mobilização, sensibilização e capacitação de pessoas, visando o desenvolvimento de competências técnicas e habilidades socioemocionais alinhadas às 
		tendências de empreendedorismo inovador e gestão de negócios."
		base:id "OB.ES3 - PortoDigital"
		canvas:buscaAtingir RE.CP1, RE.CP3, RE.MP2, RE.LP2
	]
	instance OB.ES4 : canvas:ObjetivoEspecifico [
		base:nome " Implementar programa de fomento ao empreendedorismo, que preveja as Trilhas de pré-incubação, incubação e pré-aceleração de empresas de base tecnológica, negócios 
		inovadores e startups. "
		base:id "OB.ES4 - PortoDigital"
		canvas:buscaAtingir RE.CP4, RE.MP3, RE.LP6
	]
	
	instance OB.ES5 : canvas:ObjetivoEspecifico [
		base:nome "Implementar programa de internacionalização de empresas pernambucanas, a partir de plataforma de softlanding na Europa, com o objetivo de acesso a 
		novos mercados, acesso a fontes de investimentos internacionais, cooperação com empresas e mecanismo de suporte à inovação internacional. "
		base:id "OB.ES5 - PortoDigital"
		canvas:buscaAtingir RE.CP4, RE.MP4, RE.MP5, RE.LP3
	]
	// Resultados Esperados
	
	// Curto Prazo
	instance RE.CP1 : canvas:ResultadoEsperado [
		base:nome "Expansão do número de eventos e atividades ligadas ao empreendedorismo inovador em todo o Estado de Pernambuco."
		base:id "RE.CP1 - PortoDigital"
		canvas:prazo "curto"
	]
	instance RE.CP2 : canvas:ResultadoEsperado [
		base:nome "Ampliação da participação de representantes do ecossistema do Porto Digital em eventos nacionais e internacionais."
		base:id "RE.CP2 - PortoDigital"
		canvas:prazo "curto"
	]
	instance RE.CP3 : canvas:ResultadoEsperado [
		base:nome "Crescimento do número de maratonas de experimentação e sensibilização de Talentos (Hackathons e Ideathons) no Estado de Pernambuco."
		base:id "RE.CP3 - PortoDigital"
		canvas:prazo "curto"
	]
	instance RE.CP4 : canvas:ResultadoEsperado [
		base:nome "Expansão da quantidade de atendimento e desenvolvimento de negócios inovadores."
		base:id "RE.CP4 - PortoDigital"
		canvas:prazo "curto"
	]
	instance RE.CP5 : canvas:ResultadoEsperado [
		base:nome "Consolidação dos dados de empresas na plataforma do Porto Digital."
		base:id "RE.CP5 - PortoDigital"
		canvas:prazo "curto"
	]
	instance RE.CP6 : canvas:ResultadoEsperado [
		base:nome "Disponibilização de dashboards iniciais com diagnósticos em tempo real sobre o mercado de TI e a saúde do ecossistema."
		base:id "RE.CP6 - PortoDigital"
		canvas:prazo "curto"
	]

	// Médio Prazo
	instance RE.MP1 : canvas:ResultadoEsperado [
		base:nome "Promoção de capacitação para gestores de mecanismos de inovação."
		base:id "RE.MP1 - PortoDigital"
		canvas:prazo "médio"
	]
	instance RE.MP2 : canvas:ResultadoEsperado [
		base:nome "Desenvolvimento de talentos para preparação dos negócios do futuro para o Estado."
		base:id "RE.MP2 - PortoDigital"
		canvas:prazo "médio"
	]
	instance RE.MP3 : canvas:ResultadoEsperado [
		base:nome "Expansão do número de startups ativas no estado de Pernambuco."
		base:id "RE.MP3 - PortoDigital"
		canvas:prazo "médio"
	]
	instance RE.MP4 : canvas:ResultadoEsperado [
		base:nome "Expansão de oportunidades em negócios regional e nacional."
		base:id "RE.MP4 - PortoDigital"
		canvas:prazo "médio"
	]
	instance RE.MP5 : canvas:ResultadoEsperado [
		base:nome "Ampliação do número de negócios com atuação internacional."
		base:id "RE.MP5 - PortoDigital"
		canvas:prazo "médio"
	]
	instance RE.MP6 : canvas:ResultadoEsperado [
		base:nome "Lançamento do Portal estratégico e vitrine de negócios do Porto Digital."
		base:id "RE.MP6 - PortoDigital"
		canvas:prazo "médio"
	]

	// Longo Prazo
	instance RE.LP1 : canvas:ResultadoEsperado [
		base:nome "Expansão do número de polos e/ou comunidades de inovação no interior do estado."
		base:id "RE.LP1 - PortoDigital"
		canvas:prazo "longo"
	]
	instance RE.LP2 : canvas:ResultadoEsperado [
		base:nome "Aumento de profissionais qualificados para atender às demandas específicas do mercado de TIC."
		base:id "RE.LP2 - PortoDigital"
		canvas:prazo "longo"
	]
	instance RE.LP3 : canvas:ResultadoEsperado [
		base:nome "Consolidação física de empresas pernambucanas no mercado internacional."
		base:id "RE.LP3 - PortoDigital"
		canvas:prazo "longo"
	]
	instance RE.LP4 : canvas:ResultadoEsperado [
		base:nome "Consolidação de um portal integrado de inteligência, com estruturação e cruzamento de dados da trajetória, evolução e interação de atores do
ecossistema, permitindo suporte à tomada de decisão de políticas e programas."
		base:id "RE.LP4 - PortoDigital"
		canvas:prazo "longo"
	]
	instance RE.LP5 : canvas:ResultadoEsperado [
		base:nome "Consolidação do hub internacional que conecta nativamente quem gera tecnologia com quem precisa dela."
		base:id "RE.LP5 - PortoDigital"
		canvas:prazo "longo"
	]
	instance RE.LP6 : canvas:ResultadoEsperado [
		base:nome "Aumento da quantidade de startups com possibilidade de captar investidores."
		base:id "RE.LP6 - PortoDigital"
		canvas:prazo "longo"
	]
}

description <http://secti.pe.gov.br/indicador_cti/description/programas/programasInfraestrutura/PROUPE/PROUPE#> as PROUPE {
	
	extends <http://secti.pe.gov.br/indicador_cti/description/parceirosChave/parceirosGoverno#> as parceirosGoverno
	extends <http://secti.pe.gov.br/indicador_cti/description/parceirosChave/parceirosAcademiaICTs#> as parceirosAcademiaICTs
	extends <http://secti.pe.gov.br/indicador_cti/description/fatoresExternos#> as fatorExterno
	extends <http://secti.pe.gov.br/indicador_cti/description/entradas/entradasOrcamentoFinanciamento#> as entradasOrcamentoFinanciamento
	extends <http://secti.pe.gov.br/indicador_cti/description/entradas/entradasDadosSistemasPlataformas#> as entradasDadosSistemasPlataformas
	extends <http://secti.pe.gov.br/indicador_cti/description/entradas/entradasCapitalHumano#> as entradasCapitalHumano
	extends <http://secti.pe.gov.br/indicador_cti/description/atividadesChave#> as atividadeChave
	extends <http://secti.pe.gov.br/indicador_cti/description/saidas#> as saida
	uses <http://secti.pe.gov.br/indicador_cti/vocabulary/base#> as base
	uses <http://secti.pe.gov.br/indicador_cti/vocabulary/DesignAvaliacao/canvas#> as canvas
	uses <http://secti.pe.gov.br/indicador_cti/vocabulary/programa#> as programa
	
	instance PR9 : programa:programaCTI [
		base:nome "ProUPE"
		base:descricao "O Proupe (Programa Universidade para Todos em Pernambuco) é um programa de bolsas de estudo para alunos de instituições de ensino superior 
públicas estaduais, principalmente de autarquias municipais de Pernambuco"
		base:id "PR9"
		programa:possuiParceiros parceirosGoverno:PC1.1, parceirosAcademiaICTs:PC3.3, parceirosAcademiaICTs:PC3.5
		programa:condicionadoPor fatorExterno:FE.OP19, fatorExterno:FE.OP20, fatorExterno:FE.OP21, fatorExterno:FE.OP22,fatorExterno:FE.OP23, 
		fatorExterno:FE.OP24,fatorExterno:FE.AM26, fatorExterno:FE.AM27, fatorExterno:FE.AM28, fatorExterno:FE.AM29
		programa:recebeEntradas entradasOrcamentoFinanciamento:EN1.2, entradasOrcamentoFinanciamento:EN1.5, entradasDadosSistemasPlataformas:EN2.2, 
		entradasCapitalHumano:EN3.2, entradasCapitalHumano:EN3.3
		programa:executa atividadeChave:AC19, atividadeChave:AC20, atividadeChave:AC21, atividadeChave:AC22, atividadeChave:AC23, atividadeChave:AC24, 
		atividadeChave:AC25
		programa:geraSaidas saida:SA18, saida:SA19, saida:SA20, saida:SA21, saida:SA22, saida:SA23, saida:SA24, saida:SA25, saida:SA26, saida:SA27, saida:SA28, 
		saida:SA29, saida:SA30, saida:SA31, saida:SA32, saida:SA33, saida:SA34
		programa:produzResultados RE.CP1, RE.CP2, RE.CP3, RE.CP4, RE.MP1, RE.MP2, RE.MP3, RE.MP4, RE.MP5, RE.MP6, RE.MP7, RE.LP1, RE.LP2, RE.LP3, RE.LP4, RE.LP5, 
		RE.LP6
		programa:buscaAtingirGeral OB.GE
		programa:buscaAtingirEspecifico OB.ES1, OB.ES2, OB.ES3, OB.ES4, OB.ES5, OB.ES6
	]
	
	// Objetivo Geral
	instance OB.GE : canvas:ObjetivoGeral [
		base:nome "Ampliar o acesso ao Ensino Superior e promover a formação de profissionais qualificados, capazes de contribuir para o desenvolvimento social, 
econômico e tecnológico do Estado, especialmente nas regiões interioranas, reduzindo desigualdades educacionais e fortalecendo a interiorização da educação 
superior"
		base:id "OB.GE - PROUPE"
	]
	
	// Objetivos Específicos
	instance OB.ES1 : canvas:ObjetivoEspecifico [
		base:nome "Ampliação do acesso ao Ensino Superior: garantir condições financeiras para que estudantes de baixa renda possam cursar graduação nas Autarquias 
Municipais de Ensino Superior, reduzindo desigualdades educacionais, e favorecendo jovens de regiões historicamente menos atendidas"
		base:id "OB.ES1 - PROUPE"
		canvas:buscaAtingir RE.CP1, RE.CP3, RE.MP1
	]
	instance OB.ES2 : canvas:ObjetivoEspecifico [
		base:nome "Qualificação do capital humano: formar profissionais em áreas estratégicas, com prioridade para cursos de STEM, licenciaturas e cursos 
superiores de tecnologia; desenvolver competências técnicas, científicas e pedagógicas para promover o desenvolvimento econômico, social e tecnológico das diversas 
regiões de desenvolvimento do Estado"
		base:id "OB.ES2 - PROUPE"
		canvas:buscaAtingir RE.CP2, RE.MP3, RE.MP4, RE.MP5, RE.MP6, RE.LP2, RE.LP3, RE.LP4
	]
	instance OB.ES3 : canvas:ObjetivoEspecifico [
		base:nome "Inclusão social e equidade: reservar até 20% das vagas para professores em exercício, pessoas com deficiência e mulheres em situação de 
vulnerabilidade socioeconômica ou vítimas de violência doméstica e familiar; contribuir para a diversidade e inclusão no Ensino Superior, reconhecendo condições 
sociais que exigem atenção especial"
		base:id "OB.ES3 - PROUPE"
		canvas:buscaAtingir RE.MP2
	]
	instance OB.ES4 : canvas:ObjetivoEspecifico [
		base:nome "Interiorização do Ensino Superior: incentivar a permanência de talentos na região onde estudam, reduzindo deslocamentos para grandes centros 
urbanos; estimular o desenvolvimento regional por meio da qualificação de profissionais localmente, fortalecendo a economia, a ciência e a tecnologia nos 
municípios atendidos" 
		base:id "OB.ES4 - PROUPE"
		canvas:buscaAtingir RE.MP6, RE.MP7, RE.LP6
	]
	instance OB.ES5 : canvas:ObjetivoEspecifico [
		base:nome "Aumentar o número de pessoas formadas com nível superior no Estado: diminuir a evasão durante o programa e melhorar o desempenho dos estudantes"
		base:id "OB.ES5 - PROUPE"
		canvas:buscaAtingir RE.CP3, RE.CP4, RE.LP1
	]
	instance OB.ES6 : canvas:ObjetivoEspecifico [
		base:nome "Impacto social e retorno à sociedade: promover impacto social nas regiões atendidas pelo Programa, por meio da realização, pelos bolsistas, de 
atividades educativas, de extensão, científicas e tecnológicas, contribuindo para o fortalecimento da educação pública, da produção do conhecimento, da inovação e 
do desenvolvimento social e econômico"
		base:id "OB.ES6 - PROUPE"
		canvas:buscaAtingir RE.LP5
	]
	
	// Resultados Esperados
	
	// Curto Prazo
	instance RE.CP1 : canvas:ResultadoEsperado [
		base:nome "Aumento do número de estudantes de baixa renda matriculados em cursos de graduação nas Autarquias Municipais de Ensino Superior de Pernambuco 
por meio da concessão de bolsas de estudo, integrais ou parciais. Esse crescimento inclui a ampliação da matrícula de pessoas com deficiência e de mulheres em 
situação de vulnerabilidade socioeconômica ou vítimas de violência doméstica e familiar, bem como o aumento do número de professores matriculados para a realização 
da segunda graduação em licenciaturas"
		base:id "RE.CP1 - PROUPE"
		canvas:prazo "curto"
	]
	instance RE.CP2 : canvas:ResultadoEsperado [
		base:nome "Crescimento da matrícula em cursos STEM e licenciaturas, fortalecendo áreas estratégicas"
		base:id "RE.CP2 - PROUPE"
		canvas:prazo "curto"
	]
	instance RE.CP3 : canvas:ResultadoEsperado [
		base:nome "Ampliação do acesso ao ensino superior, com maior ocupação das vagas disponíveis"
		base:id "RE.CP3 - PROUPE"
		canvas:prazo "curto"
	]
	instance RE.CP4 : canvas:ResultadoEsperado [
		base:nome "Redução da evasão e aumento do número de concluintes de graduação"
		base:id "RE.CP4 - PROUPE"
		canvas:prazo "curto"
	]
	
	// Médio Prazo
	instance RE.MP1 : canvas:ResultadoEsperado [
		base:nome "Expansão do número de estudantes beneficiados com bolsas de estudo"
		base:id "RE.MP1 - PROUPE"
		canvas:prazo "médio"
	]
	instance RE.MP2 : canvas:ResultadoEsperado [
		base:nome "Ocupação de todas as vagas reservadas para pessoas com deficiência e para mulheres em situação de vulnerabilidade socioeconômica ou vítimas de 
violência doméstica e familiar, assim como para professores em segunda licenciatura"
		base:id "RE.MP2 - PROUPE"
		canvas:prazo "médio"
	]
	instance RE.MP3 : canvas:ResultadoEsperado [
		base:nome "Crescimento da matrícula em cursos STEM e licenciaturas, fortalecendo áreas estratégicas"
		base:id "RE.MP3 - PROUPE"
		canvas:prazo "médio"
	]
	instance RE.MP4 : canvas:ResultadoEsperado [
		base:nome "Consolidação da redução da evasão estudantil, com aumento significativo de concluintes e formação de capital humano qualificado, alinhado às 
demandas do Estado e às áreas prioritárias (STEM, licenciaturas e cursos superiores de tecnologia)"
		base:id "RE.MP4 - PROUPE"
		canvas:prazo "médio"
	]
	instance RE.MP5 : canvas:ResultadoEsperado [
		base:nome "Aumento do número de professores concluindo segunda graduação em licenciaturas"
		base:id "RE.MP5 - PROUPE"
		canvas:prazo "médio"
	]
	instance RE.MP6 : canvas:ResultadoEsperado [
		base:nome "Aumento da trabalhabilidade e retenção de talentos nas regiões de desenvolvimento onde o bolsista está inserido"
		base:id "RE.MP6 - PROUPE"
		canvas:prazo "médio"
	]
	instance RE.MP7 : canvas:ResultadoEsperado [
		base:nome "Aumento do número de residentes na respectiva região de desenvolvimento, matriculado na respectiva Autarquia"
		base:id "RE.MP7 - PROUPE"
		canvas:prazo "médio"
	]
	
	// Longo Prazo
	instance RE.LP1 : canvas:ResultadoEsperado [
		base:nome "Sustentação de alta ocupação de vagas e baixa evasão, consolidando o impacto das bolsas na permanência estudantil"
		base:id "RE.LP1 - PROUPE"
		canvas:prazo "longo"
	]
	instance RE.LP2 : canvas:ResultadoEsperado [
		base:nome "Formação consistente de profissionais qualificados, contribuindo para o desenvolvimento científico, tecnológico, econômico e social do Estado"
		base:id "RE.LP2 - PROUPE"
		canvas:prazo "longo"
	]
	instance RE.LP3 : canvas:ResultadoEsperado [
		base:nome "Consolidação do estímulo às licenciaturas, fortalecendo a formação de professores e melhorando a qualidade da educação básica no estado"
		base:id "RE.LP3 - PROUPE"
		canvas:prazo "longo"
	]
	instance RE.LP4 : canvas:ResultadoEsperado [
		base:nome "Continuidade do incentivo aos cursos STEM, priorizando áreas estratégicas para o desenvolvimento do Estado"
		base:id "RE.LP4 - PROUPE"
		canvas:prazo "longo"
	]
	instance RE.LP5 : canvas:ResultadoEsperado [
		base:nome "Impacto social das contrapartidas pelos bolsistas, promovendo atividades educativas, de extensão, científicas ou tecnológicas sob supervisão 
docente"
		base:id "RE.LP5 - PROUPE"
		canvas:prazo "longo"
	]
	instance RE.LP6 : canvas:ResultadoEsperado [
		base:nome "Retenção do talento na região de desenvolvimento onde realizou a graduação"
		base:id "RE.LP6 - PROUPE"
		canvas:prazo "longo"
	]
}
	instance PA1 : planoAvaliacao:questaoAvaliacao [
		base:nome "Qual o número e percentual de beneficiários e de bolsas concedidas por semestre e a evolução do acesso ao ensino superior para estudantes de baixa renda?"
		base:id "PA1 - PROUPE"
		planoAvaliacao:custo "Moderado"
		planoAvaliacao:temMetrica PA1.ME1, PA1.ME2, PA1.ME3, PA1.ME4, PA1.ME5
		planoAvaliacao:temEscopo PA1.ES
		planoAvaliacao:temMetodologia PA1.MA1, PA1.MA2, PA1.MA3, PA1.MA4, PA1.MA5, PA1.MA6, PA1.MA7
		planoAvaliacao:temRisco R1, R2
		planoAvaliacao:temLimitacao LIM1
		planoAvaliacao:alinhaComResultado PROUPE:RE.CP1, PROUPE:RE.MP1, PROUPE:RE.LP1
	]
	

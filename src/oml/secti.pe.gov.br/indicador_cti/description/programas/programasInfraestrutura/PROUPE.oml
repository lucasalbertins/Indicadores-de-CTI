description <http://secti.pe.gov.br/indicador_cti/description/programas/programasInfraestrutura/PROUPE#> as PROUPE {
	
	extends <http://secti.pe.gov.br/indicador_cti/description/parceirosChave#> as parceiroChave
	extends <http://secti.pe.gov.br/indicador_cti/description/fatoresExternos#> as fatorExterno
//	extends <http://secti.pe.gov.br/indicador_cti/description/entradas#> as entrada
	extends <http://secti.pe.gov.br/indicador_cti/description/atividadesChave#> as atividadeChave
	extends <http://secti.pe.gov.br/indicador_cti/description/saidas#> as saida
	//extends <http://secti.pe.gov.br/indicador_cti/description/resultados#> as resultado
	extends <http://secti.pe.gov.br/indicador_cti/description/publicoAlvo#> as publicoAlvo
	
	uses <http://secti.pe.gov.br/indicador_cti/vocabulary/base#> as base
	uses <http://secti.pe.gov.br/indicador_cti/vocabulary/canvas#> as canvas
	uses <http://secti.pe.gov.br/indicador_cti/vocabulary/programa#> as programa
	
	instance PROUPE : programa:programaCTI [
		base:nome "Programa: Programa Universidade para Todos em Pernambuco"
		base:descricao "O Proupe (Programa Universidade para Todos em Pernambuco) é um programa de bolsas 
de estudo para alunos de instituições de ensino superior públicas estaduais, principalmente de autarquias 
municipais de Pernambuco"
		base:id "PROUPE"
		programa:possuiParceiros parceiroChave:SECTI-PE, parceiroChave:ASSIESPE, parceiroChave:AEDAI, 
		parceiroChave:AEDA, parceiroChave:AESA, parceiroChave:ABCDE, parceiroChave:AEB, 
		parceiroChave:AEDECCA, parceiroChave:AESGA, parceiroChave:AMESG, parceiroChave:AESLI, 
		parceiroChave:AEMASUL, parceiroChave:AEVSF, parceiroChave:AEDS
		programa:condicionadoPor fatorExterno:ValidacaoInscricoes, 
		fatorExterno:DificuldadeCumprimentoProporcaoLegal, fatorExterno:DescumprimentoContrapartida, 
		fatorExterno:ProblemasSistemaGerenciamento,fatorExterno:ExpansaoDemanda, 
		fatorExterno:ValorizacaoAreasSTEM,fatorExterno:IntegracaoPoliticasFederais, 
		fatorExterno:CrescimentoMercadoTrabalho, fatorExterno:ReconhecimentoPublico
	//	programa:recebeEntradas entrada:OrcamentoEstadual, entrada:RecursoFinanceiro, entrada:RHSECTI, 
	//	entrada:RHAutarquias, entrada:SistemaGerencimento 
		programa:executa atividadeChave:LancamentoEdital, 
		atividadeChave:SolicitacaoDisponibilidadeOrcamentaria, 
		atividadeChave:AutorizacaoCamaraProgramacaoFinanceira, atividadeChave:InscricaoCandidatos, 
		atividadeChave:ValidacaoInscricoes, atividadeChave:SelecaoContemplados, 
		atividadeChave:DivulgacaoResultado, atividadeChave:ApresentacaoRecursos, 
		atividadeChave:PrimeiraConvocacao, atividadeChave:DivulgarListasRemanejamento, 
		atividadeChave:AssinaturaObrigatoria, atividadeChave:ImplementacaoBolsas, 
		atividadeChave:RepasseFinanceiro, atividadeChave:CumprimentoPelosBolsistas, 
		atividadeChave:AcompanhamentoAtividadesContrapartida, 
		atividadeChave:ValidacaoCumprimentoContrapartida, atividadeChave:AcompanhamentoPeloSistema, 
		atividadeChave:VerificacaoMensal, atividadeChave:EmissaoRelatoriosTecnicos, 
		atividadeChave:AvaliacaoImpactoPrograma, atividadeChave:ParceriasEstrategicas
		programa:geraSaidas saida:DDO, saida:RecursosOrcamentarios, saida:FluxoFinanceiro, 
		saida:EditalSelecao, saida:InscricoesValidadas, saida:BaseDadosCandidatos, 
		saida:ResultadoPreliminar, saida:AnaliseRecursos, saida:ListasRemanejamento, 
		saida:TermosCompromisso, saida:BolsasImplementadas, saida:ControleFinanceiroAcademico, 
		saida:AtvdEducativasCientificas, saida:RelatoriosContrapartida, 
		saida:RelatoriosMensaisSemestraisAnuais, saida:PainelAcompanhamentoAtualizado, 
		saida:AvaliacaoImpactoPrograma
	//	programa:produzResultados resultado:AumentoEstudantesMatriculados, 
		//resultado:CrescimentoMatriculaSTEM, resultado:AmpliacaoAcessoES, resultado:ReducaoEvasao,
		//resultado:ExpansaoEstudantesBeneficiados, resultado:GarantiaVagasReservadas, 
		//resultado:CrescMatriculasSTEM, resultado:ConsolidacaoReducaoEvasao, 
		//resultado:AumentoProfessoresConcluindo,
		//resultado:AumentoRetencaoTalentos, resultado:AumentoConcluintesRD, 
		//resultado:FortalecimentoAcessoES, resultado:AltaOcupacaoVagas, 
		//resultado:FormacaoProfissionaisQuali, resultado:ConsolidacaoEstimuloLdos, 
		//resultado:ContinuidadeIncentivoSTEM , resultado:ImpactoSocialContrapartidas, 
		//resultado:RetencaoTalendoRD
		programa:direcionadoA publicoAlvo:EstudantesdasAutarquias
	//	programa:buscaAtingir1 OBJGeral
		//programa:buscaAtingir2 AmpliacaoAcessoES, QualificacaoCapitalHumano, InclusaoEquidade, 
		//InteorizacaoES
	]
	
	instance OBJGeral : canvas:ObjetivoGeral [
		base:nome "Ampliar o acesso ao Ensino Superior e promover a formação de profissionais 
qualificados, capazes de contribuir para o desenvolvimento social, econômico e tecnológico de Pernambuco, 
especialmente nas regiões interioranas, reduzindo desigualdades educacionais e fortalecendo a 
interiorização da educação superior"
		base:id "g"
	]
	instance AmpliacaoAcessoES : canvas:ObjetivoEspecifico [
		base:nome "Ampliação do acesso ao Ensino Superior: garantir condições financeiras para que 
estudantes de baixa renda (renda familiar per capita entre 1,5 e 4 salários-mínimos) possam cursar 
graduação nas Autarquias Municipais de Ensino Superior, reduzindo desigualdades educacionais, e 
favorecendo jovens de regiões historicamente menos atendidas"
		base:id "h"
	]
	instance QualificacaoCapitalHumano : canvas:ObjetivoEspecifico [
		base:nome "Qualificação do capital humano: formar profissionais em áreas estratégicas, com 
prioridade para cursos de STEM, licenciaturas e cursos superiores de tecnologia; desenvolver competências 
técnicas, científicas e pedagógicas para promover o desenvolvimento econômico, social e tecnológico das 
diversas regiões de desenvolvimento de Pernambuco"
		base:id "i"
	]
	instance InclusaoEquidade : canvas:ObjetivoEspecifico [
		base:nome "Inclusão social e equidade: reservar até 20% das vagas para professores em exercício, 
pessoas com deficiência e mulheres em situação de vulnerabilidade socioeconômica ou vítimas de violência 
doméstica e familiar; contribuir para a diversidade e inclusão no Ensino Superior, reconhecendo condições 
sociais que exigem atenção especial"
		base:id "j"
	]
	instance InteorizacaoES : canvas:ObjetivoEspecifico [
		base:nome "Interiorização do Ensino Superior: incentivar a permanência de talentos na região onde 
estudam, reduzindo deslocamentos para grandes centros urbanos; estimular o desenvolvimento regional por 
meio da qualificação de profissionais localmente, fortalecendo a economia, a ciência e a tecnologia nos 
municípios atendidos"
		base:id "k"
	]
}
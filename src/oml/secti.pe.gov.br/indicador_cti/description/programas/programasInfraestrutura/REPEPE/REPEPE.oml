description <http://secti.pe.gov.br/indicador_cti/description/programas/programasInfraestrutura/REPEPE/REPEPE#> as REPEPE {
	extends <http://secti.pe.gov.br/indicador_cti/description/parceirosChave/parceirosGoverno#> as parceirosGoverno
	extends <http://secti.pe.gov.br/indicador_cti/description/parceirosChave/parceirosAcademiaICTs#> as parceirosAcademiaICTs
	extends <http://secti.pe.gov.br/indicador_cti/description/parceirosChave/parceirosEmpresas#> as parceirosEmpresas
	extends <http://secti.pe.gov.br/indicador_cti/description/fatoresExternos/fatoresCenarioInstitucionalLegal#> as fatoresCenarioInstitucionalLegal
	extends <http://secti.pe.gov.br/indicador_cti/description/fatoresExternos/fatoresCenarioTecnologico#> as fatoresCenarioTecnologico
	extends <http://secti.pe.gov.br/indicador_cti/description/entradas/entradasInstrumentosLegaisNormativos#> as entradasInstrumentosLegaisNormativos
	extends <http://secti.pe.gov.br/indicador_cti/description/fatoresExternos/fatoresDinamicaEcossistema#> as fatoresDinamicaEcossistema
	extends <http://secti.pe.gov.br/indicador_cti/description/entradas/entradasInfraestruturaFisica#> as entradasInfraestruturaFisica
	extends <http://secti.pe.gov.br/indicador_cti/description/entradas/entradasCapitalHumano#> as entradasCapitalHumano
	extends <http://secti.pe.gov.br/indicador_cti/description/publicosAlvo/publicosGovernoInstituicoesPublicas#> as publicosGovernoInstituicoesPublicas
	extends <http://secti.pe.gov.br/indicador_cti/description/publicosAlvo/publicosAcademiaICTs#> as publicosAcademiaICTs
	extends <http://secti.pe.gov.br/indicador_cti/description/atividadesChave#> as atividadeChave
	extends <http://secti.pe.gov.br/indicador_cti/description/saidas#> as saida
	extends <http://secti.pe.gov.br/indicador_cti/description/programas/programasInfraestrutura/REPEPE/PA_REPEPE#> as PA_REPEPE
	uses <http://secti.pe.gov.br/indicador_cti/vocabulary/base#> as base
	uses <http://secti.pe.gov.br/indicador_cti/vocabulary/DesignAvaliacao/canvas#> as canvas
	uses <http://secti.pe.gov.br/indicador_cti/vocabulary/programa#> as programa
	uses <http://www.w3.org/2001/XMLSchema#> as xsd
	
	instance CanvasPR17 : canvas:canvas [
		base:nome "Canvas do Programa Rede Pernambucana de Pesquisa e Educação"
		base:id "C-PR17"
		base:versao "V1-Homologado"
		base:dataCriacao "2026-05-12T00:00:00Z"^^xsd:dateTime
		canvas:possuiParceiros parceirosGoverno:PC1.1, parceirosAcademiaICTs:PC3.3,parceirosAcademiaICTs:PC3.4, parceirosAcademiaICTs:PC3.5, 
		parceirosAcademiaICTs:PC3.6, parceirosEmpresas:PC4.7, parceirosEmpresas:PC4.8, parceirosGoverno:PC1.9
		canvas:condicionadoPor fatoresCenarioTecnologico:FE3.OP1, fatoresCenarioTecnologico:FE3.OP4, fatoresCenarioTecnologico:FE3.AM2, fatoresCenarioInstitucionalLegal:FE2.AM2,
		 fatoresDinamicaEcossistema:FE5.OP2, fatoresDinamicaEcossistema:FE5.OP3, fatoresDinamicaEcossistema:FE5.OP5
		canvas:recebeEntradas entradasInfraestruturaFisica:EN4.1, entradasCapitalHumano:EN3.4, entradasInstrumentosLegaisNormativos:EN5.4,
		 entradasInstrumentosLegaisNormativos:EN5.2
		canvas:executa atividadeChave:AC1, atividadeChave:AC2, atividadeChave:AC3, atividadeChave:AC4, atividadeChave:AC5
		canvas:geraSaidas saida:SA1, saida:SA2, saida:SA3 
		canvas:produzResultados RE.CP1, RE.CP2, RE.MP1, RE.MP2, RE.MP3, RE.MP4, RE.MP5, RE.LP1, RE.LP2, RE.LP3, RE.LP4, RE.LP5, RE.LP6, RE.LP7 
		canvas:buscaAtingirGeral OB.GE 
		canvas:buscaAtingirEspecifico OB.ES1, OB.ES2, OB.ES3, OB.ES4
	]
	
	instance PR17 : programa:programaCTI [ 
		base:nome "Rede Pernambucana de Pesquisa e Educação" 
		base:descricao "Programa voltado à integração de instituições de educação, pesquisa e órgãos governamentais por meio de rede óptica digital de alta performance." 
		base:id "PR17" 
		programa:temCanvas CanvasPR17
		programa:temPlanoAvaliacao PA_REPEPE:PAV1
	]
	
	// Relações REPEPE --> Público-Alvo 
	relation instance PR17.direcionadoA.PU1 : canvas:direcionadoA [
		from PR17 
		to publicosAcademiaICTs:PU1.14 
		base:tipo "direto"
	] 
	
	relation instance PR17.direcionadoA.PU2 : canvas:direcionadoA [ 
		from PR17
		to publicosGovernoInstituicoesPublicas:PU2.2
		 base:tipo "direto"
	]
	
	relation instance PR17.direcionadoA.PU3 : canvas:direcionadoA [ 
		from PR17 
		to publicosGovernoInstituicoesPublicas:PU2.3 
		base:tipo "direto"
	] 
	
	relation instance PR17.direcionadoA.PU4 : canvas:direcionadoA [ 
		from PR17 
		to publicosGovernoInstituicoesPublicas:PU2.4 
		base:tipo "indireto"
	] 
	
	// Objetivo Geral 
	
	instance OB.GE : canvas:ObjetivoGeral [ 
		base:nome "Integrar instituições de educação ou pesquisa, públicas ou privadas, e órgãos governamentais por meio de rede de informação e comunicação de alta performance baseada em tecnologia óptica digital." 
		base:id "OB.GE - REPEPE"
	] 
	
	// Objetivos Específicos 
	instance OB.ES1 : canvas:ObjetivoEspecifico [ 
		base:nome "Ampliar e desenvolver a oferta de conectividade expansível de alta qualidade para interconectar instituições na Região Metropolitana do Recife e demais regiões do Estado." 
		base:id "OB.ES1 - REPEPE" 
		canvas:buscaAtingir RE.CP1, RE.MP1, RE.MP2, RE.LP1, RE.LP2, RE.LP3, RE.LP4
	] 
	instance OB.ES2 : canvas:ObjetivoEspecifico [ 
		base:nome "Promover a cooperação, intercâmbio de conhecimento técnico e integração do sistema estadual ao Sistema Nacional de Ciência, Tecnologia e Inovação." 
		base:id "OB.ES2 - REPEPE" 
		canvas:buscaAtingir RE.CP2, RE.MP3, RE.LP5
	] 
	instance OB.ES3 : canvas:ObjetivoEspecifico [ 
		base:nome "Estimular soluções tecnológicas e modelos sustentáveis de uso compartilhado de infraestrutura digital." 
		base:id "OB.ES3 - REPEPE" canvas:buscaAtingir RE.MP4, RE.LP6
	] 
	instance OB.ES4 : canvas:ObjetivoEspecifico [ 
		base:nome "Promover integração e compartilhamento de infraestrutura TIC entre instituições públicas e privadas." 
		base:id "OB.ES4 - REPEPE" 
		canvas:buscaAtingir RE.MP5, RE.LP7
	] 
	
	// Resultados Esperados 
	
	// Curto Prazo 
	
	instance RE.CP1 : canvas:ResultadoEsperado [ 
		base:nome "Ampliação do Backbone ao longo do Estado" 
		base:id "RE.CP1 - REPEPE" 
		canvas:prazo "curto"
	] 
	instance RE.CP2 : canvas:ResultadoEsperado [ 
		base:nome "Conexão à rede da ATI" 
		base:id "RE.CP2 - REPEPE" 
		canvas:prazo "curto"
	] 
	
	// Médio Prazo 
	
	instance RE.MP1 : canvas:ResultadoEsperado [ 
		base:nome "Ampliação da rede de acesso às instituições" 
		base:id "RE.MP1 - REPEPE" 
		canvas:prazo "médio"
	] 
	instance RE.MP2 : canvas:ResultadoEsperado [ 
		base:nome "Fornecimento de serviços por meio da conexão da ATI à rede REPEPE" 
		base:id "RE.MP2 - REPEPE" 
		canvas:prazo "médio"
	] 
	instance RE.MP3 : canvas:ResultadoEsperado [ 
		base:nome "Conectar pontos de instituições do Governo Estadual à REPEPE" 
		base:id "RE.MP3 - REPEPE" 
		canvas:prazo "médio"
	] 
	instance RE.MP4 : canvas:ResultadoEsperado [ 
		base:nome "Habilitar o desenvolvimento de soluções e alternativas tecnológicas pelas instituições governamentais através da conexão à rede REPEPE" 
		base:id "RE.MP4 - REPEPE" 
		canvas:prazo "médio"
	] 
	instance RE.MP5 : canvas:ResultadoEsperado [ 
		base:nome "Redução de custos operacionais de conectividade para as instituições conectadas na REPEPE" 
		base:id "RE.MP5 - REPEPE" 
		canvas:prazo "médio"
	] 
	
	// Longo Prazo 
	
	instance RE.LP1 : canvas:ResultadoEsperado [ 
		base:nome "Ampliação das instituições conectadas à Rede REPEPE" 
		base:id "RE.LP1 - REPEPE" 
		canvas:prazo "longo"
	] 
	instance RE.LP2 : canvas:ResultadoEsperado [ 
		base:nome "Ampliação de serviços fornecidos pela ATI através da Rede REPEPE" 
		base:id "RE.LP2 - REPEPE" 
		canvas:prazo "longo"
	] 
	instance RE.LP3 : canvas:ResultadoEsperado [
		base:nome "Ampliação de novas rotas do Backbone" 
		base:id "RE.LP3 - REPEPE" 
		canvas:prazo "longo"
	] 
	instance RE.LP4 : canvas:ResultadoEsperado [ 
		base:nome "Ampliação da quantidade de pontos de presença da REPEPE no interior do Estado" 
		base:id "RE.LP4 - REPEPE" 
		canvas:prazo "longo"
	] 
	instance RE.LP5 : canvas:ResultadoEsperado [ 
		base:nome "Participação em eventos de cooperação técnica e intercâmbio para melhoria da Rede REPEPE" 
		base:id "RE.LP5 - REPEPE" 
		canvas:prazo "longo"
	] 
	instance RE.LP6 : canvas:ResultadoEsperado [ 
		base:nome "Expansão do uso avançado de TIC pelas instituições governamentais através da conexão à REPEPE" 
		base:id "RE.LP6 - REPEPE" 
		canvas:prazo "longo"
	] 
	instance RE.LP7 : canvas:ResultadoEsperado [ 
		base:nome " Redução de custos devido à utilização dos serviços para as instituições conectadas na REPEPE " 
		base:id "RE.LP7 - REPEPE" 
		canvas:prazo "longo"
	]
}
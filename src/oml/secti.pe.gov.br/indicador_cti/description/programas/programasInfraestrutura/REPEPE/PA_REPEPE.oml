description <http://secti.pe.gov.br/indicador_cti/description/programas/programasInfraestrutura/REPEPE/PA_REPEPE#> as PA_REPEPE {
	
	extends <http://secti.pe.gov.br/indicador_cti/description/fontesInformacao/fontesSistemasBasesGovernamentais#> as fontesSistemasBasesGovernamentais
	extends <http://secti.pe.gov.br/indicador_cti/description/programas/programasInfraestrutura/REPEPE/REPEPE#> as REPEPE
	uses <http://secti.pe.gov.br/indicador_cti/vocabulary/base#> as base
	uses <http://secti.pe.gov.br/indicador_cti/vocabulary/DesignAvaliacao/planoAvaliacao#> as planoAvaliacao
	uses <http://secti.pe.gov.br/indicador_cti/vocabulary/DesignAvaliacao/metricas#> as metricas
	uses <http://www.w3.org/2001/XMLSchema#> as xsd
	
	instance PAV1 : planoAvaliacao:planoAvaliacao[
		base:nome "Plano de Avaliação do Programa Rede Pernambucana de Pesquisa e Educação"
		base:id "PA-PR17"
		base:versao "V1-Homologado"
		base:dataCriacao "2026-07-07T00:00:00"^^xsd:dateTime
		planoAvaliacao:temQuestaoAvaliacao PA_REPEPE:PA1, PA_REPEPE:PA2, PA_REPEPE:PA3, PA_REPEPE:PA4, PA_REPEPE:PA5, PA_REPEPE:PA6, PA_REPEPE:PA7, PA_REPEPE:PA8, PA_REPEPE:PA9, PA_REPEPE:PA10
	]
	
	// Perguntas de Avaliação 

	instance PA1 : planoAvaliacao:questaoAvaliacao [
		base:nome "Qual a quantidade de municípios e regiões de desenvolvimento com presença da rede REPEPE?"
		base:id "PA1 - REPEPE"
		planoAvaliacao:custo "Baixo"
		planoAvaliacao:risco "Médio"
		planoAvaliacao:temMetrica PA1.ME1, PA1.ME2
		planoAvaliacao:temEscopo PA1.ES
		planoAvaliacao:temMetodologia PA1.MA4
		planoAvaliacao:temLimitacao RI1, RI2, LIM1
		planoAvaliacao:alinhaComResultado REPEPE:RE.CP1
	]
	instance PA2 : planoAvaliacao:questaoAvaliacao [
		base:nome "A conexão com a rede da Agência Estadual de Tecnologia da Informação (ATI) foi estabelecida com sucesso?"
		base:id "PA2 - REPEPE"
		planoAvaliacao:custo "Baixo"
		planoAvaliacao:risco "Médio"
		planoAvaliacao:temMetrica PA2.ME1, PA2.ME2
		planoAvaliacao:temEscopo PA2.ES
		planoAvaliacao:temMetodologia PA2.MA1
		planoAvaliacao:temLimitacao RI1, RI2, LIM1
		planoAvaliacao:alinhaComResultado REPEPE:RE.CP2
	]
	instance PA3 : planoAvaliacao:questaoAvaliacao [
		base:nome "Houve um aumento efetivo no número de pontos de acesso institucionais e governamentais conectados?"
		base:id "PA3 - REPEPE"
		planoAvaliacao:custo "Baixo"
		planoAvaliacao:risco "Médio"
		planoAvaliacao:temMetrica PA3.ME1, PA3.ME2, PA3.ME3, PA3.ME4, PA3.ME5
		planoAvaliacao:temEscopo PA3.ES
		planoAvaliacao:temMetodologia PA3.MA4
		planoAvaliacao:temLimitacao RI1, RI2, LIM1
		planoAvaliacao:alinhaComResultado REPEPE:RE.MP3, REPEPE:RE.LP1
	]
	instance PA4 : planoAvaliacao:questaoAvaliacao [
		base:nome "Qual a quantidade de municípios atendidos (com instituições usufruindo da rede) pela REPEPE?"
		base:id "PA4 - REPEPE"
		planoAvaliacao:custo "Baixo"
		planoAvaliacao:risco "Médio"
		planoAvaliacao:temMetrica PA4.ME1
		planoAvaliacao:temEscopo PA4.ES
		planoAvaliacao:temMetodologia PA4.MA4
		planoAvaliacao:temLimitacao RI1, RI2, LIM1
		planoAvaliacao:alinhaComResultado REPEPE:RE.MP1
	]
	instance PA5 : planoAvaliacao:questaoAvaliacao [
		base:nome "Quais serviços estão sendo consumidos pelas instituições através da conexão ATI/REPEPE?"
		base:id "PA5 - REPEPE"
		planoAvaliacao:custo "Baixo"
		planoAvaliacao:risco "Médio"
		planoAvaliacao:temMetrica PA5.ME1, PA5.ME2, PA5.ME3, PA5.ME4
		planoAvaliacao:temEscopo PA5.ES
		planoAvaliacao:temMetodologia PA5.MA4
		planoAvaliacao:temLimitacao RI1, RI2, LIM1
		planoAvaliacao:alinhaComResultado REPEPE:RE.MP2, REPEPE:RE.LP2
	]
	instance PA6 : planoAvaliacao:questaoAvaliacao [
		base:nome "Quais os casos de sucesso no uso de TICs das instituições conectadas à REPEPE?"
		base:id "PA6 - REPEPE"
		planoAvaliacao:custo "Baixo"
		planoAvaliacao:risco "Médio"
		planoAvaliacao:temMetrica PA6.ME1, PA6.ME2
		planoAvaliacao:temEscopo PA6.ES
		planoAvaliacao:temMetodologia PA6.MA4
		planoAvaliacao:temLimitacao RI1, RI2, LIM1
		planoAvaliacao:alinhaComResultado REPEPE:RE.MP4, REPEPE:RE.LP6
	]
	instance PA7 : planoAvaliacao:questaoAvaliacao [
		base:nome "Qual a redução percentual nos custos de conectividade das instituições após a adesão à REPEPE?"
		base:id "PA7 - REPEPE"
		planoAvaliacao:custo "Médio"
		planoAvaliacao:risco "Médio"
		planoAvaliacao:temMetrica PA7.ME1, PA7.ME2
		planoAvaliacao:temEscopo PA7.ES
		planoAvaliacao:temMetodologia PA7.MA1
		planoAvaliacao:temLimitacao RI1, RI2, RI3, RI4, LIM1
		planoAvaliacao:alinhaComResultado REPEPE:RE.MP5, REPEPE:RE.LP7
	]
	instance PA8 : planoAvaliacao:questaoAvaliacao [
		base:nome "A rede atingiu a capilaridade necessária no interior do estado para mitigar desigualdades regionais de CT&I?"
		base:id "PA8 - REPEPE"
		planoAvaliacao:custo "Baixo"
		planoAvaliacao:risco "Médio"
		planoAvaliacao:temMetrica PA8.ME1, PA8.ME2
		planoAvaliacao:temEscopo PA8.ES
		planoAvaliacao:temMetodologia PA8.MA4
		planoAvaliacao:temLimitacao RI1, RI2, LIM1
		planoAvaliacao:alinhaComResultado REPEPE:RE.LP4
	]
	instance PA9 : planoAvaliacao:questaoAvaliacao [
		base:nome "Novas rotas estratégicas de Backbone foram implementadas para garantir redundância e expansão?"
		base:id "PA9 - REPEPE"
		planoAvaliacao:custo "Baixo"
		planoAvaliacao:risco "Médio"
		planoAvaliacao:temMetrica PA9.ME1, PA9.ME2
		planoAvaliacao:temEscopo PA9.ES
		planoAvaliacao:temMetodologia PA9.MA4
		planoAvaliacao:temLimitacao RI1, RI2, LIM1
		planoAvaliacao:alinhaComResultado REPEPE:RE.LP3
	]
	instance PA10 : planoAvaliacao:questaoAvaliacao [
		base:nome "Como a participação em eventos e intercâmbios e realização de cooperações resultaram em melhorias técnicas incrementais na rede?"
		base:id "PA10 - REPEPE"
		planoAvaliacao:custo "Baixo"
		planoAvaliacao:risco "Médio"
		planoAvaliacao:temMetrica PA10.ME1, PA10.ME2
		planoAvaliacao:temEscopo PA10.ES
		planoAvaliacao:temMetodologia PA10.MA4
		planoAvaliacao:temLimitacao RI1, RI2, LIM1
		planoAvaliacao:alinhaComResultado REPEPE:RE.LP5
	]
	
	// Métricas (ME) e Fontes de Informação (FI)

	instance PA1.ME1 : metricas:metrica [
		base:nome "Quantidade Municípios REPEPE"
		base:descricao "Quantidade total de municípios com presença da rede REPEPE"
		base:id "PA1.ME1 - REPEPE"
		metricas:temFonte fontesSistemasBasesGovernamentais:FI2.10
	]
	instance PA1.ME2 : metricas:metrica [
		base:nome "Quantidade Municípios REPEPE por RD"
		base:descricao "Quantidade de municípios com presença da rede REPEPE, desagregada por Região de Desenvolvimento (RD)"
		base:id "PA1.ME2 - REPEPE"
		metricas:temFonte fontesSistemasBasesGovernamentais:FI2.10
	]

	instance PA2.ME1 : metricas:metrica [
		base:nome "Conexão ATI Realizada"
		base:descricao "Conexão realizada com a rede da ATI (status binário da conexão - Sim/Não)"
		base:id "PA2.ME1 - REPEPE"
		metricas:temFonte fontesSistemasBasesGovernamentais:FI2.10
	]
	instance PA2.ME2 : metricas:metrica [
		base:nome "Largura de Banda Média ATI"
		base:descricao "Largura de banda média disponível na interconexão REPEPE-ATI"
		base:id "PA2.ME2 - REPEPE"
		metricas:temFonte fontesSistemasBasesGovernamentais:FI2.10
	]

	instance PA3.ME1 : metricas:metrica [
		base:nome "Evolução Pontos de Acesso Governo"
		base:descricao "Evolução percentual anual do número de novos pontos de acesso ativos às instituições do governo estadual"
		base:id "PA3.ME1 - REPEPE"
		metricas:temFonte fontesSistemasBasesGovernamentais:FI2.10
	]
	instance PA3.ME2 : metricas:metrica [
		base:nome "Evolução Pontos de Acesso ICTs"
		base:descricao "Evolução percentual anual do número de novos pontos de acesso ativos às ICTs"
		base:id "PA3.ME2 - REPEPE"
		metricas:temFonte fontesSistemasBasesGovernamentais:FI2.10
	]
	instance PA3.ME3 : metricas:metrica [
		base:nome "Quantidade Instituições Governo Conectadas"
		base:descricao "Quantidade de instituições do governo estadual conectadas à REPEPE"
		base:id "PA3.ME3 - REPEPE"
		metricas:temFonte fontesSistemasBasesGovernamentais:FI2.10
	]
	instance PA3.ME4 : metricas:metrica [
		base:nome "Quantidade ICTs Conectadas"
		base:descricao "Quantidade de ICTs conectadas à REPEPE"
		base:id "PA3.ME4 - REPEPE"
		metricas:temFonte fontesSistemasBasesGovernamentais:FI2.10
	]
	instance PA3.ME5 : metricas:metrica [
		base:nome "Quantidade Total Instituições Conectadas"
		base:descricao "Quantidade total de instituições conectadas à REPEPE.

	Fórmula: Quantidade_Total = Quantidade_Inst_Governo_PE + Quantidade_ICTs
	
	Onde:
	Quantidade_Inst_Governo_PE = quantidade de instituições do governo estadual conectadas (PA3.ME3);
	Quantidade_ICTs = quantidade de ICTs conectadas (PA3.ME4)."
		base:id "PA3.ME5 - REPEPE"
		metricas:temFonte fontesSistemasBasesGovernamentais:FI2.10
	]

	instance PA4.ME1 : metricas:metrica [
		base:nome "Quantidade Municípios Atendidos"
		base:descricao "Quantidade de municípios atendidos (com instituições usufruindo da rede) pela REPEPE"
		base:id "PA4.ME1 - REPEPE"
		metricas:temFonte fontesSistemasBasesGovernamentais:FI2.10
	]

	instance PA5.ME1 : metricas:metrica [
		base:nome "Listagem Serviços Ofertados ATI"
		base:descricao "Listagem de serviços ofertados pela ATI através da rede REPEPE"
		base:id "PA5.ME1 - REPEPE"
		metricas:temFonte fontesSistemasBasesGovernamentais:FI2.10
	]
	instance PA5.ME2 : metricas:metrica [
		base:nome "Listagem Serviços Consumidos ATI"
		base:descricao "Listagem de serviços que são ofertados pela ATI e de fato estão sendo consumidos pelas instituições através da rede REPEPE"
		base:id "PA5.ME2 - REPEPE"
		metricas:temFonte fontesSistemasBasesGovernamentais:FI2.10
	]
	instance PA5.ME3 : metricas:metrica [
		base:nome "Incremento Anual Serviços Ofertados ATI"
		base:descricao "Percentual de incremento anual de serviços ofertados pela ATI através da rede REPEPE"
		base:id "PA5.ME3 - REPEPE"
		metricas:temFonte fontesSistemasBasesGovernamentais:FI2.10
	]
	instance PA5.ME4 : metricas:metrica [
		base:nome "Incremento Anual Serviços Consumidos ATI"
		base:descricao "Percentual de incremento anual de serviços ofertados pela ATI que estão sendo consumidos pelas instituições através da rede REPEPE"
		base:id "PA5.ME4 - REPEPE"
		metricas:temFonte fontesSistemasBasesGovernamentais:FI2.10
	]

	instance PA6.ME1 : metricas:metrica [
		base:nome "Quantidade Casos de Sucesso TIC"
		base:descricao "Quantidade de casos de sucesso no uso de TIC habilitados pela conexão com a REPEPE"
		base:id "PA6.ME1 - REPEPE"
		metricas:temFonte fontesSistemasBasesGovernamentais:FI2.10
	]
	instance PA6.ME2 : metricas:metrica [
		base:nome "Incremento Anual Casos de Sucesso TIC"
		base:descricao "Percentual de incremento anual de casos de sucesso no uso de TIC habilitados pela conexão com a REPEPE"
		base:id "PA6.ME2 - REPEPE"
		metricas:temFonte fontesSistemasBasesGovernamentais:FI2.10
	]

	instance PA7.ME1 : metricas:metrica [
		base:nome "Custo Médio Conectividade REPEPE x Mercado"
		base:descricao "Custo médio de conectividade por Mbps/instituição na REPEPE comparado aos preços dos serviços de conectividade disponíveis no contrato corporativo de serviços de telemática"
		base:id "PA7.ME1 - REPEPE"
		metricas:temFonte fontesSistemasBasesGovernamentais:FI2.10, fontesSistemasBasesGovernamentais:FI2.11
	]
	instance PA7.ME2 : metricas:metrica [
		base:nome "Custo Médio Serviços REPEPE x Mercado"
		base:descricao "Custo médio de uso de serviços usufruídos através da REPEPE comparado aos preços dos serviços disponíveis no mercado"
		base:id "PA7.ME2 - REPEPE"
		metricas:temFonte fontesSistemasBasesGovernamentais:FI2.10, fontesSistemasBasesGovernamentais:FI2.11
	]

	instance PA8.ME1 : metricas:metrica [
		base:nome "Proporção Instituições CT&I Interior x RMR"
		base:descricao "Proporção do número de instituições de CT&I conectadas à REPEPE em Regiões de Desenvolvimento do Interior em relação ao número de instituições de CT&I conectadas à REPEPE na RMR"
		base:id "PA8.ME1 - REPEPE"
		metricas:temFonte fontesSistemasBasesGovernamentais:FI2.10
	]
	instance PA8.ME2 : metricas:metrica [
		base:nome "Quantidade Municípios REPEPE Interior"
		base:descricao "Quantidade de municípios com presença da rede REPEPE estratificados por Região de Desenvolvimento (RD), exceto a RMR"
		base:id "PA8.ME2 - REPEPE"
		metricas:temFonte fontesSistemasBasesGovernamentais:FI2.10
	]

	instance PA9.ME1 : metricas:metrica [
		base:nome "Quantidade Rotas de Backbone"
		base:descricao "Número de rotas de Backbone implantadas"
		base:id "PA9.ME1 - REPEPE"
		metricas:temFonte fontesSistemasBasesGovernamentais:FI2.10
	]
	instance PA9.ME2 : metricas:metrica [
		base:nome "Percentual Redundância Física"
		base:descricao "Percentual da rede com redundância física da topologia"
		base:id "PA9.ME2 - REPEPE"
		metricas:temFonte fontesSistemasBasesGovernamentais:FI2.10
	]

	instance PA10.ME1 : metricas:metrica [
		base:nome "Quantidade Atividades de Melhoria na Rede"
		base:descricao "Número de atividades educativas, de extensão ou científicas e tecnológicas (incluindo cooperações) realizadas que resultaram em melhoria na rede REPEPE"
		base:id "PA10.ME1 - REPEPE"
		metricas:temFonte fontesSistemasBasesGovernamentais:FI2.10
	]
	instance PA10.ME2 : metricas:metrica [
		base:nome "Estimativa Pessoas Beneficiadas"
		base:descricao "Estimativa do número de pessoas beneficiadas pela execução das atividades educativas, de extensão ou científicas e tecnológicas (incluindo cooperações) realizadas que resultaram em melhoria na rede REPEPE"
		base:id "PA10.ME2 - REPEPE"
		metricas:temFonte fontesSistemasBasesGovernamentais:FI2.10
	]

	// Escopos (ES) e Métodos de Avaliação (MA)

	instance PA1.ES : planoAvaliacao:escopo [
		base:descricao "Espera-se identificar a progressão da presença da REPEPE nos municípios de Pernambuco ao longo do tempo, estratificada por Região de Desenvolvimento (RD)"
		base:id "PA1.ES - REPEPE"
	]
	instance PA1.MA4 : planoAvaliacao:metodoAvaliacao [
		base:descricao "Regressão de Dados em Painel"
		base:id "PA1.MA4 - REPEPE"
	]

	instance PA2.ES : planoAvaliacao:escopo [
		base:descricao "Espera-se comprovar que a conexão com a rede da ATI foi realizada e avaliar a largura de banda média para checar a viabilidade de expansão da REPEPE"
		base:id "PA2.ES - REPEPE"
	]
	instance PA2.MA1 : planoAvaliacao:metodoAvaliacao [
		base:descricao "Análise Descritiva"
		base:id "PA2.MA1 - REPEPE"
	]

	instance PA3.ES : planoAvaliacao:escopo [
		base:descricao "Espera-se identificar a evolução do número de pontos de acesso, tanto do governo quanto de ICTs"
		base:id "PA3.ES - REPEPE"
	]
	instance PA3.MA4 : planoAvaliacao:metodoAvaliacao [
		base:descricao "Regressão de Dados em Painel"
		base:id "PA3.MA4 - REPEPE"
	]

	instance PA4.ES : planoAvaliacao:escopo [
		base:descricao "Espera-se identificar a quantidade de municípios que estão usufruindo de fato da rede REPEPE"
		base:id "PA4.ES - REPEPE"
	]
	instance PA4.MA4 : planoAvaliacao:metodoAvaliacao [
		base:descricao "Regressão de Dados em Painel"
		base:id "PA4.MA4 - REPEPE"
	]

	instance PA5.ES : planoAvaliacao:escopo [
		base:descricao "Espera-se identificar como os serviços da ATI estão sendo ofertados e consumidos através da rede REPEPE"
		base:id "PA5.ES - REPEPE"
	]
	instance PA5.MA4 : planoAvaliacao:metodoAvaliacao [
		base:descricao "Regressão de Dados em Painel"
		base:id "PA5.MA4 - REPEPE"
	]

	instance PA6.ES : planoAvaliacao:escopo [
		base:descricao "Espera-se identificar a evolução dos casos de sucesso no uso de TIC habilitados pela REPEPE"
		base:id "PA6.ES - REPEPE"
	]
	instance PA6.MA4 : planoAvaliacao:metodoAvaliacao [
		base:descricao "Regressão de Dados em Painel"
		base:id "PA6.MA4 - REPEPE"
	]

	instance PA7.ES : planoAvaliacao:escopo [
		base:descricao "Espera-se identificar os custos médios de conectividade e serviços ao utilizar a REPEPE e também ao utilizar serviços do mercado, e realizar uma comparação de custos"
		base:id "PA7.ES - REPEPE"
	]
	instance PA7.MA1 : planoAvaliacao:metodoAvaliacao [
		base:descricao "Análise Descritiva"
		base:id "PA7.MA1 - REPEPE"
	]

	instance PA8.ES : planoAvaliacao:escopo [
		base:descricao "Espera-se identificar a capilaridade da rede em relação ao interior do estado"
		base:id "PA8.ES - REPEPE"
	]
	instance PA8.MA4 : planoAvaliacao:metodoAvaliacao [
		base:descricao "Regressão de Dados em Painel"
		base:id "PA8.MA4 - REPEPE"
	]

	instance PA9.ES : planoAvaliacao:escopo [
		base:descricao "Espera-se identificar a capilaridade e a redundância na rede REPEPE, identificando tendências ao longo do tempo"
		base:id "PA9.ES - REPEPE"
	]
	instance PA9.MA4 : planoAvaliacao:metodoAvaliacao [
		base:descricao "Regressão de Dados em Painel"
		base:id "PA9.MA4 - REPEPE"
	]

	instance PA10.ES : planoAvaliacao:escopo [
		base:descricao "Espera-se identificar qual o impacto da rede REPEPE na sociedade, em termos de atividades suportadas pela rede e beneficiários dessas atividades"
		base:id "PA10.ES - REPEPE"
	]
	instance PA10.MA4 : planoAvaliacao:metodoAvaliacao [
		base:descricao "Regressão de Dados em Painel"
		base:id "PA10.MA4 - REPEPE"
	]


	// Riscos (RI)
	
	instance RI1 : planoAvaliacao:limitacao [
		base:descricao "Falta de acesso à fonte FI2.10 (Relatório de gestão semestral sobre a REPEPE, SECTI) para obtenção de informações atualizadas da rede REPEPE"
	]
	instance RI2 : planoAvaliacao:limitacao [
		base:descricao "Informações incompletas, desatualizadas ou inverídicas na fonte FI2.10 sobre a gestão da REPEPE"
	]
	instance RI3 : planoAvaliacao:limitacao [
		base:descricao "Falta de acesso à fonte FI2.11 (Contrato corporativo dos serviços de telemática do governo) para obtenção de informações"
	]
	instance RI4 : planoAvaliacao:limitacao [
		base:descricao "Informações incompletas, desatualizadas ou inverídicas na fonte FI2.11"
	]

	// Limitações (LIM)

	instance LIM1 : planoAvaliacao:limitacao [
		base:descricao "Dependência dos dados primários localizados e geridos por outras instituições, como ITEP e ATI, para elaboração da fonte FI2.10"
	]
	
}
		base:id "PA8.ME1 - PernambucanasInovadoras"
		metricas:temFonte fontesSistemasBasesGovernamentais:FI2.1
	]
	instance PA8.ME2 : metricas:metrica [
		base:nome "Taxa de Interiorização dos Projetos"
		base:descricao "Taxa de Interiorização dos projetos: percentual de projetos coordenados por mulheres vinculadas a ICTs no interior do estado em relação ao 
total de projetos apoiados em todo o estado, por ano"
		base:id "PA8.ME2 - PernambucanasInovadoras"
		metricas:temFonte fontesSistemasBasesGovernamentais:FI2.1
	]

	// Escopos (ES) e Métodos de Avaliação (MA)
	
	instance PA1.ES : planoAvaliacao:escopo [
		base:descricao "Identificar o aumento do número de projetos de inovação sob a liderança/coordenação de mulheres no total de projetos da FACEPE (projetos de 
inovação na Diretoria de Inovação), por ano"
		base:id "PA1.ES - PernambucanasInovadoras"
	]
	instance PA1.MA1 : planoAvaliacao:metodoAvaliacao [
		base:descricao "Análise Descritiva"
		base:id "PA1.MA1 - PernambucanasInovadoras"
	]
	instance PA1.MA4 : planoAvaliacao:metodoAvaliacao [
		base:descricao "Regressão de Dados em Painel"
		base:id "PA1.MA4 - PernambucanasInovadoras"
	]


description <http://secti.pe.gov.br/indicador_cti/description/programas/programasApoioAPesquisa/PernambucanasInovadoras/PA_PernambucanasInovadoras#> as PA_PernambucanasInovadoras {
	
	extends <http://secti.pe.gov.br/indicador_cti/description/fontesInformacao/fontesDadosPrimarios#> as fontesDadosPrimarios
	extends <http://secti.pe.gov.br/indicador_cti/description/fontesInformacao/fontesSistemasBasesGovernamentais#> as fontesSistemasBasesGovernamentais
	extends <http://secti.pe.gov.br/indicador_cti/description/programas/programasApoioAPesquisa/PernambucanasInovadoras/PernambucanasInovadoras#> as PernambucanasInovadoras
	
	uses <http://secti.pe.gov.br/indicador_cti/vocabulary/base#> as base
	uses <http://secti.pe.gov.br/indicador_cti/vocabulary/DesignAvaliacao/planoAvaliacao#> as planoAvaliacao
	uses <http://secti.pe.gov.br/indicador_cti/vocabulary/DesignAvaliacao/metricas#> as metricas
	uses <http://www.w3.org/2001/XMLSchema#> as xsd
	
	
	instance PAV10 : planoAvaliacao:planoAvaliacao [
		base:nome "Plano de Avaliação do Programa Pernambucanas Inovadoras"
		base:id "PA-PR10"
		base:versao "V1-Final"
		base:dataCriacao "2026-08-25T00:00:00"^^xsd:dateTime
		planoAvaliacao:temQuestaoAvaliacao PA1, PA2, PA3, PA4, PA5, PA6, PA7, PA8
	]
	
	// Perguntas de Avaliação (PA)
	//===================================================================

	instance PA1 : planoAvaliacao:questaoAvaliacao [
		base:nome "Qual a evolução do número de projetos de inovação liderados/coordenados por mulheres na FACEPE?"
		base:id "PA1 - PernambucanasInovadoras"
		planoAvaliacao:custo "Baixo"
		planoAvaliacao:risco "Baixo"
		planoAvaliacao:temMetrica PA1.ME1
		planoAvaliacao:temEscopo PA1.ES
		planoAvaliacao:temMetodologia PA1.MA1, PA1.MA4
		planoAvaliacao:alinhaComResultado PernambucanasInovadoras:RE.CP1
	]
	instance PA2 : planoAvaliacao:questaoAvaliacao [
		base:nome "Qual a evolução da Taxa de Liderança Feminina nos projetos de inovação na FACEPE?"
		base:id "PA2 - PernambucanasInovadoras"
		planoAvaliacao:custo "Baixo"
		planoAvaliacao:risco "Baixo"
		planoAvaliacao:temMetrica PA2.ME1, PA2.ME2, PA2.ME3
		planoAvaliacao:temEscopo PA2.ES
		planoAvaliacao:temMetodologia PA2.MA1, PA2.MA4
		planoAvaliacao:alinhaComResultado PernambucanasInovadoras:RE.CP1
	]
	instance PA3 : planoAvaliacao:questaoAvaliacao [
		base:nome "Qual a evolução do número de mulheres na liderança/chefia de startups, spin-offs e empresas de base tecnológica no Ecossistema de Inovação do Estado?"
		base:id "PA3 - PernambucanasInovadoras"
		planoAvaliacao:custo "Alto"
		planoAvaliacao:risco "Alto"
		planoAvaliacao:temMetrica PA3.ME1
		planoAvaliacao:temEscopo PA3.ES
		planoAvaliacao:temMetodologia PA3.MA1, PA3.MA4
		planoAvaliacao:temLimitacao LIM1
		planoAvaliacao:alinhaComResultado PernambucanasInovadoras:RE.MP2
	]
	instance PA4 : planoAvaliacao:questaoAvaliacao [
		base:nome "Qual a evolução da relação das pesquisadoras das ICTs com os demais agentes do Sistema de CT&I?"
		base:id "PA4 - PernambucanasInovadoras"
		planoAvaliacao:custo "Baixo"
		planoAvaliacao:risco "Baixo"
		planoAvaliacao:temMetrica PA4.ME1, PA4.ME2
		planoAvaliacao:temEscopo PA4.ES
		planoAvaliacao:temMetodologia PA4.MA1, PA4.MA4
		planoAvaliacao:alinhaComResultado PernambucanasInovadoras:RE.CP2
	]
	instance PA5 : planoAvaliacao:questaoAvaliacao [
		base:nome "Em que medida os projetos apoiados pelo Programa resultaram em inovações em seus diferentes estágios?"
		base:id "PA5 - PernambucanasInovadoras"
		planoAvaliacao:custo "Alto"
		planoAvaliacao:risco "Alto"
		planoAvaliacao:temMetrica PA5.ME1, PA5.ME2, PA5.ME3, PA5.ME4
		planoAvaliacao:temEscopo PA5.ES
		planoAvaliacao:temMetodologia PA5.MA1
		planoAvaliacao:temLimitacao LIM1, LIM2
		planoAvaliacao:alinhaComResultado PernambucanasInovadoras:RE.MP1
	]
	instance PA6 : planoAvaliacao:questaoAvaliacao [
		base:nome "Qual a probabilidade de uma beneficiária do PPI progredir na esteira/trilha dos programas de empreendedorismo inovador da FACEPE/SECTI?"
		base:id "PA6 - PernambucanasInovadoras"
		planoAvaliacao:custo "Baixo"
		planoAvaliacao:risco "Baixo"
		planoAvaliacao:temMetrica PA6.ME1, PA6.ME2, PA6.ME3, PA6.ME4, PA6.ME5, PA6.ME6, PA6.ME7
		planoAvaliacao:temEscopo PA6.ES
		planoAvaliacao:temMetodologia PA6.MA1, PA6.MA4
		planoAvaliacao:alinhaComResultado PernambucanasInovadoras:RE.LP1
	]
	instance PA7 : planoAvaliacao:questaoAvaliacao [
		base:nome "Como os critérios de diversidade estão sendo efetivamente aplicados na seleção?"
		base:id "PA7 - PernambucanasInovadoras"
		planoAvaliacao:custo "Baixo"
		planoAvaliacao:risco "Baixo"
		planoAvaliacao:temMetrica PA7.ME1
		planoAvaliacao:temEscopo PA7.ES
		planoAvaliacao:temMetodologia PA7.MA1, PA7.MA4
		planoAvaliacao:temLimitacao LIM3
		planoAvaliacao:alinhaComResultado PernambucanasInovadoras:RE.CP3
	]
	instance PA8 : planoAvaliacao:questaoAvaliacao [
		base:nome "Qual a evolução da taxa de interiorização de projetos de inovação coordenados por mulheres alcançada pelo programa?"
		base:id "PA8 - PernambucanasInovadoras"
		planoAvaliacao:custo "Baixo"
		planoAvaliacao:risco "Baixo"
		planoAvaliacao:temMetrica PA8.ME1, PA8.ME2
		planoAvaliacao:temEscopo PA8.ES
		planoAvaliacao:temMetodologia PA8.MA1, PA8.MA4
		planoAvaliacao:alinhaComResultado PernambucanasInovadoras:RE.CP5
	]

	// Métricas (ME) e Fontes de Informação (FI)

	instance PA1.ME1 : metricas:metrica [
		base:nome "Quantidade Projetos Liderados por Mulheres"
		base:descricao "Número de projetos de inovação aprovados na FACEPE liderados/coordenados por mulheres, por ano e Região de Desenvolvimento de Pernambuco (RDE)"
		base:id "PA1.ME1 - PernambucanasInovadoras"
		metricas:temFonte fontesSistemasBasesGovernamentais:FI2.1
	]

	instance PA2.ME1 : metricas:metrica [
		base:nome "Quantidade Projetos Liderados por Mulheres"
		base:descricao "Número de projetos de inovação aprovados na FACEPE liderados/coordenados por mulheres, por ano e Região de Desenvolvimento de Pernambuco (RDE)"
		base:id "PA2.ME1 - PernambucanasInovadoras"
		metricas:temFonte fontesSistemasBasesGovernamentais:FI2.1
	]
	instance PA2.ME2 : metricas:metrica [
		base:nome "Quantidade Total Projetos de Inovação"
		base:descricao "Total de projetos de inovação aprovados na FACEPE, por ano e Região de Desenvolvimento de Pernambuco (RDE)"
		base:id "PA2.ME2 - PernambucanasInovadoras"
		metricas:temFonte fontesSistemasBasesGovernamentais:FI2.1
	]
	instance PA2.ME3 : metricas:metrica [
		base:nome "Taxa Liderança Feminina"
		base:descricao "Taxa de Liderança Feminina nos projetos de inovação: participação percentual de projetos de inovação coordenados por mulheres no total de 
projetos de inovação da FACEPE, por ano e Região de Desenvolvimento de Pernambuco (RDE)"
		base:id "PA2.ME3 - PernambucanasInovadoras"
		metricas:temFonte fontesSistemasBasesGovernamentais:FI2.1
	]

	instance PA3.ME1 : metricas:metrica [
		base:nome "Quantidade Mulheres em Liderança Startups"
		base:descricao "Número de mulheres na liderança/chefia de startups, spin-offs e empresas de base tecnológica dos projetos apoiados pelo programa, por ano e 
Região de Desenvolvimento de Pernambuco (RDE)"
		base:id "PA3.ME1 - PernambucanasInovadoras"
		metricas:temFonte fontesDadosPrimarios:FI1.1
	]

	instance PA4.ME1 : metricas:metrica [
		base:nome "Quantidade Agentes CT&I Relacionados"
		base:descricao "Número total de agentes do Sistema Estadual de CT&I diferentes (CNPJ) relacionados nos projetos apoiados no Programa, por ano e Região de 
Desenvolvimento de Pernambuco (RDE)"
		base:id "PA4.ME1 - PernambucanasInovadoras"
		metricas:temFonte fontesSistemasBasesGovernamentais:FI2.1
	]
	instance PA4.ME2 : metricas:metrica [
		base:nome "Adensamento Institucional"
		base:descricao "Adensamento institucional: número médio de agentes diferentes (CNPJ) do Sistema Estadual de CT&I relacionados nos projetos apoiados no 
Programa por projeto, por ano e Região de Desenvolvimento de Pernambuco (RDE)."
		base:id "PA4.ME2 - PernambucanasInovadoras"
		metricas:temFonte fontesSistemasBasesGovernamentais:FI2.1
	]

	instance PA5.ME1 : metricas:metrica [
		base:nome "Quantidade Total Projetos Aprovados"
		base:descricao "Número total de projetos aprovados, por ano e Região de Desenvolvimento de Pernambuco (RDE)"
		base:id "PA5.ME1 - PernambucanasInovadoras"
		metricas:temFonte fontesDadosPrimarios:FI1.1
	]
	instance PA5.ME2 : metricas:metrica [
		base:nome "Quantidade Projetos com Resultado Técnico"
		base:descricao "Número de projetos com protótipo, piloto, prova de conceito (PoC), novos produtos e/ou processos finalizados e aprovados ao final do contrato, 
por tipo de resultado, por ano e Região de Desenvolvimento de Pernambuco (RDE)"
		base:id "PA5.ME2 - PernambucanasInovadoras"
		metricas:temFonte fontesDadosPrimarios:FI1.1
	]
	instance PA5.ME3 : metricas:metrica [
		base:nome "Participação Percentual Tipos de Resultado"
		base:descricao "Participação percentual dos tipos de resultados dos projetos apoiados pelo Programa em relação ao total de resultados, por ano e Região de 
Desenvolvimento de Pernambuco (RDE)"
		base:id "PA5.ME3 - PernambucanasInovadoras"
		metricas:temFonte fontesDadosPrimarios:FI1.1
	]
	instance PA5.ME4 : metricas:metrica [
		base:nome "Taxa de Inovação dos Projetos"
		base:descricao "Taxa de Inovação dos Projetos: percentual de novos produtos, serviços e/ou processos finalizados e aprovados, como resultados dos projetos 
apoiados, por ano e Região de Desenvolvimento de Pernambuco (RDE)"
		base:id "PA5.ME4 - PernambucanasInovadoras"
		metricas:temFonte fontesDadosPrimarios:FI1.1
	]

	instance PA6.ME1 : metricas:metrica [
		base:nome "Beneficiadas Pernambucanas Inovadoras"
		base:descricao "CPF (nome) das beneficiadas no Programa Pernambucanas Inovadoras (a partir de 2022), por ano e Região de Desenvolvimento de Pernambuco (RDE)"
		base:id "PA6.ME1 - PernambucanasInovadoras"
		metricas:temFonte fontesSistemasBasesGovernamentais:FI2.1
	]
	instance PA6.ME2 : metricas:metrica [
		base:nome "Beneficiadas Pró-Startups Mulheres"
		base:descricao "CPF (nome) de todas as mulheres beneficiadas no Programa Pró-Startups Mulheres que Inovam (a partir de 2022), por ano, acumulado por ano e 
Região de Desenvolvimento de Pernambuco (RDE)"
		base:id "PA6.ME2 - PernambucanasInovadoras"
		metricas:temFonte fontesSistemasBasesGovernamentais:FI2.1
	]
	instance PA6.ME3 : metricas:metrica [
		base:nome "Beneficiadas COMPET Mulheres"
		base:descricao "CPF (nome) de todas as mulheres beneficiadas no Programa COMPET Mulheres (a partir de 2022), por ano, acumulado por ano e Região de 
Desenvolvimento de Pernambuco (RDE)"
		base:id "PA6.ME3 - PernambucanasInovadoras"
		metricas:temFonte fontesSistemasBasesGovernamentais:FI2.1
	]
	instance PA6.ME4 : metricas:metrica [
		base:nome "Beneficiadas Demais Programas Empreendedorismo"
		base:descricao "CPF (nome) de todas as mulheres beneficiadas em todos os programas de fomento ao empreendedorismo inovador da FACEPE/SECTI, exceto os 
exclusivos para mulheres (a partir de 2022), por ano, acumulado por ano e Região de Desenvolvimento de Pernambuco (RDE)"
		base:id "PA6.ME4 - PernambucanasInovadoras"
		metricas:temFonte fontesSistemasBasesGovernamentais:FI2.1
	]
	instance PA6.ME5 : metricas:metrica [
		base:nome "Sobreposição Pernambucanas x Pró-Startups Mulheres"
		base:descricao "Número de vezes que o CPF (nome) das beneficiadas no Programa Pernambucanas Inovadoras é encontrado no conjunto do número de CPF das 
beneficiadas no Programa Pró-Startups Mulheres que Inovam (a partir de 2022), por ano, acumulado por ano e Região de Desenvolvimento de Pernambuco (RDE)"
		base:id "PA6.ME5 - PernambucanasInovadoras"
		metricas:temFonte fontesSistemasBasesGovernamentais:FI2.1
	]
	instance PA6.ME6 : metricas:metrica [
		base:nome "Sobreposição Pernambucanas x COMPET Mulheres"
		base:descricao "Número de vezes que o CPF (nome) das beneficiadas no Programa Pernambucanas Inovadoras é encontrado no conjunto do número de CPF das 
beneficiadas no Programa COMPET Mulheres (a partir de 2022), por ano, acumulado por ano e Região de Desenvolvimento de Pernambuco (RDE)"
		base:id "PA6.ME6 - PernambucanasInovadoras"
		metricas:temFonte fontesSistemasBasesGovernamentais:FI2.1
	]
	instance PA6.ME7 : metricas:metrica [
		base:nome "Sobreposição Pernambucanas x Demais Programas"
		base:descricao "Número de vezes que o CPF (nome) das beneficiadas no Programa Pernambucanas Inovadoras é encontrado no conjunto de todos os programas de 
fomento ao empreendedorismo inovador da FACEPE/SECTI, exceto os exclusivos para mulheres (a partir de 2022), por ano, acumulado por ano e Região de 
Desenvolvimento de Pernambuco (RDE)"
		base:id "PA6.ME7 - PernambucanasInovadoras"
		metricas:temFonte fontesSistemasBasesGovernamentais:FI2.1
	]

	instance PA7.ME1 : metricas:metrica [
		base:nome "Taxa Diversidade Social dos Projetos"
		base:descricao "Taxa de Diversidade Social dos Projetos: percentual de integrantes dos projetos apoiados declarados negros, indígenas, trans ou PCD em 
relação ao total de integrantes, por ano e Região de Desenvolvimento de Pernambuco (RDE)"
		base:id "PA7.ME1 - PernambucanasInovadoras"
		metricas:temFonte fontesSistemasBasesGovernamentais:FI2.1

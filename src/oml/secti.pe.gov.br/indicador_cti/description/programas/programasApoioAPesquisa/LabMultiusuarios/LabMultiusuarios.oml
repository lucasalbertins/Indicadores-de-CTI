description <http://secti.pe.gov.br/indicador_cti/description/programas/programasApoioAPesquisa/LabMultiusuarios/LabMultiusuarios#> as LabMultiusuarios {
	
	extends <http://secti.pe.gov.br/indicador_cti/description/programas/programasApoioAPesquisa/LabMultiusuarios/PA_LabMultiusuarios#> as PA_LabMultiusuarios
	extends <http://secti.pe.gov.br/indicador_cti/description/parceirosChave/parceirosGoverno#> as parceirosGoverno
	extends <http://secti.pe.gov.br/indicador_cti/description/parceirosChave/parceirosAgenciasFomento#> as parceirosAgenciasFomento
	extends <http://secti.pe.gov.br/indicador_cti/description/parceirosChave/parceirosAcademiaICTs#> as parceirosAcademiaICTs
	extends <http://secti.pe.gov.br/indicador_cti/description/parceirosChave/parceirosEmpresas#> as parceirosEmpresas
	extends <http://secti.pe.gov.br/indicador_cti/description/fatoresExternos/fatoresCenarioEconomico#> as fatoresCenarioEconomico
	extends <http://secti.pe.gov.br/indicador_cti/description/fatoresExternos/fatoresCenarioInstitucionalLegal#> as fatoresCenarioInstitucionalLegal
	extends <http://secti.pe.gov.br/indicador_cti/description/fatoresExternos/fatoresCenarioTecnologico#> as fatoresCenarioTecnologico
	extends <http://secti.pe.gov.br/indicador_cti/description/fatoresExternos/fatoresCenarioSocialEducacional#> as fatoresCenarioSocialEducacional
	extends <http://secti.pe.gov.br/indicador_cti/description/fatoresExternos/fatoresDinamicaEcossistema#> as fatoresDinamicaEcossistema
	extends <http://secti.pe.gov.br/indicador_cti/description/entradas/entradasOrcamentoFinanciamento#> as entradasOrcamentoFinanciamento
	extends <http://secti.pe.gov.br/indicador_cti/description/entradas/entradasDadosSistemasPlataformas#> as entradasDadosSistemasPlataformas
	extends <http://secti.pe.gov.br/indicador_cti/description/entradas/entradasCapitalHumano#> as entradasCapitalHumano
	extends <http://secti.pe.gov.br/indicador_cti/description/entradas/entradasInstrumentosLegaisNormativos#> as entradasInstrumentosLegaisNormativos
	extends <http://secti.pe.gov.br/indicador_cti/description/atividadesChave#> as atividadeChave
	extends <http://secti.pe.gov.br/indicador_cti/description/saidas#> as saida
	extends <http://secti.pe.gov.br/indicador_cti/description/publicosAlvo/publicosAcademiaICTs#> as publicosAcademiaICTs
	extends <http://secti.pe.gov.br/indicador_cti/description/publicosAlvo/publicosEmpresasEmpreendedores#> as publicosEmpresasEmpreendedores
	extends <http://secti.pe.gov.br/indicador_cti/description/publicosAlvo/publicosSociedadeTerceiroSetor#> as publicosSociedadeTerceiroSetor
	uses <http://secti.pe.gov.br/indicador_cti/vocabulary/base#> as base
	uses <http://secti.pe.gov.br/indicador_cti/vocabulary/DesignAvaliacao/canvas#> as canvas
	uses <http://secti.pe.gov.br/indicador_cti/vocabulary/programa#> as programa
	uses <http://www.w3.org/2001/XMLSchema#> as xsd
	
	instance CanvasPR2 : canvas:canvas [
		base:nome "Canvas do Programa Lab.Multiusuários"
		base:id "C-PR2"
		base:versao "V1-Homologado"
		base:dataCriacao "2026-06-05T00:00:00Z"^^xsd:dateTime
		canvas:possuiParceiros parceirosGoverno:PC1.11, parceirosAgenciasFomento:PC2.1, parceirosAcademiaICTs:PC3.3, parceirosAcademiaICTs:PC3.5, 
		parceirosAcademiaICTs:PC3.6, parceirosAcademiaICTs:PC3.8, parceirosAcademiaICTs:PC3.9, parceirosEmpresas:PC4.1, parceirosEmpresas:PC4.2
		canvas:condicionadoPor fatoresCenarioEconomico:FE1.OP1, fatoresCenarioInstitucionalLegal:FE2.OP2, fatoresCenarioTecnologico:FE3.OP2, 
		fatoresDinamicaEcossistema:FE5.OP4, fatoresCenarioEconomico:FE1.AM3, fatoresCenarioEconomico:FE1.AM6, fatoresCenarioInstitucionalLegal:FE2.AM6, 
		fatoresCenarioSocialEducacional:FE4.AM1
		canvas:recebeEntradas entradasOrcamentoFinanciamento:EN1.1, entradasOrcamentoFinanciamento:EN1.5, entradasDadosSistemasPlataformas:EN2.1, 
		entradasCapitalHumano:EN3.1, entradasCapitalHumano:EN3.5, entradasCapitalHumano:EN3.6, entradasCapitalHumano:EN3.7, 
		entradasInstrumentosLegaisNormativos:EN5.1
		canvas:executa atividadeChave:AC1, atividadeChave:AC2, atividadeChave:AC3, atividadeChave:AC4, atividadeChave:AC6, atividadeChave:AC7
		canvas:geraSaidas saida:SA1, saida:SA3, saida:SA4
		canvas:produzResultados RE.CP1, RE.CP2, RE.CP3, RE.CP4, RE.MP1, RE.MP2, RE.MP3, RE.MP4, RE.MP5, RE.LP1, RE.LP2
		canvas:buscaAtingirGeral OB.GE
		canvas:buscaAtingirEspecifico OB.ES1, OB.ES2, OB.ES3, OB.ES4, OB.ES5, OB.ES6, OB.ES7, OB.ES8, OB.ES9
	]
	
	instance PR2 : programa:programaCTI [
		base:nome "Lab.Multiusuários"
		base:descricao "Apoiar atividades que propiciem a ampliação do acesso de pesquisadores a serviços especializados de suporte à pesquisa existentes no 
estado, mediante apoio financeiro a projetos para manutenção, operação e disponibilização de laboratórios multiusuários ou recuperação e conservação de acervos de 
interesse científico visando ampliar a sua disponibilidade e acessibilidade para pesquisadores, empresas e sociedade em geral, e maximizar os benefícios dessas 
estruturas, equipamentos e acervos para a geração de conhecimento no estado de Pernambuco"
		base:id "PR2"
		programa:temCanvas CanvasPR2
		programa:temPlanoAvaliacao PA_LabMultiusuarios:PAV1
	]
	
	// Relações Laboratórios MultiUsuários --> Público-Alvo
	relation instance PR2.direcionadoA.PU1.1 : canvas:direcionadoA [
		from PR2
		to publicosAcademiaICTs:PU1.1
		base:tipo "direto"
	]
	relation instance PR2.direcionadoA.PU1.2 : canvas:direcionadoA [
		from PR2
		to publicosAcademiaICTs:PU1.2
		base:tipo "direto"
	]
	relation instance PR2.direcionadoA.PU1.5 : canvas:direcionadoA [
		from PR2
		to publicosAcademiaICTs:PU1.5
		base:tipo "direto"
	]
	relation instance PR2.direcionadoA.PU1.6 : canvas:direcionadoA [
		from PR2
		to publicosAcademiaICTs:PU1.6
		base:tipo "direto"
	]
	relation instance PR2.direcionadoA.PU1.7 : canvas:direcionadoA [
		from PR2
		to publicosAcademiaICTs:PU1.7
		base:tipo "direto"
	]
	relation instance PR2.direcionadoA.PU1.10 : canvas:direcionadoA [
		from PR2
		to publicosAcademiaICTs:PU1.10
		base:tipo "direto"
	]
	relation instance PR2.direcionadoA.PU1.11 : canvas:direcionadoA [
		from PR2
		to publicosAcademiaICTs:PU1.11
		base:tipo "direto"
	]
	relation instance PR2.direcionadoA.PU1.12 : canvas:direcionadoA [
		from PR2
		to publicosAcademiaICTs:PU1.12
		base:tipo "direto"
	]
	relation instance PR2.direcionadoA.PU3.2 : canvas:direcionadoA [
		from PR2
		to publicosEmpresasEmpreendedores:PU3.2
		base:tipo "direto"
	]
	relation instance PR2.direcionadoA.PU5.1 : canvas:direcionadoA [
		from PR2
		to publicosSociedadeTerceiroSetor:PU5.1
		base:tipo "indireto"
	]
	
	// Objetivo Geral
	instance OB.GE : canvas:ObjetivoGeral [
		base:nome "Incentivar e apoiar a implantação, recuperação, conservação, manutenção e disponibilização de laboratórios multiusuários e acervos científicos 
no estado"
		base:id "OB.GE - LabMultiusuarios"
		canvas:buscaAtingir RE.CP1
	]
	
	// Objetivos Específicos
	instance OB.ES1 : canvas:ObjetivoEspecifico [
		base:nome "Promover o avanço estadual em CT&I através da universalização do acesso aos laboratórios multiusuários e acervos científicos"
		base:id "OB.ES1 - LabMultiusuarios"
		canvas:buscaAtingir RE.CP2
	]
	instance OB.ES2 : canvas:ObjetivoEspecifico [
		base:nome "Ampliar e diversificar os serviços prestados pelos laboratórios multiusuários e acervos científicos"
		base:id "OB.ES2 - LabMultiusuarios"
		canvas:buscaAtingir RE.CP3
	]
	instance OB.ES3 : canvas:ObjetivoEspecifico [
		base:nome "Maximizar os benefícios das estruturas laboratoriais e acervos científicos"
		base:id "OB.ES3 - LabMultiusuarios"
		canvas:buscaAtingir RE.LP1, RE.LP2
	]
	instance OB.ES4 : canvas:ObjetivoEspecifico [
		base:nome "Estimular o uso compartilhado de equipamentos, laboratórios e acervos científicos com maior interação, integração, intercâmbio de conhecimento"
		base:id "OB.ES4 - LabMultiusuarios"
	]
	instance OB.ES5 : canvas:ObjetivoEspecifico [
		base:nome "Prover recursos para aquisição, manutenção e atualização de equipamentos especializados, assegurando a continuidade, o uso compartilhado e a 
sustentabilidade técnica da infraestrutura de pesquisa"
		base:id "OB.ES5 - LabMultiusuarios"
		canvas:buscaAtingir RE.CP4
	]
	instance OB.ES6 : canvas:ObjetivoEspecifico [
		base:nome "Interiorizar a infraestrutura laboratorial e de acervos científicos"
		base:id "OB.ES6 - LabMultiusuarios"
		canvas:buscaAtingir RE.MP1
	]
	instance OB.ES7 : canvas:ObjetivoEspecifico [
		base:nome "Apoiar a acreditação e certificação dos laboratórios em Pernambuco"
		base:id "OB.ES7 - LabMultiusuarios"
	]
	instance OB.ES8 : canvas:ObjetivoEspecifico [
		base:nome "Incentivar uma melhor gestão e sustentabilidade dos laboratórios multiusuários e acervos científicos"
		base:id "OB.ES8 - LabMultiusuarios"
		canvas:buscaAtingir RE.MP2, RE.MP4
	]
	instance OB.ES9 : canvas:ObjetivoEspecifico [
		base:nome "Apoiar a formação, capacitação de recursos humanos"
		base:id "OB.ES9 - LabMultiusuarios"
		canvas:buscaAtingir RE.MP2, RE.MP3
	]
	
	// Resultados Esperados
	
	// Curto Prazo
	instance RE.CP1 : canvas:ResultadoEsperado [
		base:nome "Infraestrutura de pesquisa ampliada a partir dos laboratórios multiusuários e acervos científicos recuperados, implantados, mantidos e 
operacionais em Pernambuco"
		base:id "RE.CP1 - LabMultiusuarios"
		canvas:prazo "curto"
	]
	instance RE.CP2 : canvas:ResultadoEsperado [
		base:nome "Aumento no acesso a serviços especializados a partir dos laboratórios multiusuários e acervos para os pernambucanos"
		base:id "RE.CP2 - LabMultiusuarios"
		canvas:prazo "curto"
	]
	instance RE.CP3 : canvas:ResultadoEsperado [
		base:nome "Aumento e diversificação dos serviços prestados pelos laboratórios multiusuários e acervos científicos"
		base:id "RE.CP3 - LabMultiusuarios"
		canvas:prazo "curto"
	]
	instance RE.CP4 : canvas:ResultadoEsperado [
		base:nome "Ampliação e diversificação dos equipamentos especializados para prestação de serviços e pesquisa"
		base:id "RE.CP4 - LabMultiusuarios"
		canvas:prazo "curto"
	]
	
	// Médio Prazo
	instance RE.MP1 : canvas:ResultadoEsperado [
		base:nome "Fortalecimento da pesquisa e serviços especializados no interior do estado"
		base:id "RE.MP1 - LabMultiusuarios"
		canvas:prazo "médio"
	]
	instance RE.MP2 : canvas:ResultadoEsperado [
		base:nome "Planejamento e sustentabilidade financeira e da gestão dos laboratórios e acervos científicos"
		base:id "RE.MP2 - LabMultiusuarios"
		canvas:prazo "médio"
	]
	instance RE.MP3 : canvas:ResultadoEsperado [
		base:nome "Recursos humanos mais qualificado através do uso dos laboratórios multiusuários e acervos científicos apoiados"
		base:id "RE.MP3 - LabMultiusuarios"
		canvas:prazo "médio"
	]
	instance RE.MP4 : canvas:ResultadoEsperado [
		base:nome "Maior número de laboratórios multiusuários de Pernambuco com sistemas de gestão da qualidade implementados e certificados, promovendo maior 
confiabilidade, rastreabilidade e reconhecimento técnico-científico dos serviços"
		base:id "RE.MP4 - LabMultiusuarios"
		canvas:prazo "médio"
	]
	instance RE.MP5 : canvas:ResultadoEsperado [
		base:nome "Ampliação das redes, parcerias e alianças estratégicas entre instituições a partir dos laboratórios multiusuários e acervos científicos"
		base:id "RE.MP5 - LabMultiusuarios"
		canvas:prazo "médio"
	]
	
	// Longo Prazo
	instance RE.LP1 : canvas:ResultadoEsperado [
		base:nome "Geração de novos conhecimentos e inovações através do uso maximizado das estruturas e equipamentos apoiados"
		base:id "RE.LP1 - LabMultiusuarios"
		canvas:prazo "longo"
	]
	instance RE.LP2 : canvas:ResultadoEsperado [
		base:nome "Aumento da produção científica e tecnológica a partir dos laboratórios multiusuários apoiados e acervos científicos"
		base:id "RE.LP2 - LabMultiusuarios"
		canvas:prazo "longo"
	]
}
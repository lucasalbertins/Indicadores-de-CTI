	instance PA1 : planoAvaliacao:questaoAvaliacao [
		base:nome "Qual a evolução do número de laboratórios multiusuários apoiados pelo Programa em Pernambuco por ano?"
		base:id "PA1 - LabMultiusuarios"
		planoAvaliacao:custo "Baixo"
		planoAvaliacao:temMetrica PA1.ME1
		planoAvaliacao:temEscopo PA1.ES
		planoAvaliacao:temMetodologia PA1.MA
		planoAvaliacao:temLimitacao LIM1
		planoAvaliacao:alinhaComResultado LabMultiusuarios:RE.CP1
	]

	// Limitações
	instance LIM1 : planoAvaliacao:limitacao [
		base:descricao "Dependência da disponibilidade dos dados no AgilFAP/FACEPE"
	]
	instance LIM2 : planoAvaliacao:limitacao [
		base:descricao "A PNIPE pode não dispor do universo dos laboratórios multiusuários e acervos científicos, pois alguns laboratórios/acervos existentes 
podem não se encontrar cadastrados na PNIPE, o que pode comprometer o resultado da análise. Inclusive, as ICT privadas que não tem obrigação de cadastrar seus 
laboratórios no PNIPE/MCTI"
	]
	instance LIM3 : planoAvaliacao:limitacao [
		base:descricao "A PNIPE pode não dispor do universo dos laboratórios multiusuários e acervos científicos, pois alguns laboratórios/acervos existentes 
podem não se encontrar cadastrados na PNIPE, o que pode comprometer o resultado da análise. Acrescenta-se o fato da PNPE não possuir a classificação de “acervo 
científico” pré-definida na base de dados, o que requer um esforço maior de identificação dos mesmos a partir da análise das informações existentes na Plataforma 
pelo analista"
	]
	instance LIM4 : planoAvaliacao:limitacao [
		base:descricao "Só é possível obter os dados primários para responder a essa pergunta de avaliação e calcular as métricas a partir de pesquisa primária 
junto aos laboratórios multiusuários e/ou acervos científicos apoiados"
	]
	instance LIM5 : planoAvaliacao:limitacao [
		base:descricao "Não há segurança que os pesquisadores indiquem nas publicações científicas a utilização dos laboratórios multiusuários e acervos 
científicos e assim não ser possível captar essa informação no texto da publicação"
	]
	instance LIM6 : planoAvaliacao:limitacao [
		base:descricao "Talvez o AgilFap não contenha todos os dados necessários para responder a essa pergunta. É possível obter os dados primários para 
responder a essa pergunta de avaliação e calcular as métricas a partir de pesquisa primária junto aos laboratórios multiusuários e acervos científicos apoiados"
	]
}
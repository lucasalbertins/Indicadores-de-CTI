	instance PA5.ES : planoAvaliacao:escopo [
		base:descricao "Identificar e quantificar o número de usuários dos laboratórios multiusuários apoiados pelo programa segundo tipo e categoria, por ano"
		base:id "PA5.ES - LabMultiusuarios"
	]
	instance PA5.MA : planoAvaliacao:metodoAvaliacao [
		base:descricao "Análise longitudinal e descritiva. CONCEITOS ENVOLVIDOS:
															Usuários = pessoas (nº de CPF) mais instituições (nº de CNPJ) 
															Tipos de usuários = pessoas e instituições
															Categoria de usuários:
															Pessoas – alunos de graduação
															Pessoas – alunos de pós-graduação
															Pessoas – professores
															Pessoas – pesquisadores
															Pessoas – outras
															Instituição - ICT pública
															Instituição - ICT privada
															Instituição – governo/ adm. pública
															Instituição - empresa pública
															Instituição - empresa privada
															Instituição – outras"
		base:id "PA5.MA - LabMultiusuarios"
	]
	
	instance PA6.ES : planoAvaliacao:escopo [
		base:descricao "Identificar e quantificar o número de usuários dos laboratórios multiusuários apoiados pelo programa segundo tipo e categoria, por ano"
		base:id "PA6.ES - LabMultiusuarios"
	]
	instance PA6.MA : planoAvaliacao:metodoAvaliacao [
		base:descricao "Análise longitudinal e descritiva. CONCEITOS ENVOLVIDOS:
															Usuários = pessoas (nº de CPF) mais instituições (nº de CNPJ) 
															Tipos de usuários = pessoas e instituições
															Categoria de usuários:
															Pessoas – alunos de graduação
															Pessoas – alunos de pós-graduação
															Pessoas – professores
															Pessoas – pesquisadores
															Pessoas – outras
															Instituição - ICT pública
															Instituição - ICT privada
															Instituição – governo/ adm. pública
															Instituição - empresa pública
															Instituição - empresa privada
															Instituição – outras"
		base:id "PA6.MA - LabMultiusuarios"
	]
	

description <http://secti.pe.gov.br/indicador_cti/description/programas/programasApoioAPesquisa/CientistaArretado/CientistaArretado#> as CientistaArretado {
	
	extends <http://secti.pe.gov.br/indicador_cti/description/programas/programasApoioAPesquisa/CientistaArretado/PA_CientistaArretado#> as PA_CientistaArretado
	extends <http://secti.pe.gov.br/indicador_cti/description/parceirosChave/parceirosGoverno#> as parceirosGoverno
	extends <http://secti.pe.gov.br/indicador_cti/description/parceirosChave/parceirosAgenciasFomento#> as parceirosAgenciasFomento
	extends <http://secti.pe.gov.br/indicador_cti/description/parceirosChave/parceirosAcademiaICTs#> as parceirosAcademiaICTs
	extends <http://secti.pe.gov.br/indicador_cti/description/fatoresExternos/fatoresCenarioEconomico#> as fatoresCenarioEconomico
	extends <http://secti.pe.gov.br/indicador_cti/description/fatoresExternos/fatoresCenarioTecnologico#> as fatoresCenarioTecnologico
	extends <http://secti.pe.gov.br/indicador_cti/description/fatoresExternos/fatoresCenarioSocialEducacional#> as fatoresCenarioSocialEducacional
	extends <http://secti.pe.gov.br/indicador_cti/description/entradas/entradasOrcamentoFinanciamento#> as entradasOrcamentoFinanciamento
	extends <http://secti.pe.gov.br/indicador_cti/description/entradas/entradasDadosSistemasPlataformas#> as entradasDadosSistemasPlataformas
	extends <http://secti.pe.gov.br/indicador_cti/description/entradas/entradasCapitalHumano#> as entradasCapitalHumano
	extends <http://secti.pe.gov.br/indicador_cti/description/entradas/entradasInstrumentosLegaisNormativos#> as entradasInstrumentosLegaisNormativos
	extends <http://secti.pe.gov.br/indicador_cti/description/atividadesChave#> as atividadeChave
	extends <http://secti.pe.gov.br/indicador_cti/description/saidas#> as saida
	extends <http://secti.pe.gov.br/indicador_cti/description/publicosAlvo/publicosAcademiaICTs#> as publicosAcademiaICTs
	extends <http://secti.pe.gov.br/indicador_cti/description/publicosAlvo/publicosGovernoInstituicoesPublicas#> as publicosGovernoInstituicoesPublicas
	extends <http://secti.pe.gov.br/indicador_cti/description/publicosAlvo/publicosEmpresasEmpreendedores#> as publicosEmpresasEmpreendedores
	extends <http://secti.pe.gov.br/indicador_cti/description/publicosAlvo/publicosSociedadeTerceiroSetor#> as publicosSociedadeTerceiroSetor
	uses <http://secti.pe.gov.br/indicador_cti/vocabulary/base#> as base
	uses <http://secti.pe.gov.br/indicador_cti/vocabulary/DesignAvaliacao/canvas#> as canvas
	uses <http://secti.pe.gov.br/indicador_cti/vocabulary/programa#> as programa
	uses <http://www.w3.org/2001/XMLSchema#> as xsd
	
	
	
	
	instance CanvasPR6 : canvas:canvas [
		base:nome "Canvas do Programa Cientista Arretado"
		base:id "C-PR6"
		base:versao "V1-Homologado"
		base:dataCriacao "2026-03-11T00:00:00"^^xsd:dateTime
		canvas:possuiParceiros parceirosGoverno:PC1.1, parceirosGoverno:PC1.2, parceirosGoverno:PC1.11, parceirosAgenciasFomento:PC2.1, 
		parceirosAcademiaICTs:PC3.3, parceirosAcademiaICTs:PC3.5, parceirosAcademiaICTs:PC3.6
		canvas:condicionadoPor fatoresCenarioTecnologico:FE3.OP1, fatoresCenarioSocialEducacional:FE4.OP2, fatoresCenarioEconomico:FE1.AM2, 
		fatoresCenarioEconomico:FE1.AM3, fatoresCenarioTecnologico:FE3.AM1, fatoresCenarioSocialEducacional:FE4.AM1
		canvas:recebeEntradas entradasOrcamentoFinanciamento:EN1.1, entradasOrcamentoFinanciamento:EN1.5, entradasDadosSistemasPlataformas:EN2.1, 
		entradasDadosSistemasPlataformas:EN2.4, entradasCapitalHumano:EN3.5, entradasInstrumentosLegaisNormativos:EN5.1, entradasInstrumentosLegaisNormativos:EN5.7
		canvas:executa atividadeChave:AC1, atividadeChave:AC2, atividadeChave:AC3, atividadeChave:AC4, atividadeChave:AC5, atividadeChave:AC6, atividadeChave:AC7
		canvas:geraSaidas saida:SA1, saida:SA2, saida:SA3, saida:SA4, saida:SA5, saida:SA6, saida:SA7, saida:SA8, saida:SA9, saida:SA10, saida:SA11, saida:SA12
		canvas:produzResultados RE.CP1, RE.CP2, RE.CP3, RE.CP4, RE.CP5, RE.MP1, RE.MP2, RE.MP3, RE.LP1, RE.LP2
		canvas:buscaAtingirGeral OB.GE
		canvas:buscaAtingirEspecifico OB.ES1, OB.ES2, OB.ES3, OB.ES4, OB.ES5
	]
	
	instance PR6 : programa:programaCTI [
		base:nome "Cientista Arretado"
		base:descricao "Financia pesquisas aplicadas para resolver desafios da gestão pública estadual. Com foco em inovação, aproxima pesquisadores sêniores de ICTs das demandas de secretarias, oferecendo bolsas e recursos para projetos que gerem impacto social e soluções baseadas em evidências"
		base:id "PR6"
		programa:temCanvas CanvasPR6
		programa:temPlanoAvaliacao PA_CientistaArretado:PAV1
	]
	
	// Relações Cientista Arretado --> Público-Alvo
	relation instance CanvasPR6.direcionadoA.PU1.2 : canvas:direcionadoA [
		from CanvasPR6
		to publicosAcademiaICTs:PU1.2
		base:tipo "direto"
	]
	relation instance CanvasPR6.direcionadoA.PU1.10 : canvas:direcionadoA [
		from CanvasPR6
		to publicosAcademiaICTs:PU1.10
		base:tipo "direto"
	]
	relation instance CanvasPR6.direcionadoA.PU1.12 : canvas:direcionadoA [
		from CanvasPR6
		to publicosAcademiaICTs:PU1.12
		base:tipo "direto"
	]
	relation instance CanvasPR6.direcionadoA.PU2.1 : canvas:direcionadoA [
		from CanvasPR6
		to publicosGovernoInstituicoesPublicas:PU2.1
		base:tipo "direto"
	]
	relation instance CanvasPR6.direcionadoA.PU2.2 : canvas:direcionadoA [
		from CanvasPR6
		to publicosGovernoInstituicoesPublicas:PU2.2
		base:tipo "indireto"
	]
	relation instance CanvasPR6.direcionadoA.PU3.2 : canvas:direcionadoA [
		from CanvasPR6
		to publicosEmpresasEmpreendedores:PU3.2
		base:tipo "direto"
	]
	relation instance CanvasPR6.direcionadoA.PU5.1 : canvas:direcionadoA [
		from CanvasPR6
		to publicosSociedadeTerceiroSetor:PU5.1
		base:tipo "direto"
	]
	
	// Objetivo Geral
	instance OB.GE : canvas:ObjetivoGeral [
		base:nome "Fomentar a cooperação entre o governo do estado e pesquisadores de ICTs pernambucanas para o desenvolvimento de inovações e tecnologias que solucionem desafios no âmbito governamental"
		base:id "OB.GE - CientistaArretado"
		canvas:buscaAtingir RE.CP1
	]
	
	// Objetivos Específicos
	instance OB.ES1 : canvas:ObjetivoEspecifico [
		base:nome "Fomentar a inovação na gestão pública estadual"
		base:id "OB.ES1 - CientistaArretado"
		canvas:buscaAtingir RE.CP3
	]
	instance OB.ES2 : canvas:ObjetivoEspecifico [
		base:nome "Apoiar a articulação entre o governo do estado e pesquisadores de ICTs"
		base:id "OB.ES2 - CientistaArretado"
		canvas:buscaAtingir RE.CP2
	]
	instance OB.ES3 : canvas:ObjetivoEspecifico [
		base:nome "Ampliar a efetividade dos serviços públicos prestados à sociedade"
		base:id "OB.ES3 - CientistaArretado"
		canvas:buscaAtingir RE.MP1, RE.LP1
	]
	instance OB.ES4 : canvas:ObjetivoEspecifico [
		base:nome "Promover a eficiência da gestão pública estadual"
		base:id "OB.ES4 - CientistaArretado"
		canvas:buscaAtingir RE.CP5, RE.MP2, RE.MP3
	]
	instance OB.ES5 : canvas:ObjetivoEspecifico [
		base:nome "Fortalecer o Sistema Estadual de Ciência, Tecnologia e Inovação com maior interação, integração, intercâmbio de conhecimento e alianças estratégicas entre ICTs e o governo do estado"
		base:id "OB.ES5 - CientistaArretado"
		canvas:buscaAtingir RE.CP4, RE.LP2
	]
	
	// Resultados Esperados
	
	// Curto Prazo
	instance RE.CP1 : canvas:ResultadoEsperado [
		base:nome "Desenvolvimento de soluções inovadoras para os desafios do setor público"
		base:id "RE.CP1 - CientistaArretado"
		canvas:prazo "curto"
	]
	instance RE.CP2 : canvas:ResultadoEsperado [
		base:nome "Maior integração entre os pesquisadores pernambucanos e o governo do estado"
		base:id "RE.CP2 - CientistaArretado"
		canvas:prazo "curto"
	]
	instance RE.CP3 : canvas:ResultadoEsperado [
		base:nome "Criação de novas estruturas governamentais e instrumentos de gestão a partir das soluções inovadoras desenvolvidas"
		base:id "RE.CP3 - CientistaArretado"
		canvas:prazo "curto"
	]
	instance RE.CP4 : canvas:ResultadoEsperado [
		base:nome "Geração de novos conhecimentos e inovações no Sistema Estadual de CT&I"
		base:id "RE.CP4 - CientistaArretado"
		canvas:prazo "curto"
	]
	instance RE.CP5 : canvas:ResultadoEsperado [
		base:nome "Recursos humanos do governo (técnico, servidores, gestores públicos) mais capacitados para o desenvolvimento, uso e aplicação das soluções desenvolvidas"
		base:id "RE.CP5 - CientistaArretado"
		canvas:prazo "curto"
	]
	
	// Médio Prazo
	instance RE.MP1 : canvas:ResultadoEsperado [
		base:nome "Ampliação da efetividade dos serviços públicos prestados à sociedade (diretamente nos órgãos demandantes)"
		base:id "RE.MP1 - CientistaArretado"
		canvas:prazo "médio"
	]
	instance RE.MP2 : canvas:ResultadoEsperado [
		base:nome "Eficiência da gestão pública estadual (fazer mais com menos recursos – tempo, pessoas e orçamento) com base nas soluções implementadas"
		base:id "RE.MP2 - CientistaArretado"
		canvas:prazo "médio"
	]
	instance RE.MP3 : canvas:ResultadoEsperado [
		base:nome "Garantia, sem ônus, do direito de propriedade, uso e posse dos resultados desenvolvidos (dados, códigos fonte, tecnologias, documentos) para os órgãos e entidades da administração pública estadual"
		base:id "RE.MP3 - CientistaArretado"
		canvas:prazo "médio"
	]
	
	// Longo Prazo
	instance RE.LP1 : canvas:ResultadoEsperado [
		base:nome "Ampliação da capacidade de resposta em temas/desafios estratégicos para o estado de Pernambuco"
		base:id "RE.LP1 - CientistaArretado"
		canvas:prazo "longo"
	]
	instance RE.LP2 : canvas:ResultadoEsperado [
		base:nome "Consolidação de alianças estratégicas entre ICTs e o governo do estado (redes e intercâmbio de conhecimento)"
		base:id "RE.LP2 - CientistaArretado"
		canvas:prazo "longo"
	]
}
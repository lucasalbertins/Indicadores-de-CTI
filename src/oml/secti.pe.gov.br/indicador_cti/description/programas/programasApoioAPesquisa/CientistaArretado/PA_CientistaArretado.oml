		planoAvaliacao:custo "Alto"
		planoAvaliacao:risco "Alto"
		planoAvaliacao:temMetrica PA15.ME1
		planoAvaliacao:temEscopo PA15.ES
		planoAvaliacao:temMetodologia PA15.MA1
		planoAvaliacao:temLimitacao LIM2
		planoAvaliacao:alinhaComResultado CientistaArretado:RE.MP1
	]
	instance PA16 : planoAvaliacao:questaoAvaliacao [
		base:nome "Quantas novas alianças estratégicas formais (acordos e/ou convênios) foram estabelecidas entre órgãos do governo e ICTs a partir dos projetos?"

		base:id "PA12.ME1 - CientistaArretado"
		metricas:temFonte fontesDadosPrimarios:FI1.1
	]
	
	instance PA13.ME1 : metricas:metrica [
		base:descricao "Indicadores de utilização de recursos (tempo, pessoas, custos e/ou outras variáveis) na execução das atividades relacionadas aos projetos 

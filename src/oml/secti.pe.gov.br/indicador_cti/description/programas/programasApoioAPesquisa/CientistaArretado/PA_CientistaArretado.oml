	]
	instance PA10 : planoAvaliacao:questaoAvaliacao [
		base:nome "Qual o número de produção científica ou tecnológica publicações científicas e/ou trabalhos técnicos (artigos, TCC, dissertações e teses) gerados 
diretamente a partir dos projetos apoiados?"
		base:id "PA10 - CientistaArretado"
		planoAvaliacao:custo "Alto"
		planoAvaliacao:risco "Alto"
		planoAvaliacao:temMetrica PA10.ME1, PA10.ME2
		planoAvaliacao:temEscopo PA10.ES
		planoAvaliacao:temMetodologia PA10.MA1
		planoAvaliacao:temLimitacao LIM2

		base:nome "Qual o número de servidores/gestores públicos capacitados/treinados para o uso ou gestão das soluções desenvolvidas nos órgãos demandantes?"
		base:id "PA11 - CientistaArretado"
		planoAvaliacao:custo "Alto"
		planoAvaliacao:risco "Alto"
		planoAvaliacao:temMetrica PA11.ME1
		planoAvaliacao:temEscopo PA11.ES
		planoAvaliacao:temMetodologia PA11.MA1
		planoAvaliacao:temLimitacao LIM2
		planoAvaliacao:alinhaComResultado CientistaArretado:RE.CP5
	]
	instance PA12 : planoAvaliacao:questaoAvaliacao [
		base:nome "Em que medida as soluções resultantes dos projetos demonstraram melhoria resposta/entrega de serviços nos órgãos demandantes?"
		base:id "PA12 - CientistaArretado"
		planoAvaliacao:custo "Alto"
		planoAvaliacao:risco "Alto"
		planoAvaliacao:temMetrica PA12.ME1
		planoAvaliacao:temEscopo PA12.ES
		planoAvaliacao:temMetodologia PA12.MA1
		planoAvaliacao:temLimitacao LIM2
		planoAvaliacao:alinhaComResultado CientistaArretado:RE.MP1
	]
	instance PA13 : planoAvaliacao:questaoAvaliacao [
		base:nome "Qual a redução de recursos (tempo, pessoas, custos e/ou outras variáveis) utilizados na execução das atividades relacionadas aos projetos 
apoiados nos órgãos demandantes após a implementação das soluções?"
		base:id "PA13 - CientistaArretado"
		planoAvaliacao:custo "Alto"
		planoAvaliacao:risco "Alto"
		planoAvaliacao:temMetrica PA13.ME1, PA13.ME2, PA13.ME3
		planoAvaliacao:temEscopo PA13.ES
		planoAvaliacao:temMetodologia PA13.MA1
		planoAvaliacao:temLimitacao LIM2
		planoAvaliacao:alinhaComResultado CientistaArretado:RE.MP2
	]
	instance PA14 : planoAvaliacao:questaoAvaliacao [
		base:nome "Qual a proporção de projetos que tiveram suas soluções (conhecimento, códigos, tecnologias, dados, etc.) transferidas (direito de propriedade, 
uso ou posse) para o órgão demandante?"
		base:id "PA14 - CientistaArretado"
		planoAvaliacao:custo "Alto"
		planoAvaliacao:risco "Alto"
		planoAvaliacao:temMetrica PA14.ME1, PA14.ME2
		planoAvaliacao:temEscopo PA14.ES
		planoAvaliacao:temMetodologia PA14.MA1
		planoAvaliacao:temLimitacao LIM2

description <http://secti.pe.gov.br/indicador_cti/description/programas/programasApoioAPesquisa/CientistaArretado/PA_CientistaArretado#> as PA_CientistaArretado {
	
	extends <http://secti.pe.gov.br/indicador_cti/description/fontesInformacao/fontesDadosPrimarios#> as fontesDadosPrimarios
	extends <http://secti.pe.gov.br/indicador_cti/description/fontesInformacao/fontesSistemasBasesGovernamentais#> as fontesSistemasBasesGovernamentais
	extends <http://secti.pe.gov.br/indicador_cti/description/programas/programasApoioAPesquisa/CientistaArretado/CientistaArretado#> as CientistaArretado
	uses <http://secti.pe.gov.br/indicador_cti/vocabulary/base#> as base
	uses <http://secti.pe.gov.br/indicador_cti/vocabulary/DesignAvaliacao/planoAvaliacao#> as planoAvaliacao
	uses <http://secti.pe.gov.br/indicador_cti/vocabulary/DesignAvaliacao/metricas#> as metricas
	uses <http://www.w3.org/2001/XMLSchema#> as xsd
	
	
	instance PAV1 : planoAvaliacao:planoAvaliacao[
		base:nome "Plano de Avaliação do Programa Cientista Arretado"
		base:id "PA-PR6"
		base:versao "V1-Homologado"
		base:dataCriacao "2026-03-11T00:00:00Z"^^xsd:dateTime
		planoAvaliacao:temQuestaoAvaliacao PA_CientistaArretado:PA1, PA_CientistaArretado:PA2, PA_CientistaArretado:PA3, PA_CientistaArretado:PA4, PA_CientistaArretado:PA5, 
		PA_CientistaArretado:PA6, PA_CientistaArretado:PA7, PA_CientistaArretado:PA8, PA_CientistaArretado:PA9, PA_CientistaArretado:PA10, 
		PA_CientistaArretado:PA11, PA_CientistaArretado:PA12, PA_CientistaArretado:PA13, PA_CientistaArretado:PA14, PA_CientistaArretado:PA15, 
		PA_CientistaArretado:PA16
	]
	
	instance PA1 : planoAvaliacao:questaoAvaliacao [
		base:nome "Qual a evolução do número de projetos apoiados em cada edital (em todas as rodadas)?"
		base:id "PA1 - CientistaArretado"
		planoAvaliacao:custo "Baixo"
		planoAvaliacao:risco "Baixo"
		planoAvaliacao:temMetrica PA1.ME1
		planoAvaliacao:temEscopo PA1.ES
		planoAvaliacao:temMetodologia PA1.MA1
		planoAvaliacao:temLimitacao LIM1
		planoAvaliacao:alinhaComResultado CientistaArretado:RE.CP1
	]
	instance PA2 : planoAvaliacao:questaoAvaliacao [
		base:nome "Qual a evolução do número de soluções validadas ao final do período do projeto (desenvolvidas ou em fase piloto) em cada edital (todas as 
rodadas)?"
		base:id "PA2 - CientistaArretado"
		planoAvaliacao:custo "Alto"
		planoAvaliacao:risco "Alto"
		planoAvaliacao:temMetrica PA2.ME1
		planoAvaliacao:temEscopo PA2.ES
		planoAvaliacao:temMetodologia PA2.MA1
		planoAvaliacao:temLimitacao LIM2
		planoAvaliacao:alinhaComResultado CientistaArretado:RE.CP1
	]
	instance PA3 : planoAvaliacao:questaoAvaliacao [
		base:nome "Qual a proporção de projetos cujas soluções foram efetivamente implementadas nos órgãos demandantes após a finalização dos projetos?"
		base:id "PA3 - CientistaArretado"
		planoAvaliacao:custo "Alto"
		planoAvaliacao:risco "Alto"
		planoAvaliacao:temMetrica PA3.ME1, PA3.ME2
		planoAvaliacao:temEscopo PA3.ES
		planoAvaliacao:temMetodologia PA3.MA1
		planoAvaliacao:temLimitacao LIM2
		planoAvaliacao:alinhaComResultado CientistaArretado:RE.CP1
	]
	instance PA4 : planoAvaliacao:questaoAvaliacao [
		base:nome "Quais as ICTs-PE envolvidas como instituições executoras nos projetos por edital (todas as rodadas)?"
		base:id "PA4 - CientistaArretado"
		planoAvaliacao:custo "Baixo"
		planoAvaliacao:risco "Baixo"
		planoAvaliacao:temMetrica PA4.ME1, PA4.ME2, PA4.ME3
		planoAvaliacao:temEscopo PA4.ES
		planoAvaliacao:temMetodologia PA4.MA1
		planoAvaliacao:temLimitacao LIM1
		planoAvaliacao:alinhaComResultado CientistaArretado:RE.CP2
	]
	instance PA5 : planoAvaliacao:questaoAvaliacao [
		base:nome "Qual o número de pesquisadores vinculados às ICTs e envolvidos nos projetos aprovados por edital (todas as rodadas)?"
		base:id "PA5 - CientistaArretado"
		planoAvaliacao:custo "Baixo"
		planoAvaliacao:risco "Baixo"
		planoAvaliacao:temMetrica PA5.ME1
		planoAvaliacao:temEscopo PA5.ES
		planoAvaliacao:temMetodologia PA5.MA1
		planoAvaliacao:temLimitacao LIM1
		planoAvaliacao:alinhaComResultado CientistaArretado:RE.CP2
	]
	instance PA6 : planoAvaliacao:questaoAvaliacao [
		base:nome "Qual o número de órgãos da administração pública (direta ou indireta) envolvidos na execução dos projetos (demandantes)?"
		base:id "PA6 - CientistaArretado"
		planoAvaliacao:custo "Baixo"
		planoAvaliacao:risco "Baixo"
		planoAvaliacao:temMetrica PA6.ME1, PA6.ME2
		planoAvaliacao:temEscopo PA6.ES
		planoAvaliacao:temMetodologia PA6.MA1
		planoAvaliacao:temLimitacao LIM1
		planoAvaliacao:alinhaComResultado CientistaArretado:RE.CP2
	]
	instance PA7 : planoAvaliacao:questaoAvaliacao [
		base:nome "Qual a evolução do número de servidores/empregados públicos envolvidos como contrapartida ou equipe de apoio nos projetos nos órgãos 

	// Escopos e Métodos de Avaliação
	instance PA1.ES : planoAvaliacao:escopo [
		base:descricao "Quantificar o número direto de projetos apoiados em cada edital (ou seja, pelo programa) em termos absoluto. Esse valor será utilizado como 
base e referência para calcular outras variáveis e indicadores de avaliação do programa"
		base:id "PA1.ES - CientistaArretado"
	]
	instance PA1.MA1 : planoAvaliacao:metodoAvaliacao [
		base:descricao "Análise longitudinal e descritiva"
		base:id "PA1.MA1 - CientistaArretado"
	]
	
	instance PA2.ES : planoAvaliacao:escopo [
		base:descricao "Quantificar o número soluções validadas ao final do período do projeto (desenvolvidas ou em fase piloto)"
		base:id "PA2.ES - CientistaArretado"
	]
	instance PA2.MA1 : planoAvaliacao:metodoAvaliacao [
		base:descricao "Análise longitudinal e descritiva"
		base:id "PA2.MA1 - CientistaArretado"
	]
	

		planoAvaliacao:risco "Baixo"
		planoAvaliacao:temMetrica PA8.ME1, PA8.ME2, PA8.ME3, PA8.ME4
		planoAvaliacao:temEscopo PA8.ES
		planoAvaliacao:temMetodologia PA8.MA1
		planoAvaliacao:temLimitacao LIM1
		planoAvaliacao:alinhaComResultado CientistaArretado:RE.CP3
	]
	instance PA9 : planoAvaliacao:questaoAvaliacao [
		base:nome "Quais instrumentos de gestão ou estruturas (ex: portais de dados, núcleos de análise, etc.) foram criados ou aprimorados a partir dos projetos?"
		base:id "PA9 - CientistaArretado"
		planoAvaliacao:custo "Alto"
		planoAvaliacao:risco "Alto"
		planoAvaliacao:temMetrica PA9.ME1, PA9.ME2
		planoAvaliacao:temEscopo PA9.ES
		planoAvaliacao:temMetodologia PA9.MA1
		planoAvaliacao:temLimitacao LIM2

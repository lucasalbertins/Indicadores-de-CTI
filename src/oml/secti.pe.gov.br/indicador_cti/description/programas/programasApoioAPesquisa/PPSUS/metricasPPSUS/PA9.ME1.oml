description <http://secti.pe.gov.br/indicador_cti/description/programas/programasApoioAPesquisa/PPSUS/metricasPPSUS/PA9.ME1#> as PA9.ME1 {
	
	extends <http://secti.pe.gov.br/indicador_cti/description/fontesInformacao/fontesSistemasBasesGovernamentais#> as fontesSistemasBasesGovernamentais
	uses <http://secti.pe.gov.br/indicador_cti/vocabulary/DesignAvaliacao/metricas#> as metricas
	uses <http://secti.pe.gov.br/indicador_cti/vocabulary/DesignAvaliacao/formulas#> as formulas
	uses <http://secti.pe.gov.br/indicador_cti/vocabulary/base#> as base
	uses <http://www.w3.org/2001/XMLSchema#> as xsd

	// ESTRATIFICAÇÕES (Dimensões de Desagregação)
	instance estratEdital : formulas:estratificacao [
		base:id "estrat_edital_PA9.ME1"
		base:nome "Edital/Ano"
	]

	instance estratRde : formulas:estratificacao [
		base:id "estrat_rde_PA9.ME1"
		base:nome "Região de Desenvolvimento do Estado"
	]

	// MÉTRICA: Total de Integrantes dos Projetos
	instance totalIntegrantes : metricas:metrica [
		base:id "PA9.ME1_PPSUS"
		base:nome "Total de Integrantes dos Projetos"
		base:descricao "Número total de integrantes dos projetos apoiados pelo Programa"
		metricas:finalidade "Maximizar"
		formulas:possuiFormula formulaIdentidadePA9ME1
		formulas:estratificadaPor estratEdital
		formulas:estratificadaPor estratRde
		metricas:temFonte fontesSistemasBasesGovernamentais:FI2.1
	]

	// retorna o valor da fonte de dados
	instance formulaIdentidadePA9ME1 : formulas:formula [
		base:id "formula_identidade_PA9.ME1"
		formulas:referenciaOperacao "http://www.openmath.org/cd/fns1#identity"
		formulas:possuiArgumento varFontePA9ME1
		formulas:formulaDe totalIntegrantes
	]

	instance varFontePA9ME1 : formulas:argumento [
		base:id "arg_fontepa9me1_PA9.ME1"
		formulas:posicao "1"^^xsd:int
		formulas:nome "Total de Integrantes dos Projetos"
		formulas:possuiValor AgilFap_Integrantes_Total
		formulas:argumentoDe formulaIdentidadePA9ME1
	]

	instance AgilFap_Integrantes_Total : formulas:tipovalorMetrica [
		base:id "AgilFapIntegrantesTotal_PA9.ME1"
		formulas:valorMetrica totalIntegrantes
	]
	
}
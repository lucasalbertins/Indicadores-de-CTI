description <http://secti.pe.gov.br/indicador_cti/description/programas/programasApoioAPesquisa/PPSUS/metricasPPSUS/PA10.ME1#> as PA10.ME1 {
	
	extends <http://secti.pe.gov.br/indicador_cti/description/fontesInformacao/fontesSistemasBasesGovernamentais#> as fontesSistemasBasesGovernamentais
	uses <http://secti.pe.gov.br/indicador_cti/vocabulary/DesignAvaliacao/metricas#> as metricas
	uses <http://secti.pe.gov.br/indicador_cti/vocabulary/DesignAvaliacao/formulas#> as formulas
	uses <http://secti.pe.gov.br/indicador_cti/vocabulary/base#> as base
	uses <http://www.w3.org/2001/XMLSchema#> as xsd

	// ESTRATIFICAÇÕES (Dimensões de Desagregação)
	instance estratEdital : formulas:estratificacao [
		base:id "estrat_edital_PA10.ME1"
		base:nome "Edital/Ano"
	]

	instance estratEixo : formulas:estratificacao [
		base:id "estrat_eixo_PA10.ME1"
		base:nome "Eixo Temático"
	]

	instance estratRde : formulas:estratificacao [
		base:id "estrat_rde_PA10.ME1"
		base:nome "Região de Desenvolvimento do Estado"
	]

	// MÉTRICA: Projetos que Contemplam PCD
	instance projetosComPCD : metricas:metrica [
		base:id "PA10.ME1_PPSUS"
		base:nome "Projetos que Contemplam PCD"
		base:descricao "Número de projetos que contemplam pessoas com deficiência (PCD)"
		metricas:finalidade "Maximizar"
		formulas:possuiFormula formulaIdentidadePA10ME1
		formulas:estratificadaPor estratEdital
		formulas:estratificadaPor estratEixo
		formulas:estratificadaPor estratRde
		metricas:temFonte fontesSistemasBasesGovernamentais:FI2.1
	]

	// retorna o valor da fonte de dados
	instance formulaIdentidadePA10ME1 : formulas:formula [
		base:id "formula_identidade_PA10.ME1"
		formulas:referenciaOperacao "http://www.openmath.org/cd/fns1#identity"
		formulas:possuiArgumento varFontePA10ME1
		formulas:formulaDe projetosComPCD
	]

	instance varFontePA10ME1 : formulas:argumento [
		base:id "arg_fontepa10me1_PA10.ME1"
		formulas:posicao "1"^^xsd:int
		formulas:nome "Projetos que Contemplam PCD"
		formulas:possuiValor AgilFap_Projetos_PCD
		formulas:argumentoDe formulaIdentidadePA10ME1
	]

	instance AgilFap_Projetos_PCD : formulas:tipovalorMetrica [
		base:id "AgilFapProjetosPCD_PA10.ME1"
		formulas:valorMetrica projetosComPCD
	]
	
}
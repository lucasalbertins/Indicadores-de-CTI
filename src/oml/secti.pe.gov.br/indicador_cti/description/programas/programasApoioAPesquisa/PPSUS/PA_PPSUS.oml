		metricas:temFonte fontesSistemasBasesGovernamentais:FI2.1
	]
	instance PA18.ME4 : metricas:metrica [
		base:nome "Participação Recursos no Interior"
		base:descricao "Participação dos recursos financeiros alocados em projetos no interior do estado: percentual do volume de recursos alocados em projetos no 
		interior do estado, por edital/ano e eixo temático"
		base:id "PA18.ME4 - PPSUS"
		metricas:temFonte fontesSistemasBasesGovernamentais:FI2.1
	]


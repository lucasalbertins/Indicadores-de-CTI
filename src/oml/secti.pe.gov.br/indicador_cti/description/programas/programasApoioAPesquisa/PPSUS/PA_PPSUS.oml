		base:descricao "Taxa de articulação interestadual do PPSUS-PE: percentual de projetos apoiados que envolveram pelo menos uma instituição de fora do 
		estado, por edital/ano e eixo temático"
		base:id "PA17.ME2 - PPSUS"
		metricas:temFonte fontesSistemasBasesGovernamentais:FI2.1, fontesSistemasBasesGovernamentais:FI2.9, fontesDadosPrimarios:FI1.1
	]

	instance PA18.ME1 : metricas:metrica [
		base:nome "Quantidade Projetos por Localização"
		base:descricao "Número de projetos apoiados pelo Programa, total e por localização da instituição proponente (RMR e interior do estado), por edital/ano e 
		eixo temático"

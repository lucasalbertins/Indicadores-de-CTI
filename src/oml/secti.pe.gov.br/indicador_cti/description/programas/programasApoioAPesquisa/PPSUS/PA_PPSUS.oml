		base:id "PA12.ME1 - PPSUS"
		metricas:temFonte fontesSistemasBasesGovernamentais:FI2.1
	]
	instance PA12.ME2 : metricas:metrica [
		base:nome "Taxa de Equidade Étnico-Racial"
		base:descricao "Taxa de equidade étnico-racial nos Projetos: número de projetos que contemplam integrantes negros, indígenas e/ou quilombolas em relação 
		ao total de projetos apoiados, por edital/ano e Região de Desenvolvimento do Estado (RDE)"
		base:id "PA12.ME2 - PPSUS"
		metricas:temFonte fontesSistemasBasesGovernamentais:FI2.1
	]

	instance PA13.ME1 : metricas:metrica [
		base:nome "Taxa Participação de Pernambuco no PPSUS Brasil"
		base:descricao "Taxa de participação de Pernambuco nos projetos de pesquisa em saúde apoiados pelo PPSUS Brasil: número de projetos apoiados em 
		Pernambuco em relação ao total de projetos apoiados no Brasil (somatório de todos os estados participantes do PPSUS), por edital/ano e Região de 
		Desenvolvimento do Estado (RDE)"
		base:id "PA13.ME1 - PPSUS"
		metricas:temFonte fontesSistemasBasesGovernamentais:FI2.1, fontesSistemasBasesGovernamentais:FI2.12
	]

	instance PA14.ME1 : metricas:metrica [
		base:nome "Índice de Disseminação Técnica"
		base:descricao "Índice de Disseminação Técnica: quantidade de notas técnicas, cartilhas operacionais, workshops institucionais e capacitações executadas 
		direcionadas ao corpo técnico do SUS, por edital/ano e Região de Desenvolvimento do Estado (RDE)"
		base:id "PA14.ME1 - PPSUS"
		metricas:temFonte fontesDadosPrimarios:FI1.1, fontesSistemasBasesGovernamentais:FI2.9
	]

	instance PA15.ME1 : metricas:metrica [
		base:nome "Índice de Incorporação de Resultados"
		base:descricao "Índice de Incorporação dos Resultados em Protocolos do SES-PE: proporção de resultados de projetos concluídos que se transformaram em 
		insumos de novos protocolos clínicos, diretrizes terapêuticas ou rotinas administrativas homologadas pelo SUS até 2 anos após o encerramento dos projetos. 
		Observação: o coordenador do projeto deve sinalizar ao gestor da saúde (programa, política ou serviço) o que e como serão articuladas as ações para 
		incorporação dos resultados"
		base:id "PA15.ME1 - PPSUS"
		metricas:temFonte fontesDadosPrimarios:FI1.1, fontesSistemasBasesGovernamentais:FI2.9
	]


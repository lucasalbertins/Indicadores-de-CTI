		base:nome "Instituições Articuladas em Pernambuco"
		base:descricao "Número de instituições (IES, ICT, empresas e outras) localizadas em Pernambuco articuladas nos projetos apoiados pelo Programa, por 
		edital/ano, eixo temático e Região de Desenvolvimento do Estado"
		base:id "PA16.ME1 - PPSUS"
		metricas:temFonte fontesSistemasBasesGovernamentais:FI2.1, fontesSistemasBasesGovernamentais:FI2.9, fontesDadosPrimarios:FI1.1
	]
	instance PA16.ME2 : metricas:metrica [
		base:nome "Taxa Articulação Intraestadual"
		base:descricao "Taxa de articulação intraestadual do PPSUS-PE: percentual de projetos apoiados que envolveram mais de uma instituição (IES, ICT, empresas 
		e outras) localizadas em Pernambuco em relação ao total de projetos apoiados, por edital/ano e eixo temático"
		base:id "PA16.ME2 - PPSUS"
		metricas:temFonte fontesSistemasBasesGovernamentais:FI2.1, fontesSistemasBasesGovernamentais:FI2.9, fontesDadosPrimarios:FI1.1
	]

	instance PA17.ME1 : metricas:metrica [
		base:nome "Instituições Articuladas Fora de Pernambuco"
		base:descricao "Número de instituições (IES, ICT, empresas e outras) localizadas fora de Pernambuco articuladas nos projetos apoiados pelo Programa, por 
		edital/ano, eixo temático e UF de origem"
		base:id "PA17.ME1 - PPSUS"
		metricas:temFonte fontesSistemasBasesGovernamentais:FI2.1, fontesSistemasBasesGovernamentais:FI2.9, fontesDadosPrimarios:FI1.1
	]
	instance PA17.ME2 : metricas:metrica [

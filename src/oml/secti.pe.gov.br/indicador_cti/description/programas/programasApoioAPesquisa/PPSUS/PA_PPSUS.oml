	uses <http://www.w3.org/2001/XMLSchema#> as xsd

	instance PAV14 : planoAvaliacao:planoAvaliacao [
		base:nome "Plano de Avaliação do Programa Pesquisa para o SUS: gestão compartilhada em saúde (PPSUS-PE)"
		base:id "PA-PR14"
		base:versao "V1-Homologado"
		base:dataCriacao "2026-08-21T00:00:00"^^xsd:dateTime
		planoAvaliacao:temQuestaoAvaliacao PA1, PA2, PA3, PA4, PA5, PA6, PA7, PA8, PA9, PA10, PA11, PA12, PA13, PA14, PA15, PA16, PA17, PA18
	]

	// Perguntas de Avaliação (PA)

	instance PA1 : planoAvaliacao:questaoAvaliacao [
		base:nome "Qual a evolução da demanda bruta (propostas/projetos submetidos) no PPSUS em Pernambuco?"

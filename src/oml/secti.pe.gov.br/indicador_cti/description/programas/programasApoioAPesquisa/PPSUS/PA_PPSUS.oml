	//===================================================================
	// Métricas (ME) e Fontes de Informação (FI)
	//===================================================================

	instance PA1.ME1 : metricas:metrica [
		base:nome "Quantidade Propostas Submetidas"
		base:descricao "Quantidade de propostas/projetos de pesquisa submetidos no PPSUS em Pernambuco por edital/ano, eixos prioritários, faixas de fomento e Região 
de Desenvolvimento de Pernambuco (RDE). Observação: para fins de avaliação do PPSUS-PE cada projeto de pesquisa representa um grupo de pesquisadores ou 
um grupo de pesquisa"
		base:id "PA1.ME1 - PPSUS"
		metricas:temFonte fontesSistemasBasesGovernamentais:FI2.1
	]

	instance PA2.ME1 : metricas:metrica [
		base:nome "Quantidade Grupos de Pesquisa Apoiados"
		base:descricao "Quantidade de projetos de pesquisa (grupos de pesquisa) apoiados por edital/ano, eixos prioritários, faixas de fomento e Região de 
Desenvolvimento de Pernambuco (RDE)"
		base:id "PA2.ME1 - PPSUS"
		metricas:temFonte fontesSistemasBasesGovernamentais:FI2.1
	]

	instance PA3.ME1 : metricas:metrica [
		base:nome "Volume Recursos Aprovados"
		base:descricao "Volume de recursos aprovados para os projetos apoiados por edital/ano, eixos prioritários, faixas de fomento e Região de Desenvolvimento de 
		Pernambuco (RDE)"
		base:id "PA3.ME1 - PPSUS"
		metricas:temFonte fontesSistemasBasesGovernamentais:FI2.1
	]
	instance PA3.ME2 : metricas:metrica [
		base:nome "Volume Recursos Executados"
		base:descricao "Volume de recursos executados pelos projetos apoiados ao final de execução por edital/ano e eixos prioritários, faixas de fomento e Região de 
		Desenvolvimento de Pernambuco (RDE)"
		base:id "PA3.ME2 - PPSUS"
		metricas:temFonte fontesSistemasBasesGovernamentais:FI2.1
	]

	instance PA4.ME1 : metricas:metrica [
		base:nome "Publicações Científicas Geradas"
		base:descricao "Número de publicações científicas geradas a partir dos projetos apoiados: total anual e acumulado da produção científica resultante dos 
		projetos (até 2 anos após o encerramento do projeto), por edital/ano, por eixos temáticos e Região de Desenvolvimento do Estado (RDE). Observação: tratam-se de 
		artigos científicos publicados em periódicos, livros e capítulos de livros"
		base:id "PA4.ME1 - PPSUS"
		metricas:temFonte fontesDadosPrimarios:FI1.1, fontesSistemasBasesGovernamentais:FI2.1, fontesBasesAcademicasCientificasEducacionais:FI3.2
	]
	instance PA4.ME2 : metricas:metrica [
		base:nome "TCC Dissertações e Teses Geradas"
		base:descricao "Número de TCC, dissertações e teses geradas por meio do Programa: total anual e acumulado de TCC, dissertações e teses defendidas 
		resultantes dos projetos apoiados pelo Programa, até 2 anos após o encerramento do projeto, por edital/ano, por eixos temáticos e Região de Desenvolvimento do 
		Estado (RDE)"
		base:id "PA4.ME2 - PPSUS"
		metricas:temFonte fontesDadosPrimarios:FI1.1, fontesSistemasBasesGovernamentais:FI2.1, fontesBasesAcademicasCientificasEducacionais:FI3.1, 
		fontesBasesAcademicasCientificasEducacionais:FI3.2
	]

	instance PA5.ME1 : metricas:metrica [
		base:nome "Tecnologias e Inovações Geradas"
		base:descricao "Tecnologias e inovações geradas: número de tecnologias e inovações (produtos, processos, serviços) geradas a partir dos projetos apoiados 
		pelo PPSUS-PE, por edital/ano, por eixo temático e Região de Desenvolvimento do Estado (RDE), segundo categorias selecionadas.
		
		Categorias selecionadas (taxonomia do anexo): TT01 Tecnologias Diagnósticas; TT02 Medicamentos, Biofármacos e Terapias; TT03 Tecnologias Digitais e Sistemas 
		de Informação em Saúde; TT04 Tecnologias Organizacionais e de Gestão do SUS; TT05 Protocolos Clínicos e Tecnologias Assistenciais; TT06 Tecnologias para 
		Vigilância Epidemiológica e Saúde Pública; TT07 Tecnologias Educacionais e Tecnologias Sociais em Saúde; TT08 Métodos, Modelos e Ferramentas Analíticas"
		base:id "PA5.ME1 - PPSUS"
		metricas:temFonte fontesDadosPrimarios:FI1.1, fontesSistemasBasesGovernamentais:FI2.1
	]
	instance PA5.ME2 : metricas:metrica [
		base:nome "Taxa de Inovação por Edital"
		base:descricao "Taxa de inovação por edital/ano: número de projetos que geraram tecnologias e inovações (produto, processo e serviço) em relação ao total de 
		projetos apoiados pelo programa por edital/ano, por eixo temático e Região de Desenvolvimento do Estado (RDE)."
		base:id "PA5.ME2 - PPSUS"
		metricas:temFonte fontesDadosPrimarios:FI1.1, fontesSistemasBasesGovernamentais:FI2.1
	]

	instance PA6.ME1 : metricas:metrica [
		base:nome "Quantidade PI Geradas"
		base:descricao "Quantidade PI geradas: número de produtos de Propriedade Intelectual (PI) gerados pelos projetos apoiados pelo PPSUS-PE por tipo da 
		propriedade intelectual (patente, programa de computador, desenho industrial, marca, cultivares, etc.), por edital/ano, eixo temático e Região de Desenvolvimento 
		do Estado (RDE)"
		base:id "PA6.ME1 - PPSUS"
		metricas:temFonte fontesDadosPrimarios:FI1.1, fontesSistemasBasesGovernamentais:FI2.1, fontesSistemasBasesGovernamentais:FI2.9
	]
	instance PA6.ME2 : metricas:metrica [
		base:nome "Taxa de PI Geradas"
		base:descricao "Taxa de PI geradas: proporção de projetos que geraram produtos de Propriedade Intelectual (PI) por tipo da propriedade intelectual (patente, 
		programa de computador, desenho industrial, marca, cultivares, partituras etc.) em relação ao total de projetos apoiados pelo PPSUS-PE, por edital/ano, eixo 
		temático e Região de Desenvolvimento do Estado (RDE)"
		base:id "PA6.ME2 - PPSUS"
		metricas:temFonte fontesDadosPrimarios:FI1.1, fontesSistemasBasesGovernamentais:FI2.1, fontesSistemasBasesGovernamentais:FI2.9
	]

	instance PA7.ME1 : metricas:metrica [
		base:nome "Pesquisadores Relacionados por Edital"
		base:descricao "Pesquisadores diretamente relacionados nos projetos por edital/ano: número de integrantes dos projetos apoiados pelo Programa segundo a 
		função/posição no projeto, desagregado por nacionalidade (brasileiro ou estrangeiro), edital/ano, por eixo temático e Região de Desenvolvimento do Estado (RDE).
		Função/posição no projeto: 1. Pesquisador (1.1 Coordenador; 1.2 Coordenador substituto/vice; 1.3 Pesquisador integrante, com horas de dedicação semanal; 1.4 
		Pesquisador consultor, participação pontual/eventual/estratégica/consultiva); 2. Aluno/estudante (2.1 Graduação; 2.2 Mestrado; 2.3 Doutorado; 2.4 Pós-doutorado); 
		3. Técnico.
		
		Observação: o projeto de pesquisa apoiado pelo PPSUS pode representar uma parte de uma pesquisa maior e pode utilizar outras fontes de recursos para custeio, 
		capital e bolsas não declarados na proposta aprovada"
		base:id "PA7.ME1 - PPSUS"
		metricas:temFonte fontesSistemasBasesGovernamentais:FI2.1, fontesSistemasBasesGovernamentais:FI2.9
	]
	instance PA7.ME2 : metricas:metrica [
		base:nome "Pesquisadores Relacionados Acumulado"
		base:descricao "Pesquisadores diretamente relacionados nos projetos acumulado no Programa: número de integrantes dos projetos apoiados pelo Programa, 
		segundo a qualificação técnica no projeto (pesquisador-coordenador, pesquisador-integrante, aluno e/ou técnico), acumulado por edital/ano, considerando 
		diferentes CPF, eixo temático e desagregado por Região de Desenvolvimento do Estado (RDE)"
		base:id "PA7.ME2 - PPSUS"
		metricas:temFonte fontesSistemasBasesGovernamentais:FI2.1, fontesSistemasBasesGovernamentais:FI2.9
	]

	instance PA8.ME1 : metricas:metrica [
		base:nome "Quantidade Estudantes Pós-Graduação"
		base:descricao "Número total de estudantes de pós-graduação integrantes dos projetos apoiados pelo Programa por modalidade acadêmica (mestrado e 
		doutorado), edital/ano, eixo temático e Região de Desenvolvimento do Estado (RDE). Observação: os estudantes de pós-graduação integrantes dos projetos 
		apoiados pelo PPSUS podem ter ou não bolsas de formação diretamente relacionadas ao projeto apoiado"
		base:id "PA8.ME1 - PPSUS"
		metricas:temFonte fontesSistemasBasesGovernamentais:FI2.1, fontesBasesAcademicasCientificasEducacionais:FI3.1
	]
	instance PA8.ME2 : metricas:metrica [
		base:nome "Quantidade Estudantes Titulados"
		base:descricao "Número de estudantes de pós-graduação integrantes dos projetos apoiados pelo Programa que foram titulados até 2 anos após o 
		encerramento do projeto, por modalidade acadêmica (mestrado e doutorado), edital/ano, eixo temático e Região de Desenvolvimento do Estado (RDE)"
		base:id "PA8.ME2 - PPSUS"
		metricas:temFonte fontesSistemasBasesGovernamentais:FI2.1, fontesBasesAcademicasCientificasEducacionais:FI3.1
	]
	instance PA8.ME3 : metricas:metrica [
		base:nome "Taxa Formação RH Alto Nível"
		base:descricao "Taxa de formação de recursos humanos de alto nível no Programa: percentual de estudantes de pós-graduação integrantes dos projetos 
		apoiados que foram titulados até 2 anos após o encerramento do projeto, por modalidade acadêmica (mestrado e doutorado), em relação ao total de integrantes 
		dos projetos, por edital/ano, eixo temático e Região de Desenvolvimento do Estado (RDE)."
		base:id "PA8.ME3 - PPSUS"
		metricas:temFonte fontesSistemasBasesGovernamentais:FI2.1, fontesBasesAcademicasCientificasEducacionais:FI3.1
	]

	instance PA9.ME1 : metricas:metrica [
		base:nome "Quantidade Total Integrantes"
		base:descricao "Número total de integrantes dos projetos apoiados pelo Programa, por edital/ano e Região de Desenvolvimento do Estado (RDE)"
		base:id "PA9.ME1 - PPSUS"
		metricas:temFonte fontesSistemasBasesGovernamentais:FI2.1
	]
	instance PA9.ME2 : metricas:metrica [
		base:nome "Integrantes com Vínculo Formal SUS"
		base:descricao "Número total de integrantes dos projetos apoiados pelo Programa, por edital/ano e Região de Desenvolvimento do Estado (RDE), que 
		possuíam vínculo formal no Sistema de Atenção de Saúde do Estado em Pernambuco"
		base:id "PA9.ME2 - PPSUS"
		metricas:temFonte fontesSistemasBasesGovernamentais:FI2.1, fontesSistemasBasesGovernamentais:FI2.13
	]
	instance PA9.ME3 : metricas:metrica [
		base:nome "Taxa Fixação RH Qualificados"
		base:descricao "Taxa de Fixação de RH qualificados no Sistema de Atenção de Saúde de Pernambuco: proporção percentual de integrantes dos projetos que 
		mantinham vínculo formal no Sistema de Atenção de Saúde do Estado em Pernambuco após 2 anos do fim do projeto, por edital/ano e Região de Desenvolvimento 
		do Estado (RDE)."
		base:id "PA9.ME3 - PPSUS"
		metricas:temFonte fontesSistemasBasesGovernamentais:FI2.1, fontesSistemasBasesGovernamentais:FI2.13
	]

	instance PA10.ME1 : metricas:metrica [
		base:nome "Quantidade Projetos com PCD"
		base:descricao "Número de projetos que contemplam PCD, por edital/ano, eixo temático e Região de Desenvolvimento do Estado (RDE)"
		base:id "PA10.ME1 - PPSUS"
		metricas:temFonte fontesSistemasBasesGovernamentais:FI2.1
	]
	instance PA10.ME2 : metricas:metrica [
		base:nome "Taxa de Inclusão de PCD"
		base:descricao "Taxa de inclusão de PCD nos Projetos: número de projetos apoiados com integrantes PCD em relação ao total de projetos apoiados, por 
		edital/ano, eixos temáticos e Região de Desenvolvimento do Estado (RDE)"
		base:id "PA10.ME2 - PPSUS"
		metricas:temFonte fontesSistemasBasesGovernamentais:FI2.1
	]

	instance PA11.ME1 : metricas:metrica [
		base:nome "Taxa Participação de Mulheres"
		base:descricao "Taxa de proporção média da participação de mulheres nos projetos apoiados pelo Programa, por edital/ano, por eixos temáticos e Região de 
		Desenvolvimento do Estado (RDE)"
		base:id "PA11.ME1 - PPSUS"
		metricas:temFonte fontesSistemasBasesGovernamentais:FI2.1
	]

	instance PA12.ME1 : metricas:metrica [
		base:nome "Quantidade Projetos com Equidade Étnico-Racial"

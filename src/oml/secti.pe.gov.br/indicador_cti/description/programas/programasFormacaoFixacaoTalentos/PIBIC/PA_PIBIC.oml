description <http://secti.pe.gov.br/indicador_cti/description/programas/programasFormacaoFixacaoTalentos/PIBIC/PA_PIBIC#> as PA_PIBIC {
	
	extends <http://secti.pe.gov.br/indicador_cti/description/fontesInformacao/fontesDadosPrimarios#> as fontesDadosPrimarios
	extends <http://secti.pe.gov.br/indicador_cti/description/fontesInformacao/fontesSistemasBasesGovernamentais#> as fontesSistemasBasesGovernamentais
	extends <http://secti.pe.gov.br/indicador_cti/description/fontesInformacao/fontesBasesAcademicasCientificasEducacionais#> as fontesBasesAcademicasCientificasEducacionais
	extends <http://secti.pe.gov.br/indicador_cti/description/fontesInformacao/fontesInfraestruturaAtivosCTI#> as fontesInfraestruturaAtivosCTI	
	extends <http://secti.pe.gov.br/indicador_cti/description/programas/programasFormacaoFixacaoTalentos/PIBIC/PIBIC#> as PIBIC
	uses <http://secti.pe.gov.br/indicador_cti/vocabulary/base#> as base
	uses <http://secti.pe.gov.br/indicador_cti/vocabulary/DesignAvaliacao/planoAvaliacao#> as planoAvaliacao
	uses <http://secti.pe.gov.br/indicador_cti/vocabulary/DesignAvaliacao/metricas#> as metricas
	
	instance PA1 : planoAvaliacao:questaoAvaliacao [
		base:nome "Qual a evolução da produção científica dos bolsistas PIBIC e dos orientadores (Jovens doutores), considerando da concessão até a conclusão do curso de graduação?"
		base:id "PA1 - PIBIC"
		planoAvaliacao:custo "Alto"
		planoAvaliacao:risco "Alto"
		planoAvaliacao:temMetrica PA1.ME1, PA1.ME2, PA1.ME3, PA1.ME4, PA1.ME5
		planoAvaliacao:temEscopo PA1.ES
		planoAvaliacao:temMetodologia PA1.MA1
		planoAvaliacao:temLimitacao LIM1
		planoAvaliacao:alinhaComResultado PIBIC:RE.CP1
	]
	
	instance PA2 : planoAvaliacao:questaoAvaliacao [
		base:nome "Qual a taxa de evasão dos bolsistas PIBIC em relação a evasão geral?"
		base:id "PA2 - PIBIC"
		planoAvaliacao:custo "Médio"
		planoAvaliacao:risco "Médio"
		planoAvaliacao:temMetrica PA2.ME1, PA2.ME2, PA2.ME3
		planoAvaliacao:temEscopo PA2.ES
		planoAvaliacao:temMetodologia PA2.MA1
		planoAvaliacao:alinhaComResultado PIBIC:RE.CP2
	]
	
	instance PA3 : planoAvaliacao:questaoAvaliacao [
		base:nome "Qual a taxa de titulação dos bolsistas PIBIC em relação à taxa de sucesso do curso ao qual o bolsista é vinculado?"
		base:id "PA3 - PIBIC"
		planoAvaliacao:custo "Médio"
		planoAvaliacao:risco "Médio"
		planoAvaliacao:temMetrica PA3.ME1, PA3.ME2, PA3.ME3
		planoAvaliacao:temEscopo PA3.ES
		planoAvaliacao:temMetodologia PA3.MA1, PA3.MA2
		planoAvaliacao:temLimitacao LIM2
		planoAvaliacao:alinhaComResultado PIBIC:RE.CP3
	]
	
	instance PA4 : planoAvaliacao:questaoAvaliacao [
		base:nome "Qual o percentual de egressos PIBIC matriculados em programas de pós-graduação (acadêmico ou profissional), considerando o periodo de dois anos após titulação?"
		base:id "PA4 - PIBIC"
		planoAvaliacao:custo "Médio"
		planoAvaliacao:risco "Médio"
		planoAvaliacao:temMetrica PA4.ME1, PA4.ME2, PA4.ME3, PA4.ME4
		planoAvaliacao:temEscopo PA4.ES
		planoAvaliacao:temMetodologia PA4.MA1, PA4.MA4
		planoAvaliacao:alinhaComResultado PIBIC:RE.MP1
	]
	
	instance PA5 : planoAvaliacao:questaoAvaliacao [
		base:nome "Qual a evolução da proporção de bolsistas PIBIC egressos que migraram para cursos de doutorado, considerando o período de dois anos após titulação?"
		base:id "PA5 - PIBIC"
		planoAvaliacao:custo "Médio"
		planoAvaliacao:risco "Médio"
		planoAvaliacao:temMetrica PA5.ME1, PA5.ME2, PA5.ME3, PA5.ME4
		planoAvaliacao:temEscopo PA5.ES
		planoAvaliacao:temMetodologia PA5.MA1, PA5.MA4
		planoAvaliacao:alinhaComResultado PIBIC:RE.MP2
	]
	
	instance PA6 : planoAvaliacao:questaoAvaliacao [
		base:nome "Qual a evolução da empregabilidade do bolsista PIBIC em setor público/privado ou empreendedorismo, considerando o período de mais de dois anos após titulação?"
		base:id "PA6 - PIBIC"
		planoAvaliacao:custo "Médio"
		planoAvaliacao:risco "Médio"
		planoAvaliacao:temMetrica PA6.ME1, PA6.ME2
		planoAvaliacao:temEscopo PA6.ES
		planoAvaliacao:temMetodologia PA6.MA1, PA6.MA4
		planoAvaliacao:alinhaComResultado PIBIC:RE.LP2
	]
	
	instance PA7 : planoAvaliacao:questaoAvaliacao [
		base:nome "Qual a evolução da participação de bolsistas PIBIC egresso que ingressaram em programas de doutorado?"
		base:id "PA7 - PIBIC"
		planoAvaliacao:custo "Alto"
		planoAvaliacao:risco "Médio"
		planoAvaliacao:temMetrica PA7.ME1, PA7.ME2, PA7.ME3, PA7.ME4
		planoAvaliacao:temEscopo PA7.ES
		planoAvaliacao:temMetodologia PA7.MA1, PA7.MA4
		planoAvaliacao:alinhaComResultado PIBIC:RE.LP1
	]
	
	//Métricas PA1
	instance PA1.ME1 : metricas:metrica [
		base:nome "Quantidade Produção Científica Bolsistas"
		base:descricao "Número anual da produção científica em geral dos bolsistas PIBIC desagregado pela grande área do conhecimento FACEPE, ações afirmativas e região de desenvolvimento (RDE)"
		base:id "PA1.ME1 - PIBIC"
		metricas:temFonte fontesSistemasBasesGovernamentais:FI2.1, fontesBasesAcademicasCientificasEducacionais:FI3.2, fontesBasesAcademicasCientificasEducacionais:FI3.3
	]
	instance PA1.ME2 : metricas:metrica [
		base:nome "Quantidade Publicações Periódicos Bolsistas"
		base:descricao "Número anual de publicações em periódicos em geral dos bolsistas PIBIC desagregado pela grande área do conhecimento FACEPE, ações afirmativas e RDE"
		base:id "PA1.ME2 - PIBIC"
		metricas:temFonte fontesSistemasBasesGovernamentais:FI2.1, fontesBasesAcademicasCientificasEducacionais:FI3.2, fontesBasesAcademicasCientificasEducacionais:FI3.3
	]
	instance PA1.ME3 : metricas:metrica [
		base:nome "Quantidade Publicações Eventos Bolsistas"
		base:descricao "Número anual de publicações em anais de eventos dos bolsistas PIBIC desagregado por grande área de conhecimento FACEPE, ações afirmativas RDE"
		base:id "PA1.ME3 - PIBIC"
		metricas:temFonte fontesSistemasBasesGovernamentais:FI2.1, fontesBasesAcademicasCientificasEducacionais:FI3.2, fontesBasesAcademicasCientificasEducacionais:FI3.3
	]
	instance PA1.ME4 : metricas:metrica [
		base:nome "Quantidade Produção Científica Docente Jovem"
		base:descricao "Número anual da produção científica em geral dos docentes orientadores jovens doutores com até oito anos de conclusão do doutorado, desagregado por grande área do conhecimento FACEPE e RDE"
		base:id "PA1.ME4 - PIBIC"
		metricas:temFonte fontesSistemasBasesGovernamentais:FI2.1, fontesBasesAcademicasCientificasEducacionais:FI3.2, fontesBasesAcademicasCientificasEducacionais:FI3.3
	]
	instance PA1.ME5 : metricas:metrica [
		base:nome "Quantidade Publicações Periódicos Docente Jovem"
		base:descricao "Número anual de publicações em periódicos em geral dos docentes orientadores jovens doutores com até oito anos de conclusão do doutorado, desagregado por grande área do conhecimento FACEPE e RDE"
		base:id "PA1.ME5 - PIBIC"
		metricas:temFonte fontesSistemasBasesGovernamentais:FI2.1, fontesBasesAcademicasCientificasEducacionais:FI3.2, fontesBasesAcademicasCientificasEducacionais:FI3.3
	]

	//Métricas PA2
	instance PA2.ME1 : metricas:metrica [
		base:nome "Quantidade Evasão Bolsistas"
		base:descricao "Número anual de bolsistas PIBIC que evadiram do curso vinculado, desagregado pela grande área de conhecimento FACEPE, curso, ações afirmativas e RDE"
		base:id "PA2.ME1 - PIBIC"
		metricas:temFonte fontesSistemasBasesGovernamentais:FI2.1, fontesBasesAcademicasCientificasEducacionais:FI3.5
	]
	instance PA2.ME2 : metricas:metrica [
		base:nome "Taxa Evasão Bolsista"
		base:descricao "Número anual de bolsistas PIBIC que evadiram do curso sobre o número total de bolsistas PIBIC desagregado pela grande área de conhecimento FACEPE, curso, ações afirmativas e RDE"
		base:id "PA2.ME2 - PIBIC"
		metricas:temFonte fontesSistemasBasesGovernamentais:FI2.1, fontesBasesAcademicasCientificasEducacionais:FI3.5
	]
	instance PA2.ME3 : metricas:metrica [
		base:nome "Taxa evasão Bolsista e evasão geral"
		base:descricao "Evolução anual das taxas de evasão dos bolsistas PIBIC e da taxa de evasão do curso ao qual o bolsista pertence desagregado pela grande área de conhecimento FACEPE, curso, ações afirmativas e RDE"
		base:id "PA2.ME3 - PIBIC"
		metricas:temFonte fontesSistemasBasesGovernamentais:FI2.1, fontesBasesAcademicasCientificasEducacionais:FI3.5
	]

	//Métricas PA3
	instance PA3.ME1 : metricas:metrica [
		base:nome "Número Bolsistas Titulados"
		base:descricao "Número anual de bolsistas PIBIC titulados desagregado pela grande área de conhecimento FACEPE, curso, ações afirmativas e RDE"
		base:id "PA3.ME1 - PIBIC"
		metricas:temFonte fontesSistemasBasesGovernamentais:FI2.1, fontesBasesAcademicasCientificasEducacionais:FI3.5
	]
	instance PA3.ME2 : metricas:metrica [
		base:nome "Taxa Bolsista Titulado"
		base:descricao "Proporção de bolsistas PIBIC titulados com relação ao total de alunos concluintes ao qual o bolsista é vinculado, desagregado por ano, curso, ações afirmativas e RDE"
		base:id "PA3.ME2 - PIBIC"
		metricas:temFonte fontesSistemasBasesGovernamentais:FI2.1, fontesBasesAcademicasCientificasEducacionais:FI3.5
	]
	instance PA3.ME3 : metricas:metrica [
		base:nome "Taxa evasão Bolsista e evasão geral"
		base:descricao "Evolução anual das taxas de evasão dos bolsistas PIBIC e da taxa de evasão do curso ao qual o bolsista pertence, desagregado pela grande área de conhecimento FACEPE, curso, ações afirmativas e RDE"
		base:id "PA3.ME3 - PIBIC"
		metricas:temFonte fontesSistemasBasesGovernamentais:FI2.1, fontesBasesAcademicasCientificasEducacionais:FI3.5
	]

	//Métricas PA4
	instance PA4.ME1 : metricas:metrica [
		base:nome "Quantidade Egressos Matriculados PPG Acadêmico"
		base:descricao "Número anual de egressos PIBIC, com até dois anos de egresso, matriculados em programas de pós-graduação acadêmico, desagregado por: grande área do conhecimento FACEPE; ações afirmativas; e região de desenvolvimento"
		base:id "PA4.ME1 - PIBIC"
		metricas:temFonte fontesSistemasBasesGovernamentais:FI2.1, fontesBasesAcademicasCientificasEducacionais:FI3.1
	]
	instance PA4.ME2 : metricas:metrica [
		base:nome "Taxa Egressos Matriculados PPG Acadêmico"
		base:descricao "Número de bolsistas egressos PIBIC, com até dois anos de egresso, matriculados em programas de pós-graduação acadêmico em relação ao número total de egressos PIBIC, desagregado por: grande área de conhecimento FACEPE, ações afirmativas e região de desenvolvimento"
		base:id "PA4.ME2 - PIBIC"
		metricas:temFonte fontesSistemasBasesGovernamentais:FI2.1, fontesBasesAcademicasCientificasEducacionais:FI3.1
	]
	instance PA4.ME3 : metricas:metrica [
		base:nome "Quantidade Egressos Matriculados PPG Profissional"
		base:descricao "Número anual de egressos PIBIC, com até dois anos de egresso, matriculados em programas de pós-graduação profissional, desagregado por: grande área do conhecimento FACEPE; ações afirmativas; e região de desenvolvimento"
		base:id "PA4.ME3 - PIBIC"
		metricas:temFonte fontesSistemasBasesGovernamentais:FI2.1, fontesBasesAcademicasCientificasEducacionais:FI3.1
	]
	instance PA4.ME4 : metricas:metrica [
		base:nome "Taxa Egressos Matriculados PPG Profissional"
		base:descricao "Número de bolsistas egressos PIBIC, com até dois anos de egresso, matriculados em programas de pós-graduação profissional em relação ao número total de egressos PIBIC, desagregado por: grande área de conhecimento FACEPE, ações afirmativas e região de desenvolvimento"
		base:id "PA4.ME4 - PIBIC"
		metricas:temFonte fontesSistemasBasesGovernamentais:FI2.1, fontesBasesAcademicasCientificasEducacionais:FI3.1
	]

	//Métricas PA5
	instance PA5.ME1 : metricas:metrica [
		base:nome "Quantidade Egressos Migrados Doutorado Acadêmico"
		base:descricao "Número anual de egressos PIBIC, com até dois anos de egresso, que migraram para cursos de doutorado acadêmico, desagregado por: grande área do conhecimento FACEPE; ações afirmativas; e região de desenvolvimento"
		base:id "PA5.ME1 - PIBIC"
		metricas:temFonte fontesSistemasBasesGovernamentais:FI2.1, fontesBasesAcademicasCientificasEducacionais:FI3.1
	]
	instance PA5.ME2 : metricas:metrica [
		base:nome "Taxa Egressos Migrados Doutorado Acadêmico"
		base:descricao "Número de bolsistas egressos PIBIC, com até dois anos de egresso, que migraram para cursos de doutorado acadêmico em relação ao número total de matriculados em PPGs acadêmicos, desagregado por: grande área de conhecimento FACEPE, ações afirmativas e região de desenvolvimento"
		base:id "PA5.ME2 - PIBIC"
		metricas:temFonte fontesSistemasBasesGovernamentais:FI2.1, fontesBasesAcademicasCientificasEducacionais:FI3.1
	]
	instance PA5.ME3 : metricas:metrica [
		base:nome "Quantidade Egressos Migrados Doutorado Profissional"
		base:descricao "Número anual de egressos PIBIC, com até dois anos de egresso, que migraram para cursos de doutorado profissional, desagregado por: grande área do conhecimento FACEPE; ações afirmativas; e região de desenvolvimento.(faz sentido?)"
		base:id "PA5.ME3 - PIBIC"
		metricas:temFonte fontesSistemasBasesGovernamentais:FI2.1, fontesBasesAcademicasCientificasEducacionais:FI3.1
	]
	instance PA5.ME4 : metricas:metrica [
		base:nome "Taxa Egressos Migrados Doutorado Profissional"
		base:descricao "Número de bolsistas egressos PIBIC, com até dois anos de egresso, que migraram para cursos de doutorado profissional em relação ao número total de matriculados em PPGS profissional egressos PIBIC, desagregado por: grande área de conhecimento FACEPE, ações afirmativas e região de desenvolvimento"
		base:id "PA5.ME4 - PIBIC"
		metricas:temFonte fontesSistemasBasesGovernamentais:FI2.1, fontesBasesAcademicasCientificasEducacionais:FI3.1
	]

	//Métricas PA6
	instance PA6.ME1 : metricas:metrica [
		base:nome "Quantidade Egressos Empregados"
		base:descricao "Número anual de egressos bolsistas PIBIC que estão empregados formalmente no período de mais de dois anos após o final do curso, desagregado por ano, ações afirmativas, grande área FACEPE e setor do vínculo"
		base:id "PA6.ME1 - PIBIC"
		metricas:temFonte fontesSistemasBasesGovernamentais:FI2.1, fontesSistemasBasesGovernamentais:FI2.2
	]
	instance PA6.ME2 : metricas:metrica [
		base:nome "Taxa Egressos Empregados"
		base:descricao "Número anual de bolsista PIBIC egressos que estão empregados formalmente no período de mais de dois anos após o final do curso em relação ao total de bolsistas egressos no mesmo período desagregado por: ano, grande área FACEPE, ações afirmativas e setor do vínculo"
		base:id "PA6.ME2 - PIBIC"
		metricas:temFonte fontesSistemasBasesGovernamentais:FI2.1, fontesSistemasBasesGovernamentais:FI2.2
	]

	//Métricas PA7
	instance PA7.ME1 : metricas:metrica [
		base:nome "Quantidade Egressos Matriculados Doutorado Acadêmico"
		base:descricao "Número anual de egressos PIBIC, com mais de dois anos de egresso, que estão matriculados em cursos de doutorado acadêmico, desagregado por: grande área do conhecimento FACEPE; ações afirmativas; região de desenvolvimento e localidade (nacional ou exterior)"
		base:id "PA7.ME1 - PIBIC"
		metricas:temFonte fontesSistemasBasesGovernamentais:FI2.1, fontesBasesAcademicasCientificasEducacionais:FI3.1, fontesBasesAcademicasCientificasEducacionais:FI3.2
	]
	instance PA7.ME2 : metricas:metrica [
		base:nome "Taxa Egressos Matriculados Doutorado Acadêmico"
		base:descricao "Número de bolsistas egressos PIBIC, com mais de dois anos de egresso, que estão matriculados em cursos de doutorado acadêmico em relação ao número total de egressos em mestrados acadêmicos, desagregado por: grande área de conhecimento FACEPE, ações afirmativas e região de desenvolvimento e localidade (nacional ou exterior)"
		base:id "PA7.ME2 - PIBIC"
		metricas:temFonte fontesSistemasBasesGovernamentais:FI2.1, fontesBasesAcademicasCientificasEducacionais:FI3.1, fontesBasesAcademicasCientificasEducacionais:FI3.2
	]
	instance PA7.ME3 : metricas:metrica [
		base:nome "Quantidade Egressos Matriculados Doutorado Profissional"
		base:descricao "Número anual de egressos PIBIC, com mais de dois anos de egresso, que estão matriculados em cursos de doutorado profissional, desagregado por: grande área do conhecimento FACEPE; ações afirmativas; região de desenvolvimento"
		base:id "PA7.ME3 - PIBIC"
		metricas:temFonte fontesSistemasBasesGovernamentais:FI2.1, fontesBasesAcademicasCientificasEducacionais:FI3.1
	]
	instance PA7.ME4 : metricas:metrica [
		base:nome "Taxa Egressos Matriculados Doutorado Profissional"
		base:descricao "Número de bolsistas egressos PIBIC, com mais de dois anos de egresso, que estão matriculados em cursos de doutorado profissional em relação ao número total de egressos em mestrados profissionais, desagregado por: grande área de conhecimento FACEPE, ações afirmativas e região de desenvolvimento"
		base:id "PA7.ME4 - PIBIC"
		metricas:temFonte fontesSistemasBasesGovernamentais:FI2.1, fontesBasesAcademicasCientificasEducacionais:FI3.1
	]

	//Escopos e Métodos de Avaliação
	instance PA1.ES : planoAvaliacao:escopo [
		base:descricao "Espera-se identificar a evolução da quantidade da produção científica dos bolsistas PIBIC, bem como os professores orientadores jovens doutores. A comparação será longitudinal (ao longo dos anos)"
		base:id "PA1.ES - PIBIC"
	]
	instance PA1.MA1 : planoAvaliacao:metodoAvaliacao [
		base:descricao "Análise Descritiva"
		base:id "PA1.MA1 - PIBIC"
	]

	instance PA2.ES : planoAvaliacao:escopo [
		base:descricao "Espera-se identificar a evasão dos bolsistas PIBIC nos cursos de graduação e comparar com a taxa de evasão geral do curso ao qual o bolsista é vinculado. A comparação será longitudinal (ao longo dos anos)"
		base:id "PA2.ES - PIBIC"
	]
	instance PA2.MA1 : planoAvaliacao:metodoAvaliacao [
		base:descricao "Análise Descritiva"
		base:id "PA2.MA1 - PIBIC"
	]

	instance PA3.ES : planoAvaliacao:escopo [
		base:descricao "Espera-se identificar o quantitativo e a evolução de bolsistas PIBIC titulados e a taxa de bolsistas titulados em relação ao concluintes, bem como comparar a evasão do bolsista em relação a evasão geral do curso. A comparação será longitudinal (ao longo dos anos) e transversal entre o grupo tratado (bolsistas PIBIC) e o grupo controle (alunos concluintes dos cursos não bolsista)"
		base:id "PA3.ES - PIBIC"
	]
	instance PA3.MA1 : planoAvaliacao:metodoAvaliacao [
		base:descricao "Análise Descritiva"
		base:id "PA3.MA1 - PIBIC"
	]
	instance PA3.MA2 : planoAvaliacao:metodoAvaliacao [
		base:descricao "Método Econométrico: Propensity Score Matching"
		base:id "PA3.MA2 - PIBIC"
	]

	instance PA4.ES : planoAvaliacao:escopo [
		base:descricao "Espera-se identificar evolução da a quantidade de egressos matriculados em PPGs acadêmico e profissional. A comparação será longitudinal (ao longo dos anos) e transversal entre o grupo tratado (bolsista matriculado) e o grupo de controle (bolsista concluinte)"
		base:id "PA4.ES - PIBIC"
	]
	instance PA4.MA1 : planoAvaliacao:metodoAvaliacao [
		base:descricao "Análise Descritiva"
		base:id "PA4.MA1 - PIBIC"
	]
	instance PA4.MA4 : planoAvaliacao:metodoAvaliacao [
		base:descricao "Método Econométrico: Dados em Painel"
		base:id "PA4.MA4 - PIBIC"
	]

	instance PA5.ES : planoAvaliacao:escopo [
		base:descricao "Espera-se identificar evolução da quantidade de egressos matriculados em PPGs acadêmico e profissional que migraram para cursos de doutorado. A comparação será longitudinal (ao longo dos anos) e transversal entre o grupo tratado (bolsista que migrou) e o grupo de controle (bolsistas matriculados PPG)"
		base:id "PA5.ES - PIBIC"
	]
	instance PA5.MA1 : planoAvaliacao:metodoAvaliacao [
		base:descricao "Análise Descritiva"
		base:id "PA5.MA1 - PIBIC"
	]
	instance PA5.MA4 : planoAvaliacao:metodoAvaliacao [
		base:descricao "Método Econométrico: Dados em Painel"

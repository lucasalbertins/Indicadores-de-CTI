description <http://secti.pe.gov.br/indicador_cti/description/programas/programasFormacaoFixacaoTalentos/BPP/BPP#> as BPP {
	
	extends <http://secti.pe.gov.br/indicador_cti/description/programas/programasFormacaoFixacaoTalentos/BPP/PA_BPP#> as PA_BPP
	extends <http://secti.pe.gov.br/indicador_cti/description/parceirosChave/parceirosGoverno#> as parceirosGoverno
	extends <http://secti.pe.gov.br/indicador_cti/description/parceirosChave/parceirosAgenciasFomento#> as parceirosAgenciasFomento
	extends <http://secti.pe.gov.br/indicador_cti/description/parceirosChave/parceirosAcademiaICTs#> as parceirosAcademiaICTs
	extends <http://secti.pe.gov.br/indicador_cti/description/fatoresExternos/fatoresCenarioEconomico#> as fatoresCenarioEconomico
	extends <http://secti.pe.gov.br/indicador_cti/description/fatoresExternos/fatoresCenarioInstitucionalLegal#> as fatoresCenarioInstitucionalLegal
	extends <http://secti.pe.gov.br/indicador_cti/description/fatoresExternos/fatoresCenarioSocialEducacional#> as fatoresCenarioSocialEducacional
	extends <http://secti.pe.gov.br/indicador_cti/description/fatoresExternos/fatoresDinamicaEcossistema#> as fatoresDinamicaEcossistema
	extends <http://secti.pe.gov.br/indicador_cti/description/entradas/entradasOrcamentoFinanciamento#> as entradasOrcamentoFinanciamento
	extends <http://secti.pe.gov.br/indicador_cti/description/entradas/entradasDadosSistemasPlataformas#> as entradasDadosSistemasPlataformas
	extends <http://secti.pe.gov.br/indicador_cti/description/entradas/entradasCapitalHumano#> as entradasCapitalHumano
	extends <http://secti.pe.gov.br/indicador_cti/description/entradas/entradasInstrumentosLegaisNormativos#> as entradasInstrumentosLegaisNormativos
	extends <http://secti.pe.gov.br/indicador_cti/description/atividadesChave#> as atividadeChave
	extends <http://secti.pe.gov.br/indicador_cti/description/saidas#> as saida
	extends <http://secti.pe.gov.br/indicador_cti/description/publicosAlvo/publicosAcademiaICTs#> as publicosAcademiaICTs
	extends <http://secti.pe.gov.br/indicador_cti/description/publicosAlvo/publicosGovernoInstituicoesPublicas#> as publicosGovernoInstituicoesPublicas
	extends <http://secti.pe.gov.br/indicador_cti/description/publicosAlvo/publicosEmpresasEmpreendedores#> as publicosEmpresasEmpreendedores
	extends <http://secti.pe.gov.br/indicador_cti/description/publicosAlvo/publicosAmbientesInovacao#> as publicosAmbientesInovacao
	extends <http://secti.pe.gov.br/indicador_cti/description/publicosAlvo/publicosSociedadeTerceiroSetor#> as publicosSociedadeTerceiroSetor
	
	uses <http://secti.pe.gov.br/indicador_cti/vocabulary/base#> as base
	uses <http://secti.pe.gov.br/indicador_cti/vocabulary/DesignAvaliacao/canvas#> as canvas
	uses <http://secti.pe.gov.br/indicador_cti/vocabulary/programa#> as programa
	uses <http://www.w3.org/2001/XMLSchema#> as xsd
	
	instance CanvasPR8 : canvas:canvas [
		base:nome "Canvas do Programa Bolsa de Produtividade Pernambucana"
		base:id "C-PR8"
		base:versao "V1-Homologado"
		base:dataCriacao "2026-09-06T00:00:00"^^xsd:dateTime
		
		canvas:possuiParceiros parceirosGoverno:PC1.10, parceirosAgenciasFomento:PC2.5, parceirosAgenciasFomento:PC2.6, parceirosAgenciasFomento:PC2.7, parceirosAgenciasFomento:PC2.9, parceirosAcademiaICTs:PC3.1
		canvas:condicionadoPor fatoresDinamicaEcossistema:FE5.OP1, fatoresDinamicaEcossistema:FE5.OP2, fatoresCenarioEconomico:FE1.AM1, fatoresCenarioInstitucionalLegal:FE2.AM1, fatoresCenarioSocialEducacional:FE4.AM1
		canvas:recebeEntradas entradasOrcamentoFinanciamento:EN1.1, entradasDadosSistemasPlataformas:EN2.1, entradasCapitalHumano:EN3.1, entradasCapitalHumano:EN3.5, entradasCapitalHumano:EN3.7, entradasInstrumentosLegaisNormativos:EN5.1
		canvas:executa atividadeChave:AC1, atividadeChave:AC2, atividadeChave:AC3, atividadeChave:AC4, atividadeChave:AC5, atividadeChave:AC6
		canvas:geraSaidas saida:SA1, saida:SA2, saida:SA3, saida:SA4, saida:SA5, saida:SA6
		canvas:produzResultados RE.CP1, RE.CP2, RE.CP3, RE.CP4, RE.CP5, RE.CP6, RE.CP7, RE.MP1, RE.MP2, RE.LP1, RE.LP2, RE.LP3, RE.LP4
		canvas:buscaAtingirGeral OB.GE
		canvas:buscaAtingirEspecifico OB.ES1, OB.ES2, OB.ES3, OB.ES4, OB.ES5, OB.ES6, OB.ES7, OB.ES8
	]
	
	instance PR8 : programa:programaCTI [
		base:nome "BPP"
		base:descricao "Apoia pesquisadores com notável produção científica, tecnológica ou de inovação em Pernambuco. A modalidade oferece bolsas e adicionais de bancada para aumentar a qualidade da pesquisa e promover a fixação de talentos, especialmente no interior do estado."
		base:id "PR8"
		programa:temCanvas CanvasPR8
		programa:temPlanoAvaliacao PA_BPP:PAV1
	]
	
	// Relações Direcionadas (Públicos-Alvo)
	relation instance CanvasPR8.direcionadoA.PU1.2 : canvas:direcionadoA [
		from CanvasPR8
		to publicosAcademiaICTs:PU1.2
		base:tipo "direto"
	]
	relation instance CanvasPR8.direcionadoA.PU1.8 : canvas:direcionadoA [
		from CanvasPR8
		to publicosAcademiaICTs:PU1.8
		base:tipo "indireto"
	]
	relation instance CanvasPR8.direcionadoA.PU1.14 : canvas:direcionadoA [
		from CanvasPR8
		to publicosAcademiaICTs:PU1.14
		base:tipo "indireto"
	]
	relation instance CanvasPR8.direcionadoA.PU1.15 : canvas:direcionadoA [
		from CanvasPR8
		to publicosAcademiaICTs:PU1.15
		base:tipo "indireto"
	]
	relation instance CanvasPR8.direcionadoA.PU2.2 : canvas:direcionadoA [
		from CanvasPR8
		to publicosGovernoInstituicoesPublicas:PU2.2
		base:tipo "indireto"
	]
	relation instance CanvasPR8.direcionadoA.PU3.2 : canvas:direcionadoA [
		from CanvasPR8
		to publicosEmpresasEmpreendedores:PU3.2
		base:tipo "indireto"
	]
	relation instance CanvasPR8.direcionadoA.PU4.9 : canvas:direcionadoA [
		from CanvasPR8
		to publicosAmbientesInovacao:PU4.9
		base:tipo "indireto"
	]
	relation instance CanvasPR8.direcionadoA.PU5.1 : canvas:direcionadoA [
		from CanvasPR8
		to publicosSociedadeTerceiroSetor:PU5.1
		base:tipo "indireto"
	]
	
	// Objetivo Geral
	instance OB.GE : canvas:ObjetivoGeral [
		base:nome "Apoiar pesquisadores(as) residentes e atuantes fora da Região Metropolitana do Recife (RMR), que contribuam para o incremento da produção científica, tecnológica e inovadora de qualidade."
		base:id "OB.GE - BPP"
	]
	
	// Objetivos Específicos e Correlação de Resultados
	instance OB.ES1 : canvas:ObjetivoEspecifico [
		base:nome "Estimular a fixação de pesquisadores fora da RMR."
		base:id "OB.ES1 - BPP"
		canvas:buscaAtingir RE.LP2
	]
	instance OB.ES2 : canvas:ObjetivoEspecifico [
		base:nome "Contribuir para fortalecer e/ou nuclear os grupos de pesquisa atuantes no estado fora da RMR."
		base:id "OB.ES2 - BPP"
		canvas:buscaAtingir RE.CP4, RE.CP5, RE.CP7
	]
	instance OB.ES3 : canvas:ObjetivoEspecifico [
		base:nome "Estimular a produção e a disseminação de conhecimento de vanguarda, além da mão de obra de alto nível para o desenvolvimento competitivo e sustentável do Estado fora da RMR."
		base:id "OB.ES3 - BPP"
		canvas:buscaAtingir RE.CP1, RE.CP3, RE.CP4, RE.CP7, RE.MP1, RE.LP1
	]
	instance OB.ES4 : canvas:ObjetivoEspecifico [
		base:nome "Contribuir para formação de recursos humanos, a nível técnico, graduação e pós-graduação no estado fora da RMR."
		base:id "OB.ES4 - BPP"  
		canvas:buscaAtingir RE.CP2, RE.CP7
	]
	instance OB.ES5 : canvas:ObjetivoEspecifico [
		base:nome "Estimular cooperações e transferências científicas e tecnológicas com organizações públicas e privadas, nacionais e internacionais."
		base:id "OB.ES5 - BPP"
		canvas:buscaAtingir RE.CP4, RE.CP7, RE.MP1, RE.MP2, RE.LP1
	]
	instance OB.ES6 : canvas:ObjetivoEspecifico [
		base:nome "Ampliar a competitividade do pesquisador para além do âmbito local."
		base:id "OB.ES6 - BPP"
		canvas:buscaAtingir RE.CP5, RE.CP7, RE.LP2
	]
	instance OB.ES7 : canvas:ObjetivoEspecifico [
		base:nome "Apoiar a criação e consolidação de Programas de Pós-graduação (PPGs) fora da RMR."
		base:id "OB.ES7 - BPP"
		canvas:buscaAtingir RE.CP7, RE.LP2, RE.LP3, RE.LP4
	]
	instance OB.ES8 : canvas:ObjetivoEspecifico [
		base:nome "Estimular a participação em sociedades científicas, conselhos, editoriais de periódicos no país e no exterior."
		base:id "OB.ES8 - BPP" 
		canvas:buscaAtingir RE.CP6, RE.CP7
	]
	
	// Resultados Esperados
	
	// Curto Prazo
	instance RE.CP1 : canvas:ResultadoEsperado [
		base:nome "Aumento da produção científica qualificada e de alto impacto."
		base:id "RE.CP1 - BPP"
		canvas:prazo "curto"
	]
	instance RE.CP2 : canvas:ResultadoEsperado [
		base:nome "Aumento do número de orientações, nos níveis técnico, de graduação e pós-graduação em pesquisa e inovação nas ICTs fora da RMR."
		base:id "RE.CP2 - BPP"
		canvas:prazo "curto"
	]
	instance RE.CP3 : canvas:ResultadoEsperado [
		base:nome "Aumento da Proteção intelectual do conhecimento gerado por meio de patentes depositadas e programas de software registrados."
		base:id "RE.CP3 - BPP"
		canvas:prazo "curto"
	]
	instance RE.CP4 : canvas:ResultadoEsperado [
		base:nome "Aumento de cooperações e transferências científicas e tecnológicas com organizações públicas e privadas, nacionais e internacionais."
		base:id "RE.CP4 - BPP"
		canvas:prazo "curto"
	]
	instance RE.CP5 : canvas:ResultadoEsperado [
		base:nome "Aumento da captação de recursos através de editais de fomento, cooperações e convênios com ICTs e empresas."
		base:id "RE.CP5 - BPP"
		canvas:prazo "curto"
	]
	instance RE.CP6 : canvas:ResultadoEsperado [
		base:nome "Aumento da participação em sociedades científicas, conselhos, editoriais de periódicos no país e no exterior."
		base:id "RE.CP6 - BPP"
		canvas:prazo "curto"
	]
	instance RE.CP7 : canvas:ResultadoEsperado [
		base:nome "Aumento do número de bolsistas que não renovaram a bolsa para adquirir bolsa PQ ou DT do CNPq."
		base:id "RE.CP7 - BPP"
		canvas:prazo "curto"
	]
	
	// Médio Prazo
	instance RE.MP1 : canvas:ResultadoEsperado [
		base:nome "Aumento de Startups de base científica e tecnológica e Spin-offs acadêmicos fora da RMR."
		base:id "RE.MP1 - BPP"
		canvas:prazo "médio"
	]
	instance RE.MP2 : canvas:ResultadoEsperado [
		base:nome "Geração de inovações (produtos, processos, soluções, serviços) para Indústria, Governo e Sociedade."
		base:id "RE.MP2 - BPP"
		canvas:prazo "médio"
	]
	
	// Longo Prazo
	instance RE.LP1 : canvas:ResultadoEsperado [
		base:nome "Licenciamento da propriedade intelectual pela Indústria e Governo."
		base:id "RE.LP1 - BPP"
		canvas:prazo "longo"
	]
	instance RE.LP2 : canvas:ResultadoEsperado [
		base:nome "Fortalecimento da permanência do pesquisador fora da RMR."
		base:id "RE.LP2 - BPP"
		canvas:prazo "longo"
	]
	instance RE.LP3 : canvas:ResultadoEsperado [
		base:nome "Criação de novos PPGs fora da RMR com participação dos bolsistas BPP."
		base:id "RE.LP3 - BPP"
		canvas:prazo "longo"
	]
	instance RE.LP4 : canvas:ResultadoEsperado [
		base:nome "Aumento do conceito CAPES dos PPGs fora da RMR."
		base:id "RE.LP4 - BPP"
		canvas:prazo "longo"
	]
}
description <http://secti.pe.gov.br/indicador_cti/description/programas/programasFormacaoFixacaoTalentos/BPP/PA_BPP#> as PA_BPP {
	
	extends <http://secti.pe.gov.br/indicador_cti/description/fontesInformacao/fontesDadosPrimarios#> as fontesDadosPrimarios
	extends <http://secti.pe.gov.br/indicador_cti/description/fontesInformacao/fontesSistemasBasesGovernamentais#> as fontesSistemasBasesGovernamentais
	extends <http://secti.pe.gov.br/indicador_cti/description/fontesInformacao/fontesBasesAcademicasCientificasEducacionais#> as fontesBasesAcademicasCientificasEducacionais
	extends <http://secti.pe.gov.br/indicador_cti/description/fontesInformacao/fontesInfraestruturaAtivosCTI#> as fontesInfraestruturaAtivosCTI
	extends <http://secti.pe.gov.br/indicador_cti/description/programas/programasFormacaoFixacaoTalentos/BPP/BPP#> as BPP
	uses <http://secti.pe.gov.br/indicador_cti/vocabulary/base#> as base
	uses <http://secti.pe.gov.br/indicador_cti/vocabulary/DesignAvaliacao/planoAvaliacao#> as planoAvaliacao
	uses <http://secti.pe.gov.br/indicador_cti/vocabulary/DesignAvaliacao/metricas#> as metricas
	
	instance PA1 : planoAvaliacao:questaoAvaliacao [
		base:nome "Qual a evolução da produção científica dos bolsistas BPP com/sem coautoria de pesquisadores/alunos de Pernambuco, considerando até um ano de egresso do edital?"
		base:id "PA1 - BPP"
		planoAvaliacao:custo "Alto"
		planoAvaliacao:risco "Médio"
		planoAvaliacao:temMetrica PA1.ME1, PA1.ME2, PA1.ME3, PA1.ME4, PA1.ME5, PA1.ME6, PA1.ME7, PA1.ME8, PA1.ME9, PA1.ME10, PA1.ME11, PA1.ME12
		planoAvaliacao:temEscopo PA1.ES
		planoAvaliacao:temMetodologia PA1.MA1, PA1.MA3
		planoAvaliacao:temLimitacao LIM1
		planoAvaliacao:alinhaComResultado BPP:RE.CP1
	]
	instance PA2 : planoAvaliacao:questaoAvaliacao [
		base:nome "Qual a evolução do número de trabalhos de conclusão de cursos a nível técnico, graduação e pós-graduação orientados e/ou coorientados (nível pós) pelo bolsista BPP em pesquisa e inovação nas ICTs fora da RMR, considerando até um ano de egresso do edital?"
		base:id "PA2 - BPP"
		planoAvaliacao:custo "Médio"
		planoAvaliacao:risco "Médio"
		planoAvaliacao:temMetrica PA2.ME1, PA2.ME2, PA2.ME3
		planoAvaliacao:temEscopo PA2.ES
		planoAvaliacao:temMetodologia PA2.MA1, PA2.MA3
		planoAvaliacao:temLimitacao LIM1, LIM2, LIM4
		planoAvaliacao:alinhaComResultado BPP:RE.CP2
	]
	instance PA3 : planoAvaliacao:questaoAvaliacao [
		base:nome "Quantas patentes foram depositadas e/ou programas de computador foram registrados por bolsistas BPP, considerando até um ano de egresso do edital?"
		base:id "PA3 - BPP"
		planoAvaliacao:custo "Alto"
		planoAvaliacao:risco "Médio"
		planoAvaliacao:temMetrica PA3.ME1, PA3.ME2
		planoAvaliacao:temEscopo PA3.ES
		planoAvaliacao:temMetodologia PA3.MA1, PA3.MA3
		planoAvaliacao:temLimitacao LIM1, LIM2
		planoAvaliacao:alinhaComResultado BPP:RE.CP3
	]
	instance PA4 : planoAvaliacao:questaoAvaliacao [
		base:nome "Qual a evolução da produção científica e tecnológica em coautoria nacional e internacional dos bolsistas BPP em até um ano de egresso do edital?"
		base:id "PA4 - BPP"
		planoAvaliacao:custo "Alto"
		planoAvaliacao:risco "Médio"
		planoAvaliacao:temMetrica PA4.ME1, PA4.ME2, PA4.ME3, PA4.ME4, PA4.ME5, PA4.ME6
		planoAvaliacao:temEscopo PA4.ES
		planoAvaliacao:temMetodologia PA4.MA1, PA4.MA3
		planoAvaliacao:temLimitacao LIM1, LIM2
		planoAvaliacao:alinhaComResultado BPP:RE.CP4
	]
	instance PA5 : planoAvaliacao:questaoAvaliacao [
		base:nome "Qual a evolução do número de bolsistas BPP com projetos financiados com recursos de editais de fomento, cooperação e convênios na condição de coordenador?"
		base:id "PA5 - BPP"
		planoAvaliacao:custo "Alto"
		planoAvaliacao:risco "Médio"
		planoAvaliacao:temMetrica PA5.ME1, PA5.ME2, PA5.ME3, PA5.ME4, PA5.ME5
		planoAvaliacao:temEscopo PA5.ES
		planoAvaliacao:temMetodologia PA5.MA1
		planoAvaliacao:temLimitacao LIM2, LIM3
		planoAvaliacao:alinhaComResultado BPP:RE.CP5
	]
	instance PA6 : planoAvaliacao:questaoAvaliacao [
		base:nome "Qual a evolução da participação do bolsista BPP em sociedades científicas, conselhos, editoriais de periódicos no país e no exterior?"
		base:id "PA6 - BPP"
		planoAvaliacao:custo "Alto"
		planoAvaliacao:risco "Médio"
		planoAvaliacao:temMetrica PA6.ME1, PA6.ME2
		planoAvaliacao:temEscopo PA6.ES
		planoAvaliacao:temMetodologia PA6.MA1
		planoAvaliacao:temLimitacao LIM2, LIM3
		planoAvaliacao:alinhaComResultado BPP:RE.CP6
	]
	instance PA7 : planoAvaliacao:questaoAvaliacao [
		base:nome "Quantos bolsistas não renovaram a bolsa e quantos egressos adquiriram bolsa PQ e DT do CNPq?"
		base:id "PA7 - BPP"
		planoAvaliacao:custo "Baixo"
		planoAvaliacao:risco "Médio"
		planoAvaliacao:temMetrica PA7.ME1, PA7.ME2, PA7.ME3
		planoAvaliacao:temEscopo PA7.ES
		planoAvaliacao:temMetodologia PA7.MA1
		planoAvaliacao:temLimitacao LIM2
		planoAvaliacao:alinhaComResultado BPP:RE.CP7
	]
	instance PA8 : planoAvaliacao:questaoAvaliacao [
		base:nome "Qual a evolução do número de startups de base científica e tecnológica criados com a participação direta de bolsistas/egressos do BPP, considerando o período de três anos de egresso do edital BPP?"
		base:id "PA8 - BPP"
		planoAvaliacao:custo "Alto"
		planoAvaliacao:risco "Médio"
		planoAvaliacao:temMetrica PA8.ME1, PA8.ME2
		planoAvaliacao:temEscopo PA8.ES
		planoAvaliacao:temMetodologia PA8.MA1
		planoAvaliacao:temLimitacao LIM3
		planoAvaliacao:alinhaComResultado BPP:RE.MP1
	]
	instance PA9 : planoAvaliacao:questaoAvaliacao [
		base:nome "Quantas inovações (produtos, processos, serviços) fomentadas pelo BPP foram adotadas por empresas ou pelo governo?"
		base:id "PA9 - BPP"
		planoAvaliacao:custo "Alto"
		planoAvaliacao:risco "Médio"
		planoAvaliacao:temMetrica PA9.ME1, PA9.ME2, PA9.ME3
		planoAvaliacao:temEscopo PA9.ES
		planoAvaliacao:temMetodologia PA9.MA1
		planoAvaliacao:temLimitacao LIM3
		planoAvaliacao:alinhaComResultado BPP:RE.MP2
	]
	instance PA10 : planoAvaliacao:questaoAvaliacao [
		base:nome "Qual o quantitativo de patentes e programas de computador de egressos do BPP licenciados e comercializados?"
		base:id "PA10 - BPP"
		planoAvaliacao:custo "Alto"
		planoAvaliacao:risco "Médio"
		planoAvaliacao:temMetrica PA10.ME1
		planoAvaliacao:temEscopo PA10.ES
		planoAvaliacao:temMetodologia PA10.MA1
		planoAvaliacao:temLimitacao LIM3
		planoAvaliacao:alinhaComResultado BPP:RE.LP1
	]
	instance PA11 : planoAvaliacao:questaoAvaliacao [
		base:nome "Qual a taxa de fixação do pesquisador bolsista BPP egresso fora da RMR?"
		base:id "PA11 - BPP"
		planoAvaliacao:custo "Alto"
		planoAvaliacao:risco "Médio"
		planoAvaliacao:temMetrica PA11.ME1, PA11.ME2
		planoAvaliacao:temEscopo PA11.ES
		planoAvaliacao:temMetodologia PA11.MA1
		planoAvaliacao:temLimitacao LIM2, LIM3
		planoAvaliacao:alinhaComResultado BPP:RE.LP2
	]
	instance PA12 : planoAvaliacao:questaoAvaliacao [
		base:nome "Qual a evolução do número de PPGs criados fora da RMR com a participação de bolsistas BPP?"
		base:id "PA12 - BPP"
		planoAvaliacao:custo "Baixo"
		planoAvaliacao:risco "Baixo"
		planoAvaliacao:temMetrica PA12.ME1
		planoAvaliacao:temEscopo PA12.ES
		planoAvaliacao:temMetodologia PA12.MA1
		planoAvaliacao:alinhaComResultado BPP:RE.LP3
	]
	instance PA13 : planoAvaliacao:questaoAvaliacao [
		base:nome "Qual a evolução do conceito CAPES dos PPGs criados fora da RMR com a participação do bolsista BPP?"
		base:id "PA13 - BPP"
		planoAvaliacao:custo "Baixo"
		planoAvaliacao:risco "Baixo"
		planoAvaliacao:temMetrica PA13.ME1, PA13.ME2, PA13.ME3
		planoAvaliacao:temEscopo PA13.ES
		planoAvaliacao:temMetodologia PA13.MA1
		planoAvaliacao:alinhaComResultado BPP:RE.LP4
	]
	
	//Métricas
	instance PA1.ME1 : metricas:metrica [
		base:nome "Quantidade Produção Científica Bolsistas"
		base:descricao "Número anual da produção científica em geral dos bolsistas BPP desagregado pela grande área do conhecimento FACEPE"
		base:id "PA1.ME1 - BPP"
		metricas:temFonte fontesSistemasBasesGovernamentais:FI2.1, fontesBasesAcademicasCientificasEducacionais:FI3.1, 
		fontesBasesAcademicasCientificasEducacionais:FI3.2, fontesBasesAcademicasCientificasEducacionais:FI3.4
	]
	instance PA1.ME2 : metricas:metrica [
		base:nome "Quantidade Publicações Periódicos Bolsistas"
		base:descricao "Número anual de publicações em periódicos em geral dos bolsistas BPP desagregado pela grande área do conhecimento FACEPE"
		base:id "PA1.ME2 - BPP"
		metricas:temFonte fontesSistemasBasesGovernamentais:FI2.1, fontesBasesAcademicasCientificasEducacionais:FI3.1, 
		fontesBasesAcademicasCientificasEducacionais:FI3.2, fontesBasesAcademicasCientificasEducacionais:FI3.4
	]
	instance PA1.ME3 : metricas:metrica [
		base:nome "Quantidade Publicações Periódicos Scopus Bolsistas"
		base:descricao "Número anual de publicações em periódicos indexados na base científica Scopus dos BPP, desagregado pela grande área do conhecimento FACEPE"
		base:id "PA1.ME3 - BPP"
		metricas:temFonte fontesSistemasBasesGovernamentais:FI2.1, fontesBasesAcademicasCientificasEducacionais:FI3.1, 
		fontesBasesAcademicasCientificasEducacionais:FI3.4
	]
	instance PA1.ME4 : metricas:metrica [
		base:nome "Taxa Publicações Periódicos Qualificados Bolsistas"
		base:descricao "Número anual de publicações em periódicos indexados na base Scopus dos bolsistas BPP por quartil sobre o número total de publicações em periódicos indexados na Scopus dos bolsistas BPP no mesmo ano de publicação desagregado pela grande área de conhecimento FACEPE"
		base:id "PA1.ME4 - BPP"
		metricas:temFonte fontesSistemasBasesGovernamentais:FI2.1, fontesBasesAcademicasCientificasEducacionais:FI3.1, 
		fontesBasesAcademicasCientificasEducacionais:FI3.4
	]
	instance PA1.ME5 : metricas:metrica [
		base:nome "Quantidade Citações Bolsistas"
		base:descricao "Número anual de citações em geral dos bolsistas BPP desagregado pela grande área do conhecimento FACEPE"
		base:id "PA1.ME5 - BPP"
		metricas:temFonte fontesSistemasBasesGovernamentais:FI2.1, fontesBasesAcademicasCientificasEducacionais:FI3.1, 
		fontesBasesAcademicasCientificasEducacionais:FI3.2, fontesBasesAcademicasCientificasEducacionais:FI3.4
	]
	instance PA1.ME6 : metricas:metrica [
		base:nome "Quantidade Citações Scopus Bolsistas"
		base:descricao "Número anual de citações na base científica Scopus dos bolsistas BPP desagregado pela grande área do conhecimento FACEPE"
		base:id "PA1.ME6 - BPP"
		metricas:temFonte fontesSistemasBasesGovernamentais:FI2.1, fontesBasesAcademicasCientificasEducacionais:FI3.1, 
		fontesBasesAcademicasCientificasEducacionais:FI3.4
	]
	instance PA1.ME7 : metricas:metrica [
		base:nome "Média Citações por Publicação Scopus Bolsistas"
		base:descricao "Número anual de citações na base científica Scopus dos bolsistas BPP sobre o número total de publicações indexadas na Scopus dos bolsistas BPP no mesmo ano desagregado pela grande área do conhecimento FACEPE"
		base:id "PA1.ME7 - BPP"
		metricas:temFonte fontesSistemasBasesGovernamentais:FI2.1, fontesBasesAcademicasCientificasEducacionais:FI3.1, 
		fontesBasesAcademicasCientificasEducacionais:FI3.4
	]
	instance PA1.ME8 : metricas:metrica [
		base:nome "Taxa Citações Quartil Superior Scopus Bolsistas"
		base:descricao "Número anual de citações presentes no quartil superior (Top 25%) na base científica Scopus dos bolsistas BPP sobre o número total de citações na Scopus dos bolsistas BPP no mesmo ano desagregado pela grande área do conhecimento FACEPE"
		base:id "PA1.ME8 - BPP"
		metricas:temFonte fontesSistemasBasesGovernamentais:FI2.1, fontesBasesAcademicasCientificasEducacionais:FI3.1, 
		fontesBasesAcademicasCientificasEducacionais:FI3.4
	]
	instance PA1.ME9 : metricas:metrica [
		base:nome "Índice h Scopus Bolsistas"
		base:descricao "Índice h médio na base científica Scopus dos bolsistas BPP desagregado por ano e grande área do conhecimento FACEPE"
		base:id "PA1.ME9 - BPP"
		metricas:temFonte fontesSistemasBasesGovernamentais:FI2.1, fontesBasesAcademicasCientificasEducacionais:FI3.1, 
		fontesBasesAcademicasCientificasEducacionais:FI3.4
	]
	instance PA1.ME10 : metricas:metrica [
		base:nome "Índice h5 Scopus Bolsistas"
		base:descricao "Índice h5 médio na base científica Scopus dos bolsistas BPP desagregado por ano e grande área do conhecimento FACEPE"
		base:id "PA1.ME10 - BPP"
		metricas:temFonte fontesSistemasBasesGovernamentais:FI2.1, fontesBasesAcademicasCientificasEducacionais:FI3.1, 
		fontesBasesAcademicasCientificasEducacionais:FI3.4
	]
	instance PA1.ME11 : metricas:metrica [
		base:nome "Quantidade Publicações Coautoria Bolsistas"
		base:descricao "Número anual de publicações dos bolsistas BPP, até um ano de egresso do edital em coautoria com pelo menos um autor (aluno/pesquisador) atuante em Pernambuco, desagregado por grande área do conhecimento FACEPE"
		base:id "PA1.ME11 - BPP"
		metricas:temFonte fontesSistemasBasesGovernamentais:FI2.1, fontesBasesAcademicasCientificasEducacionais:FI3.1, 
		fontesBasesAcademicasCientificasEducacionais:FI3.2, fontesBasesAcademicasCientificasEducacionais:FI3.3, fontesBasesAcademicasCientificasEducacionais:FI3.4
	]
	instance PA1.ME12 : metricas:metrica [
		base:nome "Taxa Publicação Coautoria Bolsistas"
		base:descricao "Número de bolsistas BPP com publicação em coautoria com pelo menos um autor (aluno/pesquisador) atuante em Pernambuco, até um ano de egresso do edital, sobre o número total de bolsistas BPP com pelo menos uma publicação, desagregado por: ano de publicação e grande área do conhecimento FACEPE"
		base:id "PA1.ME12 - BPP"
		metricas:temFonte fontesSistemasBasesGovernamentais:FI2.1, fontesBasesAcademicasCientificasEducacionais:FI3.1, 
		fontesBasesAcademicasCientificasEducacionais:FI3.2, fontesBasesAcademicasCientificasEducacionais:FI3.3, fontesBasesAcademicasCientificasEducacionais:FI3.4
	]
	
	instance PA2.ME1 : metricas:metrica [
		base:nome "Quantidade Orientação Bolsista"
		base:descricao "Número de trabalhos de Iniciação Científica, Extensão e Inovação com orientação do bolsista BPP fora da RMR por ano, por grande área de conhecimento FACEPE"
		base:id "PA2.ME1 - BPP"
		metricas:temFonte fontesSistemasBasesGovernamentais:FI2.1, fontesBasesAcademicasCientificasEducacionais:FI3.2
	]
	instance PA2.ME2 : metricas:metrica [
		base:nome "Quantidade Orientação TCC Bolsista"
		base:descricao "Número de trabalhos conclusão de cursos com orientação do bolsista BPP por ano, por nível (técnico e graduação) fora da RMR e por grande área de conhecimento FACEPE"
		base:id "PA2.ME2 - BPP"
		metricas:temFonte fontesSistemasBasesGovernamentais:FI2.1, fontesBasesAcademicasCientificasEducacionais:FI3.2
	]
	instance PA2.ME3 : metricas:metrica [
		base:nome "Quantidade (Co)orientação Pós-graduação"
		base:descricao "Número de trabalhos conclusão de curso de pós-graduação com orientação e/ou coorientação do bolsista BPP por ano e por modalidade (mestrado e doutorado)"
		base:id "PA2.ME3 - BPP"
		metricas:temFonte fontesSistemasBasesGovernamentais:FI2.1, fontesBasesAcademicasCientificasEducacionais:FI3.2
	]
	
	instance PA3.ME1 : metricas:metrica [
		base:nome "Quantidade PI Bolsistas"
		base:descricao "Número anual da Propriedade Intelectual (PI) dos bolsistas BPP desagregado por grande área do conhecimento FACEPE; e tipo da propriedade intelectual (patente, programa de computador, desenho industrial, marca, cultivares, partituras etc.)"
		base:id "PA3.ME1 - BPP"
		metricas:temFonte fontesSistemasBasesGovernamentais:FI2.1, fontesBasesAcademicasCientificasEducacionais:FI3.1, 
		fontesBasesAcademicasCientificasEducacionais:FI3.2, fontesInfraestruturaAtivosCTI:FI4.2
	]
	instance PA3.ME2 : metricas:metrica [
		base:nome "Taxa PI Bolsistas BPP"
		base:descricao "Proporção de bolsistas BFP com Propriedade Intelectual com relação ao total de bolsistas BFP desagregado por ano e por área"
		base:id "PA3.ME2 - BPP"
		metricas:temFonte fontesSistemasBasesGovernamentais:FI2.1, fontesBasesAcademicasCientificasEducacionais:FI3.1, 
		fontesBasesAcademicasCientificasEducacionais:FI3.2, fontesInfraestruturaAtivosCTI:FI4.2
	]
	
	instance PA4.ME1 : metricas:metrica [
		base:nome "Quantidade Publicações Coautoria Bolsistas"
		base:descricao "Número anual de publicações dos bolsistas BPP, até um ano de egresso do edital, em coautoria com pelo menos um autor filiado a outra organização, desagregado por: grande área do conhecimento FACEPE; tipo da organização (empresa, ICT e governo); e localização da organização (nacional, exterior)"
		base:id "PA4.ME1 - BPP"
		metricas:temFonte fontesSistemasBasesGovernamentais:FI2.1, fontesBasesAcademicasCientificasEducacionais:FI3.1, 

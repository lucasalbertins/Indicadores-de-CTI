		base:id "PA2.ES - BPP"
	]
	instance PA2.MA1 : planoAvaliacao:metodoAvaliacao [
		base:descricao "Análise Descritiva"
		base:id "PA2.MA1 - BPP"
	]
	instance PA2.MA3 : planoAvaliacao:metodoAvaliacao [
		base:descricao "Regressão Descontínua"
		base:id "PA2.MA3 - BPP"
	]
	

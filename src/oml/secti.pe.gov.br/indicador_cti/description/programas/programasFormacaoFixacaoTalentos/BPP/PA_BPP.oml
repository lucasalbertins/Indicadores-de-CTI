	//Escopos e Métodos de Avaliação
	instance PA1.ES : planoAvaliacao:escopo [
		base:descricao "Espera-se identificar a evolução da quantidade e qualidade da produção científica dos bolsistas BPP.  A comparação será longitudinal (ao longo dos anos) e transversal entre o grupo tratado (bolsistas BPP) e o grupo controle (candidatos a bolsa BPP que ficaram próximos à linha de corte)"
		base:id "PA1.ES - BPP"
	]
	instance PA1.MA1 : planoAvaliacao:metodoAvaliacao [
		base:descricao "Análise Descritiva"
		base:id "PA1.MA1 - BPP"
	]
	instance PA1.MA3 : planoAvaliacao:metodoAvaliacao [
		base:descricao "Regressão Descontínua"
		base:id "PA1.MA3 - BPP"
	]
	
	instance PA2.ES : planoAvaliacao:escopo [

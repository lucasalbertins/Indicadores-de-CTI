	//Limitações
	instance LIM1 : planoAvaliacao:limitacao [
		base:descricao "A análise identifica correlação, mas não garante identificar a causalidade entre as cotas BPP utilizadas e a evolução da produção científica dos bolsistas BPP."
	]
	instance LIM2 : planoAvaliacao:limitacao [
		base:descricao "Dados da Plataforma Lattes são autodeclarados e dependem de atualização."
	]
	instance LIM3 : planoAvaliacao:limitacao [
		base:descricao "Não há garantia da precisão da análise devido a necessidade de dados primários."
	]
	instance LIM4 : planoAvaliacao:limitacao [
		base:descricao "Identifica correlação, mas não garante causalidade isolada."
	]
}
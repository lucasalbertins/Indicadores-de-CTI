description <http://secti.pe.gov.br/indicador_cti/description/programas/programasFormacaoFixacaoTalentos/BIA/PA_BIA#> as PA_BIA {
	
	extends <http://secti.pe.gov.br/indicador_cti/description/fontesInformacao/fontesDadosPrimarios#> as fontesDadosPrimarios
	extends <http://secti.pe.gov.br/indicador_cti/description/fontesInformacao/fontesSistemasBasesGovernamentais#> as fontesSistemasBasesGovernamentais
	extends <http://secti.pe.gov.br/indicador_cti/description/fontesInformacao/fontesBasesAcademicasCientificasEducacionais#> as fontesBasesAcademicasCientificasEducacionais
	extends <http://secti.pe.gov.br/indicador_cti/description/fontesInformacao/fontesInfraestruturaAtivosCTI#> as fontesInfraestruturaAtivosCTI
	extends <http://secti.pe.gov.br/indicador_cti/description/fontesInformacao/fontesDadosSocioeconomicosTerritoriais#> as fontesDadosSocioeconomicosTerritoriais
	extends <http://secti.pe.gov.br/indicador_cti/description/programas/programasFormacaoFixacaoTalentos/BIA/BIA#> as BIA
	uses <http://secti.pe.gov.br/indicador_cti/vocabulary/base#> as base
	uses <http://secti.pe.gov.br/indicador_cti/vocabulary/DesignAvaliacao/planoAvaliacao#> as planoAvaliacao
	uses <http://secti.pe.gov.br/indicador_cti/vocabulary/DesignAvaliacao/metricas#> as metricas

	// Perguntas de Avaliação (PA)
	instance PA1 : planoAvaliacao:questaoAvaliacao [
		base:nome "Qual a taxa de evasão dos bolsistas BIA em relação a evasão geral?"
		base:id "PA1 - BIA"
		planoAvaliacao:custo "Médio"
		planoAvaliacao:risco "Médio"
		planoAvaliacao:temMetrica PA1.ME1, PA1.ME2, PA1.ME3
		planoAvaliacao:temEscopo PA1.ES
		planoAvaliacao:temMetodologia PA1.MA1
		planoAvaliacao:alinhaComResultado BIA:RE.CP1
	]

	instance PA2 : planoAvaliacao:questaoAvaliacao [
		base:nome "Quantos bolsistas BIA migraram para o PIBIC/FACEPE e outros programas durante a graduação?"
		base:id "PA2 - BIA"
		planoAvaliacao:custo "Médio"
		planoAvaliacao:risco "Médio"
		planoAvaliacao:temMetrica PA2.ME1, PA2.ME2, PA2.ME3, PA2.ME4, PA2.ME5
		planoAvaliacao:temEscopo PA2.ES
		planoAvaliacao:temMetodologia PA2.MA1
		planoAvaliacao:alinhaComResultado BIA:RE.MP1
	]

	instance PA3 : planoAvaliacao:questaoAvaliacao [
		base:nome "Qual a evolução da empregabilidade do bolsista egresso BIA em setores estratégicos em Pernambuco?"
		base:id "PA3 - BIA"
		planoAvaliacao:custo "Médio"
		planoAvaliacao:risco "Médio"
		planoAvaliacao:temMetrica PA3.ME1, PA3.ME2, PA3.ME3
		planoAvaliacao:temEscopo PA3.ES
		planoAvaliacao:temMetodologia PA3.MA1
		planoAvaliacao:alinhaComResultado BIA:RE.LP2
	]

	instance PA4 : planoAvaliacao:questaoAvaliacao [
		base:nome "Quantos alunos bolsistas egressos BIA estão matriculados em programas de mestrado acadêmico e profissional em IES pernambucana?"
		base:id "PA4 - BIA"
		planoAvaliacao:custo "Médio"
		planoAvaliacao:risco "Médio"
		planoAvaliacao:temMetrica PA4.ME1, PA4.ME2, PA4.ME3, PA4.ME4, PA4.ME5
		planoAvaliacao:temEscopo PA4.ES
		planoAvaliacao:temMetodologia PA4.MA1
		planoAvaliacao:alinhaComResultado BIA:RE.LP1
	]

	// Métricas - PA1
	instance PA1.ME1 : metricas:metrica [
		base:nome "Quantidade Evasão Bolsistas"
		base:descricao "Número anual de bolsistas BIA que evadiram do curso vinculado, desagregado pela grande área de conhecimento FACEPE, curso, e RDE."
		base:id "PA1.ME1 - BIA"
		metricas:temFonte fontesSistemasBasesGovernamentais:FI2.1, fontesBasesAcademicasCientificasEducacionais:FI3.5
	]

	instance PA1.ME2 : metricas:metrica [
		base:nome "Taxa Evasão Bolsista"
		base:descricao "Número anual de bolsistas BIA que evadiram do curso sobre o número total de bolsistas BIA desagregado pela grande área de conhecimento FACEPE, curso e RDE."
		base:id "PA1.ME2 - BIA"
		metricas:temFonte fontesSistemasBasesGovernamentais:FI2.1, fontesBasesAcademicasCientificasEducacionais:FI3.5
	]

	instance PA1.ME3 : metricas:metrica [
		base:nome "Taxa evasão Bolsista e evasão geral"
		base:descricao "Evolução anual das taxas de evasão dos bolsistas BIA e da taxa de evasão do curso ao qual o bolsista pertence desagregado pela grande área de conhecimento FACEPE, curso e RDE."
		base:id "PA1.ME3 - BIA"
		metricas:temFonte fontesSistemasBasesGovernamentais:FI2.1, fontesBasesAcademicasCientificasEducacionais:FI3.5
	]

	// Métricas - PA2
	instance PA2.ME1 : metricas:metrica [
		base:nome "Número de Bolsistas Migrados para PIBIC/FACEPE"
		base:descricao "Número anual absoluto de bolsistas BIA que migraram para bolsa PIBIC/FACEPE após o fim da bolsa, desagregados por semestre, grande área de conhecimento da FACEPE, curso e RDE."
		base:id "PA2.ME1 - BIA"
		metricas:temFonte fontesSistemasBasesGovernamentais:FI2.1
	]

	instance PA2.ME2 : metricas:metrica [
		base:nome "Número Total de Concluintes da Bolsa BIA"
		base:descricao "Número anual absoluto de bolsistas BIA que encerraram a bolsa, desagregado por semestre, grande área de conhecimento da FACEPE, curso e RDE."
		base:id "PA2.ME2 - BIA"
		metricas:temFonte fontesSistemasBasesGovernamentais:FI2.1
	]

	instance PA2.ME3 : metricas:metrica [
		base:nome "Taxa de Bolsistas Migrados para PIBIC/FACEPE"
		base:descricao "Percentual anual de bolsistas BIA que migraram para bolsa PIBIC/FACEPE em relação ao número total de bolsistas concluintes desagregados por semestre, grande área de conhecimento FACEPE, curso e RDE."
		base:id "PA2.ME3 - BIA"
		metricas:temFonte fontesSistemasBasesGovernamentais:FI2.1
	]

	instance PA2.ME4 : metricas:metrica [
		base:nome "Número de Bolsistas Migrados para Outros Programas"
		base:descricao "Número anual absoluto de bolsistas BIA que migraram para bolsa de outros Programas após o fim da bolsa, desagregados por semestre, grande área de conhecimento, curso, tipo de programa e RDE."
		base:id "PA2.ME4 - BIA"
		metricas:temFonte fontesSistemasBasesGovernamentais:FI2.1, fontesBasesAcademicasCientificasEducacionais:FI3.2, fontesBasesAcademicasCientificasEducacionais:FI3.5
	]

	instance PA2.ME5 : metricas:metrica [
		base:nome "Taxa de Bolsistas Migrados para Outros Programas"
		base:descricao "Percentual de bolsistas BIA que migraram para outros programas de bolsa em relação ao número total de bolsistas concluintes desagregados por semestre, grande área de conhecimento FACEPE, curso, tipo de programa e RDE."
		base:id "PA2.ME5 - BIA"
		metricas:temFonte fontesSistemasBasesGovernamentais:FI2.1, fontesBasesAcademicasCientificasEducacionais:FI3.5
	]

	// Métricas - PA3
	instance PA3.ME1 : metricas:metrica [
		base:nome "Número de Bolsistas Empregados"
		base:descricao "Número absoluto de bolsistas egressos BIA que possuem vínculo empregatício formal em Pernambuco após a conclusão do curso, desagregados por ano, área de conhecimento FACEPE, atividade econômica e região de desenvolvimento."
		base:id "PA3.ME1 - BIA"
		metricas:temFonte fontesSistemasBasesGovernamentais:FI2.1, fontesSistemasBasesGovernamentais:FI2.2
	]

	instance PA3.ME2 : metricas:metrica [
		base:nome "Número Total de Concluintes da Bolsa BIA"
		base:descricao "Número absoluto de bolsistas BIA que encerraram a bolsa, desagregado por ano, grande área de conhecimento e RDE."
		base:id "PA3.ME2 - BIA"
		metricas:temFonte fontesSistemasBasesGovernamentais:FI2.1
	]

	instance PA3.ME3 : metricas:metrica [
		base:nome "Taxa de Bolsistas BIA Empregados"
		base:descricao "Percentual de bolsistas egressos BIA que estão empregados em relação ao número total de bolsistas concluintes desagregados por ano, grande área de conhecimento FACEPE, atividade econômica e RDE."
		base:id "PA3.ME3 - BIA"
		metricas:temFonte fontesSistemasBasesGovernamentais:FI2.1, fontesSistemasBasesGovernamentais:FI2.2
	]

	// Métricas - PA4
	instance PA4.ME1 : metricas:metrica [
		base:nome "Número de Bolsistas BIA Matriculados em PPGs Acadêmicos"
		base:descricao "Número total de bolsistas egressos BIA que estão matriculados em Programas de Pós-graduação Acadêmico nível mestrado em IES Pernambucana, desagregado por ano, grande área de conhecimento FACEPE e região de desenvolvimento."
		base:id "PA4.ME1 - BIA"
		metricas:temFonte fontesSistemasBasesGovernamentais:FI2.1, fontesBasesAcademicasCientificasEducacionais:FI3.1
	]

	instance PA4.ME2 : metricas:metrica [
		base:nome "Número Total de Concluintes da Bolsa BIA"
		base:descricao "Número absoluto de bolsistas BIA que encerraram a bolsa, desagregado por ano, grande área de conhecimento e RDE."
		base:id "PA4.ME2 - BIA"
		metricas:temFonte fontesSistemasBasesGovernamentais:FI2.1
	]

	instance PA4.ME3 : metricas:metrica [
		base:nome "Taxa de Bolsistas BIA Matriculados em PPGs Acadêmicos"
		base:descricao "Percentual de bolsistas egressos BIA que estão matriculados em PPGs acadêmicos, nível mestrado, em relação ao número total de bolsistas concluintes desagregados por ano, grande área de conhecimento FACEPE e RDE."
		base:id "PA4.ME3 - BIA"
		metricas:temFonte fontesSistemasBasesGovernamentais:FI2.1, fontesBasesAcademicasCientificasEducacionais:FI3.1
	]

	instance PA4.ME4 : metricas:metrica [
		base:nome "Número de Bolsistas BIA Matriculados em PPGs Profissional"
		base:descricao "Número total de bolsistas egressos BIA que estão matriculados em Programas de Pós-graduação Profissional nível mestrado em IES Pernambucana, desagregado por ano, grande área de conhecimento FACEPE e região de desenvolvimento."
		base:id "PA4.ME4 - BIA"
		metricas:temFonte fontesSistemasBasesGovernamentais:FI2.1, fontesBasesAcademicasCientificasEducacionais:FI3.1
	]

	instance PA4.ME5 : metricas:metrica [
		base:nome "Taxa de Bolsistas BIA Matriculados em PPGs Profissional"
		base:descricao "Percentual de bolsistas egressos BIA que estão matriculados em PPGs profissional, nível mestrado, em relação ao número total de bolsistas concluintes desagregados por ano, grande área de conhecimento FACEPE e RDE."
		base:id "PA4.ME5 - BIA"
		metricas:temFonte fontesSistemasBasesGovernamentais:FI2.1, fontesBasesAcademicasCientificasEducacionais:FI3.1
	]

	// Escopos e Métodos de Avaliação
	instance PA1.ES : planoAvaliacao:escopo [
		base:descricao "Espera-se identificar a evasão dos bolsistas PIBIC nos cursos de graduação e comparar com a taxa de evasão geral do curso ao qual o bolsista é vinculado. A comparação será longitudinal (ao longo dos anos)."
		base:id "PA1.ES - BIA"
	]

	instance PA1.MA1 : planoAvaliacao:metodoAvaliacao [
		base:descricao "Análise Descritiva"
		base:id "PA1.MA1 - BIA"
	]

	instance PA2.ES : planoAvaliacao:escopo [
		base:descricao "Espera-se identificar o número de bolsistas BIA que encerraram a bolsa e que migraram para programas de bolsa como PIBIC/FACEPE e outros programas. A comparação será longitudinal (ao longo dos semestres)."
		base:id "PA2.ES - BIA"
	]

	instance PA2.MA1 : planoAvaliacao:metodoAvaliacao [
		base:descricao "Análise Descritiva"
		base:id "PA2.MA1 - BIA"
	]

	instance PA3.ES : planoAvaliacao:escopo [
		base:descricao "Espera-se identificar o grau de empregabilidade do bolsista egresso BIA após a conclusão do curso do bolsista vinculado. A comparação será longitudinal (ao longo dos anos)."
		base:id "PA3.ES - BIA"
	]

	instance PA3.MA1 : planoAvaliacao:metodoAvaliacao [
		base:descricao "Análise Descritiva"
		base:id "PA3.MA1 - BIA"
	]

	instance PA4.ES : planoAvaliacao:escopo [
		base:descricao "Espera-se identificar a quantidade de bolsistas egressos do BIA que estão matriculados em programas de pós-graduação de nível acadêmico e profissional em IES pernambucanas. A comparação será longitudinal (ao longo dos anos)."
		base:id "PA4.ES - BIA"
	]

	instance PA4.MA1 : planoAvaliacao:metodoAvaliacao [
		base:descricao "Análise Descritiva"
		base:id "PA4.MA1 - BIA"
	]
}
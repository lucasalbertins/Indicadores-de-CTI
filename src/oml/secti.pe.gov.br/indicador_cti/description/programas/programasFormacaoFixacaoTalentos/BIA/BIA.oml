description <http://secti.pe.gov.br/indicador_cti/description/programas/programasFormacaoFixacaoTalentos/BIA/BIA#> as BIA {

	extends <http://secti.pe.gov.br/indicador_cti/description/programas/programasFormacaoFixacaoTalentos/BIA/PA_BIA#> as PA_BIA
	extends <http://secti.pe.gov.br/indicador_cti/description/parceirosChave/parceirosGoverno#> as parceirosGoverno
	extends <http://secti.pe.gov.br/indicador_cti/description/parceirosChave/parceirosAgenciasFomento#> as parceirosAgenciasFomento
	extends <http://secti.pe.gov.br/indicador_cti/description/parceirosChave/parceirosEmpresas#> as parceirosEmpresas
	extends <http://secti.pe.gov.br/indicador_cti/description/parceirosChave/parceirosAmbientesInovacao#> as parceirosAmbientesInovacao
	extends <http://secti.pe.gov.br/indicador_cti/description/fatoresExternos/fatoresCenarioEconomico#> as fatoresCenarioEconomico
	extends <http://secti.pe.gov.br/indicador_cti/description/fatoresExternos/fatoresCenarioInstitucionalLegal#> as fatoresCenarioInstitucionalLegal
	extends <http://secti.pe.gov.br/indicador_cti/description/fatoresExternos/fatoresCenarioSocialEducacional#> as fatoresCenarioSocialEducacional
	extends <http://secti.pe.gov.br/indicador_cti/description/fatoresExternos/fatoresDinamicaEcossistema#> as fatoresDinamicaEcossistema
	extends <http://secti.pe.gov.br/indicador_cti/description/entradas/entradasOrcamentoFinanciamento#> as entradasOrcamentoFinanciamento
	extends <http://secti.pe.gov.br/indicador_cti/description/entradas/entradasDadosSistemasPlataformas#> as entradasDadosSistemasPlataformas
	extends <http://secti.pe.gov.br/indicador_cti/description/entradas/entradasCapitalHumano#> as entradasCapitalHumano
	extends <http://secti.pe.gov.br/indicador_cti/description/entradas/entradasInstrumentosLegaisNormativos#> as entradasInstrumentosLegaisNormativos
	extends <http://secti.pe.gov.br/indicador_cti/description/atividadesChave#> as atividadeChave
	extends <http://secti.pe.gov.br/indicador_cti/description/saidas#> as saida
	extends <http://secti.pe.gov.br/indicador_cti/description/publicosAlvo/publicosGovernoInstituicoesPublicas#> as publicosGovernoInstituicoesPublicas
	extends <http://secti.pe.gov.br/indicador_cti/description/publicosAlvo/publicosEmpresasEmpreendedores#> as publicosEmpresasEmpreendedores
	extends <http://secti.pe.gov.br/indicador_cti/description/publicosAlvo/publicosAmbientesInovacao#> as publicosAmbientesInovacao
	extends <http://secti.pe.gov.br/indicador_cti/description/publicosAlvo/publicosSociedadeTerceiroSetor#> as publicosSociedadeTerceiroSetor
	extends <http://secti.pe.gov.br/indicador_cti/description/parceirosChave/parceirosAcademiaICTs#> as parceirosAcademiaICTS
	extends <http://secti.pe.gov.br/indicador_cti/description/publicosAlvo/publicosAcademiaICTs#> as publicosAcademiaICTs
	uses <http://secti.pe.gov.br/indicador_cti/vocabulary/base#> as base
	uses <http://secti.pe.gov.br/indicador_cti/vocabulary/DesignAvaliacao/canvas#> as canvas
	uses <http://secti.pe.gov.br/indicador_cti/vocabulary/programa#> as programa
    uses <http://www.w3.org/2001/XMLSchema#> as xsd

	instance CanvasPR50 : canvas:canvas [
		base:nome "Canvas do BIA"
		base:id "C-PR50"
		base:versao "V1-Homologado"
		base:dataCriacao "2026-03-11T00:00:00"^^xsd:dateTime
		
		canvas:possuiParceiros parceirosGoverno:PC1.1, parceirosGoverno:PC1.2, parceirosAcademiaICTS:PC3.1, parceirosEmpresas:PC4.1, parceirosEmpresas:PC4.2, parceirosAgenciasFomento:PC2.9, parceirosAgenciasFomento:PC2.10
		canvas:condicionadoPor fatoresDinamicaEcossistema:FE5.OP6,fatoresCenarioSocialEducacional:FE4.OP1,fatoresCenarioInstitucionalLegal:FE2.OP1,fatoresCenarioEconomico:FE1.AM2,fatoresCenarioEconomico:FE1.AM3,fatoresCenarioInstitucionalLegal:FE2.AM2
		canvas:recebeEntradas entradasOrcamentoFinanciamento:EN1.1,entradasCapitalHumano:EN3.5,entradasCapitalHumano:EN3.7,entradasCapitalHumano:EN3.1,entradasDadosSistemasPlataformas:EN2.1, entradasInstrumentosLegaisNormativos:EN5.1, entradasInstrumentosLegaisNormativos:EN5.2
		canvas:executa atividadeChave:AC1, atividadeChave:AC3, atividadeChave:AC2, atividadeChave:AC4, atividadeChave:AC7, atividadeChave:AC6
		canvas:geraSaidas saida:SA1, saida:SA2, saida:SA3, saida:SA4, saida:SA5, saida:SA6, saida:SA7, saida:SA8, saida:SA9
		
		canvas:produzResultados RE.CP1, RE.MP1, RE.LP1, RE.LP2
		canvas:buscaAtingirGeral OB.GE
		canvas:buscaAtingirEspecifico OB.ES1, OB.ES2, OB.ES3, OB.ES4	
	]

	instance PR50 : programa:programaCTI [
		base:nome "BIA"
		base:descricao "Incentivar a adaptação à vida acadêmica e a inserção em atividades de ensino, pesquisa e extensão de alunos egressos da rede pública de ensino que obtiveram as melhores classificações nos exames vestibulares das Instituições públicas de Ensino Superior (IES) de Pernambuco, federais ou estaduais, buscando evitar que, por carência de recursos financeiros, estes alunos abandonem os cursos ainda no primeiro ano de estudo."
		base:id "PR50"
		programa:temCanvas CanvasPR50
		programa:temPlanoAvaliacao PA_BIA:PAV1
	]
	
	// Relações Direcionadas (Públicos-Alvo)
	relation instance CanvasPR50.direcionadoA.PU1.10 : canvas:direcionadoA [
		from CanvasPR50
		to publicosAcademiaICTs:PU1.10
		base:tipo "direto"
	]
	
	relation instance CanvasPR50.direcionadoA.PU1.2 : canvas:direcionadoA [
		from CanvasPR50
		to publicosAcademiaICTs:PU1.2
		base:tipo "direto"
	]
	
	relation instance CanvasPR50.direcionadoA.PU1.14 : canvas:direcionadoA [
		from CanvasPR50
		to publicosAcademiaICTs:PU1.14
		base:tipo "direto"
	]
	
	relation instance CanvasPR50.direcionadoA.PU2.5 : canvas:direcionadoA [
		from CanvasPR50
		to publicosGovernoInstituicoesPublicas:PU2.5
		base:tipo "indireto"
	]
	
	relation instance CanvasPR50.direcionadoA.PU2.2 : canvas:direcionadoA [
		from CanvasPR50
		to publicosGovernoInstituicoesPublicas:PU2.2
		base:tipo "indireto"
	]
	
	relation instance CanvasPR50.direcionadoA.PU5.1 : canvas:direcionadoA [
		from CanvasPR50
		to publicosSociedadeTerceiroSetor:PU5.1
		base:tipo "indireto"
	]
		
	// Objetivo Geral
	instance OB.GE : canvas:ObjetivoGeral [
		base:nome "Incentivar a adaptação à vida acadêmica e a inserção em atividades de ensino, pesquisa e extensão de alunos egressos da rede pública de ensino que obtiveram as melhores classificações no ENEM para as Instituições Públicas de Ensino Superior de Pernambuco, federais ou estaduais, buscando evitar que, por carência de recursos financeiros, estes alunos abandonem os cursos ainda no primeiro ano de estudo."
		base:id "OB.GE - BIA"
	]
	
	// Objetivos Específicos
	instance OB.ES1 : canvas:ObjetivoEspecifico [
		base:nome "Minimizar a evasão universitária no primeiro ano de estudo por carência de recursos financeiros."
		base:id "OB.ES1 - BIA"
		canvas:buscaAtingir RE.CP1
	]
	instance OB.ES2 : canvas:ObjetivoEspecifico [
		base:nome "Incentivar o aluno a dar continuidade na vida acadêmica concorrendo a programas de iniciação científica FACEPE a partir do segundo ano de graduação."
		base:id "OB.ES2 - BIA"
		canvas:buscaAtingir RE.MP1
	]
	instance OB.ES3 : canvas:ObjetivoEspecifico [
		base:nome "Incentivar o aluno a desenvolver habilidades por meio de atividades relacionadas à sua graduação, como outros programas de iniciação científica, programas de extensão ou tecnológico e de estágio, a partir do segundo ano de graduação."
		base:id "OB.ES3 - BIA"
		canvas:buscaAtingir RE.MP1
	]
	instance OB.ES4 : canvas:ObjetivoEspecifico [
		base:nome "Fortalecer o fluxo de talentos para a pós-graduação e diversos setores da economia."
		base:id "OB.ES4 - BIA"
		canvas:buscaAtingir RE.LP1, RE.LP2
	]
	
	// Resultados Esperados
	
	// Curto Prazo
	instance RE.CP1 : canvas:ResultadoEsperado [
		base:nome "Redução da evasão e retenção de alunos vulneráveis no primeiro ano de graduação."
		base:id "RE.CP1 - BIA"
		canvas:prazo "curto"
	]
	
	// Médio Prazo
	instance RE.MP1 : canvas:ResultadoEsperado [
		base:nome "Migração para programa PIBIC/ FACEPE ou outros programas (PIBIT/PET)."
		base:id "RE.MP1 - BIA"
		canvas:prazo "médio"
	]
	
	// Longo Prazo	
	instance RE.LP1 : canvas:ResultadoEsperado [
		base:nome "Elevação do percentual de egressos matriculados em programas de Mestrado (Acadêmico ou Profissional) em IES de Pernambuco."
		base:id "RE.LP1 - BIA"
		canvas:prazo "longo"
	]
	
	instance RE.LP2 : canvas:ResultadoEsperado [
		base:nome "Inserção de egressos em posições estratégicas na indústria/setor público que demandem competências técnicas e analíticas avançadas."
		base:id "RE.LP2 - BIA"
		canvas:prazo "longo"
	]
}
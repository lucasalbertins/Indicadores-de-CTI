description <http://secti.pe.gov.br/indicador_cti/description/programas/programasFormacaoFixacaoTalentos/BFP/BFP#> as BFP {
	
	extends <http://secti.pe.gov.br/indicador_cti/description/programas/programasFormacaoFixacaoTalentos/BFP/PA_BFP#> as PA_BFP
	extends <http://secti.pe.gov.br/indicador_cti/description/parceirosChave/parceirosGoverno#> as parceirosGoverno
	extends <http://secti.pe.gov.br/indicador_cti/description/parceirosChave/parceirosAgenciasFomento#> as parceirosAgenciasFomento
	extends <http://secti.pe.gov.br/indicador_cti/description/parceirosChave/parceirosAcademiaICTs#> as parceirosAcademiaICTs
	extends <http://secti.pe.gov.br/indicador_cti/description/fatoresExternos#> as fatorExterno
	extends <http://secti.pe.gov.br/indicador_cti/description/entradas/entradasOrcamentoFinanciamento#> as entradasOrcamentoFinanciamento
	extends <http://secti.pe.gov.br/indicador_cti/description/entradas/entradasDadosSistemasPlataformas#> as entradasDadosSistemasPlataformas
	extends <http://secti.pe.gov.br/indicador_cti/description/entradas/entradasCapitalHumano#> as entradasCapitalHumano
	extends <http://secti.pe.gov.br/indicador_cti/description/entradas/entradasInstrumentosLegaisNormativos#> as entradasInstrumentosLegaisNormativos
	extends <http://secti.pe.gov.br/indicador_cti/description/atividadesChave#> as atividadeChave
	extends <http://secti.pe.gov.br/indicador_cti/description/saidas#> as saida
	extends <http://secti.pe.gov.br/indicador_cti/description/publicosAlvo/publicosAcademiaICTs#> as publicosAcademiaICTs
	extends <http://secti.pe.gov.br/indicador_cti/description/publicosAlvo/publicosGovernoInstituicoesPublicas#> as publicosGovernoInstituicoesPublicas
	extends <http://secti.pe.gov.br/indicador_cti/description/publicosAlvo/publicosEmpresasEmpreendedores#> as publicosEmpresasEmpreendedores
	extends <http://secti.pe.gov.br/indicador_cti/description/publicosAlvo/publicosAmbientesInovacao#> as publicosAmbientesInovacao
	extends <http://secti.pe.gov.br/indicador_cti/description/publicosAlvo/publicosSociedadeTerceiroSetor#> as publicosSociedadeTerceiroSetor
	uses <http://secti.pe.gov.br/indicador_cti/vocabulary/base#> as base
	uses <http://secti.pe.gov.br/indicador_cti/vocabulary/DesignAvaliacao/canvas#> as canvas
	uses <http://secti.pe.gov.br/indicador_cti/vocabulary/programa#> as programa
	
	instance PR4 : programa:programaCTI [
		base:nome "Bolsa de Fixação de Pesquisador"
		base:descricao "É destinada a atrair e fixar doutores em instituições de ensino ou pesquisa (ICTs) e empresas em Pernambuco"
		base:id "PR4"
		programa:possuiParceiros parceirosAcademiaICTs:PC3.2, parceirosAcademiaICTs:PC3.4, parceirosGoverno:PC1.11, parceirosAgenciasFomento:PC2.9, 
		parceirosAgenciasFomento:PC2.10
		programa:condicionadoPor fatorExterno:FE.OP1, fatorExterno:FE.OP2, fatorExterno:FE.AM1, fatorExterno:FE.AM11, fatorExterno:FE.AM3, fatorExterno:FE.AM4
		programa:recebeEntradas entradasOrcamentoFinanciamento:EN1.1, entradasDadosSistemasPlataformas:EN2.1, entradasCapitalHumano:EN3.1, 
		entradasCapitalHumano:EN3.5, entradasCapitalHumano:EN3.7, entradasInstrumentosLegaisNormativos:EN5.1
		programa:executa atividadeChave:AC1, atividadeChave:AC2, atividadeChave:AC3, atividadeChave:AC4, atividadeChave:AC6, atividadeChave:AC7
		programa:geraSaidas saida:SA1, saida:SA2, saida:SA3, saida:SA4, saida:SA6, saida:SA7, saida:SA8
		programa:produzResultados RE.CP1, RE.CP2, RE.CP3, RE.CP4, RE.CP5, RE.MP1, RE.MP2, RE.MP3, RE.LP1, RE.LP2, RE.LP3
		programa:buscaAtingirGeral OB.GE
		programa:buscaAtingirEspecifico OB.ES1, OB.ES2, OB.ES3, OB.ES4, OB.ES5, OB.ES6
		programa:avaliadoPor PA_BFP:PA1, PA_BFP:PA2, PA_BFP:PA3, PA_BFP:PA4, PA_BFP:PA5, PA_BFP:PA6, PA_BFP:PA7, PA_BFP:PA8, PA_BFP:PA9, PA_BFP:PA10, PA_BFP:PA11
	]
	
	// Relações BFP --> Público-Alvo
	relation instance PR4.direcionadoA.PA1.2 : programa:direcionadoA [
		from PR4
		to publicosAcademiaICTs:PA1.2
		base:tipo "direto"
	]
	relation instance PR4.direcionadoA.PA1.6 : programa:direcionadoA [
		from PR4
		to publicosAcademiaICTs:PA1.6
		base:tipo "direto"
	]
	relation instance PR4.direcionadoA.PA1.13 : programa:direcionadoA [
		from PR4
		to publicosAcademiaICTs:PA1.13
		base:tipo "indireto"
	]
	relation instance PR4.direcionadoA.PA1.14 : programa:direcionadoA [
		from PR4
		to publicosAcademiaICTs:PA1.14
		base:tipo "indireto"
	]
	relation instance PR4.direcionadoA.PA2.2 : programa:direcionadoA [
		from PR4
		to publicosGovernoInstituicoesPublicas:PA2.2
		base:tipo "indireto"
	]
	relation instance PR4.direcionadoA.PA2.3 : programa:direcionadoA [
		from PR4
		to publicosGovernoInstituicoesPublicas:PA2.3
		base:tipo "indireto"
	]
	relation instance PR4.direcionadoA.PA3.2 : programa:direcionadoA [
		from PR4
		to publicosEmpresasEmpreendedores:PA3.2
		base:tipo "indireto"
	]
	relation instance PR4.direcionadoA.PA3.5 : programa:direcionadoA [
		from PR4
		to publicosEmpresasEmpreendedores:PA3.5
		base:tipo "indireto"
	]
	relation instance PR4.direcionadoA.PA4.1 : programa:direcionadoA [
		from PR4
		to publicosAmbientesInovacao:PA4.1
		base:tipo "indireto"
	]
	relation instance PR4.direcionadoA.PA4.6 : programa:direcionadoA [
		from PR4
		to publicosAmbientesInovacao:PA4.6
		base:tipo "indireto"
	]
	relation instance PR4.direcionadoA.PA4.7 : programa:direcionadoA [
		from PR4
		to publicosAmbientesInovacao:PA4.7
		base:tipo "indireto"
	]
	relation instance PR4.direcionadoA.PA4.8 : programa:direcionadoA [
		from PR4
		to publicosAmbientesInovacao:PA4.8
		base:tipo "indireto"
	]
	relation instance PR4.direcionadoA.PA5.1 : programa:direcionadoA [
		from PR4
		to publicosSociedadeTerceiroSetor:PA5.1
		base:tipo "indireto"
	]
	
	// Objetivo Geral
	instance OB.GE : canvas:ObjetivoGeral [
		base:nome "Incentivar a fixação de doutores no estado de Pernambuco em Instituições de ensino superior e pesquisa, Institutos de pesquisa e Empresas 
públicas de pesquisa e desenvolvimento que atuem em investigação científica, tecnológica e/ou inovação"
		base:id "OB.GE - BFP"
	]
	
	// Objetivos Específicos
	instance OB.ES1 : canvas:ObjetivoEspecifico [
		base:nome "Fixar pesquisadores altamente qualificados no ecossistema de CT&I do Estado"
		base:id "OB.ES1 - BFP"
		canvas:buscaAtingir RE.CP1, RE.MP1
	]
	instance OB.ES2 : canvas:ObjetivoEspecifico [
		base:nome "Contribuir para fortalecer e/ou nuclear os grupos de pesquisa atuantes no estado"
		base:id "OB.ES2 - BFP"
		canvas:buscaAtingir RE.CP2, RE.MP1
	]
	instance OB.ES3 : canvas:ObjetivoEspecifico [
		base:nome "Fomentar o desenvolvimento de pesquisa e inovação de excelência no estado"
		base:id "OB.ES3 - BFP"
		canvas:buscaAtingir RE.CP2, RE.CP4, RE.MP1
	]
	instance OB.ES4 : canvas:ObjetivoEspecifico [
		base:nome "Contribuição para formação de recursos humanos no estado"
		base:id "OB.ES4 - BFP"
		canvas:buscaAtingir RE.CP3, RE.LP3
	]
	instance OB.ES5 : canvas:ObjetivoEspecifico [
		base:nome "Estimular cooperações científicas e tecnológicas com organizações públicas e privadas, nacionais e internacionais"
		base:id "OB.ES5 - BFP"
		canvas:buscaAtingir RE.CP5, RE.MP1, RE.MP2, RE.MP3, RE.LP2
	]
	instance OB.ES6 : canvas:ObjetivoEspecifico [
		base:nome "Contribuir para o desenvolvimento científico, tecnológico ou de inovação"
		base:id "OB.ES6 - BFP"
		canvas:buscaAtingir RE.CP3, RE.CP4, RE.CP5, RE.MP1, RE.MP2, RE.MP3, RE.LP1, RE.LP2
	]
	
	// Resultados Esperados
	
	// Curto Prazo
	instance RE.CP1 : canvas:ResultadoEsperado [
		base:nome "Absorção e fixação de doutores pelo ecossistema de CT&I do estado"
		base:id "RE.CP1 - BFP"
		canvas:prazo "curto"
	]
	instance RE.CP2 : canvas:ResultadoEsperado [
		base:nome "Aumento da produção científica, tecnológica e de inovação dos grupos de pesquisa em Pernambuco no qual o bolsista está associado"
		base:id "RE.CP2 - BFP"
		canvas:prazo "curto"
	]
	instance RE.CP3 : canvas:ResultadoEsperado [
		base:nome "Aumento do número de trabalhos de IC, TCC, pós-graduação, extensão e inovação orientados e/ou coorientados pelo bolsista BFP"
		base:id "RE.CP3 - BFP"
		canvas:prazo "curto"
	]
	instance RE.CP4 : canvas:ResultadoEsperado [
		base:nome "Aumento da Proteção intelectual do conhecimento gerado por meio de patentes depositadas e/ou programas de software registrados"
		base:id "RE.CP4 - BFP"
		canvas:prazo "curto"
	]
	instance RE.CP5 : canvas:ResultadoEsperado [
		base:nome "Cooperação científica e tecnológica nacional e internacional incrementado"
		base:id "RE.CP5 - BFP"
		canvas:prazo "curto"
	]
	
	// Médio Prazo
	instance RE.MP1 : canvas:ResultadoEsperado [
		base:nome "Aumento do conceito CAPES dos PPGs"
		base:id "RE.MP1 - BFP"
		canvas:prazo "médio"
	]
	instance RE.MP2 : canvas:ResultadoEsperado [
		base:nome "Aumento de Startups de base científica e tecnológica e Spin-offs acadêmicos"
		base:id "RE.MP2 - BFP"
		canvas:prazo "médio"
	]
	instance RE.MP3 : canvas:ResultadoEsperado [
		base:nome "Geração de inovações (produtos, processos, soluções, serviços) para Indústria, Governo e Sociedade"
		base:id "RE.MP3 - BFP"
		canvas:prazo "médio"
	]
	
	// Longo Prazo
	instance RE.LP1 : canvas:ResultadoEsperado [
		base:nome "Evolução dos índices econômicos, sociais e ambientais do estado"
		base:id "RE.LP1 - BFP"
		canvas:prazo "longo"
	]
	instance RE.LP2 : canvas:ResultadoEsperado [
		base:nome "Licenciamento da propriedade intelectual pela Indústria e Governo"
		base:id "RE.LP2 - BFP"
		canvas:prazo "longo"
	]
	instance RE.LP3 : canvas:ResultadoEsperado [
		base:nome "Empregabilidade dos egressos BFP de alto nível salarial"
		base:id "RE.LP3 - BFP"
		canvas:prazo "longo"
	]
}
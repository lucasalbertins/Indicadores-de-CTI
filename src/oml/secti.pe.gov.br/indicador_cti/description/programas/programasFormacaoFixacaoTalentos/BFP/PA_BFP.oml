	]
	
	instance PA5.ES : planoAvaliacao:escopo [
		base:descricao "Espera-se identificar a evolução da participação científica dos bolsistas BFP em projetos com cooperação nacional e internacional. A 
comparação será longitudinal (ao longo dos anos) do próprio BFP e transversal entre o grupo tratado (bolsistas BFP) e o grupo controle 
(doutores titulados em ICT-PE não contemplados com bolsa BFP)"
		base:id "PA5.ES - BFP"
	]
	instance PA5.MA1 : planoAvaliacao:metodoAvaliacao [

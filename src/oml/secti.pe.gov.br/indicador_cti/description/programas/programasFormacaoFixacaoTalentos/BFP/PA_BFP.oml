	//Limitações
	instance LIM1 : planoAvaliacao:limitacao [
		base:descricao "A análise identifica correlação, mas não garante identificar a causalidade entre as cotas BFP que os bolsistas recebem e a evolução da 
produção científica dos bolsistas"
	]
	instance LIM2 : planoAvaliacao:limitacao [
		base:descricao "Informação do lattes pode estar desatualizada ou o bolsista não informar (co)orientação ativa/concluída"
	]
	instance LIM3 : planoAvaliacao:limitacao [
		base:descricao "Não há garantia da precisão da análise devido a necessidade de dados primários"
	]

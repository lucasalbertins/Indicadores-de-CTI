	// Escopos e Métodos de Avaliação
	instance PA1.ES : planoAvaliacao:escopo [
		base:descricao "Espera-se identificar a efetiva contribuição do BFP para a fixação de doutores em Pernambuco. A comparação será longitudinal 
(ao longo dos anos) do próprio BFP e transversal entre o grupo tratado (bolsistas do BFP) e o grupo controle (doutores que pleitearam a bolsa BFP e não foram 
contemplados)"
		base:id "PA1.ES - BFP"
	]
	instance PA1.MA1 : planoAvaliacao:metodoAvaliacao [
		base:descricao "Análise descritiva"
		base:id "PA1.MA1 - BFP"
	]
	instance PA1.MA4 : planoAvaliacao:metodoAvaliacao [
		base:descricao "Regressão descontínua"
		base:id "PA1.MA4 - BFP"
	]
	
	instance PA2.ES : planoAvaliacao:escopo [
		base:descricao "Espera-se identificar a evolução da produtividade científica e tecnológica dos bolsistas BFP. A comparação será longitudinal 
(ao longo dos anos) do próprio BFP e o grupo controle (doutores que pleitearam a bolsa BFP e não foram contemplados)"

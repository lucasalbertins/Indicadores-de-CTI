	instance P9 : planoAvaliacao:questaoAvaliacao[
		base:nome "P9"
		base:descricao "Quantas patentes foram depositadas e programas de computador foram registrados em co-autoria com organizações (empresas, ICT, governo) públicas ou privadas, nacionais ou internacionais por bolsistas PBPG em até 02 anos após a titulação?"
		planoAvaliacao:temMetodologia MA1P5 
		planoAvaliacao:temEscopo escopoP5		

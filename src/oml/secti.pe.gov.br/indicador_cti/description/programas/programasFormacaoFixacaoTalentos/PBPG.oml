		planoAvaliacao:temRisco R1,R3,R4,R5,R6,R7,R8,R9
		planoAvaliacao:temLimitacao LP5
	]
	
	instance P6 : planoAvaliacao:questaoAvaliacao[
		base:nome "P6"
		base:descricao "Quantas publicações em periódicos e eventos de alto impacto, nacionais e internacionais, foram realizadas por bolsistas do PBPG em até 02 anos após a titulação?"
		planoAvaliacao:temMetodologia MA1P6 
		planoAvaliacao:temEscopo escopoP6		

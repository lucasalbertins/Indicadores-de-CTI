description <http://secti.pe.gov.br/indicador_cti/description/programas/programasFormacaoFixacaoTalentos/PBPG/metricasPBPG/PA11.ME1#> as PA11.ME1 {

	// Gerado por scripts/gerar_metricas_oml.py a partir de formulas.json.
	// Fórmula, argumentos e operações OpenMath vêm do JSON; temFonte,
	// finalidade e valores vêm do PA-PBPG.oml (métrica PA11.ME1).

	extends <http://secti.pe.gov.br/indicador_cti/description/fontesInformacao/fontesBasesAcademicasCientificasEducacionais#> as fontesBasesAcademicasCientificasEducacionais
	extends <http://secti.pe.gov.br/indicador_cti/description/fontesInformacao/fontesDadosPrimarios#> as fontesDadosPrimarios
	extends <http://secti.pe.gov.br/indicador_cti/description/fontesInformacao/fontesSistemasBasesGovernamentais#> as fontesSistemasBasesGovernamentais
	uses <http://secti.pe.gov.br/indicador_cti/vocabulary/DesignAvaliacao/metricas#> as metricas
	uses <http://secti.pe.gov.br/indicador_cti/vocabulary/DesignAvaliacao/formulas#> as formulas
	uses <http://secti.pe.gov.br/indicador_cti/vocabulary/base#> as base
	uses <http://www.w3.org/2001/XMLSchema#> as xsd

	// ESTRATIFICAÇÕES (dimensões de desagregação citadas na descrição)
	instance estratAno : formulas:estratificacao [
		base:id "estrat_ano_PA11.ME1"
		base:nome "Ano"
	]

	instance estratModalidade : formulas:estratificacao [
		base:id "estrat_modalidade_PA11.ME1"
		base:nome "Modalidade"
	]

	instance estratArea : formulas:estratificacao [
		base:id "estrat_area_PA11.ME1"
		base:nome "Grande Área do Conhecimento FACEPE"
	]

	instance estratRDE : formulas:estratificacao [
		base:id "estrat_rde_PA11.ME1"
		base:nome "Região de Desenvolvimento do Estado"
	]

	// MÉTRICA
	instance quantidadeBolsistasEmStartups : metricas:metrica [
		base:id "PA11.ME1_PBPG"
		base:nome "Quantidade Bolsistas em Startups"
		base:descricao "Número de bolsistas PBPG diretamente envolvidos em atividades de empresas nascentes (startups) de base científica e tecnológica, em até 5 anos após a titulação, desagregado por ano de titulação, modalidade (mestrado e doutorado), grande área de conhecimento FACEPE e Região de Desenvolvimento do Estado (RDE)."
		formulas:possuiFormula formulaIdentidade
		formulas:estratificadaPor estratAno
		formulas:estratificadaPor estratModalidade
		formulas:estratificadaPor estratArea
		formulas:estratificadaPor estratRDE
		metricas:temFonte fontesDadosPrimarios:FI1.1, fontesSistemasBasesGovernamentais:FI2.1, fontesBasesAcademicasCientificasEducacionais:FI3.1
	]

	// fórmula raiz
	instance formulaIdentidade : formulas:formula [
		base:id "formula_identidade_PA11.ME1"
		formulas:referenciaOperacao "http://www.openmath.org/cd/fns1#identity"
		formulas:possuiArgumento argQuantidadeBolsistasEmStartups
		formulas:formulaDe quantidadeBolsistasEmStartups
	]

	instance argQuantidadeBolsistasEmStartups : formulas:argumento [
		base:id "arg_quantidade_bolsistas_em_startups_PA11.ME1"
		formulas:posicao "1"^^xsd:int
		formulas:nome "Quantidade Bolsistas em Startups"
		formulas:possuiValor valQuantidadeBolsistasEmStartups
		formulas:argumentoDe formulaIdentidade
	]

	// PENDENTE: no Plano de Avaliação este operando é uma métrica
	// simples própria; até que ela exista, fica a chave de extração.
	instance valQuantidadeBolsistasEmStartups : formulas:tipovalorMetrica [
		base:id "val_quantidade_bolsistas_em_startups_PA11.ME1"
		formulas:valorMetrica "primario.quantidade.bolsistas.em.startups"
	]

}

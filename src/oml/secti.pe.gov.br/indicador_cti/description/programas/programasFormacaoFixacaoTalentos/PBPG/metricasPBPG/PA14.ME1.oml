description <http://secti.pe.gov.br/indicador_cti/description/programas/programasFormacaoFixacaoTalentos/PBPG/metricasPBPG/PA14.ME1#> as PA14.ME1 {

	// Gerado por scripts/gerar_metricas_oml.py a partir de formulas.json.
	// Fórmula, argumentos e operações OpenMath vêm do JSON; temFonte,
	// finalidade e valores vêm do PA-PBPG.oml (métrica PA14.ME1).

	extends <http://secti.pe.gov.br/indicador_cti/description/fontesInformacao/fontesBasesAcademicasCientificasEducacionais#> as fontesBasesAcademicasCientificasEducacionais
	extends <http://secti.pe.gov.br/indicador_cti/description/fontesInformacao/fontesDadosPrimarios#> as fontesDadosPrimarios
	extends <http://secti.pe.gov.br/indicador_cti/description/fontesInformacao/fontesInfraestruturaAtivosCTI#> as fontesInfraestruturaAtivosCTI
	extends <http://secti.pe.gov.br/indicador_cti/description/fontesInformacao/fontesSistemasBasesGovernamentais#> as fontesSistemasBasesGovernamentais
	uses <http://secti.pe.gov.br/indicador_cti/vocabulary/DesignAvaliacao/metricas#> as metricas
	uses <http://secti.pe.gov.br/indicador_cti/vocabulary/DesignAvaliacao/formulas#> as formulas
	uses <http://secti.pe.gov.br/indicador_cti/vocabulary/base#> as base
	uses <http://www.w3.org/2001/XMLSchema#> as xsd

	// ESTRATIFICAÇÕES (dimensões de desagregação citadas na descrição)
	instance estratAno : formulas:estratificacao [
		base:id "estrat_ano_PA14.ME1"
		base:nome "Ano"
	]

	instance estratModalidade : formulas:estratificacao [
		base:id "estrat_modalidade_PA14.ME1"
		base:nome "Modalidade"
	]

	instance estratArea : formulas:estratificacao [
		base:id "estrat_area_PA14.ME1"
		base:nome "Grande Área do Conhecimento FACEPE"
	]

	// MÉTRICA
	instance quantidadePiLicenciadasBolsistas : metricas:metrica [
		base:id "PA14.ME1_PBPG"
		base:nome "Quantidade PI Licenciadas Bolsistas"
		base:descricao "Número de Propriedade Intelectual (PI) licenciada/comercializada de bolsistas PBPG em até 10 anos após a titulação, desagregado por ano de titulação, modalidade (mestrado e doutorado) e grande área de conhecimento FACEPE."
		formulas:possuiFormula formulaIdentidade
		formulas:estratificadaPor estratAno
		formulas:estratificadaPor estratModalidade
		formulas:estratificadaPor estratArea
		metricas:temFonte fontesDadosPrimarios:FI1.1, fontesSistemasBasesGovernamentais:FI2.1, fontesBasesAcademicasCientificasEducacionais:FI3.1, fontesInfraestruturaAtivosCTI:FI4.2
	]

	// fórmula raiz
	instance formulaIdentidade : formulas:formula [
		base:id "formula_identidade_PA14.ME1"
		formulas:referenciaOperacao "http://www.openmath.org/cd/fns1#identity"
		formulas:possuiArgumento argQuantidadePiLicenciadasBolsistas
		formulas:formulaDe quantidadePiLicenciadasBolsistas
	]

	instance argQuantidadePiLicenciadasBolsistas : formulas:argumento [
		base:id "arg_quantidade_pi_licenciadas_bolsistas_PA14.ME1"
		formulas:posicao "1"^^xsd:int
		formulas:nome "Quantidade PI Licenciadas Bolsistas"
		formulas:possuiValor valQuantidadePiLicenciadasBolsistas
		formulas:argumentoDe formulaIdentidade
	]

	// PENDENTE: no Plano de Avaliação este operando é uma métrica
	// simples própria; até que ela exista, fica a chave de extração.
	instance valQuantidadePiLicenciadasBolsistas : formulas:tipovalorMetrica [
		base:id "val_quantidade_pi_licenciadas_bolsistas_PA14.ME1"
		formulas:valorMetrica "primario.quantidade.pi.licenciadas.bolsistas"
	]

}

description <http://secti.pe.gov.br/indicador_cti/description/programas/programasFormacaoFixacaoTalentos/PBPG/metricasPBPG/PA5.ME3#> as PA5.ME3 {

	// Gerado por scripts/gerar_metricas_oml.py a partir de formulas.json.
	// Fórmula, argumentos e operações OpenMath vêm do JSON; temFonte,
	// finalidade e valores vêm do PA-PBPG.oml (métrica PA5.ME3).

	extends <http://secti.pe.gov.br/indicador_cti/description/fontesInformacao/fontesBasesAcademicasCientificasEducacionais#> as fontesBasesAcademicasCientificasEducacionais
	extends <http://secti.pe.gov.br/indicador_cti/description/fontesInformacao/fontesSistemasBasesGovernamentais#> as fontesSistemasBasesGovernamentais
	uses <http://secti.pe.gov.br/indicador_cti/vocabulary/DesignAvaliacao/metricas#> as metricas
	uses <http://secti.pe.gov.br/indicador_cti/vocabulary/DesignAvaliacao/formulas#> as formulas
	uses <http://secti.pe.gov.br/indicador_cti/vocabulary/base#> as base
	uses <http://www.w3.org/2001/XMLSchema#> as xsd

	// ESTRATIFICAÇÕES (dimensões de desagregação citadas na descrição)
	instance estratAno : formulas:estratificacao [
		base:id "estrat_ano_PA5.ME3"
		base:nome "Ano"
	]

	instance estratArea : formulas:estratificacao [
		base:id "estrat_area_PA5.ME3"
		base:nome "Grande Área do Conhecimento FACEPE"
	]

	// MÉTRICA
	instance quantidadePublicacoesPeriodicosScopusDocentes : metricas:metrica [
		base:id "PA5.ME3_PBPG"
		base:nome "Quantidade Publicações Periódicos Scopus Docentes"
		base:descricao "Número anual de publicações em periódicos indexados na base científica Scopus dos docentes permanentes dos PPG apoiados pelo PBPG desagregado pela grande área do conhecimento FACEPE."
		formulas:possuiFormula formulaIdentidade
		formulas:estratificadaPor estratAno
		formulas:estratificadaPor estratArea
		metricas:temFonte fontesSistemasBasesGovernamentais:FI2.1, fontesBasesAcademicasCientificasEducacionais:FI3.1, fontesBasesAcademicasCientificasEducacionais:FI3.4
	]

	// fórmula raiz
	instance formulaIdentidade : formulas:formula [
		base:id "formula_identidade_PA5.ME3"
		formulas:referenciaOperacao "http://www.openmath.org/cd/fns1#identity"
		formulas:possuiArgumento argQuantidadePublicacoesPeriodicosScopusDocentes
		formulas:formulaDe quantidadePublicacoesPeriodicosScopusDocentes
	]

	instance argQuantidadePublicacoesPeriodicosScopusDocentes : formulas:argumento [
		base:id "arg_quantidade_publicacoes_periodicos_scopus_docentes_PA5.ME3"
		formulas:posicao "1"^^xsd:int
		formulas:nome "Quantidade Publicações Periódicos Scopus Docentes"
		formulas:possuiValor valQuantidadePublicacoesPeriodicosScopusDocentes
		formulas:argumentoDe formulaIdentidade
	]

	// PENDENTE: no Plano de Avaliação este operando é uma métrica
	// simples própria; até que ela exista, fica a chave de extração.
	instance valQuantidadePublicacoesPeriodicosScopusDocentes : formulas:tipovalorMetrica [
		base:id "val_quantidade_publicacoes_periodicos_scopus_docentes_PA5.ME3"
		formulas:valorMetrica "agilfap.quantidade.publicacoes.periodicos.scopus.docentes"
	]

}

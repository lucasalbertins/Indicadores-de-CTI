description <http://secti.pe.gov.br/indicador_cti/description/programas/programasFormacaoFixacaoTalentos/PBPG/metricasPBPG/PA4.ME1#> as PA4.ME1 {

	// Gerado por scripts/gerar_metricas_oml.py a partir de formulas.json.
	// Fórmula, argumentos e operações OpenMath vêm do JSON; temFonte,
	// finalidade e valores vêm do PA-PBPG.oml (métrica PA4.ME1).

	extends <http://secti.pe.gov.br/indicador_cti/description/fontesInformacao/fontesBasesAcademicasCientificasEducacionais#> as fontesBasesAcademicasCientificasEducacionais
	extends <http://secti.pe.gov.br/indicador_cti/description/fontesInformacao/fontesSistemasBasesGovernamentais#> as fontesSistemasBasesGovernamentais
	uses <http://secti.pe.gov.br/indicador_cti/vocabulary/DesignAvaliacao/metricas#> as metricas
	uses <http://secti.pe.gov.br/indicador_cti/vocabulary/DesignAvaliacao/formulas#> as formulas
	uses <http://secti.pe.gov.br/indicador_cti/vocabulary/base#> as base
	uses <http://www.w3.org/2001/XMLSchema#> as xsd

	// ESTRATIFICAÇÕES (dimensões de desagregação citadas na descrição)
	instance estratQuadrienio : formulas:estratificacao [
		base:id "estrat_quadrienio_PA4.ME1"
		base:nome "Quadriênio de Avaliação"
	]

	// MÉTRICA
	instance conceitoPpg : metricas:metrica [
		base:id "PA4.ME1_PBPG"
		base:nome "Conceito PPG"
		base:descricao "Conceito CAPES dos Programas de Pós-graduação (PPG) apoiados pelo PBPG por avaliação quadrienal."
		formulas:possuiFormula formulaIdentidade
		formulas:estratificadaPor estratQuadrienio
		metricas:temFonte fontesSistemasBasesGovernamentais:FI2.1, fontesBasesAcademicasCientificasEducacionais:FI3.1
	]

	// fórmula raiz
	instance formulaIdentidade : formulas:formula [
		base:id "formula_identidade_PA4.ME1"
		formulas:referenciaOperacao "http://www.openmath.org/cd/fns1#identity"
		formulas:possuiArgumento argConceitoppg
		formulas:formulaDe conceitoPpg
	]

	instance argConceitoppg : formulas:argumento [
		base:id "arg_conceitoppg_PA4.ME1"
		formulas:posicao "1"^^xsd:int
		formulas:nome "ConceitoPPG"
		formulas:possuiValor valConceitoppg
		formulas:argumentoDe formulaIdentidade
	]

	// PENDENTE: no Plano de Avaliação este operando é uma métrica
	// simples própria; até que ela exista, fica a chave de extração.
	instance valConceitoppg : formulas:tipovalorMetrica [
		base:id "val_conceitoppg_PA4.ME1"
		formulas:valorMetrica "agilfap.conceitoppg"
	]

}

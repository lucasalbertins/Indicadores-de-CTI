		base:descricao "Número de bolsistas PBPG diretamente envolvidos em atividades de empresas nascentes (startups) de base científica e tecnológica, em até 5 
anos após a titulação, desagregado por ano de titulação, modalidade (mestrado e doutorado), grande área de conhecimento FACEPE e Região de Desenvolvimento do 
Estado (RDE)"
		base:id "PA11.ME1 - PBPG"
		metricas:temFonte fontesDadosPrimarios:FI1.1, fontesSistemasBasesGovernamentais:FI2.1, fontesBasesAcademicasCientificasEducacionais:FI3.1
	]
	instance PA11.ME2 : metricas:metrica [
		base:nome "Taxa Bolsistas em Startups"
		base:descricao "Número de bolsistas PBPG diretamente envolvidos em atividades de empresas nascentes (startups) de base científica e tecnológica do estado 
de Pernambuco, em até 5 anos após a titulação, sobre o número de bolsistas PPG respondentes do survey, desagregado por ano de titulação, modalidade 
(mestrado e doutorado), grande área de conhecimento FACEPE e Região de Desenvolvimento do Estado (RDE)"
		base:id "PA11.ME2 - PBPG"
		metricas:temFonte fontesDadosPrimarios:FI1.1, fontesSistemasBasesGovernamentais:FI2.1, fontesBasesAcademicasCientificasEducacionais:FI3.1
	]
	
	instance PA12.ME1 : metricas:metrica [

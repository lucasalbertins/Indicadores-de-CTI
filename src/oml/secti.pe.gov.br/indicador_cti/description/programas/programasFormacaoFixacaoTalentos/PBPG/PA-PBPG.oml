description <http://secti.pe.gov.br/indicador_cti/description/programas/programasFormacaoFixacaoTalentos/PBPG/PA-PBPG#> as PA-PBPG {
	
	extends <http://secti.pe.gov.br/indicador_cti/description/fontesInformacao/fontesDadosPrimarios#> as fontesDadosPrimarios
	extends <http://secti.pe.gov.br/indicador_cti/description/fontesInformacao/fontesSistemasBasesGovernamentais#> as fontesSistemasBasesGovernamentais
	extends <http://secti.pe.gov.br/indicador_cti/description/fontesInformacao/fontesBasesAcademicasCientificasEducacionais#> as fontesBasesAcademicasCientificasEducacionais
	extends <http://secti.pe.gov.br/indicador_cti/description/fontesInformacao/fontesInfraestruturaAtivosCTI#> as fontesInfraestruturaAtivosCTI
	extends <http://secti.pe.gov.br/indicador_cti/description/fontesInformacao/fontesDadosSocioeconomicosTerritoriais#> as fontesDadosSocioeconomicosTerritoriais
	extends <http://secti.pe.gov.br/indicador_cti/description/programas/programasFormacaoFixacaoTalentos/PBPG/PBPG#> as PBPG
	uses <http://secti.pe.gov.br/indicador_cti/vocabulary/base#> as base
	uses <http://secti.pe.gov.br/indicador_cti/vocabulary/DesignAvaliacao/planoAvaliacao#> as planoAvaliacao
	uses <http://secti.pe.gov.br/indicador_cti/vocabulary/DesignAvaliacao/metricas#> as metricas
	
	instance PA1 : planoAvaliacao:questaoAvaliacao [
		base:nome "Qual a taxa de sucesso e quantos bolsistas PBPG foram titulados como mestres e doutores, por ano, por prazo (regular ou prorrogado), por área de conhecimento e por região de desenvolvimento do Estado?"
		base:id "PA1 - PBPG"
		planoAvaliacao:custo "Moderado"
		planoAvaliacao:risco "Médio"
		planoAvaliacao:temMetrica PA1.ME1, PA1.ME2, PA1.ME3, PA1.ME4
		planoAvaliacao:temEscopo PA1.ES
		planoAvaliacao:temMetodologia PA1.MA1
		planoAvaliacao:alinhaComResultado PBPG:RE.CP1
	]
	instance PA2 : planoAvaliacao:questaoAvaliacao [
		base:nome "Qual o quantitativo e o percentual de dissertações/teses desenvolvidas por bolsistas PBPG em áreas estratégicas prioritárias para Pernambuco?"
		base:id "PA2 - PBPG"
		planoAvaliacao:custo "Alto"
		planoAvaliacao:risco "Médio"
		planoAvaliacao:temMetrica PA2.ME1, PA2.ME2
		planoAvaliacao:temEscopo PA2.ES
		planoAvaliacao:temMetodologia PA2.MA1
		planoAvaliacao:alinhaComResultado PBPG:RE.CP4
	]
	instance PA3 : planoAvaliacao:questaoAvaliacao [
		base:nome "Qual a taxa de fixação de egressos do PBPG no Estado, por segmento (governo, empresas, ICT) e por região de desenvolvimento, após 2 anos da titulação?"
		base:id "PA3 - PBPG"
		planoAvaliacao:custo "Alto"
		planoAvaliacao:risco "Médio"
		planoAvaliacao:temMetrica PA3.ME1, PA3.ME2, PA3.ME3
		planoAvaliacao:temEscopo PA3.ES
		planoAvaliacao:temMetodologia PA3.MA1
		planoAvaliacao:alinhaComResultado PBPG:RE.MP1
	]
	instance PA4 : planoAvaliacao:questaoAvaliacao [
		base:nome "Qual a evolução do conceito CAPES dos PPGs apoiados pelo PBPG?"
		base:id "PA4 - PBPG"
		planoAvaliacao:custo "Baixo"
		planoAvaliacao:risco "Médio"
		planoAvaliacao:temMetrica PA4.ME1, PA4.ME2, PA4.ME3
		planoAvaliacao:temEscopo PA4.ES
		planoAvaliacao:temMetodologia PA4.MA1
		planoAvaliacao:temLimitacao LIM1
		planoAvaliacao:alinhaComResultado PBPG:RE.MP2, PBPG:RE.MP3
	]
	instance PA5 : planoAvaliacao:questaoAvaliacao [
		base:nome "Qual a evolução da qualidade científica e tecnológica (quantitativo de citações, publicações, índice h, bolsa de produtividade, patentes, startups) dos docentes permanentes (orientadores) dos PPGs apoiados pelo PBPG?"
		base:id "PA5 - PBPG"
		planoAvaliacao:custo "Alto"
		planoAvaliacao:risco "Médio"
		planoAvaliacao:temMetrica PA5.ME1, PA5.ME2, PA5.ME3, PA5.ME4, PA5.ME5, PA5.ME6, PA5.ME7, PA5.ME8, PA5.ME9, PA5.ME10, PA5.ME11, PA5.ME12, PA5.ME13
		planoAvaliacao:temEscopo PA5.ES
		planoAvaliacao:temMetodologia PA5.MA1, PA5.MA5
		planoAvaliacao:temLimitacao LIM2
		planoAvaliacao:alinhaComResultado PBPG:RE.CP2, PBPG:RE.CP3, PBPG:RE.MP4
	]
	instance PA6 : planoAvaliacao:questaoAvaliacao [
		base:nome "Quantas publicações em periódicos e eventos de alto impacto, nacionais e internacionais, foram realizadas por bolsistas do PBPG em até 02 anos após a titulação?"
		base:id "PA6 - PBPG"
		planoAvaliacao:custo "Alto"
		planoAvaliacao:risco "Médio"
		planoAvaliacao:temMetrica PA6.ME1, PA6.ME2, PA6.ME3, PA6.ME4, PA6.ME5, PA6.ME6, PA6.ME7, PA6.ME8, PA6.ME9, PA6.ME10, PA6.ME11, PA6.ME12
		planoAvaliacao:temEscopo PA6.ES
		planoAvaliacao:temMetodologia PA6.MA1
		planoAvaliacao:alinhaComResultado PBPG:RE.CP2
	]
	instance PA7 : planoAvaliacao:questaoAvaliacao [
		base:nome "Quantas patentes foram depositadas e programas de computador foram registrados por egressos PBPG em até dois anos após a titulação?"
		base:id "PA7 - PBPG"
		planoAvaliacao:custo "Moderado"
		planoAvaliacao:risco "Médio"
		planoAvaliacao:temMetrica PA7.ME1, PA7.ME2, PA7.ME3, PA7.ME4, PA7.ME5
		planoAvaliacao:temEscopo PA7.ES
		planoAvaliacao:temMetodologia PA7.MA1
		planoAvaliacao:alinhaComResultado PBPG:RE.CP3
	]
	instance PA8 : planoAvaliacao:questaoAvaliacao [
		base:nome "Quantas publicações em co-autoria com organizações (empresas, ICT e governo) públicas ou privadas, nacionais ou estrangeiras foram realizadas por bolsistas PBPG em até dois anos após a titulação?"
		base:id "PA8 - PBPG"
		planoAvaliacao:custo "Moderado"
		planoAvaliacao:risco "Médio"
		planoAvaliacao:temMetrica PA8.ME1, PA8.ME2, PA8.ME3, PA8.ME4, PA8.ME5
		planoAvaliacao:temEscopo PA8.ES
		planoAvaliacao:temMetodologia PA8.MA1
		planoAvaliacao:alinhaComResultado PBPG:RE.CP2
	]
	instance PA9 : planoAvaliacao:questaoAvaliacao [
		base:nome "Quantas patentes foram depositadas e programas de computador foram registrados em co-autoria com organizações (empresas, ICT, governo) públicas ou privadas, nacionais ou internacionais por bolsistas PBPG em até 02 anos após a titulação?"
		base:id "PA9 - PBPG"
		planoAvaliacao:custo "Moderado"
		planoAvaliacao:risco "Médio"
		planoAvaliacao:temMetrica PA9.ME1, PA9.ME2, PA9.ME3, PA9.ME4, PA9.ME5
		planoAvaliacao:temEscopo PA9.ES
		planoAvaliacao:temMetodologia PA9.MA1
		planoAvaliacao:alinhaComResultado PBPG:RE.CP3
	]
	instance PA10 : planoAvaliacao:questaoAvaliacao [
		base:nome "Quantos mestrados/doutorados sanduíche foram realizados por bolsistas PBPG em ICT nacionais e internacionais?"
		base:id "PA10 - PBPG"
		planoAvaliacao:custo "Moderado"
		planoAvaliacao:risco "Alto"
		planoAvaliacao:temMetrica PA10.ME1, PA10.ME2, PA10.ME3
		planoAvaliacao:temEscopo PA10.ES
		planoAvaliacao:temMetodologia PA10.MA1
		planoAvaliacao:alinhaComResultado PBPG:RE.CP5
	]
	instance PA11 : planoAvaliacao:questaoAvaliacao [
		base:nome "Quantos estágios pós-doutoral foram realizados por egressos do PBPG em até 02 anos após a titulação em outra ICT?"
		base:id "PA11 - PBPG"
		planoAvaliacao:custo "Alto"
		planoAvaliacao:risco "Alto"
		planoAvaliacao:temMetrica PA11.ME1, PA11.ME2
		planoAvaliacao:temEscopo PA11.ES
		planoAvaliacao:temMetodologia PA11.MA1
		planoAvaliacao:alinhaComResultado PBPG:RE.CP5
	]
	instance PA12 : planoAvaliacao:questaoAvaliacao [
		base:nome "Quantos bolsistas PPBG foram co-orientados por pesquisadores de outras ICTs e/ou co-titulados (co-tutela) mestres e doutores?"
		base:id "PA12 - PBPG"
		planoAvaliacao:custo "Moderado"
		planoAvaliacao:risco "Médio"
		planoAvaliacao:temMetrica PA12.ME1, PA12.ME2, PA12.ME3, PA12.ME4
		planoAvaliacao:temEscopo PA12.ES
		planoAvaliacao:temMetodologia PA12.MA1
		planoAvaliacao:alinhaComResultado PBPG:RE.CP5
	]
	instance PA13 : planoAvaliacao:questaoAvaliacao [
		base:nome "Quantas inovações (produtos, processos, serviços) fomentadas pelo PPBG foram adotadas por empresas e pelo governo?"
		base:id "PA13 - PBPG"
		planoAvaliacao:custo "Alto"
		planoAvaliacao:risco "Médio"
		planoAvaliacao:temMetrica PA13.ME1, PA13.ME2, PA13.ME3, PA13.ME4
		planoAvaliacao:temEscopo PA13.ES
		planoAvaliacao:temMetodologia PA13.MA1
		planoAvaliacao:temLimitacao LIM3
		planoAvaliacao:alinhaComResultado PBPG:RE.MP5
	]
	instance PA14 : planoAvaliacao:questaoAvaliacao [
		base:nome "Quantas startups de base científica e tecnológica e spin-offs acadêmicos foram criados com a participação direta de egressos do PBPG?"
		base:id "PA14 - PBPG"
		planoAvaliacao:custo "Alto"
		planoAvaliacao:risco "Alto"
		planoAvaliacao:temMetrica PA14.ME1
		planoAvaliacao:temEscopo PA14.ES
		planoAvaliacao:temMetodologia PA14.MA1
		planoAvaliacao:temLimitacao LIM3
		planoAvaliacao:alinhaComResultado PBPG:RE.MP4
	]
	
	//Métricas	
	// Inserindo Cenário: Meta 80%, Atingido 90% (Sucesso)
	instance PA1.ME1 : metricas:metrica [
		base:nome "Taxa Titulação"
		base:descricao "Número de bolsistas PBPG titulados no semestre sobre o total de cotas PBPG encerradas no semestre, desagregado por modalidade 
(mestrado e doutorado), grande área do conhecimento FACEPE, e Região de Desenvolvimento do Estado (RDE)"
		base:id "PA1.ME1 - PBPG"
		metricas:temFonte fontesSistemasBasesGovernamentais:FI2.1, fontesBasesAcademicasCientificasEducacionais:FI3.1
		metricas:finalidade "Maximizar"
		metricas:valorAtual 0.90
		metricas:valorMeta  0.80
	]
	instance PA1.ME2 : metricas:metrica[
		base:nome "Quantidade Titulados"
		base:descricao "Número de bolsistas PBPG titulados, desagregado por: semestre, modalidade (Mestrado e Doutorado), prazo de conclusão 
(regular e com prorrogação), Grande Área do Conhecimento FACEPE, e Região de Desenvolvimento do Estado (RDE)"
		base:id "PA1.ME2 - PBPG"
		metricas:temFonte fontesSistemasBasesGovernamentais:FI2.1, fontesBasesAcademicasCientificasEducacionais:FI3.1
	]
	instance PA1.ME3 : metricas:metrica [
		base:nome "Taxa Não Titulação"
		base:descricao "Número de bolsistas contemplados no edital PBPG não titulados sobre o total de bolsistas contemplados no mesmo edital PBPG, desagregado por 
modalidade (mestrado e doutorado), grande área do conhecimento FACEPE, e Região de Desenvolvimento do Estado (RDE)"
		base:id "PA1.ME3 - PBPG"
		metricas:temFonte fontesSistemasBasesGovernamentais:FI2.1, fontesBasesAcademicasCientificasEducacionais:FI3.1
	]
	instance PA1.ME4 : metricas:metrica [
		base:nome "Taxa Tomada Contas"
		base:descricao "Número de bolsistas contemplados no edital PBPG em tomada de contas sobre o total de bolsistas contemplados no mesmo edital PBPG, 
desagregado por modalidade (mestrado e doutorado), grande área do conhecimento FACEPE, e Região de Desenvolvimento do Estado (RDE)"
		base:id "PA1.ME4 - PBPG"
		metricas:temFonte fontesSistemasBasesGovernamentais:FI2.1, fontesBasesAcademicasCientificasEducacionais:FI3.1
	]
	
	instance PA2.ME1 : metricas:metrica [
		base:nome "Quantidade Trabalhos Áreas Prioritárias"
		base:descricao "Número de bolsistas PBPG titulados por semestre com área prioritária para Pernambuco postulada na proposta submetida, desagregado por 
modalidade (mestrado e doutorado) e grande área do conhecimento FACEPE"
		base:id "PA2.ME1 - PBPG"
		metricas:temFonte fontesSistemasBasesGovernamentais:FI2.1, fontesBasesAcademicasCientificasEducacionais:FI3.1
	]
	instance PA2.ME2 : metricas:metrica [
		base:nome "Taxa Trabalhos Áreas Prioritárias"
		base:descricao "Número de bolsistas PBPG titulados no semestre, com área prioritária para Pernambuco postulada na proposta submetida, sobre o total de 
bolsistas PBPG titulados no semestre, desagregado por modalidade (mestrado e doutorado) e grande área do conhecimento FACEPE"
		base:id "PA2.ME2 - PBPG"
		metricas:temFonte fontesSistemasBasesGovernamentais:FI2.1, fontesBasesAcademicasCientificasEducacionais:FI3.1
	]
	
	// Cenário: equilibrar
	instance PA3.ME1 : metricas:metrica [
		base:nome "Taxa Fixação"
		base:descricao "Número de bolsistas PBPG titulados com emprego formal no estado de Pernambuco após dois anos da titulação sobre o total de bolsistas PBPG 
titulados, desagregado por ano, modalidade (mestrado e doutorado), grande área do conhecimento FACEPE, segmento (governo, empresas, ICT) e por Região de 
Desenvolvimento do Estado (RDE)"
		base:id "PA3.ME1 - PBPG"
		metricas:temFonte fontesSistemasBasesGovernamentais:FI2.1, fontesSistemasBasesGovernamentais:FI2.2, fontesSistemasBasesGovernamentais:FI2.6, 
		fontesBasesAcademicasCientificasEducacionais:FI3.1
		metricas:finalidade "Equilibrar"
        metricas:valorAtual 0.65
        metricas:valorMeta  0.70
	]
	// Cenário: Considerando que o objetivo seda aumentar a empregabilidade, o intuito é minimizar 
	instance PA3.ME2 : metricas:metrica[
		base:nome "Quantidade Mestres Doutorandos"
		base:descricao "Número de bolsistas PBPG titulados como mestres que, após dois anos da titulação, estão em cursos de doutorado em Instituições de Ciência e 
Tecnologia (ICT) sediadas em Pernambuco, desagregado por ano e grande área do conhecimento FACEPE"
		base:id "PA3.ME2 - PBPG"
		metricas:temFonte fontesSistemasBasesGovernamentais:FI2.1, fontesBasesAcademicasCientificasEducacionais:FI3.1, 
		fontesBasesAcademicasCientificasEducacionais:FI3.2
		metricas:finalidade "Minimizar"
        metricas:valorAtual 120
        metricas:valorMeta  100
	]
	instance PA3.ME3 : metricas:metrica[
		base:nome "Taxa Mestres Doutorandos"
		base:descricao "Número de bolsistas PBPG titulados como mestres que, após dois anos da titulação, estão em cursos de doutorado em Instituições de Ciência e 
Tecnologia (ICT) sediadas em Pernambuco sobre o total de bolsistas PBPG titulados como mestres, desagregado por ano e grande área do conhecimento FACEPE"
		base:id "PA3.ME3 - PBPG"
		metricas:temFonte fontesSistemasBasesGovernamentais:FI2.1, fontesBasesAcademicasCientificasEducacionais:FI3.1, 
		fontesBasesAcademicasCientificasEducacionais:FI3.2
	]
	
	instance PA4.ME1 : metricas:metrica [
		base:nome "Conceito PPG"
		base:descricao "Conceito CAPES dos Programas de Pós-graduação (PPG) apoiados pelo PBPG por avaliação quadrienal"
		base:id "PA4.ME1 - PBPG"
		metricas:temFonte fontesSistemasBasesGovernamentais:FI2.1, fontesBasesAcademicasCientificasEducacionais:FI3.1
	]
	instance PA4.ME2 : metricas:metrica [
		base:nome "Taxa PPG Excelência"
		base:descricao "Número de Programas de Pós-graduação (PPG) apoiados pelo PBPG com conceitos de excelência da CAPES (6 e 7) no quadriênio sobre o total de 
PPG apoiados pelo PBPG no mesmo quadriênio, desagregado pela grande área de conhecimento FACEPE"
		base:id "PA4.ME2 - PBPG"
		metricas:temFonte fontesSistemasBasesGovernamentais:FI2.1, fontesBasesAcademicasCientificasEducacionais:FI3.1
	]
	instance PA4.ME3 : metricas:metrica [
		base:nome "Taxa PPG Emergentes"
		base:descricao "Número de Programas de Pós-graduação (PPG) apoiados pelo PBPG que elevaram o conceito CAPES no quadriênio sobre o total de PPG apoiados 
pelo PBPG no mesmo quadriênio, desagregado pela grande área de conhecimento FACEPE"
		base:id "PA4.ME3 - PBPG"
		metricas:temFonte fontesSistemasBasesGovernamentais:FI2.1, fontesBasesAcademicasCientificasEducacionais:FI3.1
	]
	
	instance PA5.ME1 : metricas:metrica [
		base:nome "Quantidade Produção Científica Docentes"
		base:descricao "Número anual da produção científica em geral dos docentes permanentes dos PPG apoiados pelo PBPG desagregado pela grande área do 
conhecimento FACEPE"
		base:id "PA5.ME1 - PBPG"
		metricas:temFonte fontesSistemasBasesGovernamentais:FI2.1, fontesBasesAcademicasCientificasEducacionais:FI3.1, 
		fontesBasesAcademicasCientificasEducacionais:FI3.2, fontesBasesAcademicasCientificasEducacionais:FI3.3
	]
	instance PA5.ME2 : metricas:metrica [
		base:nome "Quantidade Publicações Periódicos Docentes"
		base:descricao "Número anual de publicações em periódicos em geral dos docentes permanentes dos PPG apoiados pelo PBPG desagregado pela grande área do 
conhecimento FACEPE"
		base:id "PA5.ME2 - PBPG"
		metricas:temFonte fontesSistemasBasesGovernamentais:FI2.1, fontesBasesAcademicasCientificasEducacionais:FI3.1, 
		fontesBasesAcademicasCientificasEducacionais:FI3.2, fontesBasesAcademicasCientificasEducacionais:FI3.3
	]
	instance PA5.ME3 : metricas:metrica [
		base:nome "Quantidade Publicações Periódicos Scopus Docentes"
		base:descricao "Número anual de publicações em periódicos indexados na base científica Scopus dos docentes permanentes dos PPG apoiados pelo PBPG 
desagregado pela grande área do conhecimento FACEPE"
		base:id "PA5.ME3 - PBPG"
		metricas:temFonte fontesSistemasBasesGovernamentais:FI2.1, fontesBasesAcademicasCientificasEducacionais:FI3.1, 
		fontesBasesAcademicasCientificasEducacionais:FI3.4
	]
	instance PA5.ME4 : metricas:metrica [
		base:nome "Taxa Publicações Periódicos Qualificados Docentes"
		base:descricao "Número anual de publicações em periódicos indexados na base Scopus dos docentes permanentes dos PPG apoiados pelo PBPG por quartil sobre o 
número total de publicações em periódicos indexados na Scopus dos docentes permanentes dos PPG apoiados pelo PBPG  no mesmo ano de publicação desagregado pela 
grande área de conhecimento FACEPE"
		base:id "PA5.ME4 - PBPG"
		metricas:temFonte fontesSistemasBasesGovernamentais:FI2.1, fontesBasesAcademicasCientificasEducacionais:FI3.1, 
		fontesBasesAcademicasCientificasEducacionais:FI3.4
	]
	instance PA5.ME5 : metricas:metrica [
		base:nome "Quantidade Citações Docentes"
		base:descricao "Número anual de citações em geral dos docentes permanentes dos PPG apoiados pelo PBPG desagregado pela grande área do conhecimento FACEPE"
		base:id "PA5.ME5 - PBPG"
		metricas:temFonte fontesSistemasBasesGovernamentais:FI2.1, fontesBasesAcademicasCientificasEducacionais:FI3.1, 
		fontesBasesAcademicasCientificasEducacionais:FI3.2, fontesBasesAcademicasCientificasEducacionais:FI3.3
	]
	instance PA5.ME6 : metricas:metrica [
		base:nome "Quantidade Citações Scopus Docentes"
		base:descricao "Número anual de citações na base científica Scopus dos docentes permanentes dos PPG apoiados pelo PBPG desagregado pela grande área do 
conhecimento FACEPE"
		base:id "PA5.ME6 - PBPG"
		metricas:temFonte fontesSistemasBasesGovernamentais:FI2.1, fontesBasesAcademicasCientificasEducacionais:FI3.1, 
		fontesBasesAcademicasCientificasEducacionais:FI3.4
	]
	instance PA5.ME7 : metricas:metrica [
		base:nome "Média Citações por Publicação Scopus Docentes"
		base:descricao "Número anual de citações na base científica Scopus dos docentes permanentes dos PPG apoiados pelo PBPG sobre o número total de publicações 
indexadas na Scopus dos docentes permanentes dos PPG apoiados pelo PBPG no mesmo ano desagregado pela grande área do conhecimento FACEPE"
		base:id "PA5.ME7 - PBPG"
		metricas:temFonte fontesSistemasBasesGovernamentais:FI2.1, fontesBasesAcademicasCientificasEducacionais:FI3.1, 
		fontesBasesAcademicasCientificasEducacionais:FI3.4
	]
	instance PA5.ME8 : metricas:metrica [
		base:nome "Taxa Citações Quartil Superior Scopus Docentes"
		base:descricao "Número anual de citações presentes no quartil superior (Top 25%) na base científica Scopus dos docentes permanentes dos PPG apoiados pelo 
PBPG sobre o número total de citações na Scopus dos docentes permanentes dos PPG apoiados pelo PBPG no mesmo ano desagregado pela grande área do conhecimento 

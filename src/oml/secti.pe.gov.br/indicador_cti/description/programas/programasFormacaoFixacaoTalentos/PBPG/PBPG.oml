		metricas:temFonte fonte:FI1, fonte:FI2, fonte:FI3, fonte:FI12
		metricas:finalidade "Maximizar"
	]
	
	// Escopos e Métodos de Avaliação
	instance PA1.ES : planoAvaliacao:escopo [
		base:descricao "Espera-se identificar a efetiva contribuição do PBPG para com a formação de mestres e doutores em Pernambuco. A comparação será longitudinal (ao longo dos anos) do próprio PBPG"
		base:id "PA1.ES"
	]
	instance PA1.MA : planoAvaliacao:metodoAvaliacao [
		base:descricao "Análise Descritiva."
		base:id "PA1.MA"
	]
	
	instance PA2.ES : planoAvaliacao:escopo [
		base:descricao "Espera-se identificar a contribuição dos trabalhos fomentados pelo PBPG em áreas estratégicas prioritárias para o estado de Pernambuco. A comparação será longitudinal (ao longo dos anos) e transversal entre o grupo tratado (bolsistas PBPG titulados) e o grupo controle (mestres e doutores titulados em Instituições de Ciência e Tecnologia de Pernambuco - ICT-PE não bolsistas PBPG)"
		base:id "PA2.ES"
	]
	instance PA2.MA : planoAvaliacao:metodoAvaliacao [
		base:descricao "(1) Definir as áreas estratégicas prioritárias para o estado de Pernambuco;
						(2) Mapear as palavras-chave para enquadramento das áreas estratégicas prioritárias;
						(3) Acessar FI1 para obter informações sobre os bolsistas PBPG;
						(4) Acessar FI2 para obter informações (título, resumo e palavras-chave) das teses e dissertações dos mestres e doutores titulados em ICT-PE;
						(5) Realizar pareamento entre as informações obtidas de FI1 e FI2;
						(6) Calcular PA2.ME1;
						(7) Calcular PA2.ME2 e comparar com PA2.ME2.VE;
						(8) Aplicar o método de regressão de dados em painel para comparação transversal."
		base:id "PA2.MA"
	]
	
	instance PA3.ES : planoAvaliacao:escopo [
		base:descricao "Espera-se identificar a contribuição do PBPG na formação de mão de obra qualificada em atuação profissional em Pernambuco. A comparação será longitudinal (ao longo dos anos) e transversal entre o grupo tratado (bolsistas PBPG titulados) e o grupo controle (mestres e doutores titulados em ICT-PE não bolsistas PBPG)"
		base:id "PA3.ES"
	]
	instance PA3.MA : planoAvaliacao:metodoAvaliacao [
		base:descricao "(1) Acessar FI1 e obter informações sobre os bolsistas PBPG; 
						(2) Acessar FI2 para obter informações sobre mestres e doutores titulados em ICT-PE;
						(3) Acessar FI3 para obter informações sobre mestres e doutores com emprego formal no Estado;
						(4) Realizar pareamento entre as informações obtidas de FI1, FI2 e FI3;
						(5) Calcular PA3.ME1 e comparar com PA3.ME1.VE;
						(6) Calcular PA3.ME2;
						(7) Aplicar o método de regressão de dados em painel para comparação transversal."
		base:id "PA3.MA"
	]
	
	instance PA4.ES : planoAvaliacao:escopo [
		base:descricao "Espera-se identificar a evolução da qualidade dos PPGs de Pernambuco apoiados pelo PBPG. A comparação será longitudinal (ao longo dos quadriênios)"
		base:id "PA4.ES"
	]
	instance PA4.MA : planoAvaliacao:metodoAvaliacao [
		base:descricao "(1) Acessar FI1 para obter os PPGs aos quais os bolsistas PBPG são vinculados;
						(2) Acessar FI2 para obter os conceitos atribuídos aos PPGs das ICT-PE;
						(3) Realizar o pareamento entre as informações obtidas de FI1 e FI2;
						(4) Calcular PA4.ME1, PA4.ME2 e PA4.ME3."
		base:id "PA4.MA"
	]
	
	instance PA5.ES : planoAvaliacao:escopo [
		base:descricao "Espera-se identificar a evolução da produtividade científica dos docentes permanentes dos PPG apoiados pelo PBPG. A comparação será longitudinal (ao longo dos anos) e transversal entre o grupo tratado (docentes permanentes orientadores de bolsistas PBPG) e o grupo controle (docentes permanentes não orientadores de bolsistas PBPG)"
		base:id "PA5.ES"
	]
	instance PA5.MA : planoAvaliacao:metodoAvaliacao [
		base:descricao "(1) Acessar FI1 para obter os PPGs aos quais os bolsistas PBPG são vinculados;
						(2) Acessar FI2 para: obter informações dos docentes permanentes dos PPG das ICT-PE (DC - PPG - ICT-PE); e a classificação QUALIS dos veículos de publicação;
						(3) Acessar FI4 para obter informações dos DC - PPG - ICT-PE que são bolsistas de produtividade;
						(4) Acessar FI6 para obter informações sobre as patentes depositadas por DC - PPG - ICT-PE;
						(5) Acessar FI7 para obter os índices h, h5 e i10 dos DC - PPG - ICT-PE;
						(6) Acessar FI5, FI8 e FI9 para obter informações das publicações dos DC - PPG - ICT-PE;
						(7) Acessar FI10 para obter informações sobre as startups em que DE - PPG - ICT-PE são sócios;
						(8) Realizar pareamento entre as informações obtidas em FI1, FI2, FI4, FI5, FI6, FI7, FI8, FI9 e FI10;
						(9) Calcular PA5.ME1, PA5.ME2, PA5.ME3, PA5.ME4 e PA5.ME5;
						(10) Aplicar o método de regressão de dados em painel para comparação transversal."
		base:id "PA5.MA"
	]
	
	instance PA6.ES : planoAvaliacao:escopo [
		base:descricao "Espera-se identificar a evolução da produção científica dos egressos do PBPG. A comparação será longitudinal (ao longo dos anos) do próprio PBPG e transversal entre o grupo tratado (bolsistas PBPG titulados) e o grupo controle (mestres e doutores titulados em ICT-PE não bolsistas PBPG)"
		base:id "PA6.ES"
	]
	instance PA6.MA : planoAvaliacao:metodoAvaliacao [
		base:descricao "(1) Acessar FI1 para obter informações sobre os bolsistas PBPG;
						(2) Acessar FI2 para obter: informações sobre os mestres e doutores titulados em ICT-PE; e classificação QUALIS dos eventos e periódicos;
						(3) Acessar FI5, FI8 e FI9 para obter informações das publicações dos mestres e doutores titulados em ICT-PE;
						(4) Realizar o pareamento entre as informações obtidas em FI1, FI2, FI5, FI8 e FI9;
						(5) Calcular PA6.ME1, PA6.ME2 (e comparar com o PA6.ME2.VE) e PA6.ME3;
						(7) Aplicar o método de regressão de dados em painel para comparação transversal."
		base:id "PA6.MA"
	]
	
	instance PA7.ES : planoAvaliacao:escopo [
		base:descricao "Espera-se identificar a evolução da produção tecnológica, com proteção intelectual, dos egressos PBPG titulados. A comparação será longitudinal (ao longo dos anos) do próprio PBPG e transversal entre o grupo tratado (bolsistas PBPG titulados) e o grupo controle (mestres e doutores titulados em ICT-PE não bolsistas PBPG)"
		base:id "PA7.ES"
	]
	instance PA7.MA : planoAvaliacao:metodoAvaliacao [
		base:descricao "(1) Acessar FI1 para obter informações sobre os bolsistas PBPG;
						(2) Acessar FI2 para obter informações sobre os mestres e doutores titulados em ICT-PE;
						(3) Acessar FI6 para obter informações sobre as patentes depositadas e programas de computador registrados pelos bolsistas PBPG;
						(4) Realizar o pareamento entre as informações obtidas em FI1, FI2 e FI6;
						(5) Calcular PA7.ME1;
						(6) Calcular PA7.ME2 e comparar com PA7.ME2.VE;
						(7) Aplicar o método de regressão de dados em painel para comparação transversal."
		base:id "PA7.MA"
	]
	
	instance PA8.ES : planoAvaliacao:escopo [
		base:descricao "Espera-se identificar a evolução da produção tecnológica, com proteção intelectual, dos egressos titulados do PBPG. A comparação será longitudinal (ao longo dos anos) do próprio PBPG e transversal entre o grupo tratado (bolsistas PBPG titulados) e o grupo controle (mestres e doutores titulados em ICT-PE não bolsistas PBPG)"
		base:id "PA8.ES"
	]
	instance PA8.MA : planoAvaliacao:metodoAvaliacao [
		base:descricao "(1) Acessar FI1 para obter informações sobre os bolsistas PBPG;
						(2) Acessar FI2 para obter informações sobre os mestres e doutores titulados em ICT-PE;
						(3) Acessar FI5, FI8 e FI9 para obter informações das publicações dos mestres e doutores titulados em ICT-PE;
						(4) Realizar o pareamento entre as informações obtidas em FI1, FI2, FI5, FI8 e FI9;
						(5) Calcular PA8.ME1;
						(6) Calcular PA8.ME2 e comparar com PA8.ME2.VE;
						(7) Calcular PA8.ME3 e comparar com PA8.ME3.VE;
						(8) Aplicar o método de regressão de dados em painel para comparação transversal."
		base:id "PA8.MA"
	]
	
	instance PA9.ES : planoAvaliacao:escopo [
		base:descricao "Espera-se identificar a evolução da produção tecnológica, com proteção intelectual, dos bolsistas PBPG em cooperação com outras organizações. A comparação será longitudinal (ao longo dos anos) do próprio PBPG e transversal entre o grupo tratado (bolsistas PBPG titulados) e o grupo controle (mestres e doutores titulados em ICT-PE não bolsistas PBPG)"
		base:id "PA9.ES"
	]
	instance PA9.MA : planoAvaliacao:metodoAvaliacao [
		base:descricao "(1) Acessar FI1 para obter informações sobre os bolsistas PBPG;
						(2) Acessar FI2 para obter informações sobre os mestres e doutores titulados em ICT-PE;
						(3) Acessar FI6 para obter informações sobre as patentes depositadas e programas de computador registrados pelos mestres e doutores titulados em ICT-PE;
						(4) Realizar o pareamento entre as informações obtidas em FI1, FI2 e FI6;
						(5) Calcular PA9.ME1;
						(6) Aplicar o método de regressão de dados em painel para comparação transversal."
		base:id "PA9.MA"
	]
	
	instance PA10.ES : planoAvaliacao:escopo [
		base:descricao "Espera-se identificar a evolução da formação acadêmica dos bolsistas PBPG em cooperação científica com outras ICT. A comparação será longitudinal (ao longo dos anos) do próprio PBPG e transversal entre o grupo tratado (bolsistas PBPG titulados) e o grupo controle (mestres e doutores titulados em ICT-PE não bolsistas PBPG)"
		base:id "PA10.ES"
	]
	instance PA10.MA : planoAvaliacao:metodoAvaliacao [
		base:descricao "(1) Acessar FI1 para obter informações sobre os bolsistas PBPG;
						(2) Acessar FI2 e FI5 para obter: informações sobre os mestres e doutores titulados em ICT-PE, incluindo formação no modelo sanduíche;
						(3) Realizar o pareamento entre as informações obtidas em FI1, FI2 e FI5;
						(4) Calcular PA10.ME1 e PA10.ME2;
						(5) Aplicar o método de regressão de dados em painel para comparação transversal."
		base:id "PA10.MA"
	]
	
	instance PA11.ES : planoAvaliacao:escopo [
		base:descricao "Espera-se identificar a evolução da cooperação científica dos doutores egressos PBPG com outras ICT. A comparação será longitudinal (ao longo dos anos) do próprio PBPG e transversal entre o grupo tratado (doutores egressos PBPG) e o grupo controle (doutores de ICT-PE não egressos PBPG)"
		base:id "PA11.ES"
	]
	instance PA11.MA : planoAvaliacao:metodoAvaliacao [
		base:descricao "(1) Acessar FI1 para obter informações sobre os bolsistas de doutorado egressos PBPG;
						(2) Acessar FI2 para obter informações sobre os doutores titulados em ICT-PE; 
						(3) Acessar FI5 para obter informações sobre formação pós-doutoral dos doutores titulados em ICT-PE;
						(4) Realizar o pareamento entre as informações obtidas em FI1, FI2 e FI5;
						(5) Calcular PA11.ME1 e PA11.ME2;
						(6) Aplicar o método de regressão de dados em painel para comparação transversal."
		base:id "PA11.MA"
	]
	
	instance PA12.ES : planoAvaliacao:escopo [
		base:descricao "Espera-se identificar a evolução das cooperações científicas com outras ICT na formação dos bolsistas PBPG. A comparação será longitudinal (ao longo dos anos) do próprio PBPG e transversal entre o grupo tratado (bolsistas PBPG titulados) e o grupo controle (mestres e doutores titulados em ICT-PE não bolsistas PBPG)"
		base:id "PA12.ES"
	]
	instance PA12.MA : planoAvaliacao:metodoAvaliacao [
		base:descricao "(1) Acessar FI1 para obter informações sobre os bolsistas egressos PBPG;
						(2) Acessar FI2 para obter informações sobre os mestres e doutores titulados em ICT-PE, incluindo co-orientação e co-titulação; 
						(3) Realizar o pareamento entre as informações obtidas em FI1 e FI2;
						(5) Calcular PA12.ME1 e PA12.ME2;
						(6) Aplicar o método de regressão de dados em painel para comparação transversal."
		base:id "PA12.MA"
	]
	
	instance PA13.ES : planoAvaliacao:escopo [
		base:descricao "Espera-se identificar a evolução da entrega de inovações fomentadas pelo PBPG para empresas e governo. A comparação será longitudinal (ao longo dos anos) do próprio PBPG"
		base:id "PA13.ES"
	]
	instance PA13.MA : planoAvaliacao:metodoAvaliacao [
		base:descricao "(1) Acessar FI1 para obter informações sobre os bolsistas PBPG e respectivos professores orientadores;
						(2) Acessar FI2 para obter informações sobre os bolsistas PBPG titulados; 
						(3) Aplicar questionário (survey) para coleta de informações (FI11) juntos a bolsistas, egressos e professores orientadores do PBPG;
						(4) Realizar o pareamento entre as informações obtidas em FI1, FI2 e FI11;
						(5) Calcular PA13.ME1."
		base:id "PA13.MA"
	]
	
	instance PA14.ES : planoAvaliacao:escopo [
		base:descricao "Espera-se identificar a evolução da geração de negócios a partir do trabalho de pesquisa fomentado pelo PBPG. A comparação será longitudinal (ao longo dos anos) do próprio PBPG"
		base:id "PA14.ES"
	]
	instance PA14.MA : planoAvaliacao:metodoAvaliacao [
		base:descricao "(1) Acessar FI1 para obter informações sobre os bolsistas PBPG;
						(2) Acessar FI2 para obter informações sobre os bolsistas PBPG titulados; 
						(3) Aplicar questionário (survey) para coleta de informações (FI11) juntos a egressos do PBPG;
						(4) Realizar o pareamento entre as informações obtidas em FI1, FI2 e FI11;
						(5) Calcular PA14.ME1."
		base:id "PA14.MA"
	]
	
	instance PA15.ES : planoAvaliacao:escopo [
		base:descricao "Espera-se identificar a empregabilidade, a atuação em atividade econômica e a renda formal de egressos do PBPG após 5 anos de titulação. A comparação será longitudinal (ao longo dos anos) e transversal entre o grupo tratado (bolsistas PBPG titulados) e o grupo controle (mestres e doutores titulados em ICT-PE não bolsistas PBPG)"
		base:id "PA15.ES"
	]
	instance PA15.MA : planoAvaliacao:metodoAvaliacao [
		base:descricao "(1) Acessar FI1 para obter informações sobre os bolsistas PBPG;
						(2) Acessar FI2 para obter informações sobre os mestres e doutores titulados em ICT-PE; 
						(3) Acessar FI3 para obter informações sobre mestres e doutores titulados em ICT-PE com emprego formal;
						(4) Realizar pareamento entre as informações obtidas de FI1, FI2 e FI3;
						(5) Calcular PA15.ME1 e PA15.ME2;
						(6) Aplicar o método de regressão de dados em painel para comparação transversal."
		base:id "PA15.MA"
	]
	
	instance PA16.ES : planoAvaliacao:escopo [
		base:descricao "Espera-se identificar a evolução do licenciamento e comercialização da produção tecnológica (patentes e programas de computador) fomentada pelo PBPG. A comparação será longitudinal (ao longo dos anos) do próprio PBPG"
		base:id "PA16.ES"
	]
	instance PA16.MA : planoAvaliacao:metodoAvaliacao [
		base:descricao "(1) Acessar FI1 para obter informações sobre os bolsistas PBPG;
						(2) Acessar FI2 para obter informações sobre os bolsistas PBPG titulados; 
						(3) Aplicar questionário (survey) para coleta de informações (FI11) juntos a egressos do PBPG;
						(4) Realizar o pareamento entre as informações obtidas em FI1, FI2 e FI11;
						(5) Calcular PA16.ME1."
		base:id "PA16.MA"
	]
	
	instance PA17.ES : planoAvaliacao:escopo [
		base:descricao "Espera-se identificar a evolução da produtividade nos segmentos econômicos de Pernambuco em que mestres e doutores egressos do PBPG atuam profissionalmente. A comparação será longitudinal (ao longo dos anos)"
		base:id "PA17.ES"
	]
	instance PA17.MA : planoAvaliacao:metodoAvaliacao [
		base:descricao "(1) Acessar FI1 para obter informações sobre os egressos PBPG;
						(2) Acessar FI2 para obter informações sobre os egressos PBPG titulados; 
						(3) Acessar FI3 para obter informações sobre egressos PBPG titulados com emprego formal em Pernambuco;
						(4) Acessar FI12 para obter informações sobre produto por trabalhador por segmento econômico;
						(5) Realizar pareamento entre as informações obtidas de FI1, FI2, FI3 e FI12;
						(5) Calcular PA17.ME1 e PA17.ME2."
		base:id "PA17.MA"
	]

	// Riscos e Limitações
	instance R1 : planoAvaliacao:risco [
		base:descricao "Falta de acesso à alguma das fontes para obtenção de informações"
		base:id "R1"
	]
	instance R2 : planoAvaliacao:risco [
		base:descricao "Dependência de respostas voluntárias na aplicação de survey"
		base:id "R2"
	]

	instance LIM1 : planoAvaliacao:limitacao [
		base:descricao "A análise não identifica a causalidade entre as cotas PBPG que os PPGs recebem e o respectivo conceito atribuído em cada avaliação quadrienal da CAPES"
	]
	instance LIM2 : planoAvaliacao:limitacao [
		base:descricao "A análise identifica correlação, mas não garante identificar a causalidade entre as cotas PBPG que os PPGs recebem e a evolução da produtividade científica dos docentes permanentes dos PPG das ICT-PE"
	]
	instance LIM3 : planoAvaliacao:limitacao [
		base:descricao "Não haverá garantia da precisão de uma das, ou de todas as métricas relacionadas"
	]
}

	instance PA13.ME1 : metricas:metricaSimples [
		base:nome "Qtde Inovações"
		base:descricao "Número de inovações (produtos, processos, serviços) fomentadas do PBPG que foram adotadas por empresas e pelo governo"
		base:id "PA13.ME1"
		metricas:temFonte fonte:FI1, fonte:FI2, fonte:FI11
		metricas:finalidade "Maximizar"
	]
	instance PA14.ME1 : metricas:metricaSimples [
		base:nome "Qtde Startups Bols"
		base:descricao "Número de startups e spin-offs acadêmicos com a participação direta de egressos do PBPG"
		base:id "PA14.ME1"
		metricas:temFonte fonte:FI1, fonte:FI2, fonte:FI11
		metricas:finalidade "Maximizar"
	]
	instance PA15.ME1 : metricas:metricaComposta [
		base:nome "Índice Empregab Bols"
		base:descricao "Índice de empregabilidade dos egressos PBPG após 5 anos de titulação"
		base:id "PA15.ME1"
		metricas:formula "Egressos PBPG empregados / Número total de egressos PBPG"
		metricas:temFonte fonte:FI1, fonte:FI2, fonte:FI3

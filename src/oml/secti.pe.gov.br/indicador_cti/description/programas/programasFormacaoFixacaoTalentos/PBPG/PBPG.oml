description <http://secti.pe.gov.br/indicador_cti/description/programas/programasFormacaoFixacaoTalentos/PBPG/PBPG#> as PBPG {
	
	extends <http://secti.pe.gov.br/indicador_cti/description/programas/programasFormacaoFixacaoTalentos/PBPG/PA-PBPG#> as PA-PBPG
	extends <http://secti.pe.gov.br/indicador_cti/description/parceirosChave/parceirosGoverno#> as parceirosGoverno
	extends <http://secti.pe.gov.br/indicador_cti/description/parceirosChave/parceirosAgenciasFomento#> as parceirosAgenciasFomento
	extends <http://secti.pe.gov.br/indicador_cti/description/parceirosChave/parceirosAcademiaICTs#> as parceirosAcademiaICTs
	extends <http://secti.pe.gov.br/indicador_cti/description/parceirosChave/parceirosEmpresas#> as parceirosEmpresas
	extends <http://secti.pe.gov.br/indicador_cti/description/fatoresExternos#> as fatorExterno
	extends <http://secti.pe.gov.br/indicador_cti/description/entradas/entradasOrcamentoFinanciamento#> as entradasOrcamentoFinanciamento
	extends <http://secti.pe.gov.br/indicador_cti/description/entradas/entradasDadosSistemasPlataformas#> as entradasDadosSistemasPlataformas
	extends <http://secti.pe.gov.br/indicador_cti/description/entradas/entradasCapitalHumano#> as entradasCapitalHumano
	extends <http://secti.pe.gov.br/indicador_cti/description/entradas/entradasInstrumentosLegaisNormativos#> as entradasInstrumentosLegaisNormativos
	extends <http://secti.pe.gov.br/indicador_cti/description/atividadesChave#> as atividadeChave
	extends <http://secti.pe.gov.br/indicador_cti/description/saidas#> as saida
	extends <http://secti.pe.gov.br/indicador_cti/description/publicosAlvo/publicosAcademiaICTs#> as publicosAcademiaICTs
	extends <http://secti.pe.gov.br/indicador_cti/description/publicosAlvo/publicosGovernoInstituicoesPublicas#> as publicosGovernoInstituicoesPublicas
	extends <http://secti.pe.gov.br/indicador_cti/description/publicosAlvo/publicosEmpresasEmpreendedores#> as publicosEmpresasEmpreendedores
	extends <http://secti.pe.gov.br/indicador_cti/description/publicosAlvo/publicosAmbientesInovacao#> as publicosAmbientesInovacao
	extends <http://secti.pe.gov.br/indicador_cti/description/publicosAlvo/publicosSociedadeTerceiroSetor#> as publicosSociedadeTerceiroSetor
	uses <http://secti.pe.gov.br/indicador_cti/vocabulary/base#> as base
	uses <http://secti.pe.gov.br/indicador_cti/vocabulary/DesignAvaliacao/canvas#> as canvas
	uses <http://secti.pe.gov.br/indicador_cti/vocabulary/programa#> as programa
	
	instance PR1 : programa:programaCTI [
		base:nome "Programa de Bolsas de Pós-Graduação"
		base:descricao "Foi criado para fomentar o desenvolvimento científico e tecnológico do estado de Pernambuco, oferecendo bolsas de estudo para alunos de 
pós-graduação"
		base:id "PR1"
		programa:possuiParceiros parceirosAcademiaICTs:PC3.2, parceirosAcademiaICTs:PC3.4, parceirosGoverno:PC1.11, parceirosEmpresas:PC4.1, 
		parceirosEmpresas:PC4.2, parceirosAgenciasFomento:PC2.9, parceirosAgenciasFomento:PC2.10 
		programa:condicionadoPor fatorExterno:FE.OP1, fatorExterno:FE.OP2, fatorExterno:FE.AM1, fatorExterno:FE.AM2, fatorExterno:FE.AM3, fatorExterno:FE.AM4, 
		fatorExterno:FE.AM5, fatorExterno:FE.AM6
		programa:recebeEntradas entradasOrcamentoFinanciamento:EN1.1, entradasOrcamentoFinanciamento:EN1.5, entradasDadosSistemasPlataformas:EN2.1, 
		entradasCapitalHumano:EN3.1, entradasCapitalHumano:EN3.5, entradasInstrumentosLegaisNormativos:EN5.1
		programa:executa atividadeChave:AC1, atividadeChave:AC2, atividadeChave:AC3, atividadeChave:AC4, atividadeChave:AC5, atividadeChave:AC6, 
		atividadeChave:AC7
		programa:geraSaidas saida:SA1, saida:SA2, saida:SA3, saida:SA4, saida:SA5, saida:SA6, saida:SA7
		programa:produzResultados RE.CP1, RE.CP2, RE.CP3, RE.CP4, RE.CP5, RE.MP1, RE.MP2, RE.MP3, RE.MP4, RE.MP5, RE.LP1, RE.LP2, RE.LP3, RE.LP4
		programa:buscaAtingirGeral OB.GE
		programa:buscaAtingirEspecifico OB.ES1, OB.ES2, OB.ES3, OB.ES4, OB.ES5, OB.ES6
		programa:avaliadoPor PA-PBPG:PA1, PA-PBPG:PA2, PA-PBPG:PA3, PA-PBPG:PA4, PA-PBPG:PA5, PA-PBPG:PA6, PA-PBPG:PA7, PA-PBPG:PA8, PA-PBPG:PA9, PA-PBPG:PA10, 
		PA-PBPG:PA11, PA-PBPG:PA12, PA-PBPG:PA13, PA-PBPG:PA14, PA-PBPG:PA15, PA-PBPG:PA16, PA-PBPG:PA17
	]
	
	// Relações PBPG --> Público-Alvo
	relation instance PR1.direcionadoA.PA1.6 : programa:direcionadoA [
		from PR1
		to publicosAcademiaICTs:PA1.6
		base:tipo "direto"
	]
	relation instance PR1.direcionadoA.PA1.11 : programa:direcionadoA [
		from PR1
		to publicosAcademiaICTs:PA1.11
		base:tipo "direto"
	]
	relation instance PR1.direcionadoA.PA1.13 : programa:direcionadoA [
		from PR1
		to publicosAcademiaICTs:PA1.13
		base:tipo "indireto"
	]
	relation instance PR1.direcionadoA.PA1.14 : programa:direcionadoA [
		from PR1
		to publicosAcademiaICTs:PA1.14
		base:tipo "direto"
	]
	relation instance PR1.direcionadoA.PA2.2 : programa:direcionadoA [
		from PR1
		to publicosGovernoInstituicoesPublicas:PA2.2
		base:tipo "indireto"
	]
	relation instance PR1.direcionadoA.PA2.3 : programa:direcionadoA [
		from PR1
		to publicosGovernoInstituicoesPublicas:PA2.3
		base:tipo "indireto"
	]
	relation instance PR1.direcionadoA.PA3.2 : programa:direcionadoA [
		from PR1
		to publicosEmpresasEmpreendedores:PA3.2
		base:tipo "indireto"
	]
	relation instance PR1.direcionadoA.PA3.5 : programa:direcionadoA [
		from PR1
		to publicosEmpresasEmpreendedores:PA3.5
		base:tipo "indireto"
	]
	relation instance PR1.direcionadoA.PA4.1 : programa:direcionadoA [
		from PR1
		to publicosAmbientesInovacao:PA4.1
		base:tipo "indireto"
	]
	relation instance PR1.direcionadoA.PA4.6 : programa:direcionadoA [
		from PR1
		to publicosAmbientesInovacao:PA4.6
		base:tipo "indireto"
	]
	relation instance PR1.direcionadoA.PA4.7 : programa:direcionadoA [
		from PR1
		to publicosAmbientesInovacao:PA4.7
		base:tipo "indireto"
	]
	relation instance PR1.direcionadoA.PA4.8 : programa:direcionadoA [
		from PR1
		to publicosAmbientesInovacao:PA4.8
		base:tipo "indireto"
	]
	relation instance PR1.direcionadoA.PA5.1 : programa:direcionadoA [
		from PR1
		to publicosSociedadeTerceiroSetor:PA5.1
		base:tipo "indireto"
	]
	
	// Objetivo Geral
	instance OB.GE : canvas:ObjetivoGeral [
		base:nome "Promover a formação de recursos humanos qualificados em nível de pós-graduação de modo a contribuir com o desenvolvimento sustentável do estado 
de Pernambuco"
		base:id "OB.GE - PBPG"
	]
	
	// Objetivos Específicos
	instance OB.ES1 : canvas:ObjetivoEspecifico [
		base:nome "Estimular a formação e a fixação de mestres e doutores no estado de Pernambuco, em especial no interior"
		base:id "OB.ES1 - PBPG"
		canvas:buscaAtingir RE.CP1, RE.MP1, RE.LP4
	]
	instance OB.ES2 : canvas:ObjetivoEspecifico [
		base:nome "Incentivar o desenvolvimento de dissertações e teses em áreas estratégicas e prioritárias para o Estado de Pernambuco"
		base:id "OB.ES2 - PBPG"
		canvas:buscaAtingir RE.CP4, RE.LP2
	]
	instance OB.ES3 : canvas:ObjetivoEspecifico [
		base:nome "Estimular a produção e a disseminação de conhecimento de vanguarda e a mão de obra de alto nível para o desenvolvimento competitivo e 
sustentável do Estado de Pernambuco"
		base:id "OB.ES3 - PBPG"
		canvas:buscaAtingir RE.CP2, RE.CP3, RE.MP4, RE.LP1, RE.LP2, RE.LP4
	]
	instance OB.ES4 : canvas:ObjetivoEspecifico [
		base:nome "Apoiar a consolidação de Programas de Pós-graduação (PPGs) novos e emergentes"
		base:id "OB.ES4 - PBPG"
		canvas:buscaAtingir RE.MP2
	]
	instance OB.ES5 : canvas:ObjetivoEspecifico [
		base:nome "Contribuir para a manutenção da excelência de PPGs consolidados"
		base:id "OB.ES5 - PBPG"
		canvas:buscaAtingir RE.MP3
	]
	instance OB.ES6 : canvas:ObjetivoEspecifico [
		base:nome "Estimular cooperações e transferências científicas e tecnológicas com organizações públicas e privadas, nacionais e internacionais"
		base:id "OB.ES6 - PBPG"
		canvas:buscaAtingir RE.CP5, RE.MP4, RE.MP5, RE.LP3
	]
	
	// Resultados Esperados
	
	// Curto Prazo
	instance RE.CP1 : canvas:ResultadoEsperado [
		base:nome "Ampliação do número de mestres e doutores titulados no Estado"
		base:id "RE.CP1 - PBPG"
		canvas:prazo "curto"
	]
	instance RE.CP2 : canvas:ResultadoEsperado [
		base:nome "Aumento da produção científica publicada em eventos e periódicos qualificados e de alto impacto"
		base:id "RE.CP2 - PBPG"
		canvas:prazo "curto"
	]
	instance RE.CP3 : canvas:ResultadoEsperado [
		base:nome "Aumento do número de patentes depositadas e programas de software registrados"
		base:id "RE.CP3 - PBPG"
		canvas:prazo "curto"
	]
	instance RE.CP4 : canvas:ResultadoEsperado [
		base:nome "Incremento do estoque de conhecimento em áreas estratégicas para o Estado"
		base:id "RE.CP4 - PBPG"
		canvas:prazo "curto"
	]
	instance RE.CP5 : canvas:ResultadoEsperado [
		base:nome "Maior intercâmbio científico nacional e internacional"
		base:id "RE.CP5 - PBPG"
		canvas:prazo "curto"
	]
	
	// Médio Prazo
	instance RE.MP1 : canvas:ResultadoEsperado [
		base:nome "Aumento da fixação de mestres e doutores pelo ecossistema de CT&I do Estado, inclusive no interior"
		base:id "RE.MP1 - PBPG"
		canvas:prazo "médio"
	]
	instance RE.MP2 : canvas:ResultadoEsperado [
		base:nome "Aumento do conceito CAPES dos PPGs novos e emergentes"
		base:id "RE.MP2 - PBPG"
		canvas:prazo "médio"
	]
	instance RE.MP3 : canvas:ResultadoEsperado [
		base:nome "Manutenção do conceito CAPES dos PPGs de excelência"
		base:id "RE.MP3 - PBPG"
		canvas:prazo "médio"
	]
	instance RE.MP4 : canvas:ResultadoEsperado [
		base:nome "Aumento do número de startups de base científica e tecnológica e spin-offs acadêmicos"
		base:id "RE.MP4 - PBPG"
		canvas:prazo "médio"
	]
	instance RE.MP5 : canvas:ResultadoEsperado [
		base:nome "Aumento das inovações para Governo, Empresas e Sociedade"
		base:id "RE.MP5 - PBPG"
		canvas:prazo "médio"
	]
	
	// Longo Prazo
	instance RE.LP1 : canvas:ResultadoEsperado [
		base:nome "Evolução dos índices econômicos, sociais e ambientais do Estado"
		base:id "RE.LP1 - PBPG"
		canvas:prazo "longo"
	]
	instance RE.LP2 : canvas:ResultadoEsperado [
		base:nome "Fortalecimento das cadeias produtivas de setores estratégicos para Pernambuco"
		base:id "RE.LP2 - PBPG"
		canvas:prazo "longo"
	]
	instance RE.LP3 : canvas:ResultadoEsperado [
		base:nome "Aumento da quantidade de licenciamentos de propriedade intelectual pelo Governo e Empresas Privadas"
		base:id "RE.LP3 - PBPG"
		canvas:prazo "longo"
	]
	instance RE.LP4 : canvas:ResultadoEsperado [
		base:nome "Aumento da empregabilidade dos egressos PBPG de alto nível salarial"
		base:id "RE.LP4 - PBPG"
		canvas:prazo "longo"
	]
}
description <http://secti.pe.gov.br/indicador_cti/description/programas/programasFormacaoFixacaoTalentos/PBPG/PBPG#> as PBPG {
	
	extends <http://secti.pe.gov.br/indicador_cti/description/parceirosChave#> as parceiroChave
	extends <http://secti.pe.gov.br/indicador_cti/description/fatoresExternos#> as fatorExterno
	extends <http://secti.pe.gov.br/indicador_cti/description/entradas#> as entrada
	extends <http://secti.pe.gov.br/indicador_cti/description/atividadesChave#> as atividadeChave
	extends <http://secti.pe.gov.br/indicador_cti/description/saidas#> as saida
	extends <http://secti.pe.gov.br/indicador_cti/description/resultados#> as resultado
	extends <http://secti.pe.gov.br/indicador_cti/description/publicoAlvo#> as publicoAlvo
	extends <http://secti.pe.gov.br/indicador_cti/description/fontesInformacao#> as fonte
	uses <http://secti.pe.gov.br/indicador_cti/vocabulary/planoAvaliacao#> as planoAvaliacao
	uses <http://secti.pe.gov.br/indicador_cti/vocabulary/base#> as base
	uses <http://secti.pe.gov.br/indicador_cti/vocabulary/canvas#> as canvas
	uses <http://secti.pe.gov.br/indicador_cti/vocabulary/programa#> as programa
	uses <http://secti.pe.gov.br/indicador_cti/vocabulary/metricas#> as metricas
	
	instance PR1 : programa:programaCTI [
		base:nome "Programa de Bolsas de Pós-Graduação"
		base:descricao "Foi criado para fomentar o desenvolvimento científico e tecnológico do estado de Pernambuco, oferecendo bolsas de estudo para alunos de 
pós-graduação"
		base:id "PR1"
		programa:possuiParceiros parceiroChave:PC1, parceiroChave:PC2, parceiroChave:PC3
		programa:condicionadoPor fatorExterno:FE.OP1, fatorExterno:FE.OP2, fatorExterno:FE.AM1, fatorExterno:FE.AM2, fatorExterno:FE.AM3, fatorExterno:FE.AM4, 
		fatorExterno:FE.AM5, fatorExterno:FE.AM6
		programa:recebeEntradas entrada:EN1, entrada:EN2, entrada:EN3, entrada:EN4, entrada:EN5, entrada:EN6
		programa:executa atividadeChave:AC1, atividadeChave:AC2, atividadeChave:AC3, atividadeChave:AC4, atividadeChave:AC5, atividadeChave:AC6, 
		atividadeChave:AC7
		programa:geraSaidas saida:SA1, saida:SA2, saida:SA3, saida:SA4, saida:SA5, saida:SA6, saida:SA7
		programa:produzResultados resultado:RE.CP1, resultado:RE.CP2, resultado:RE.CP3, resultado:RE.CP4, resultado:RE.CP5, resultado:RE.MP1, resultado:RE.MP2, resultado:RE.MP3, resultado:RE.MP4, resultado:RE.MP5, resultado:RE.LP1, resultado:RE.LP2, resultado:RE.LP3, resultado:RE.LP4
		programa:direcionadoA publicoAlvo:PU.DI1, publicoAlvo:PU.DI2, publicoAlvo:PU.DI3, publicoAlvo:PU.IN1, publicoAlvo:PU.IN2, publicoAlvo:PU.IN3, publicoAlvo:PU.IN4, publicoAlvo:PU.IN5
		programa:buscaAtingirGeral OB.GE
		programa:buscaAtingirEspecifico OB.ES1, OB.ES2, OB.ES3, OB.ES4, OB.ES5, OB.ES6
		programa:avaliadoPor PA1, PA2, PA3, PA4, PA5, PA6, PA7, PA8, PA9, PA10, PA11, PA12, PA13, PA14, PA15, PA16, PA17
	]
	
	// Objetivo Geral
	instance OB.GE : canvas:ObjetivoGeral [
		base:nome "Promover a formação de recursos humanos qualificados em nível de pós-graduação de modo a contribuir com o desenvolvimento sustentável do estado de Pernambuco"
		base:id "OB.GE"
	]
	
	// Objetivos Específicos
	instance OB.ES1 : canvas:ObjetivoEspecifico [
		base:nome "Estimular a formação e a fixação de mestres e doutores no estado de Pernambuco, em especial no interior"
		base:id "OB.ES1"
		canvas:buscaAtingir resultado:RE.CP1, resultado:RE.MP1, resultado:RE.LP4
	]
	instance OB.ES2 : canvas:ObjetivoEspecifico [
		base:nome "Incentivar o desenvolvimento de dissertações e teses em áreas estratégicas e prioritárias para o Estado de Pernambuco"
		base:id "OB.ES2"
		canvas:buscaAtingir resultado:RE.CP4, resultado:RE.LP2
	]
	instance OB.ES3 : canvas:ObjetivoEspecifico [
		base:nome "Estimular a produção e a disseminação de conhecimento de vanguarda e a mão de obra de alto nível para o desenvolvimento competitivo e sustentável do Estado de Pernambuco"
		base:id "OB.ES3"
		canvas:buscaAtingir resultado:RE.CP2, resultado:RE.CP3, resultado:RE.MP4, resultado:RE.LP1, resultado:RE.LP2, resultado:RE.LP4
	]
	instance OB.ES4 : canvas:ObjetivoEspecifico [
		base:nome "Apoiar a consolidação de Programas de Pós-graduação (PPGs) novos e emergentes"
		base:id "OB.ES4"
		canvas:buscaAtingir resultado:RE.MP2
	]
	instance OB.ES5 : canvas:ObjetivoEspecifico [
		base:nome "Contribuir para a manutenção da excelência de PPGs consolidados"
		base:id "OB.ES5"
		canvas:buscaAtingir resultado:RE.MP3
	]
	instance OB.ES6 : canvas:ObjetivoEspecifico [
		base:nome "Estimular cooperações e transferências científicas e tecnológicas com organizações públicas e privadas, nacionais e internacionais"
		base:id "OB.ES6"
		canvas:buscaAtingir resultado:RE.CP5, resultado:RE.MP4, resultado:RE.MP5, resultado:RE.LP3
	]
	
	// Questões de Avaliação
	instance PA1 : planoAvaliacao:questaoAvaliacao [
		base:nome "Qual a taxa de sucesso e quantos bolsistas PBPG foram titulados como mestres e doutores, por ano, por prazo (regular ou prorrogado), por área de conhecimento e por região de desenvolvimento do Estado?"
		base:id "PA1"
		planoAvaliacao:custo "Moderado"
		planoAvaliacao:temMetrica PA1.ME1, PA1.ME2
		planoAvaliacao:temEscopo PA1.ES
		planoAvaliacao:temMetodologia PA1.MA
		planoAvaliacao:temRisco R1
		planoAvaliacao:alinhaComResultado resultado:RE.CP1
	]
	instance PA2 : planoAvaliacao:questaoAvaliacao [
		base:nome "Qual o quantitativo e o percentual de dissertações/teses desenvolvidas por bolsistas PBPG em áreas estratégicas prioritárias para Pernambuco?"
		base:id "PA2"
		planoAvaliacao:custo "Alto"
		planoAvaliacao:temMetrica PA2.ME1, PA2.ME2
		planoAvaliacao:temEscopo PA2.ES
		planoAvaliacao:temMetodologia PA2.MA
		planoAvaliacao:temRisco R1
		planoAvaliacao:alinhaComResultado resultado:RE.CP4
	]
	instance PA3 : planoAvaliacao:questaoAvaliacao [
		base:nome "Qual a taxa de fixação de egressos do PBPG no Estado, por segmento (governo, empresas, ICT) e por região de desenvolvimento, após 2 anos da titulação?"
		base:id "PA3"
		planoAvaliacao:custo "Alto"
		planoAvaliacao:temMetrica PA3.ME1, PA3.ME2
		planoAvaliacao:temEscopo PA3.ES
		planoAvaliacao:temMetodologia PA3.MA
		planoAvaliacao:temRisco R1
		planoAvaliacao:alinhaComResultado resultado:RE.MP1
	]
	instance PA4 : planoAvaliacao:questaoAvaliacao [
		base:nome "Qual a evolução do conceito CAPES dos PPGs apoiados pelo PBPG?"
		base:id "PA4"
		planoAvaliacao:custo "Baixo"
		planoAvaliacao:temMetrica PA4.ME1, PA4.ME2, PA4.ME3
		planoAvaliacao:temEscopo PA4.ES
		planoAvaliacao:temMetodologia PA4.MA
		planoAvaliacao:temLimitacao LIM1
		planoAvaliacao:alinhaComResultado resultado:RE.MP2, resultado:RE.MP3
	]
	instance PA5 : planoAvaliacao:questaoAvaliacao [
		base:nome "Qual a evolução da qualidade científica e tecnológica (quantitativo de citações, publicações, índice h, bolsa de produtividade, patentes, startups) dos docentes permanentes (orientadores) dos PPGs apoiados pelo PBPG?"
		base:id "PA5"
		planoAvaliacao:custo "Alto"
		planoAvaliacao:temMetrica PA5.ME1, PA5.ME2, PA5.ME3, PA5.ME4, PA5.ME5 
		planoAvaliacao:temEscopo PA5.ES
		planoAvaliacao:temMetodologia PA5.MA
		planoAvaliacao:temRisco R1
		planoAvaliacao:temLimitacao LIM2
		planoAvaliacao:alinhaComResultado resultado:RE.CP2, resultado:RE.CP3, resultado:RE.MP4
	]
	instance PA6 : planoAvaliacao:questaoAvaliacao [
		base:nome "Quantas publicações em periódicos e eventos de alto impacto, nacionais e internacionais, foram realizadas por bolsistas do PBPG em até 02 anos após a titulação?"
		base:id "PA6"
		planoAvaliacao:custo "Alto"
		planoAvaliacao:temMetrica PA6.ME1, PA6.ME2, PA6.ME3
		planoAvaliacao:temEscopo PA6.ES
		planoAvaliacao:temMetodologia PA6.MA
		planoAvaliacao:temRisco R1
		planoAvaliacao:alinhaComResultado resultado:RE.CP2
	]
	instance PA7 : planoAvaliacao:questaoAvaliacao [
		base:nome "Quantas patentes foram depositadas e programas de computador foram registrados por egressos PBPG em até dois anos após a titulação?"
		base:id "PA7"
		planoAvaliacao:custo "Moderado"
		planoAvaliacao:temMetrica PA7.ME1, PA7.ME2
		planoAvaliacao:temEscopo PA7.ES
		planoAvaliacao:temMetodologia PA7.MA
		planoAvaliacao:temRisco R1
		planoAvaliacao:alinhaComResultado resultado:RE.CP3
	]
	instance PA8 : planoAvaliacao:questaoAvaliacao [
		base:nome "Quantas publicações em co-autoria com organizações (empresas, ICT e governo) públicas ou privadas, nacionais ou estrangeiras foram realizadas por bolsistas PBPG em até dois anos após a titulação?"
		base:id "PA8"
		planoAvaliacao:custo "Moderado"
		planoAvaliacao:temMetrica PA8.ME1, PA8.ME2, PA8.ME3
		planoAvaliacao:temEscopo PA8.ES
		planoAvaliacao:temMetodologia PA8.MA
		planoAvaliacao:temRisco R1
		planoAvaliacao:alinhaComResultado resultado:RE.CP2
	]
	instance PA9 : planoAvaliacao:questaoAvaliacao [
		base:nome "Quantas patentes foram depositadas e programas de computador foram registrados em co-autoria com organizações (empresas, ICT, governo) públicas ou privadas, nacionais ou internacionais por bolsistas PBPG em até 02 anos após a titulação?"
		base:id "PA9"
		planoAvaliacao:custo "Moderado"
		planoAvaliacao:temMetrica PA9.ME1
		planoAvaliacao:temEscopo PA9.ES
		planoAvaliacao:temMetodologia PA9.MA
		planoAvaliacao:temRisco R1
		planoAvaliacao:alinhaComResultado resultado:RE.CP3
	]
	instance PA10 : planoAvaliacao:questaoAvaliacao [
		base:nome "Quantos mestrados/doutorados sanduíche foram realizados por bolsistas PBPG em ICT nacionais e internacionais?"
		base:id "PA10"
		planoAvaliacao:custo "Moderado"
		planoAvaliacao:temMetrica PA10.ME1, PA10.ME2
		planoAvaliacao:temEscopo PA10.ES
		planoAvaliacao:temMetodologia PA10.MA
		planoAvaliacao:temRisco R1
		planoAvaliacao:alinhaComResultado resultado:RE.CP5
	]
	instance PA11 : planoAvaliacao:questaoAvaliacao [
		base:nome "Quantos estágios pós-doutoral foram realizados por egressos do PBPG em até 02 anos após a titulação em outra ICT?"
		base:id "PA11"
		planoAvaliacao:custo "Alto"
		planoAvaliacao:temMetrica PA11.ME1, PA11.ME2
		planoAvaliacao:temEscopo PA11.ES
		planoAvaliacao:temMetodologia PA11.MA
		planoAvaliacao:temRisco R1
		planoAvaliacao:alinhaComResultado resultado:RE.CP5
	]
	instance PA12 : planoAvaliacao:questaoAvaliacao [
		base:nome "Quantos bolsistas PPBG foram co-orientados por pesquisadores de outras ICTs e/ou co-titulados (co-tutela) mestres e doutores?"
		base:id "PA12"
		planoAvaliacao:custo "Moderado"
		planoAvaliacao:temMetrica PA12.ME1, PA12.ME2
		planoAvaliacao:temEscopo PA12.ES
		planoAvaliacao:temMetodologia PA12.MA
		planoAvaliacao:temRisco R1
		planoAvaliacao:alinhaComResultado resultado:RE.CP5
	]
	instance PA13 : planoAvaliacao:questaoAvaliacao [
		base:nome "Quantas inovações (produtos, processos, serviços) fomentadas pelo PPBG foram adotadas por empresas e pelo governo?"
		base:id "PA13"
		planoAvaliacao:custo "Alto"
		planoAvaliacao:temMetrica PA13.ME1
		planoAvaliacao:temEscopo PA13.ES
		planoAvaliacao:temMetodologia PA13.MA
		planoAvaliacao:temRisco R1, R2
		planoAvaliacao:temLimitacao LIM3
		planoAvaliacao:alinhaComResultado resultado:RE.MP5
	]
	instance PA14 : planoAvaliacao:questaoAvaliacao [
		base:nome "Quantas startups de base científica e tecnológica e spin-offs acadêmicos foram criados com a participação direta de egressos do PBPG?"
		base:id "PA14"
		planoAvaliacao:custo "Alto"
		planoAvaliacao:temMetrica PA14.ME1
		planoAvaliacao:temEscopo PA14.ES
		planoAvaliacao:temMetodologia PA14.MA
		planoAvaliacao:temRisco R1, R2
		planoAvaliacao:temLimitacao LIM3
		planoAvaliacao:alinhaComResultado resultado:RE.MP4
	]
	instance PA15 : planoAvaliacao:questaoAvaliacao [
		base:nome "Qual o índice de empregabilidade, por atividade econômica, de egressos PBPG em cargos de alto nível salarial (considerando natureza jurídica e atividade econômica) após 5 anos de titulação?"
		base:id "PA15"
		planoAvaliacao:custo "Alto"
		planoAvaliacao:temMetrica PA15.ME1, PA15.ME2
		planoAvaliacao:temEscopo PA15.ES
		planoAvaliacao:temMetodologia PA15.MA
		planoAvaliacao:temRisco R1
		planoAvaliacao:alinhaComResultado resultado:RE.LP4
	]
	instance PA16 : planoAvaliacao:questaoAvaliacao [
		base:nome "Qual o quantitativo de patentes e programas de computador de egressos do PBPG licenciados e comercializados?"
		base:id "PA16"
		planoAvaliacao:custo "Alto"
		planoAvaliacao:temMetrica PA16.ME1
		planoAvaliacao:temEscopo PA16.ES
		planoAvaliacao:temMetodologia PA16.MA
		planoAvaliacao:temRisco R1
		planoAvaliacao:temLimitacao LIM3
		planoAvaliacao:alinhaComResultado resultado:RE.LP3
	]
	instance PA17 : planoAvaliacao:questaoAvaliacao [
		base:nome "Qual a evolução da produtividade dos segmentos econômicos de Pernambuco com maior percentual de mestres e doutores egressos do PBPG?"
		base:id "PA17"
		planoAvaliacao:custo "Alto"
		planoAvaliacao:temMetrica PA17.ME1, PA17.ME2
		planoAvaliacao:temEscopo PA17.ES
		planoAvaliacao:temMetodologia PA17.MA
		planoAvaliacao:temRisco R1
		planoAvaliacao:alinhaComResultado resultado:RE.LP1, resultado:RE.LP2
	]
	
	//Métricas	
	// Inserindo Cenário: Meta 80%, Atingido 90% (Sucesso)
	instance PA1.ME1 : metricas:metricaComposta [
		base:nome "Taxa Titulação"
		base:descricao "Número de bolsistas PBPG titulados no ano sobre o total de cotas PBPG encerradas no ano"
		base:id "PA1.ME1"
		metricas:formula "Bolsistas PBPG titulados por ano / Total de cotas PBPG encerradas por ano"
		metricas:temFonte fonte:FI1, fonte:FI2
		
		metricas:finalidade "Maximizar"
		metricas:valorAtual 0.90
		metricas:valorMeta  0.80
	]
	
	instance PA1.ME2 : metricas:metricaSimples [
		base:nome "Qtde Titulados"
		base:descricao "Número de bolsistas PBPG titulados, desagregado por: (a) ano de titulação, (b) Modalidade (Mestrado e Doutorado), (c) Prazo (conclusão no prazo regular e Com prorrogação), (d) Grande Área do Conhecimento (CAPES), e (e)  Região de Desenvolvimento do Estado (RDE)"
		base:id "PA1.ME2"
		metricas:temFonte fonte:FI1, fonte:FI2
		metricas:finalidade "Maximizar"
	]
	instance PA2.ME1 : metricas:metricaSimples [
		base:nome "Qtde Trab Áreas Prior"
		base:descricao "Número de dissertações e teses de bolsistas PBPG por área estratégica prioritária para Pernambuco"
		base:id "PA2.ME1"
		metricas:temFonte fonte:FI1, fonte:FI2
		metricas:finalidade "Maximizar"
	]
	instance PA2.ME2 : metricas:metricaComposta [
		base:nome "Taxa Trab Áreas Prior"
		base:descricao "Proporção de dissertações e teses de bolsistas PBPG nas áreas estratégicas prioritárias em relação ao total de dissertações e teses PBPG"
		base:id "PA2.ME2"
		metricas:formula "Número de dissertações e teses PBPG nas áreas / Total de dissertações e teses PBPG"
		metricas:temFonte fonte:FI1, fonte:FI2
		metricas:finalidade "Maximizar"
	]
	// Cenário: equilibrar
	instance PA3.ME1 : metricas:metricaComposta [
		base:nome "Taxa Fixação"
		base:descricao "Proporção de mestres e doutores egressos PBPG, após dois anos de titulação, empregados em Pernambuco com relação ao total de mestres e doutores egressos PBPG, desdobrado por segmento (governo, empresas, ICT) e por RD"
		base:id "PA3.ME1"
		metricas:formula "PBPG empregados PE / Número total de egressos PBPG"
		metricas:temFonte fonte:FI1, fonte:FI2, fonte:FI3
		
		metricas:finalidade "Equilibrar"
        metricas:valorAtual 0.65
        metricas:valorMeta  0.70
	]
	// Cenário: Considerando que o objetivo seda aumentar a empregabilidade, o intuito é minimizar 
	instance PA3.ME2 : metricas:metricaSimples [
		base:nome "Qtde Mestres Doutorandos"
		base:descricao "Número de mestres egressos PBPG, após dois anos de titulação, que estão em cursos de doutorado em ICT-PE"
		base:id "PA3.ME2"
		metricas:temFonte fonte:FI1, fonte:FI2, fonte:FI3
		
		metricas:finalidade "Minimizar"
        metricas:valorAtual 120
        metricas:valorMeta  100
	]
	instance PA4.ME1 : metricas:metricaSimples [
		base:nome "Conceito PPG"
		base:descricao "Conceito CAPES dos Programas de Pós-graduação (PPG) apoiados pelo PBPG, por avaliação quadrienal e por área de conhecimento"
		base:id "PA4.ME1"
		metricas:temFonte fonte:FI1, fonte:FI2
		metricas:finalidade "Maximizar"
	]
	instance PA4.ME2 : metricas:metricaSimples [
		base:nome "Taxa PPG Excelência"
		base:descricao "Percentual de PPGs apoiados pelo PBPG com conceitos de excelência da CAPES (6 e 7)"
		base:id "PA4.ME2"
		metricas:temFonte fonte:FI1, fonte:FI2
		metricas:finalidade "Maximizar"
	]
	instance PA4.ME3 : metricas:metricaSimples [
		base:nome "Taxa PPG Emergentes"
		base:descricao "Percentual de PPGs apoiados pelo PBPG que elevaram seu conceito CAPES"
		base:id "PA4.ME3"
		metricas:temFonte fonte:FI1, fonte:FI2
		metricas:finalidade "Maximizar"
	]
	instance PA5.ME1 : metricas:metricaSimples [
		base:nome "Qtde Pub Quali DP"
		base:descricao "Número de publicações qualificadas (Qualis A1 a A4) dos Docentes Permanentes (DP) dos Programas de Pós-graduação (PPG) com bolsistas PBPG"
		base:id "PA5.ME1"
		metricas:temFonte fonte:FI1, fonte:FI2, fonte:FI4, fonte:FI5, fonte:FI6, fonte:FI7, fonte:FI8, fonte:FI9, fonte:FI10
		metricas:finalidade "Maximizar"
	]
	instance PA5.ME2 : metricas:metricaSimples [
		base:nome "Índices Citações DP"
		base:descricao "Média dos índices índice-h, índice h5 e índice i10 dos Docentes Permanentes (DP) dos Programas de Pós-graduação (PPG) com bolsistas PBPG"
		base:id "PA5.ME2"
		metricas:temFonte fonte:FI1, fonte:FI2, fonte:FI4, fonte:FI5, fonte:FI6, fonte:FI7, fonte:FI8, fonte:FI9, fonte:FI10
		metricas:finalidade "Maximizar"
	]
	instance PA5.ME3 : metricas:metricaSimples [
		base:nome "Qtde Bolsas Prod DP"
		base:descricao "Número  de bolsas de produtividade CNPQ dos Docentes Permanentes (DP) dos Programas de Pós-graduação (PPG) com bolsistas PBPG"
		base:id "PA5.ME3"
		metricas:temFonte fonte:FI1, fonte:FI2, fonte:FI4, fonte:FI5, fonte:FI6, fonte:FI7, fonte:FI8, fonte:FI9, fonte:FI10
		metricas:finalidade "Maximizar"
	]
	instance PA5.ME4 : metricas:metricaSimples [
		base:nome "Qtde Patentes DP"
		base:descricao "Número de patentes depositadas no INPI por Docentes Permanentes (DP) dos Programas de Pós-graduação (PPG) com bolsistas PBPG"
		base:id "PA5.ME4"
		metricas:temFonte fonte:FI1, fonte:FI2, fonte:FI4, fonte:FI5, fonte:FI6, fonte:FI7, fonte:FI8, fonte:FI9, fonte:FI10
		metricas:finalidade "Maximizar"
	]
	instance PA5.ME5 : metricas:metricaSimples [
		base:nome "Qtde Startups DP"
		base:descricao "Número de startups tendo como sócios Docentes Permanentes (DP) dos Programas de Pós-graduação (PPG) com bolsistas PBPG"
		base:id "PA5.ME5"
		metricas:temFonte fonte:FI1, fonte:FI2, fonte:FI4, fonte:FI5, fonte:FI6, fonte:FI7, fonte:FI8, fonte:FI9, fonte:FI10
		metricas:finalidade "Maximizar"
	]
	instance PA6.ME1 : metricas:metricaSimples [
		base:nome "Qtde Pub Quali Bolsistas"
		base:descricao "Número de publicações qualificadas (Qualis A1 a A4) dos egressos PBPG até dois anos após a titulação"
		base:id "PA6.ME1"
		metricas:temFonte fonte:FI1, fonte:FI2, fonte:FI5, fonte:FI8, fonte:FI9
		metricas:finalidade "Maximizar"
	]
	instance PA6.ME2 : metricas:metricaComposta [
		base:nome "Taxa Prod Quali Bols"
		base:descricao "Proporção de egressos PBPG com pelo menos uma produção qualificada até dois anos após a titulação com relação ao total de bolsistas egressos PBPG"
		base:id "PA6.ME2"
		metricas:formula "Egressos PBPG com produção / Número total de egressos PBPG"
		metricas:temFonte fonte:FI1, fonte:FI2, fonte:FI5, fonte:FI8, fonte:FI9
		metricas:finalidade "Maximizar"
	]
	instance PA6.ME3 : metricas:metricaSimples [
		base:nome "Qtde Pub Eventos Internac Bols"
		base:descricao "Número de trabalhos publicados em anais de eventos internacionais por egressos PBPG até dois anos após a titulação"
		base:id "PA6.ME3"
		metricas:temFonte fonte:FI1, fonte:FI2, fonte:FI5, fonte:FI8, fonte:FI9
		metricas:finalidade "Maximizar"
	]
	instance PA7.ME1 : metricas:metricaSimples [
		base:nome "Qtde Prod Tec Bols"
		base:descricao "Quantidade de produção tecnológica, com proteção intelectual, dos egressos PBPG até dois anos após titulação, desagregado por: (a) patentes depositadas no INPI; e (b) programas de computador registrados no INPI"
		base:id "PA7.ME1"
		metricas:temFonte fonte:FI1, fonte:FI2, fonte:FI6
		metricas:finalidade "Maximizar"
	]
	instance PA7.ME2 : metricas:metricaComposta [
		base:nome "Taxa Prod Tec Bol"
		base:descricao "Proporção de egressos PBPG com produção tecnológica com relação ao total de egressos PBPG"
		base:id "PA7.ME2"
		metricas:formula "Egressos PBPG com produção / Número total de egressos PBPG"
		metricas:temFonte fonte:FI1, fonte:FI2, fonte:FI6
		metricas:finalidade "Maximizar"
	]
	instance PA8.ME1 : metricas:metricaSimples [
		base:nome "Qtde Pub Coaut Bols"
		base:descricao "Quantidade de publicações dos bolsistas PBPG até dois anos após a titulação em co-autoria com pelo menos um autor filiado a outra organização, desagregado por: (a) tipo da organização (empresa, outra ICT e governo); (b) natureza da organização (pública, privada); e (c) localização da organização (nacional, exterior)"
		base:id "PA8.ME1"
		metricas:temFonte fonte:FI1, fonte:FI2, fonte:FI5, fonte:FI8, fonte:FI9
		metricas:finalidade "Maximizar"
	]
	instance PA8.ME2 : metricas:metricaComposta [
		base:nome "Taxa Pub Coaut Nac Bols"
		base:descricao "Proporção de bolsistas PBPG com publicação em coautoria nacional até dois anos após a titulação em relação ao total de bolsistas PBPG com pelo menos uma publicação"
		base:id "PA8.ME2"
		metricas:formula "Bolsistas PBPG com publicação coautoral nacional / Total de bolsistas PBPG com publicação"
		metricas:temFonte fonte:FI1, fonte:FI2, fonte:FI5, fonte:FI8, fonte:FI9
		metricas:finalidade "Maximizar"
	]
	instance PA8.ME3 : metricas:metricaComposta [
		base:nome "Taxa Prod Tec Bol"
		base:descricao "Proporção de egressos PBPG com produção tecnológica com relação ao total de egressos PBPG"
		base:id "PA8.ME3"
		metricas:formula "Bolsistas PBPG com publicação coautoral internacional / Total de bolsistas PBPG com publicação"
		metricas:temFonte fonte:FI1, fonte:FI2, fonte:FI5, fonte:FI8, fonte:FI9
		metricas:finalidade "Maximizar"
	]
	instance PA9.ME1 : metricas:metricaSimples [
		base:nome "Qtde Prod Tec Coaut Bols"
		base:descricao "Quantidade da produção tecnológica, com proteção intelectual, dos bolsistas PBPG até dois anos após titulação, em co-autoria com pelo menos um autor filiado a outra organização, desagregado por: (a) tipo da propriedade intelectual (patente, programa de computador); (b) tipo da organização (empresa, ICT, governo); (c) natureza da organização (pública, privada); e (d) localização da organização (nacional, exterior)"
		base:id "PA9.ME1"
		metricas:temFonte fonte:FI1, fonte:FI2, fonte:FI6
		metricas:finalidade "Maximizar"
	]
	instance PA10.ME1 : metricas:metricaComposta [
		base:nome "Taxa Sand Nac Bols"
		base:descricao "Proporção de bolsistas e egressos PBPG titulados que realizaram mestrado ou doutorado sanduíche em outra ICT nacional em relação ao total de bolsistas PBPG"
		base:id "PA10.ME1"
		metricas:formula "Egressos PBPG sanduíche nacional / Total de bolsistas PBPG"
		metricas:temFonte fonte:FI1, fonte:FI2, fonte:FI5
		metricas:finalidade "Maximizar"
	]
	instance PA10.ME2 : metricas:metricaComposta [
		base:nome "Taxa Sand Internac Bols"
		base:descricao "Proporção de bolsistas e egressos PBPG titulados que realizaram mestrados ou doutorados sanduíche em ICT estrangeira em relação ao total de bolsistas PBPG"
		base:id "PA10.ME2"
		metricas:formula "Egressos PBPG sanduíche internacional / Total de bolsistas PBPG com publicação"
		metricas:temFonte fonte:FI1, fonte:FI2, fonte:FI5
		metricas:finalidade "Maximizar"
	]

description <http://secti.pe.gov.br/indicador_cti/description/saidas#> as saidas {
	
	uses <http://secti.pe.gov.br/indicador_cti/vocabulary/base#> as base
	uses <http://secti.pe.gov.br/indicador_cti/vocabulary/canvas#> as canvas
	
	instance SA1 : canvas:Saida [
		base:nome "Edital do Programa gerenciado com sucesso"
		base:id "SA1"
	]
	instance SA2 : canvas:Saida [
		base:nome "Bolsas/subvenções implementadas e pagas de acordo com o planejamento"
		base:id "SA2"
	]
	instance SA3 : canvas:Saida [
		base:nome "Relatórios parciais e/ou final de acompanhamento"
		base:id "SA3"
	]
	instance SA4 : canvas:Saida [
		base:nome "AgilFAP em operação plena para atendimento ao Programa"
		base:id "SA4"
	]
	instance SA5 : canvas:Saida [
		base:nome "Parcerias formalizadas por meio de instrumentos legais"
		base:id "SA5"
	]
	instance SA6 : canvas:Saida [
		base:nome "Infográfico atualizado de Indicadores de desempenho e impacto do Programa"
		base:id "SA6"
	]
	instance SA7 : canvas:Saida [
		base:nome "Plano de Avaliação do Programa executado"
		base:id "SA7"
	]
	instance SA8 : canvas:Saida [
		base:nome "Seminário de avaliação"
		base:id "SA8"
	]
	instance SA9 : canvas:Saida [
		base:nome "Soluções tecnológicas e inovadoras desenvolvidas"
		base:id "SA9"
	]
	instance SA10 : canvas:Saida [
		base:nome "Novas estruturas governamentais e instrumentos de gestão criados/aplicados a partir do desenvolvimento das soluções aos desafios postos"
		base:id "SA10"
	]
	instance SA11 : canvas:Saida [
		base:nome "Capacitação e treinamento dos gestores/servidores públicos para o uso e aplicação das soluções desenvolvidas"
		base:id "SA11"
	]
	instance SA12 : canvas:Saida [
		base:nome "Formação de jovens com competências portadoras de futuro, com foco no mercado de trabalho"
		base:id "SA12"
	]
	instance SA13 : canvas:Saida [
		base:nome "Professores atualizados de acordo com as demandas na área de STEM+C"
		base:id "SA13"
	]
	instance SA14 : canvas:Saida [
		base:nome "ECRIA montados e operacionais"
		base:id "SA14"
	]
	instance SA15 : canvas:Saida [
		base:nome "Execução de projetos oriundos do Programa"
		base:id "SA15"
	]
	instance SA16 : canvas:Saida [
		base:nome "Eventos de divulgação de projetos dos espaços CRIA"
		base:id "SA16"
	]
	instance SA17 : canvas:Saida [
		base:nome "Portfólios de projetos inovadores, empreendedores e inclusivos, protótipos, produtos e soluções inovadoras desenvolvidas nos ECRIA"
		base:id "SA17"
	]
	instance SA18 : canvas:Saida [
		base:nome "Declaração de Disponibilidade Orçamentária (DDO) emitida e aprovada"
		base:id "SA18"
	]
	instance SA19 : canvas:Saida [
		base:nome "Recursos orçamentários assegurados e liberados para execução do programa"
		base:id "SA19"
	]
	instance SA20 : canvas:Saida [
		base:nome "Fluxo financeiro regular estabelecido para repasse mensal às Autarquias Municipais de Ensino Superior"
		base:id "SA20"
	]
	instance SA21 : canvas:Saida [
		base:nome "Edital de seleção publicado e amplamente divulgado"
		base:id "SA21"
	]
	instance SA22 : canvas:Saida [
		base:nome "Inscrições de candidatos realizadas e validadas pelas Autarquias Municipais de Ensino Superior"
		base:id "SA22"
	]
	instance SA23 : canvas:Saida [
		base:nome "Base de dados de candidatos, organizada e registrada no sistema de gerenciamento do Programa"
		base:id "SA23"
	]
	instance SA24 : canvas:Saida [
		base:nome "Resultado preliminar e listas de convocação divulgadas publicamente, garantindo transparência e ampla concorrência"
		base:id "SA24"
	]
	instance SA25 : canvas:Saida [
		base:nome "Processos de recursos analisados e respondidos dentro do prazo"
		base:id "SA25"
	]
	instance SA26 : canvas:Saida [
		base:nome "Listas de remanejamento publicadas até o preenchimento total das vagas ou convocação de todos os candidatos aptos"
		base:id "SA26"
	]
	instance SA27 : canvas:Saida [
		base:nome "Termos de compromisso assinados e enviados digitalmente para SECTI"
		base:id "SA27"
	]
	instance SA28 : canvas:Saida [
		base:nome "Bolsas implementadas e repasses mensais efetivados às Autarquias Municipais de Ensino Superior"
		base:id "SA28"
	]
	instance SA29 : canvas:Saida [
		base:nome "Controle financeiro e acadêmico dos bolsistas atualizado no sistema de gerenciamento do Programa"
		base:id "SA29"
	]
	instance SA30 : canvas:Saida [
		base:nome "Atividades educativas, científicas, de extensão ou tecnológicas realizadas sob supervisão docente"
		base:id "SA30"
	]
	instance SA31 : canvas:Saida [
		base:nome "Relatórios de contrapartida validados pelas Autarquias e registrados no sistema de gerenciamento do Programa, semestralmente"
		base:id "SA31"
	]
	instance SA32 : canvas:Saida [
		base:nome "Relatórios mensais, semestrais e anuais de desempenho orçamentário e financeiro do Programa"
		base:id "SA32"
	]
	instance SA33 : canvas:Saida [
		base:nome "Painel de acompanhamento atualizado no sistema de gerenciamento do Programa, com dados de bolsas, contrapartidas e indicadores de desvinculação 
do programa"
		base:id "SA33"
	]
	instance SA34 : canvas:Saida [
		base:nome "Avaliação de impacto do programa publicada periodicamente, evidenciando resultados e benefícios sociais, educacionais e econômicos"
		base:id "SA34"
	]
}
description <http://secti.pe.gov.br/indicador_cti/description/fatoresExternos/fatoresDinamicaEcossistema#> as fatoresDinamicaEcossistema {
	
	uses <http://secti.pe.gov.br/indicador_cti/vocabulary/base#> as base
	uses <http://secti.pe.gov.br/indicador_cti/vocabulary/DesignAvaliacao/canvas#> as canvas
	
	//Oportunidades
	instance FE5.OP1 : canvas:Oportunidade [
		base:nome "Crescimento do nº de startups e ambientes de inovação no Estado"
		base:id "FE5.OP1"
	]
	instance FE5.OP2 : canvas:Oportunidade [
		base:nome "Potencial nº de articuladores de CT&I vinculados a ICTs"
		base:id "FE5.OP2"
	]
	instance FE5.OP3 : canvas:Oportunidade [
		base:nome "Projeção de internacionalização das redes"
		base:id "FE5.OP3"
	]
	instance FE5.OP4 : canvas:Oportunidade [
		base:nome "Parcerias entre academia-empresas para aperfeiçoamento dos laboratórios multiusuários"
		base:id "FE5.OP4"
	]
	instance FE5.OP5 : canvas:Oportunidade [
		base:nome "Integração com políticas nacionais de ciência, tecnologia e inovação"
		base:id "FE5.OP5"
	]
	instance FE5.OP6 : canvas:Oportunidade [
		base:nome "Parcerias eventuais com Governo, Indústria e Sociedade"
		base:id "FE5.OP6"
	]
	instance FE5.OP7 : canvas:Oportunidade [
		base:nome "Reconhecimento da importância das pesquisas nas atividades produtivas"
		base:id "FE5.OP7"
	]

	instance FE5.OP8 : canvas:Oportunidade [
		base:nome "Projeção do Estado quanto ao nº de empresas pernambucanas de base tecnológica especializadas em soluções de aprimoramento dos serviços públicos"
		base:id "FE5.OP8"
	]
	instance FE5.OP9 : canvas:Oportunidade [
		base:nome "Parcerias com empresas para programas de imersão e maratonas de desenvolvimento"
		base:id "FE5.OP9"
	]
	instance FE5.OP10 : canvas:Oportunidade [
		base:nome "Engajamento dos estudantes ativos nos Espaços CRIA aos grandes eventos de tecnologia (Campus Party, Rec´n play, Eli Summit…)"
		base:id "FE5.OP10"
	]
	instance FE5.OP11 : canvas:Oportunidade [
		base:nome "Participação dos estudantes em competições locais, interestaduais e internacionais"
		base:id "FE5.OP11"
	]
	instance FE5.OP12 : canvas:Oportunidade [
		base:nome "Progressão das ETEs e EREMs com Espaços CRIA para um modelo de incubação de novos negócios"
		base:id "FE5.OP12"
	]
	instance FE5.OP13 : canvas:Oportunidade [
		base:nome "Reconhecimento do potencial inovador e criativo  dos alunos da Escola Pública para resolução de problemas da sociedade"
		base:id "FE5.OP13"
	]
	
	//Ameaças
	instance FE5.AM1 : canvas:Ameaca [
		base:nome "Envolvimento tímido do setor empresarial"
		base:id "FE5.AM1"
	]
	instance FE5.AM2 : canvas:Ameaca [
		base:nome "Prazo insuficiente para tornar as redes auto sustentáveis"
		base:id "FE5.AM2"
	]
	
	instance FE5.AM3 : canvas:Ameaca [
		base:nome "Evasão das ICTs fora da RMR"
		base:id "FE5.AM3"
	]
}
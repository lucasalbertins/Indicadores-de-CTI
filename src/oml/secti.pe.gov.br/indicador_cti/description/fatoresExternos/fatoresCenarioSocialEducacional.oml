description <http://secti.pe.gov.br/indicador_cti/description/fatoresExternos/fatoresCenarioSocialEducacional#> as fatoresCenarioSocialEducacional {
	
	uses <http://secti.pe.gov.br/indicador_cti/vocabulary/base#> as base
	uses <http://secti.pe.gov.br/indicador_cti/vocabulary/DesignAvaliacao/canvas#> as canvas
	
	//Oportunidades
	instance FE4.OP1 : canvas:Oportunidade [
		base:nome "Maior reconhecimento da importância das atividades de CT&I/PD&I para a sociedade"
		base:id "FE4.OP1"
	]
	instance FE4.OP2 : canvas:Oportunidade [
		base:nome "Massa crítica de pesquisadores existente no estado nas mais variadas áreas do conhecimento"
		base:id "FE4.OP2"
	]
	instance FE4.OP3 : canvas:Oportunidade [
		base:nome "Expansão da demanda por Ensino Superior no interior"
		base:id "FE4.OP3"
	]
	instance FE4.OP4 : canvas:Oportunidade [
		base:nome "Valorização das áreas STEM e das licenciaturas"
		base:id "FE4.OP4"
	]
	instance FE4.OP5 : canvas:Oportunidade [
		base:nome "Crescimento do mercado de trabalho qualificado"
		base:id "FE4.OP5"
	]
	
	//Ameaças
	instance FE4.AM1 : canvas:Ameaca [
		base:nome "Cenário de crises e problemas urgentes (sanitários, ambientais e sociais)"
		base:id "FE4.AM1"
	]
	instance FE4.AM2 : canvas:Ameaca [
		base:nome "Evasão estudantil"
		base:id "FE4.AM2"
	]
	
	//Falta validação
	instance FE4.AM3 : canvas:Ameaca [
		base:nome "Falta de aderência das dissertações e teses com desafios e problemas relevantes do estado de Pernambuco"
		base:id "FE4.AM3"
	]
	instance FE4.AM4 : canvas:Ameaca [
		base:nome "Perda de adesão do corpo docente aos programas de capacitação correlatos via atividades de treinamento"
		base:id "FE4.AM4"
	]
}
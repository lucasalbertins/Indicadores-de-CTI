description <http://secti.pe.gov.br/indicador_cti/description/publicosAlvo/publicosGovernoInstituicoesPublicas#> as publicosGovernoInstituicoesPublicas {
	
	uses <http://secti.pe.gov.br/indicador_cti/vocabulary/base#> as base
	uses <http://secti.pe.gov.br/indicador_cti/vocabulary/DesignAvaliacao/canvas#> as canvas
	
	instance PU2.1 : canvas:PublicoAlvo [
		base:nome "Servidores públicos (técnicos, gestores, analistas, funcionários públicos)"
		base:id "PU2.1"
	]
	instance PU2.2 : canvas:PublicoAlvo [
		base:nome "Órgãos do governo estadual (secretarias, autarquias,...)"
		base:id "PU2.2"
	]
	instance PU2.3 : canvas:PublicoAlvo [
		base:nome "Órgãos dos governos municipais (secretarias, autarquias,...)"
		base:id "PU2.3"
	]
	instance PU2.4 : canvas:PublicoAlvo [
		base:nome "Hospitais públicos e privados e unidades de saúde (ex.: UPA)"
		base:id "PU2.4"
	]
	instance PU2.5 : canvas:PublicoAlvo [
		base:nome "Instituições de Ensino Públicas ou Privadas"
		base:id "PU2.5"
	]
	instance PU2.6 : canvas:PublicoAlvo [
		base:nome "Escolas de ensino médio (EREM, ETE, outras)"
		base:id "PU2.6"
	]
	instance PU2.7 : canvas:PublicoAlvo [
		base:nome "Escolas de ensino fundamental"
		base:id "PU2.7"
	]
}
	]
	instance PA4.5 : canvas:PublicoAlvo [
		base:nome "Comunidades de startups (Manguezal, Sete Colinas, ACIC, Tapioca Valley, Caroá Hub; São Francisco Valley, etc)"
		base:id "PA4.5"
	]
	instance PA4.6 : canvas:PublicoAlvo [
		base:nome "Incubadoras"
		base:id "PA4.6"
	]
	instance PA4.7 : canvas:PublicoAlvo [
		base:nome "Aceleradoras"

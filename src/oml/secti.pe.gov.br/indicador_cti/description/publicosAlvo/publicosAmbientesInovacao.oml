	uses <http://secti.pe.gov.br/indicador_cti/vocabulary/DesignAvaliacao/canvas#> as canvas
	
	instance PA4.1 : canvas:PublicoAlvo [
		base:nome "Parques Tecnológicos"
		base:id "PA4.1"
	]
	instance PA4.2 : canvas:PublicoAlvo [
		base:nome "Porto Digital"
		base:id "PA4.2"
	]
	instance PA4.3 : canvas:PublicoAlvo [

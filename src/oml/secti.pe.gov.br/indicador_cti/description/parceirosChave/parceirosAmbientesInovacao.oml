		base:nome "Comunidades de startups (Manguezal, Sete Colinas, ACIC, Tapioca Valley, Caroá Hub; São Francisco Valley, etc)"
		base:id "PC5.5"
	]
	instance PC5.6 : canvas:ParceiroChave [

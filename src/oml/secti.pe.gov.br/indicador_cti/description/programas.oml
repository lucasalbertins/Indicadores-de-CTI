	]
	// Objetivos Gerais
	instance OBJ1 : canvas:ObjetivoGeral [
		base:nome "Promover a formação de recursos humanos qualificados em nível de pós-graduação, de modo a contribuir com o 
desenvolvimento sustentável do estado de Pernambuco"
	]
	instance OBJ2 : canvas:ObjetivoGeral [
		base:nome "Incentivar a criação e o fortalecimento de redes autossustentáveis que promovam e articulem atividades de inovação 
e integrem ICTs e demais agentes do ecossistema, em consonância com as RDs do Estado, visando o fortalecimento de seus ecossistemas"
	]
	instance OB25 : canvas:ObjetivoGeral [
		base:nome "Implantação de Espaços de Criação, Inovação e Aprendizagem, através da estruturação de centros de inovação para promover 
o fortalecimento dos ecossistemas de indústria 4.0 e cultura maker, economia criativa, economia circular e negócios 4.0, nas diferentes 
regiões de desenvolvimento do Estado de Pernambuco, com foco na formação de habilidades portadoras de futuro e no empreendedorismo inovador"
	]
	

description <http://secti.pe.gov.br/indicador_cti/description/programas#> as programas {
	
	uses <http://secti.pe.gov.br/indicador_cti/vocabulary/base#> as base
	uses <http://secti.pe.gov.br/indicador_cti/vocabulary/canvas#> as canvas
	uses <http://secti.pe.gov.br/indicador_cti/vocabulary/programa#> as programa
	
	instance PBPG : programa:programaCTI [
		base:nome "Programa de Bolsas de Pós-Graduação"
		base:descricao "Foi criado para fomentar o desenvolvimento científico e tecnológico do estado de Pernambuco, oferecendo bolsas 
de estudo para alunos de pós-graduação"
		programa:possuiParceiros PC1, PC2, PC3
		programa:condicionadoPor FE1, FE2, FE7, FE8, FE9, FE10, FE11, FE12
		programa:recebeEntradas EN1, EN2, EN3, EN5, EN6, EN7, EN8, EN9
		programa:executa AC1, AC2, AC3, AC4, AC5, AC6, AC7
		programa:geraSaidas OUT1, OUT2, OUT3, OUT4, OUT5, OUT6, OUT7
		programa:buscaAtingir OBJ1, OBJ3, OBJ4, OBJ5, OBJ6, OBJ7
		programa:produzResultados RES1, RES2, RES3, RES4, RES5, RES10, RES11, RES12, RES13, RES14, RES17, RES18, RES19, RES20
		programa:direcionadoA PA1, PA2, PA3, PA9, PA10, PA11, PA12, PA13
	]
	instance RedesDeInovacao : programa:programaCTI [
		base:nome "Programa: Redes de Inovação"
		base:descricao "Foi criado para fomentar a criação e o fortalecimento de redes de colaboração entre diferentes instituições e 
setores, com o objetivo de impulsionar atividades de pesquisa, desenvolvimento e inovação em Pernambuco"
		programa:possuiParceiros PC4, PC5, PC6
		programa:condicionadoPor FE2, FE3, FE4, FE5, FE6, FE7, FE13, FE14, FE15
		programa:recebeEntradas EN1, EN2, EN3, EN4, EN6, EN7, EN8, EN9
		programa:executa AC1, AC3, AC4, AC6, AC7
		programa:geraSaidas OUT1, OUT2, OUT3, OUT4, OUT6, OUT7
		programa:buscaAtingir OBJ2, OBJ8, OBJ9, OBJ10, OBJ11, OBJ12, OBJ13, OBJ14, OBJ15
		programa:produzResultados RES6, RES7, RES8, RES9, RES15, RES16, RES18, RES21, RES22, RES23, RES24
		programa:direcionadoA PA4, PA5, PA6, PA7, PA8, PA14, PA15, PA16, PA17, PA18
	]
	instance EspacosCria : programa:programaCTI [
		base:nome "Programa: Espaços Cria"
		base:descricao "Foi criado para fomentar a cultura da inovação e do empreendedorismo criativo entre estudantes da rede pública 
estadual de ensino médio e técnico de Pernambuco, através da criação de ambientes de aprendizagem colaborativos e inovadores."
		programa:possuiParceiros SEE, FACEPE, ETEs, EREMs, SECTI, SAD
		programa:condicionadoPor FE16, FE17, FE18, FE19, FE20,FE21, FE22, FE23, FE24, FE25, FE26
		programa:recebeEntradas EN2, EN7, EN11, EN12, EN13, EN14, EN15, EN16
		programa:executa AC8, AC9, AC10, AC11, AC12, AC13, AC14, AC15, AC16, AC17
		programa:geraSaidas OUT8, OUT9, OUT10, OUT11, OUT12, OUT13
		programa:buscaAtingir OBJ16, OBJ17, OBJ18, OBJ19, OBJ20, OBJ21, OBJ22, OBJ23, OBJ24, OB25
		programa:produzResultados RES25, RES26, RES27, RES28, RES29, RES30, RES31, RES32, RES33, RES34, RES35, RES36, RES37, RES38, RES39, RES40, RES41
		programa:direcionadoA PA19, PA20, PA21, PA22, PA23, PA24, PA25
	]
	
	// Parceiros-chave
	instance PC1 : canvas:ParceiroChave [
		base:nome "Coordenação de Aperfeiçoamento de Pessoal de Nível Superior - CAPES"
	]
	instance PC2 : canvas:ParceiroChave [
		base:nome "Secretaria de Ciência, Tecnologia e Inovação de Pernambuco - SECTI-PE"
	]
	instance PC3 : canvas:ParceiroChave [
		base:nome "Universidade Federal Rural de Pernambuco - UFRPE"
	]
	instance PC4 : canvas:ParceiroChave [
		base:nome "Fundo de Inovação do Estado de Pernambuco - Inovar-PE"
	]
	instance PC5 : canvas:ParceiroChave [
		base:nome "Agência de Empreendedorismo de Pernambuco - AGE"
	]
	instance PC6 : canvas:ParceiroChave [
		base:nome "Agência de Desenvolvimento Econômico de Pernambuco - Adepe"
	]
	instance SEE : canvas:ParceiroChave [
		base:nome "Secretaria de Educação e Esportes de Pernambuco"
		base:descricao "Organização pública"
	]
	instance FACEPE : canvas:ParceiroChave[
		base:nome "Fundação de Amparo à Ciência e Tecnologia do Estado de Pernambuco"
		base:descricao "Organização pública"
	]
	instance ETEs : canvas:ParceiroChave[
		base:nome "Escolas Técnicas Estaduais"
		base:descricao "Organização pública"
	]
	instance EREMs : canvas:ParceiroChave[
		base:nome "Escolas de Referência em Ensino Médio"
		base:descricao "Organização pública"
	]
	
	instance SECTI : canvas:ParceiroChave[
		base:nome "Secretaria de Ciência, Tecnologia e Inovação"
		base:descricao "Organização pública"
	]
	
	instance SAD : canvas:ParceiroChave[
		base:nome "Secretaria de administração"
		base:descricao "Organização pública"
	]
	
	//Oportunidades
	instance FE1 : canvas:FatorExternoOportunidade [
		base:nome "Parcerias eventuais com Governo e Indústria para financiamento ou complemento da bolsa"
	]
	instance FE2 : canvas:FatorExternoOportunidade [

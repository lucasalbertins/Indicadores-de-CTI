	]
	//Desafios (Ameaças)
	instance FE7 : canvas:FatorExternoDesafio [
		base:nome "Cortes e contingenciamento de recursos estaduais para CT&I"
	]
	instance FE8 : canvas:FatorExternoDesafio [

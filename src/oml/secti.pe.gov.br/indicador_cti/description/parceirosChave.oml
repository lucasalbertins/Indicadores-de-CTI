	]
	instance EREMs : canvas:ParceiroChave[
		base:nome "Escolas de Referência em Ensino Médio"
	]
	instance SAD : canvas:ParceiroChave[
		base:nome "Secretaria de Administração"
	]
	instance ASSIESPE : canvas:ParceiroChave [
		base:nome "Associação das Instituições Municipais de Ensino Superior de Pernambuco"
	]
	instance AGINT : canvas:ParceiroChave [
	]
	
	// Autarquias como agrupador conceitual
	instance AutarquiasMunicipais : canvas:ParceiroChave [
		base:nome "Autarquias Municipais de Ensino Superior do estado de Pernambuco"
	]	
		instance AEDAI : canvas:ParceiroChave [
			base:nome "Autarquia Educacional de Afogados da Ingazeira (AEDAI)"
		]
		instance AEDA : canvas:ParceiroChave [
			base:nome "Autarquia Educacional do Araripe (AEDA)"
		]
		instance AESA : canvas:ParceiroChave [
			base:nome "Autarquia do Ensino Superior de Arcoverde (AESA)"
		]
		instance ABCDE : canvas:ParceiroChave [
			base:nome "Autarquia Belemita de Cultura, Desportos e Educação (ABCDE)"
		]
		instance AEB : canvas:ParceiroChave [
			base:nome "Autarquia Educacional do Belo Jardim (AEB)"
		]
		instance AEDECCA : canvas:ParceiroChave [
			base:nome "Autarquia Educacional para o Desenvolvimento Cultural do Cabo de Santo Agostinho (AEDECCA)"
		]
		instance AESGA : canvas:ParceiroChave [
			base:nome "Autarquia do Ensino Superior de Garanhuns (AESGA)"
		]
		instance AMESG : canvas:ParceiroChave [
			base:nome "Autarquia Municipal do Ensino Superior de Goiana (AMESG)"
		]
		instance AESLI : canvas:ParceiroChave [
			base:nome "Autarquia do Ensino Superior de Limoeiro (AESLI)"

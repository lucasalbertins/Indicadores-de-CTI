description <http://secti.pe.gov.br/indicador_cti/description/parceirosChave#> as parceirosChave {
	
	uses <http://secti.pe.gov.br/indicador_cti/vocabulary/base#> as base
	uses <http://secti.pe.gov.br/indicador_cti/vocabulary/canvas#> as canvas
	
	instance PC1 : canvas:ParceiroChave [
		base:nome "Instituições de Ciência e Tecnologia (ICTs)"
		base:id "PC1"
	]
	instance PC2 : canvas:ParceiroChave [
		base:nome "Organizações públicas e privadas"
		base:id "PC2"
	]
	instance PC3 : canvas:ParceiroChave [
		base:nome "Agências nacionais e internacionais de fomento à CT&I"
		base:id "PC3"
	]
	
	instance CAPES : canvas:ParceiroChave [
		base:nome "Coordenação de Aperfeiçoamento de Pessoal de Nível Superior"
	]
	instance SECTI-PE : canvas:ParceiroChave [
		base:nome "Secretaria de Ciência, Tecnologia e Inovação de Pernambuco"
	]
	instance UFRPE : canvas:ParceiroChave [
		base:nome "Universidade Federal Rural de Pernambuco"
	]
	instance Inovar-PE : canvas:ParceiroChave [

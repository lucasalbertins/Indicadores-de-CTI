	]
	instance Adepe : canvas:ParceiroChave [
		base:nome "Agência de Desenvolvimento Econômico de Pernambuco"
	]
	instance SEE : canvas:ParceiroChave [
		base:nome "Secretaria de Educação e Esportes de Pernambuco"
	]
	instance FACEPE : canvas:ParceiroChave[
		base:nome "Fundação de Amparo à Ciência e Tecnologia do Estado de Pernambuco"
	]
	instance ETEs : canvas:ParceiroChave[

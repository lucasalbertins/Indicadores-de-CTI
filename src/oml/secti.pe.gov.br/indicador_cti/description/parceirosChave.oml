description <http://secti.pe.gov.br/indicador_cti/description/parceirosChave#> as parceirosChave {
	
	uses <http://secti.pe.gov.br/indicador_cti/vocabulary/base#> as base
	uses <http://secti.pe.gov.br/indicador_cti/vocabulary/canvas#> as canvas
	
	instance PC1 : canvas:ParceiroChave [
		base:nome "Instituições de Ciência e Tecnologia (ICTs)"
		base:id "PC1"
	]
	instance PC2 : canvas:ParceiroChave [
		base:nome "Organizações públicas e privadas"
		base:id "PC2"
	]
	instance PC3 : canvas:ParceiroChave [
		base:nome "Agências nacionais e internacionais de fomento à CT&I"
		base:id "PC3"
	]
	
	instance CAPES : canvas:ParceiroChave [
	    base:nome "Coordenação de Aperfeiçoamento de Pessoal de Nível Superior"
	    base:id "CAPES"
	]
	instance SECTI-PE : canvas:ParceiroChave [
	    base:nome "Secretaria de Ciência, Tecnologia e Inovação de Pernambuco"
	    base:id "SECTI"
	]
	instance UFRPE : canvas:ParceiroChave [
	    base:nome "Universidade Federal Rural de Pernambuco"
	    base:id "UFRPE"
	]
	instance Inovar-PE : canvas:ParceiroChave [
	    base:nome "Fundo de Inovação do Estado de Pernambuco"
	    base:id "INOVAR"
	]
	instance AGE : canvas:ParceiroChave [
	    base:nome "Agência de Empreendedorismo de Pernambuco"
	    base:id "AGE"
	]
	instance Adepe : canvas:ParceiroChave [
	    base:nome "Agência de Desenvolvimento Econômico de Pernambuco"
	    base:id "ADEPE"
	]
	instance SEE : canvas:ParceiroChave [
	    base:nome "Secretaria de Educação e Esportes de Pernambuco"
	    base:id "SEE"
	]
	instance FACEPE : canvas:ParceiroChave[
	    base:nome "Fundação de Amparo à Ciência e Tecnologia do Estado de Pernambuco"
	    base:id "FACEPE"
	]
	instance ETEs : canvas:ParceiroChave[
	    base:nome "Escolas Técnicas Estaduais"
	    base:id "ETES"
	]
	instance EREMs : canvas:ParceiroChave[
	    base:nome "Escolas de Referência em Ensino Médio"
	    base:id "EREMS"
	]
	instance SAD : canvas:ParceiroChave[
	    base:nome "Secretaria de Administração"
	    base:id "SAD"
	]
	instance ASSIESPE : canvas:ParceiroChave [
	    base:nome "Associação das Instituições Municipais de Ensino Superior de Pernambuco"
	    base:id "ASSIESPE"
	]
	instance AGINT : canvas:ParceiroChave [
	    base:id "PC-AGINT"
	]
	
	// Autarquias como agrupador conceitual
	instance AutarquiasMunicipais : canvas:ParceiroChave [
	    base:nome "Autarquias Municipais de Ensino Superior do estado de Pernambuco"
	    base:id "AUTARQ"
	]
		instance AEDAI : canvas:ParceiroChave [
		    base:nome "Autarquia Educacional de Afogados da Ingazeira (AEDAI)"
		    base:id "AEDAI"
		]
		instance AEDA : canvas:ParceiroChave [
		    base:nome "Autarquia Educacional do Araripe (AEDA)"
		    base:id "AEDA"
		]
		instance AESA : canvas:ParceiroChave [
		    base:nome "Autarquia do Ensino Superior de Arcoverde (AESA)"
		    base:id "AESA"
		]
		instance ABCDE : canvas:ParceiroChave [
		    base:nome "Autarquia Belemita de Cultura, Desportos e Educação (ABCDE)"
		    base:id "ABCDE"
		]
		instance AEB : canvas:ParceiroChave [
		    base:nome "Autarquia Educacional do Belo Jardim (AEB)"
		    base:id "AEB"
		]
		instance AEDECCA : canvas:ParceiroChave [
		    base:nome "Autarquia Educacional para o Desenvolvimento Cultural do Cabo de Santo Agostinho (AEDECCA)"
		    base:id "AEDECCA"
		]
		instance AESGA : canvas:ParceiroChave [
		    base:nome "Autarquia do Ensino Superior de Garanhuns (AESGA)"
		    base:id "AESGA"
		]
		instance AMESG : canvas:ParceiroChave [
		    base:nome "Autarquia Municipal do Ensino Superior de Goiana (AMESG)"
		    base:id "AMESG"
		]
		instance AESLI : canvas:ParceiroChave [
		    base:nome "Autarquia do Ensino Superior de Limoeiro (AESLI)"
		    base:id "AESLI"
		]
		instance AEMASUL : canvas:ParceiroChave [
		    base:nome "Autarquia Educacional da Mata Sul (AEMASUL)"
		    base:id "AEMASUL"
		]
		instance AEVSF : canvas:ParceiroChave [
		    base:nome "Autarquia Educacional do Vale do São Francisco (AEVSF)"
		    base:id "AEVSF"
		]
		instance AEDS : canvas:ParceiroChave [
		    base:nome "Autarquia Educacional de Salgueiro (AEDS)"
		    base:id "AEDS"
		]
	
	// Parceiros-chave mais gerais
	instance OrgaosPublicos : canvas:ParceiroChave [
	    base:nome "Órgãos públicos integrantes que são apoiadores"
	    base:id "ORGPUB"
	]
	instance EmpresasIntegrantes : canvas:ParceiroChave [
	    base:nome "Empresas integrantes que são apoiadoras"
	    base:id "EMPINT"
	]
	instance AmbientesInovacao : canvas:ParceiroChave [
	    base:nome "Ambientes promotores de inovação"
	    base:id "AMBIOV"
	]
	instance FundacoesApoio : canvas:ParceiroChave [
	    base:nome "Fundações de Apoio credenciadas junto às ICTs pernambucanas"
	    base:id "FUNDAP"
	]
}
description <http://secti.pe.gov.br/indicador_cti/description/entradas/entradasInfraestruturaFisica#> as entradasInfraestruturaFisica {
	
	uses <http://secti.pe.gov.br/indicador_cti/vocabulary/base#> as base
	uses <http://secti.pe.gov.br/indicador_cti/vocabulary/DesignAvaliacao/canvas#> as canvas
	
	instance EN4.1 : canvas:Entrada [
		base:nome "Rede óptica digital"
		base:id "EN4.1"
	]
	instance EN4.2 : canvas:Entrada [
		base:nome "Espaços físicos nas escolas de educação básica (espaço maker, laboratórios, entre outros)"
		base:id "EN4.2"
	]
	instance EN4.3 : canvas:Entrada [
		base:nome "Infraestrutura de CT&I (laboratórios de pesquisa, equipamentos técnicos, salas de treinamento, coworking, entre outras)"
		base:id "EN4.3"
	]
}
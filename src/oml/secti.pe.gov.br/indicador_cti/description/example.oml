description <http://secti.pe.gov.br/indicador_cti/description/example#> as example {
	
	uses <http://secti.pe.gov.br/indicador_cti/vocabulary/planoAvaliacao#> as planoAvaliacao
	uses <http://secti.pe.gov.br/indicador_cti/vocabulary/base#> as base
	uses <http://secti.pe.gov.br/indicador_cti/vocabulary/canvas#> as canvas
	uses <http://secti.pe.gov.br/indicador_cti/vocabulary/programa#> as programa
	uses <http://secti.pe.gov.br/indicador_cti/vocabulary/metricas#> as metricas
	
	
	instance PR1 : programa:programaCTI [	
		base:nome "PBPG: Programa de Bolsas de Pós-Graduação"
		base:descricao "Foi criado para fomentar o desenvolvimento científico e tecnológico do estado de Pernambuco, oferecendo bolsas de estudo para alunos de pós-graduação"
		base:id "PR1"
		programa:avaliadoPor PA1
	]
	
	instance PA1 : planoAvaliacao:questaoAvaliacao [
		base:nome "Qual a taxa de sucesso e quantos bolsistas PBPG foram titulados como mestres e doutores, por ano, por prazo (regular ou prorrogado), por área de conhecimento e por região de desenvolvimento do Estado?"
		base:id "PA1"
		planoAvaliacao:custo "Moderado"
		planoAvaliacao:temMetrica PA1.ME1, PA1.ME2
		planoAvaliacao:temEscopo PA1.ES
		planoAvaliacao:temMetodologia PA1.MA
		planoAvaliacao:temRisco R1
		planoAvaliacao:alinhaComResultado RE.CP1
	]
	
	instance PA1.ME1 : metricas:metricaComposta [
		base:nome "Taxa Titulação"
		base:descricao "Número de bolsistas PBPG titulados no ano sobre o total de cotas PBPG encerradas no ano"
		base:id "PA1.ME1"
		metricas:formula "Bolsistas PBPG titulados por ano / Total de cotas PBPG encerradas por ano"
		metricas:temFonte FI1, FI2
	]
	instance PA1.ME2 : metricas:metricaSimples [
		base:nome "Qtde Titulados"
		base:descricao "Número de bolsistas PBPG titulados, desagregado por: (a) ano de titulação, (b) Modalidade (Mestrado e Doutorado), (c) Prazo (conclusão no prazo regular e Com prorrogação), (d) Grande Área do Conhecimento (CAPES), e (e)  Região de Desenvolvimento do Estado (RDE)"
		base:id "PA1.ME2"
		metricas:temFonte FI1, FI2
	]
	
	instance PA1.ES : planoAvaliacao:escopo [
		base:descricao "Espera-se identificar a efetiva contribuição do PBPG para com a formação de mestres e doutores em Pernambuco. A comparação será longitudinal (ao longo dos anos) do próprio PBPG"
		base:id "PA1.ES"
	]
	instance PA1.MA : planoAvaliacao:metodoAvaliacao [
		base:descricao "Análise Descritiva."
		base:id "PA1.MA"
	]
	
	instance R1 : planoAvaliacao:risco [
		base:descricao "Falta de acesso à alguma das fontes para obtenção de informações"
		base:id "R1"
	]
	
	instance RE.CP1 : canvas:ResultadoEsperado [
		base:nome "Ampliação do número de mestres e doutores titulados no Estado"
		base:id "RE.CP1"
		canvas:prazo "curto"
	]
	
	instance FI1 : planoAvaliacao:fonteInformacao [
		base:nome "AgilFAP (FACEPE)"
		base:id "FI1"
	]
	instance FI2 : planoAvaliacao:fonteInformacao [
		base:nome "Plataforma Sucupira (CAPES)"
		base:id "FI2"
	]
	
}
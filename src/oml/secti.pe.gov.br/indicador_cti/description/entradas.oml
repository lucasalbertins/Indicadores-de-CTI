description <http://secti.pe.gov.br/indicador_cti/description/entradas#> as entradas {
	
	uses <http://secti.pe.gov.br/indicador_cti/vocabulary/base#> as base
	uses <http://secti.pe.gov.br/indicador_cti/vocabulary/canvas#> as canvas
	
	instance EN1 : canvas:Entrada [
		base:nome "Estratégia estadual de CT&I"
		base:id "EN1"
	]
	instance EN2 : canvas:Entrada [
		base:nome "Orçamento estadual"
		base:id "EN2"
	]
	instance EN3 : canvas:Entrada [
		base:nome "Orçamento dos parceiros co-financiadores"
		base:id "EN3"
	]
	instance EN4 : canvas:Entrada [
		base:nome "Recursos humanos de suporte ao Programa"
		base:id "EN4"
	]
	instance EN5 : canvas:Entrada [
		base:nome "Câmaras da FACEPE e/ou comissões de julgamento"
		base:id "EN5"
	]
	instance EN6 : canvas:Entrada [
		base:nome "Sistemas de informação em funcionamento"
		base:id "EN6"
	]
	instance EN7 : canvas:Entrada [
		base:nome "Avaliadores ad-hoc e/ou externos das propostas do Programa"
		base:id "EN7"
	]
	instance EN8 : canvas:Entrada [
		base:nome "Contrapartida das instituições executoras, receptoras e parceiras"
		base:id "EN8"
	]
	instance EN9 : canvas:Entrada [
		base:nome "Comitê Gestor de cada Laboratório Multiusuário e Acervo Científico"
		base:id "EN9"
	]
	instance EN10 : canvas:Entrada [
		base:nome "Proposta preliminar e detalhada de projetos elaborados pelos proponentes para as etapas de seleção"
		base:id "EN10"
	]
	instance EN11 : canvas:Entrada [
		base:nome "Dados e informações governamentais fornecidos pela instituição demandante"
		base:id "EN11"
	]
	instance EN12 : canvas:Entrada [
		base:nome "Espaços físicos adequados nas escolas"
		base:id "EN12"
	]
	instance EN13 : canvas:Entrada [
		base:nome "Sistemas de monitoramento dos espaços/projetos"
		base:id "EN13"
	]
	instance EN14 : canvas:Entrada [
		base:nome "Gerência e Planejamento das organizações parceiras"
		base:id "EN14"
	]
	instance EN15 : canvas:Entrada [
		base:nome "Recursos humanos das Autarquias Municipais de Ensino Superior"
		base:id "EN15"
	]
}
vocabulary <http://secti.pe.gov.br/indicador_cti/vocabulary/programa#> as programa {
	
	extends <http://secti.pe.gov.br/indicador_cti/vocabulary/base#> as base
	extends <http://secti.pe.gov.br/indicador_cti/vocabulary/canvas#> as canvas
	
	concept programaCTI < base:EntidadeNomeavel, base:EntidadeDescritivel
	
	relation possuiParceiros [
		from programaCTI
		to canvas:ParceiroChave
		reverse parceria
		asymmetric
		irreflexive
	]
	
	relation condicionadoPor [
		from programaCTI
		to base:FatorExterno
		reverse condiciona
		asymmetric
		irreflexive
	]
	
	relation recebeEntradas [
		from programaCTI
		to canvas:Entrada
		reverse fornece
		asymmetric
		irreflexive
	]
	
	relation executa [
		from programaCTI
		to canvas:AtividadeChave
		reverse executado
		asymmetric
		irreflexive
	]
	
	relation geraSaidas [
		from programaCTI
		to canvas:Saida
		reverse gerada
		asymmetric
		irreflexive
	]
	
	relation buscaAtingir [
		from programaCTI
		to base:Objetivo
		reverse atingido
		asymmetric
		irreflexive
	]
	
	relation produzResultados [
		from programaCTI
		to base:Resultado
		reverse resulta
		asymmetric
		irreflexive
	]
	
	relation direcionadoA [
		from programaCTI
		to base:PublicoAlvo
		reverse orientado
		asymmetric
		irreflexive
	]
}
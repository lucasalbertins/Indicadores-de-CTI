vocabulary <http://secti.pe.gov.br/indicador_cti/vocabulary/programa#> as programa {
	
	extends <http://secti.pe.gov.br/indicador_cti/vocabulary/base#> as base
	extends <http://secti.pe.gov.br/indicador_cti/vocabulary/canvas#> as canvas
	extends <http://secti.pe.gov.br/indicador_cti/vocabulary/planoAvaliacao#> as pl
	
	concept programaCTI < base:EntidadeNomeavel, base:EntidadeDescritivel [
		restricts buscaAtingir1 to max 1
	]

	relation possuiParceiros [
		from programaCTI
		to canvas:ParceiroChave
		reverse parceria
		asymmetric
		irreflexive
	]
	relation condicionadoPor [
		from programaCTI
		to canvas:FatorExterno
		reverse condiciona
		asymmetric
		irreflexive
	]
	relation recebeEntradas [
		from programaCTI
		to canvas:Entrada
		reverse fornece
		asymmetric
		irreflexive
	]
	relation executa [
		from programaCTI
		to canvas:AtividadeChave
		reverse executado
		asymmetric
		irreflexive
	]
	relation geraSaidas [
		from programaCTI
		to canvas:Saida
		reverse gerada
		asymmetric
		irreflexive
	]
	relation produzResultados [
		from programaCTI
		to canvas:Resultado
		reverse resulta
		asymmetric
		irreflexive
	]
	relation buscaAtingir1 [
		from programaCTI
		to canvas:ObjetivoGeral
		reverse atingido1
		asymmetric
		irreflexive
	]
	relation buscaAtingir2 [
		from programaCTI
		to canvas:ObjetivoEspecifico
		reverse atingido2
		asymmetric
		irreflexive
	]
	relation direcionadoA [
		from programaCTI
		to canvas:PublicoAlvo
		reverse orientado
		asymmetric
		irreflexive
	]
	
	// Programa é avaliado por questões
	relation avaliadoPor [
		from programa:programaCTI
		to pl:questaoAvaliacao
		reverse avaliaPrograma
		asymmetric
		irreflexive
	]
}
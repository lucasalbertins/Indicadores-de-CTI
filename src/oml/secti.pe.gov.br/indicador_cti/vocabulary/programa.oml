vocabulary <http://secti.pe.gov.br/indicador_cti/vocabulary/programa#> as programa {
	
	extends <http://secti.pe.gov.br/indicador_cti/vocabulary/base#> as base
	extends <http://secti.pe.gov.br/indicador_cti/vocabulary/DesignAvaliacao/canvas#> as canvas
	extends <http://secti.pe.gov.br/indicador_cti/vocabulary/DesignAvaliacao/planoAvaliacao#> as pl
	
	concept programaCTI < base:EntidadeNomeavel, base:EntidadeDescritivel, base:EntidadeIdentificavel
	
	relation temCanvas [
		from programaCTI
		to canvas:canvas
		reverse canvasDe
		asymmetric
		irreflexive
	]

	relation temPlanoAvaliacao [
		from programaCTI
		to pl:planoAvaliacao
		reverse planoAvaliacaoDe
		asymmetric
		irreflexive
	]
}
vocabulary <http://secti.pe.gov.br/indicador_cti/vocabulary/fontesInformacao#> as fontesInformacao {
	extends <http://www.w3.org/2001/XMLSchema#> as xsd
	extends <http://secti.pe.gov.br/indicador_cti/vocabulary/classificacao#> as cl
	extends <http://secti.pe.gov.br/indicador_cti/vocabulary/planoAvaliacao#> as pl
	
	// URL ou localização da fonte
	scalar property localizacaoFonte [
		domain pl:fonteInformacao
		range xsd:string
	]
	
	// Responsável pela fonte
	scalar property responsavelFonte [
		domain pl:fonteInformacao
		range xsd:string
	]
	
	// Frequência de atualização da fonte
	scalar property frequenciaAtualizacao [
		domain pl:fonteInformacao
		range xsd:string
	]
	
	// Disponibilidade dos dados (0-100%)
	scalar property disponibilidadeDados [
		domain pl:fonteInformacao
		range xsd:integer
	]
	
	// RELAÇÕES: FONTE DE INFORMAÇÃO
	
	// Fonte é classificada por tipo
	relation classificadaComo [
		from pl:fonteInformacao
		to cl:tipoFonte
		reverse tipoClassificaDe
		asymmetric
		irreflexive
	]
	
	// Fonte pode ter limitações associadas
	relation temLimitacao [
		from pl:fonteInformacao
		to pl:limitacao
		reverse limitacaoDaFonte
		asymmetric
		irreflexive
	]
}
vocabulary <http://secti.pe.gov.br/indicador_cti/vocabulary/base#> as base {
	
	extends <http://www.w3.org/2001/XMLSchema#> as xsd
	
	aspect EntidadeNomeavel
	aspect EntidadeDescritivel
	aspect EntidadeTipavel
	aspect EntidadeIdentificavel [
		key id
	]
	aspect EntidadeAgregavel
	
	scalar Tipo [
		oneOf "direto", "indireto"
	]
	
	scalar property nome [
		domain EntidadeNomeavel
		range xsd:string
		functional
	]
	scalar property descricao [
		domain EntidadeDescritivel
		range xsd:string
		functional
	]
	scalar property id [
		domain EntidadeIdentificavel
		range xsd:string
		functional
	]
	scalar property tipo [
		domain EntidadeTipavel
		range Tipo
		functional
	]
	
	relation entity Agregados [
		from EntidadeAgregavel
		to EntidadeAgregavel
		forward agrega
		reverse agregadoPor
		asymmetric
		irreflexive
	]
}
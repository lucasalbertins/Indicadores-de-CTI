vocabulary <http://secti.pe.gov.br/indicador_cti/vocabulary/metricas#> as metricas {
	
	extends <http://secti.pe.gov.br/indicador_cti/vocabulary/base#> as base
	extends <http://secti.pe.gov.br/indicador_cti/vocabulary/planoAvaliacao#> as planoAvaliacao
	extends <http://www.w3.org/2001/XMLSchema#> as xsd
	
	aspect metrica < base:EntidadeNomeavel, base:EntidadeDescritivel, base:EntidadeIdentificavel, 
	base:EntidadeAgregavel
	concept metricaSimples < metrica [
		restricts base:agrega to max 0
	]
	concept metricaComposta < metrica [
		//Metricas compostas podem agregas outra metricas compostas?
		restricts all base:agrega to metricaComposta
		restricts all base:agregadoPor to metricaSimples
	]

	scalar property formula [
		domain metricaComposta
		range xsd:string
	]
	scalar property valorAtual [
		domain metrica
		range xsd:decimal
	]
	scalar property valorMeta [
		domain metrica
		range xsd:decimal
	]
	
	relation temFonte [
		from metrica
		to planoAvaliacao:fonteInformacao
		reverse fontePara
		asymmetric
		irreflexive
	]
}
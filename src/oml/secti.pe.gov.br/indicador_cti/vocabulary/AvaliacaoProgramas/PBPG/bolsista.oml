vocabulary <http://secti.pe.gov.br/indicador_cti/vocabulary/AvaliacaoProgramas/PBPG/bolsista#> as bolsista {

	extends <http://secti.pe.gov.br/indicador_cti/vocabulary/base#> as base

	extends <http://secti.pe.gov.br/indicador_cti/vocabulary/AvaliacaoProgramas/PBPG/projeto#> as projeto

	extends <http://secti.pe.gov.br/indicador_cti/vocabulary/AvaliacaoProgramas/PBPG/ppg#> as ppg

	extends <http://www.w3.org/2001/XMLSchema#> as xsd

	/*
	 * PESSOA (abstrata)
	 *
	 * Agrupa os atributos que pertencem à pessoa, e não ao vínculo de bolsa,
	 * conforme o diagrama de classes da ontologia principal (ontologia.jpeg).
	 * É um aspect: não é instanciável, logo continua havendo um único tipo
	 * concreto (bolsista) e um único bloco por indivíduo nas descrições.
	 *
	 * Os demais papéis do diagrama -- autor, coordenador e empregado -- devem
	 * especializar este mesmo aspect quando forem modelados, herdando estes
	 * atributos sem duplicação e sem migração de dados.
	 *
	 * nm_pessoa do diagrama é herdado como base:nome.
	 */
	aspect pessoa < base:EntidadeNomeavel

	scalar property nr_cpf [
		domain pessoa
		range xsd:string
		functional
	]

	scalar property an_nascimento [
		domain pessoa
		range xsd:int
		functional
	]

	scalar property nm_pais_nacionalidade [
		domain pessoa
		range xsd:string
		functional
	]

	scalar property nm_cidade_endereco [
		domain pessoa
		range xsd:string
		functional
	]

	scalar property ds_url_cv_lattes [
		domain pessoa
		range xsd:string
		functional
	]

	/*
	 * BOLSISTA
	 *
	 * LIMITAÇÃO CONHECIDA: os atributos do vínculo de bolsa estão no próprio
	 * bolsista e são functional, logo cada indivíduo comporta uma única bolsa.
	 * As métricas PA3.ME2 e PA3.ME3 -- mestre titulado que, dois anos depois,
	 * está em curso de doutorado -- exigem duas concessões para a mesma pessoa
	 * e vão requerer que o vínculo seja reificado numa entidade própria
	 * (ver descrições em PA-PBPG.oml). PA1 e PA2 não são afetadas.
	 */
	concept bolsista < pessoa

	scalar modalidade [
		oneOf "MESTRADO", "DOUTORADO"
	]

	scalar status [
		oneOf "ADIMPLENTE", "INADIMPLENTE"
	]

	scalar property id_bolsa [
		domain bolsista
		range xsd:string
		functional
	]

	scalar property dt_inicio_bolsa [
		domain bolsista
		range xsd:string
		functional
	]

	scalar property dt_fim_bolsa [
		domain bolsista
		range xsd:string
		functional
	]

	scalar property vl_recebido [
		domain bolsista
		range xsd:double
		functional
	]

	scalar property nm_modalidade [
		domain bolsista
		range modalidade
		functional
	]

	scalar property id_semestre_defesa [
		domain bolsista
		range xsd:string
		functional
	]

	scalar property id_semestre_titulacao [
		domain bolsista
		range xsd:string
		functional
	]

	scalar property nm_status [
		domain bolsista
		range status
		functional
	]

	relation desenvolve [
		from bolsista
		to projeto:projeto
		reverse desenvolvidoPor
		asymmetric
		irreflexive
	]

	/*
	 * O bolsista cursa mestrado ou doutorado num unico Programa de
	 * Pos-Graduacao. O PPG, por sua vez, pertence a uma unica grande area do
	 * conhecimento (ver ppg.oml), o que da a esta relacao um segundo papel:
	 * e por ela que a area do conhecimento do BOLSISTA fica determinada, sem
	 * depender do projeto.
	 *
	 * O "unico PPG" esta em functional: no maximo um. A outra metade -- ao
	 * menos um -- seria
	 *
	 *     concept bolsista < pessoa [ restricts matriculadoEm to exactly 1 ]
	 *
	 * e NAO pode ser ligada agora: nenhum dos 9.237 bolsistas de
	 * bolsistas-PBPG.oml nem dos 109 de calculo-metricas-PBPG.oml tem PPG, e o
	 * owlReason reprova cada um deles com "Individual violates minimum
	 * cardinality restriction", derrubando ./gradlew check. Ligue essa linha
	 * quando a matricula estiver preenchida nas descricoes.
	 */
	relation matriculadoEm [
		from bolsista
		to ppg:ppg
		reverse possuiBolsista
		functional
		asymmetric
		irreflexive
	]
}

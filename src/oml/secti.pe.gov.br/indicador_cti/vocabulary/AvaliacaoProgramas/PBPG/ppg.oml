vocabulary <http://secti.pe.gov.br/indicador_cti/vocabulary/AvaliacaoProgramas/PBPG/ppg#> as ppg {

	extends <http://secti.pe.gov.br/indicador_cti/vocabulary/base#> as base

	extends <http://secti.pe.gov.br/indicador_cti/vocabulary/AvaliacaoProgramas/PBPG/areaConhecimento#> as areaConhecimento

	extends <http://www.w3.org/2001/XMLSchema#> as xsd

	/*
	 * PROGRAMA DE PÓS-GRADUAÇÃO (PPG)
	 *
	 * O programa acadêmico em que o bolsista cursa mestrado ou doutorado --
	 * não confundir com programa:programaCTI, que é o programa de fomento
	 * (PBPG, BFP, PIBIC...). São coisas distintas: o PBPG financia bolsistas
	 * matriculados em PPGs.
	 *
	 * É a entidade que falta para as questões PA4 ("evolução do conceito CAPES
	 * dos PPGs apoiados pelo PBPG") e PA5 (produção dos docentes permanentes
	 * dos PPGs). Atributos próprios do PPG -- conceito CAPES por quadriênio,
	 * instituição, nível -- ficam para quando essas métricas forem instanciadas;
	 * aqui entra apenas o que a tarefa pede.
	 *
	 * Um PPG pertence a uma única grande área do conhecimento.
	 */
	concept ppg < base:EntidadeNomeavel, base:EntidadeIdentificavel [
		restricts classificadoEm to exactly 1
	]

	relation classificadoEm [
		from ppg
		to areaConhecimento:areaConhecimento
		reverse classifica
		functional
		asymmetric
		irreflexive
	]

	/*
	 * CONCEITO CAPES POR AVALIAÇÃO
	 *
	 * O conceito que a CAPES atribui ao PPG a cada avaliação quadrienal.
	 * Mesma forma de publicacoesAno -- reunião de 02/09/2026: "publicações por
	 * ano seguiria a mesma ideia desse conceito PPG. Ele teria um ano base e a
	 * quantidade de publicações". Um registro por avaliação, cada um
	 * pertencente a um único PPG (daí o inverse functional).
	 *
	 * É a entidade que falta para PA4.ME1 ("Conceito CAPES dos PPG apoiados
	 * pelo PBPG por avaliação quadrienal") e PA4.ME2 ("PPG com conceitos de
	 * excelência da CAPES (6 e 7)").
	 *
	 * vl_conceito é xsd:int, e não uma enumeração de "1".."7", justamente
	 * porque PA4.ME2 precisa comparar (>= 6). A faixa válida é 1 a 7.
	 *
	 * Sem cardinalidade mínima em possuiConceito: PPG recém-criado ainda não
	 * passou por avaliação quadrienal e não tem conceito nenhum.
	 */
	concept conceitoPPG < base:EntidadeIdentificavel [
		restricts an_avaliacao to exactly 1
		restricts vl_conceito  to exactly 1
	]

	scalar property an_avaliacao [
		domain conceitoPPG
		range xsd:int
		functional
	]

	scalar property vl_conceito [
		domain conceitoPPG
		range xsd:int
		functional
	]

	relation possuiConceito [
		from ppg
		to conceitoPPG
		reverse conceitoDe
		inverse functional
		asymmetric
		irreflexive
	]
}

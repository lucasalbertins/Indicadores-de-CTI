vocabulary <http://secti.pe.gov.br/indicador_cti/vocabulary/AvaliacaoProgramas/PBPG/ppg#> as ppg {

	extends <http://secti.pe.gov.br/indicador_cti/vocabulary/base#> as base

	extends <http://secti.pe.gov.br/indicador_cti/vocabulary/AvaliacaoProgramas/PBPG/areaConhecimento#> as areaConhecimento

	extends <http://secti.pe.gov.br/indicador_cti/vocabulary/AvaliacaoProgramas/PBPG/conceitoPPG#> as conceitoPPG

	extends <http://www.w3.org/2001/XMLSchema#> as xsd

	/*
	 * PROGRAMA DE PÓS-GRADUAÇÃO (PPG)
	 *
	 * O programa acadêmico em que o bolsista cursa mestrado ou doutorado --

	 *
	 * Um PPG pertence a uma única grande área do conhecimento.
	 */
	concept ppg < base:EntidadeNomeavel, base:EntidadeIdentificavel [
		restricts cd_ppg         to exactly 1
		restricts classificadoEm to exactly 1
	]

	/*
	 * cd_ppg, e não só o base:id herdado: é o nome do diagrama de classes, e o
	 * mesmo padrão de conceitoPPG:cd_conceito_ppg e bolsista:id_bolsa -- o
	 * código de domínio fica explícito, o base:id continua sendo a chave da
	 * instância. xsd:string porque o diagrama diz char.
	 */
	scalar property cd_ppg [
		domain ppg
		range xsd:string
		functional
	]

	relation classificadoEm [
		from ppg
		to areaConhecimento:areaConhecimento
		reverse classifica
		functional
		asymmetric
		irreflexive
	]

	/*
	 * O conceito CAPES por avaliação quadrienal mora em conceitoPPG.oml.
	 * Sem cardinalidade mínima aqui: PPG recém-criado ainda não passou por
	 * avaliação e não tem conceito nenhum.
	 */
	relation avaliadoCom [
		from ppg
		to conceitoPPG:conceitoPPG
		reverse avaliacaoDe
		inverse functional
		asymmetric
		irreflexive
	]
}

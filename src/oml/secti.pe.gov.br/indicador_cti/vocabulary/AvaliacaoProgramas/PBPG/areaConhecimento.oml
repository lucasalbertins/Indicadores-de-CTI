vocabulary <http://secti.pe.gov.br/indicador_cti/vocabulary/AvaliacaoProgramas/PBPG/areaConhecimento#> as areaConhecimento {

	extends <http://secti.pe.gov.br/indicador_cti/vocabulary/base#> as base

	extends <http://secti.pe.gov.br/indicador_cti/vocabulary/AvaliacaoProgramas/PBPG/publicacoesAno#> as publicacoesAno

	/*
	 * ÁREA DE CONHECIMENTO
	 *
	 * Grande área do conhecimento FACEPE, usada como dimensão de desagregação
	 * em praticamente todas as métricas do plano de avaliação do PBPG.
	 *
	 * Convive, por ora, com o scalar projeto:area-conhecimento (oneOf
	 * "HUMANAS", "EXATAS", "SAÚDE"), que continua sendo o que a ABox do estudo
	 * de caso preenche via projeto:nm_area_conhecimento. Este conceito é a
	 * forma reificada da mesma noção: só ele pode receber relações -- as
	 * publicações por ano (publicacoesAno.oml) e o PPG (ppg.oml). A migração do scalar
	 * para o conceito é um passo à parte, que exige regerar as descrições.
	 */
	concept areaConhecimento < base:EntidadeNomeavel, base:EntidadeIdentificavel [
		restricts possuiPublicacoesAno to min 1
	]

	relation possuiPublicacoesAno [
		from areaConhecimento
		to publicacoesAno:publicacoesAno
		reverse publicacoesAnoDe
		inverse functional
		asymmetric
		irreflexive
	]
}

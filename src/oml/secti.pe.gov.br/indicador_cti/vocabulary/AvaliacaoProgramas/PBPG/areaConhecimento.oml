vocabulary <http://secti.pe.gov.br/indicador_cti/vocabulary/AvaliacaoProgramas/PBPG/areaConhecimento#> as areaConhecimento {

	extends <http://secti.pe.gov.br/indicador_cti/vocabulary/base#> as base

	extends <http://secti.pe.gov.br/indicador_cti/vocabulary/AvaliacaoProgramas/PBPG/publicacoesAno#> as publicacoesAno

	extends <http://secti.pe.gov.br/indicador_cti/vocabulary/AvaliacaoProgramas/PBPG/indiceHAno#> as indiceHAno

	/*
	 * ÁREA DE CONHECIMENTO
	 *
	 * SEM RESTRICAO DE CARDINALIDADE em possuiPublicacoesAno.
	 */
	concept areaConhecimento < base:EntidadeNomeavel, base:EntidadeIdentificavel

	relation possuiPublicacoesAno [
		from areaConhecimento
		to publicacoesAno:publicacoesAno
		reverse publicacoesAnoDe
		inverse functional
		asymmetric
		irreflexive
	]

	/*
	 * O índice h e o h5 médios do ano, em conceito próprio porque o grão é
	 * outro: (área, ano), sem quartil -- ver indiceHAno.oml.
	 */
	relation possuiIndiceHAno [
		from areaConhecimento
		to indiceHAno:indiceHAno
		reverse indiceHAnoDe
		inverse functional
		asymmetric
		irreflexive
	]
}

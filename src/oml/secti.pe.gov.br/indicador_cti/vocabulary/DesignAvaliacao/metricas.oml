vocabulary <http://secti.pe.gov.br/indicador_cti/vocabulary/DesignAvaliacao/metricas#> as metricas {
	
	extends <http://secti.pe.gov.br/indicador_cti/vocabulary/base#> as base
	extends <http://secti.pe.gov.br/indicador_cti/vocabulary/DesignAvaliacao/planoAvaliacao#> as planoAvaliacao
	extends <http://www.w3.org/2001/XMLSchema#> as xsd
	
	concept metrica < base:EntidadeNomeavel, base:EntidadeDescritivel, base:EntidadeIdentificavel, 
	base:EntidadeAgregavel [
		restricts temFonte to min 1
	]
	
	scalar Finalidade [
		oneOf "Maximizar", "Minimizar", "Equilibrar"
	]
	
	scalar property finalidade [
		domain metrica
		range Finalidade
		functional
	]

	scalar property valorAtual [
		domain metrica
		range xsd:decimal
	]
	scalar property valorMeta [
		domain metrica
		range xsd:decimal
	]
	
	relation temFonte [
		from metrica
		to planoAvaliacao:fonteInformacao
		reverse fontePara
		asymmetric
		irreflexive
	]
}
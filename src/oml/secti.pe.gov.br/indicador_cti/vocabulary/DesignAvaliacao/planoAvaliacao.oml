vocabulary <http://secti.pe.gov.br/indicador_cti/vocabulary/DesignAvaliacao/planoAvaliacao#> as planoAvaliacao {
	
	extends <http://secti.pe.gov.br/indicador_cti/vocabulary/base#> as base
	extends <http://secti.pe.gov.br/indicador_cti/vocabulary/DesignAvaliacao/canvas#> as canvas
	extends <http://secti.pe.gov.br/indicador_cti/vocabulary/DesignAvaliacao/metricas#> as metricas
	
	concept questaoAvaliacao < base:EntidadeNomeavel, base:EntidadeIdentificavel
	concept fonteInformacao < base:EntidadeNomeavel, base:EntidadeIdentificavel
	concept escopo < base:EntidadeDescritivel, base:EntidadeIdentificavel
	concept metodoAvaliacao < base:EntidadeDescritivel, base:EntidadeIdentificavel
	concept risco < base:EntidadeDescritivel, base:EntidadeIdentificavel
	concept limitacao < base:EntidadeDescritivel
	
	scalar Custo [
		oneOf "Alto", "Moderado", "Baixo"
	]
	
	scalar property custo [
		domain questaoAvaliacao
		range Custo
		functional
	]
	
	relation temMetrica [
		from questaoAvaliacao
		to metricas:metrica
		reverse metricaPara
		asymmetric
		irreflexive
	]
	relation temEscopo [
		from questaoAvaliacao
		to escopo
		reverse escopoPara
		asymmetric
		irreflexive
	]
	relation temMetodologia [
		from questaoAvaliacao
		to metodoAvaliacao
		reverse metodologiaPara
		asymmetric
		irreflexive
	]
	relation temRisco [
		from questaoAvaliacao
		to risco
		reverse riscoPara
		asymmetric
		irreflexive
	]
	relation temLimitacao [
		from questaoAvaliacao
		to limitacao
		reverse limitacaoPara
		asymmetric
		irreflexive
	]
	relation alinhaComResultado [
		from questaoAvaliacao
		to canvas:ResultadoEsperado
		reverse alinhadoCom
		asymmetric
		irreflexive
	]
}
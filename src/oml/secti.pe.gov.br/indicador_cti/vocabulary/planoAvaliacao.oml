vocabulary <http://secti.pe.gov.br/indicador_cti/vocabulary/planoAvaliacao#> as planoAvaliacao {
	
	extends <http://secti.pe.gov.br/indicador_cti/vocabulary/base#> as base
	extends <http://secti.pe.gov.br/indicador_cti/vocabulary/canvas#> as canvas
	extends <http://secti.pe.gov.br/indicador_cti/vocabulary/metricas#> as metricas
	
	concept questaoAvaliacao < base:EntidadeNomeavel, base:EntidadeDescritivel, 
	base:EntidadeIdentificavel
	concept fonteInformacao < base:EntidadeNomeavel, base:EntidadeDescritivel, 
	base:EntidadeIdentificavel
	concept escopo < base:EntidadeNomeavel, base:EntidadeDescritivel
	concept metodoAvaliacao < base:EntidadeNomeavel, base:EntidadeDescritivel
	concept custoExecucao < base:EntidadeNomeavel, base:EntidadeDescritivel
	concept risco < base:EntidadeNomeavel, base:EntidadeDescritivel, base:EntidadeIdentificavel
	concept limitacao < base:EntidadeNomeavel, base:EntidadeDescritivel
	
	scalar Custo [
		oneOf "Alto", "Moderado", "Baixo"
	]
	
	scalar property custo [
		domain custoExecucao
		range Custo
		functional
	]
	
	relation temMetrica [
		from questaoAvaliacao
		to metricas:metrica
		reverse metricaPara
		asymmetric
		irreflexive
	]
	relation temFonte [
		from questaoAvaliacao
		to fonteInformacao
		reverse fonteInformacaoPara
		asymmetric
		irreflexive
	]
	relation temEscopo [
		from questaoAvaliacao
		to escopo
		reverse escopoPara
		asymmetric
		irreflexive
	]
	relation temMetodologia [
		from questaoAvaliacao
		to metodoAvaliacao
		reverse metodologiaPara
		asymmetric
		irreflexive
	]
	relation temCusto [
		from questaoAvaliacao
		to custoExecucao
		reverse custoPara
		asymmetric
		irreflexive
	]
	relation temRisco [
		from questaoAvaliacao
		to risco
		reverse riscoPara
		asymmetric
		irreflexive
	]
	relation temLimitacao [
		from questaoAvaliacao
		to limitacao
		reverse limitacaoPara
		asymmetric
		irreflexive
	]
	relation alinhaComObjetivoGeral [
		from questaoAvaliacao
		to canvas:ObjetivoGeral
		reverse objetivoGeralAlinhadoCom
		asymmetric
		irreflexive
	]
	relation alinhaComObjetivoEspecifico [
		from questaoAvaliacao
		to canvas:ObjetivoEspecifico
		reverse objetivoEspecificoAlinhadoCom
		asymmetric
		irreflexive
	]
	relation alinhaComResultado [
		from questaoAvaliacao
		to canvas:Resultado
		reverse resultadoAlinhadoCom
		asymmetric
		irreflexive
	]
}
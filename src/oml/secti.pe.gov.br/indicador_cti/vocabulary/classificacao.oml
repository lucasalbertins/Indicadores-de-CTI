vocabulary <http://secti.pe.gov.br/indicador_cti/vocabulary/classificacao#> as classificacao {
	
	extends <http://secti.pe.gov.br/indicador_cti/vocabulary/base#> as base
	
	// Categoria de Avaliação - agrupamento temático das questões
	concept categoriaAvaliacao < base:EntidadeNomeavel, base:EntidadeDescritivel
	
	// Periodicidade - frequência de coleta da métrica
	concept periodicidade < base:EntidadeNomeavel
	
	// Unidade de Medida - unidade em que a métrica é expressa
	concept unidadeMedida < base:EntidadeNomeavel
	
	// Tipo de Fonte - classificação da fonte (sistema, base gov., pesquisa...)
	concept tipoFonte < base:EntidadeNomeavel
	
	// Dimensão de Avaliação - aspecto avaliado (eficácia, eficiência, impacto...)
	concept dimensaoAvaliacao < base:EntidadeNomeavel, base:EntidadeDescritivel
}
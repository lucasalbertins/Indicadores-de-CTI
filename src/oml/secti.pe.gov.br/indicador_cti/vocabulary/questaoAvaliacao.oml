vocabulary <http://secti.pe.gov.br/indicador_cti/vocabulary/questaoAvaliacao#> as questaoAvaliacao {
	extends <http://secti.pe.gov.br/indicador_cti/vocabulary/canvas#> as canvas
	extends <http://secti.pe.gov.br/indicador_cti/vocabulary/classificacao#> as cl
	extends <http://secti.pe.gov.br/indicador_cti/vocabulary/planoAvaliacao#> as pl
	
	
	// Questão possui métricas para sua medição
	relation possuiMetrica [
		from pl:questaoAvaliacao
		to pl:metrica
		reverse metricaDe
		asymmetric
		irreflexive
	]
	
	// Questão pertence a uma categoria
	relation pertenceCategoria [
		from pl:questaoAvaliacao
		to cl:categoriaAvaliacao
		reverse contemQuestao
		asymmetric
		irreflexive
	]
	
	// Questão avalia uma dimensão específica
	relation avaliaDimensao [
		from pl:questaoAvaliacao
		to cl:dimensaoAvaliacao
		reverse dimensaoAvaliadaPor
		asymmetric
		irreflexive
	]
	
	// ==========================================
	// RELAÇÕES: ALINHAMENTO COM CANVAS
	// ==========================================
	
	// Questão alinha-se com Objetivos Gerais do programa
	relation alinhaComObjetivoGeral [
		from pl:questaoAvaliacao
		to canvas:ObjetivoGeral
		reverse objetivoAvaliadoPorQuestao
		asymmetric
		irreflexive
	]
	
	// Questão alinha-se com Objetivos Específicos do programa
	relation alinhaComObjetivoEspecifico [
		from pl:questaoAvaliacao
		to canvas:ObjetivoEspecifico
		reverse avaliadoPor
		asymmetric
		irreflexive
	]
	
	// Questão alinha-se com Resultados esperados
	relation alinhaComResultado [
		from pl:questaoAvaliacao
		to canvas:Resultado
		reverse resultadoAvaliadoPor
		asymmetric
		irreflexive
	]
	
	// Questão alinha-se com Saídas do programa
	relation alinhaComSaida [
		from pl:questaoAvaliacao
		to canvas:Saida
		reverse avaliadaPorQuestao
		asymmetric
		irreflexive
	]
	
	// Questão relaciona-se com Atividades-Chave
	relation relacionaAtividadeChave [
		from pl:questaoAvaliacao
		to canvas:AtividadeChave
		reverse monitoradaPorQuestao
		asymmetric
		irreflexive
	]
	
	// Questão foca em Público-Alvo específico
	relation focaPublicoAlvo [
		from pl:questaoAvaliacao
		to canvas:PublicoAlvo
		reverse avaliadoPorQuestao
		asymmetric
		irreflexive
	]
	
	// Questão pode estar relacionada a Fatores Externos
	relation influenciadaPorFator [
		from pl:questaoAvaliacao
		to canvas:FatorExterno
		reverse influenciaQuestao
		asymmetric
		irreflexive
	]
}

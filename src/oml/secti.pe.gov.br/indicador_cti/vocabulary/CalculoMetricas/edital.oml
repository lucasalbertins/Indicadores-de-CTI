vocabulary <http://secti.pe.gov.br/indicador_cti/vocabulary/CalculoMetricas/edital#> as edital {

	extends <http://secti.pe.gov.br/indicador_cti/vocabulary/base#> as base

	extends <http://secti.pe.gov.br/indicador_cti/vocabulary/programa#> as programa

	extends <http://www.w3.org/2001/XMLSchema#> as xsd

	concept edital < base:EntidadeNomeavel, base:EntidadeIdentificavel

	scalar property dt_publicacao [
		domain edital
		range xsd:string
		functional
	]

	scalar property vl_investimento [
		domain edital
		range xsd:double
		functional
	]

	relation vinculadoA [
		from edital
		to programa:programaCTI
		reverse vincula
		asymmetric
		irreflexive
	]
}
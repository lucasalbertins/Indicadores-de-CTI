vocabulary <http://secti.pe.gov.br/indicador_cti/vocabulary/canvas#> as canvas {
	
	extends <http://secti.pe.gov.br/indicador_cti/vocabulary/base#> as base
	
	concept ParceiroChave < base:EntidadeNomeavel, base:EntidadeDescritivel, base:EntidadeIdentificavel [
		restricts base:id to max 1
		restricts base:id to min 1
	]
	concept Entrada < base:EntidadeNomeavel, base:EntidadeDescritivel, base:EntidadeIdentificavel [
		restricts base:id to max 1
		restricts base:id to min 1
	]
	concept AtividadeChave < base:EntidadeNomeavel, base:EntidadeDescritivel, base:EntidadeIdentificavel [
		restricts base:id to max 1
		restricts base:id to min 1
	]
	concept Saida < base:EntidadeNomeavel, base:EntidadeDescritivel, base:EntidadeIdentificavel [
		restricts base:id to max 1
		restricts base:id to min 1
	]
	concept Resultado < base:EntidadeNomeavel, base:EntidadeDescritivel, base:EntidadeIdentificavel [
		restricts base:id to max 1
		restricts base:id to min 1
	]
	concept PublicoAlvo < base:EntidadeNomeavel, base:EntidadeDescritivel, base:EntidadeIdentificavel [
		restricts base:id to max 1
		restricts base:id to min 1
	]
	concept FatorExterno < base:EntidadeNomeavel, base:EntidadeDescritivel, base:EntidadeIdentificavel [
		restricts base:id to max 1
		restricts base:id to min 1
	]
	concept Oportunidade < FatorExterno
	concept Ameaca < FatorExterno
	concept Objetivo < base:EntidadeNomeavel, base:EntidadeDescritivel, base:EntidadeIdentificavel
	concept ObjetivoGeral < Objetivo
	concept ObjetivoEspecifico < Objetivo

	scalar Prazo [
		oneOf "curto", "médio", "longo"
	]
	scalar Tipo [
		oneOf "direto", "indireto"
	]
	
	scalar property prazo [
		domain Resultado
		range Prazo
		functional
	]
	scalar property tipo [
		domain PublicoAlvo
		range Tipo
		functional
	]
	
	relation recebeEntrada [
		from AtividadeChave
		to Entrada
		reverse entradaDe
		asymmetric
		irreflexive
	]
	relation geraSaida [
		from AtividadeChave
		to Saida
		reverse saidaDe
		asymmetric
		irreflexive
	]
	relation buscaAtingir [
		from Resultado
		to ObjetivoEspecifico
		reverse atingidoPor
		asymmetric
		irreflexive
	]
}
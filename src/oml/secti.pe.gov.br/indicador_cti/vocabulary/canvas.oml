vocabulary <http://secti.pe.gov.br/indicador_cti/vocabulary/canvas#> as canvas {
	
	extends <http://secti.pe.gov.br/indicador_cti/vocabulary/base#> as base
	
	concept ParceiroChave < base:EntidadeNomeavel, base:EntidadeDescritivel
	concept Entrada < base:EntidadeNomeavel, base:EntidadeDescritivel
	concept AtividadeChave < base:EntidadeNomeavel, base:EntidadeDescritivel
	concept Saida < base:EntidadeNomeavel, base:EntidadeDescritivel
	concept Resultado < base:EntidadeNomeavel, base:EntidadeDescritivel
	concept PublicoAlvo < base:EntidadeNomeavel, base:EntidadeDescritivel
	concept FatorExterno < base:EntidadeNomeavel, base:EntidadeDescritivel
	concept Oportunidade < FatorExterno
	concept Ameaca < FatorExterno
	concept Objetivo < base:EntidadeNomeavel, base:EntidadeDescritivel
	concept ObjetivoGeral < Objetivo
	concept ObjetivoEspecifico < Objetivo

	scalar Prazo [
		oneOf "curto", "médio", "longo"
	]
	scalar Tipo [
		oneOf "direto", "indireto"
	]
	
	scalar property prazo [
		domain Resultado
		range Prazo
		functional
	]
	scalar property tipo [
		domain PublicoAlvo
		range Tipo
		functional
	]
}
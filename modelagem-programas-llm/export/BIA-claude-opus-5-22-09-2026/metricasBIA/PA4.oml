description <http://secti.pe.gov.br/indicador_cti/description/programas/programasFormacaoFixacaoTalentos/BIA/metricasBIA/PA4#> as PA4 {

	extends <http://secti.pe.gov.br/indicador_cti/description/programas/programasFormacaoFixacaoTalentos/BIA/metricasBIA/PA2#> as metricasPA2
	extends <http://secti.pe.gov.br/indicador_cti/description/fontesInformacao/fontesSistemasBasesGovernamentais#> as fontesSistemasBasesGovernamentais
	extends <http://secti.pe.gov.br/indicador_cti/description/fontesInformacao/fontesBasesAcademicasCientificasEducacionais#> as fontesBasesAcademicasCientificasEducacionais
	uses <http://secti.pe.gov.br/indicador_cti/vocabulary/base#> as base
	uses <http://secti.pe.gov.br/indicador_cti/vocabulary/DesignAvaliacao/metricas#> as metricas
	uses <http://secti.pe.gov.br/indicador_cti/vocabulary/DesignAvaliacao/formulas#> as formulas
	uses <http://www.w3.org/2001/XMLSchema#> as xsd

	// ESTRATIFICAÇÕES (Dimensões de Desagregação)
	instance estratAno : formulas:estratificacao [
		base:id "estrat_ano_PA4_BIA"
		base:nome "Ano"
	]
	instance estratArea : formulas:estratificacao [
		base:id "estrat_area_PA4_BIA"
		base:nome "Grande Área do Conhecimento FACEPE"
	]
	instance estratRDE : formulas:estratificacao [
		base:id "estrat_rde_PA4_BIA"
		base:nome "Região de Desenvolvimento do Estado"
	]

	// MÉTRICA PA4.ME1 - contagem direta da fonte
	instance PA4.ME1 : metricas:metrica [
		base:nome "Número de Bolsistas BIA Matriculados em PPGs Acadêmicos"
		base:descricao "Número total de bolsistas egressos BIA que estão matriculados em Programas de Pós-graduação Acadêmico nível mestrado em IES Pernambucana, desagregado por ano, grande área de conhecimento FACEPE e região de desenvolvimento."
		base:id "PA4.ME1 - BIA"
		metricas:finalidade "Maximizar"
		formulas:possuiFormula formulaPpgAcademico
		formulas:estratificadaPor estratAno
		formulas:estratificadaPor estratArea
		formulas:estratificadaPor estratRDE
		metricas:temFonte fontesSistemasBasesGovernamentais:FI2.1, fontesBasesAcademicasCientificasEducacionais:FI3.1
	]

	instance formulaPpgAcademico : formulas:formula [
		base:id "formula_identidade_PA4.ME1_BIA"
		formulas:referenciaOperacao "http://www.openmath.org/cd/fns1#identity"
		formulas:possuiArgumento argPpgAcademico
		formulas:formulaDe PA4.ME1
	]
	instance argPpgAcademico : formulas:argumento [
		base:id "arg_valor_unico_PA4.ME1_BIA"
		formulas:posicao "1"^^xsd:int
		formulas:nome "value"
		formulas:possuiValor valorPpgAcademico
		formulas:argumentoDe formulaPpgAcademico
	]
	instance valorPpgAcademico : formulas:tipovalorMetrica [
		base:id "valor_PA4.ME1_BIA"
		formulas:valorMetrica PA4.ME1
	]

	// MÉTRICA PA4.ME3 - taxa: multiplicacao(divisao(PA4.ME1, PA2.ME2), 100)
	instance PA4.ME3 : metricas:metrica [
		base:nome "Taxa de Bolsistas BIA Matriculados em PPGs Acadêmicos"
		base:descricao "Percentual de bolsistas egressos BIA que estão matriculados em PPGs acadêmicos, nível mestrado, em relação ao número total de bolsistas concluintes desagregados por ano, grande área de conhecimento FACEPE e RDE."
		base:id "PA4.ME3 - BIA"
		metricas:finalidade "Maximizar"
		formulas:possuiFormula formulaMultTaxaAcademico
		formulas:estratificadaPor estratAno
		formulas:estratificadaPor estratArea
		formulas:estratificadaPor estratRDE
		metricas:temFonte fontesSistemasBasesGovernamentais:FI2.1, fontesBasesAcademicasCientificasEducacionais:FI3.1
	]

	instance formulaDivTaxaAcademico : formulas:formula [
		base:id "formula_divisao_PA4.ME3_BIA"
		formulas:referenciaOperacao "http://www.openmath.org/cd/arith1#divide"
		formulas:possuiArgumento argDividendoAcademico
		formulas:possuiArgumento argDivisorAcademico
	]
	instance argDividendoAcademico : formulas:argumento [
		base:id "arg_dividendo_PA4.ME3_BIA"
		formulas:posicao "1"^^xsd:int
		formulas:nome "dividend"
		formulas:possuiValor valorAcademicoParaTaxa
		formulas:argumentoDe formulaDivTaxaAcademico
	]
	instance argDivisorAcademico : formulas:argumento [
		base:id "arg_divisor_PA4.ME3_BIA"
		formulas:posicao "2"^^xsd:int
		formulas:nome "divisor"
		formulas:possuiValor valorConcluintesParaTaxaAcademico
		formulas:argumentoDe formulaDivTaxaAcademico
	]
	instance valorAcademicoParaTaxa : formulas:tipovalorMetrica [
		base:id "valorAcademico_PA4.ME3_BIA"
		formulas:valorMetrica PA4.ME1
	]
	instance valorConcluintesParaTaxaAcademico : formulas:tipovalorMetrica [
		base:id "valorConcluintes_PA4.ME3_BIA"
		formulas:valorMetrica metricasPA2:PA2.ME2
	]

	instance formulaMultTaxaAcademico : formulas:formula [
		base:id "formula_multiplicacao_PA4.ME3_BIA"
		formulas:referenciaOperacao "http://www.openmath.org/cd/arith1#times"
		formulas:possuiArgumento argMultiplicandoAcademico
		formulas:possuiArgumento argMultiplicadorAcademico
		formulas:formulaDe PA4.ME3
	]
	instance argMultiplicandoAcademico : formulas:argumento [
		base:id "arg_multiplicando_PA4.ME3_BIA"
		formulas:posicao "1"^^xsd:int
		formulas:nome "multiplicand"
		formulas:possuiValor valorFormulaDivAcademico
		formulas:argumentoDe formulaMultTaxaAcademico
	]
	instance argMultiplicadorAcademico : formulas:argumento [
		base:id "arg_multiplicador_PA4.ME3_BIA"
		formulas:posicao "2"^^xsd:int
		formulas:nome "multiplier"
		formulas:possuiValor valorCemAcademico
		formulas:argumentoDe formulaMultTaxaAcademico
	]
	instance valorFormulaDivAcademico : formulas:tipovalorFormula [
		base:id "valorFormulaDivisao_PA4.ME3_BIA"
		formulas:valorFormula formulaDivTaxaAcademico
	]
	instance valorCemAcademico : formulas:tipovalorLiteral [
		base:id "valorLiteral100_PA4.ME3_BIA"
		formulas:valorLiteral 100
	]

	// MÉTRICA PA4.ME4 - contagem direta da fonte
	instance PA4.ME4 : metricas:metrica [
		base:nome "Número de Bolsistas BIA Matriculados em PPGs Profissional"
		base:descricao "Número total de bolsistas egressos BIA que estão matriculados em Programas de Pós-graduação Profissional nível mestrado em IES Pernambucana, desagregado por ano, grande área de conhecimento FACEPE e região de desenvolvimento."
		base:id "PA4.ME4 - BIA"
		metricas:finalidade "Maximizar"
		formulas:possuiFormula formulaPpgProfissional
		formulas:estratificadaPor estratAno
		formulas:estratificadaPor estratArea
		formulas:estratificadaPor estratRDE
		metricas:temFonte fontesSistemasBasesGovernamentais:FI2.1, fontesBasesAcademicasCientificasEducacionais:FI3.1
	]

	instance formulaPpgProfissional : formulas:formula [
		base:id "formula_identidade_PA4.ME4_BIA"
		formulas:referenciaOperacao "http://www.openmath.org/cd/fns1#identity"
		formulas:possuiArgumento argPpgProfissional
		formulas:formulaDe PA4.ME4
	]
	instance argPpgProfissional : formulas:argumento [
		base:id "arg_valor_unico_PA4.ME4_BIA"
		formulas:posicao "1"^^xsd:int
		formulas:nome "value"
		formulas:possuiValor valorPpgProfissional
		formulas:argumentoDe formulaPpgProfissional
	]
	instance valorPpgProfissional : formulas:tipovalorMetrica [
		base:id "valor_PA4.ME4_BIA"
		formulas:valorMetrica PA4.ME4
	]

	// MÉTRICA PA4.ME5 - taxa: multiplicacao(divisao(PA4.ME4, PA2.ME2), 100)
	instance PA4.ME5 : metricas:metrica [
		base:nome "Taxa de Bolsistas BIA Matriculados em PPGs Profissional"
		base:descricao "Percentual de bolsistas egressos BIA que estão matriculados em PPGs profissional, nível mestrado, em relação ao número total de bolsistas concluintes desagregados por ano, grande área de conhecimento FACEPE e RDE."
		base:id "PA4.ME5 - BIA"
		metricas:finalidade "Maximizar"
		formulas:possuiFormula formulaMultTaxaProfissional
		formulas:estratificadaPor estratAno
		formulas:estratificadaPor estratArea
		formulas:estratificadaPor estratRDE
		metricas:temFonte fontesSistemasBasesGovernamentais:FI2.1, fontesBasesAcademicasCientificasEducacionais:FI3.1
	]

	instance formulaDivTaxaProfissional : formulas:formula [
		base:id "formula_divisao_PA4.ME5_BIA"
		formulas:referenciaOperacao "http://www.openmath.org/cd/arith1#divide"
		formulas:possuiArgumento argDividendoProfissional
		formulas:possuiArgumento argDivisorProfissional
	]
	instance argDividendoProfissional : formulas:argumento [
		base:id "arg_dividendo_PA4.ME5_BIA"
		formulas:posicao "1"^^xsd:int
		formulas:nome "dividend"
		formulas:possuiValor valorProfissionalParaTaxa
		formulas:argumentoDe formulaDivTaxaProfissional
	]
	instance argDivisorProfissional : formulas:argumento [
		base:id "arg_divisor_PA4.ME5_BIA"
		formulas:posicao "2"^^xsd:int
		formulas:nome "divisor"
		formulas:possuiValor valorConcluintesParaTaxaProfissional
		formulas:argumentoDe formulaDivTaxaProfissional
	]
	instance valorProfissionalParaTaxa : formulas:tipovalorMetrica [
		base:id "valorProfissional_PA4.ME5_BIA"
		formulas:valorMetrica PA4.ME4
	]
	instance valorConcluintesParaTaxaProfissional : formulas:tipovalorMetrica [
		base:id "valorConcluintes_PA4.ME5_BIA"
		formulas:valorMetrica metricasPA2:PA2.ME2
	]

	instance formulaMultTaxaProfissional : formulas:formula [
		base:id "formula_multiplicacao_PA4.ME5_BIA"
		formulas:referenciaOperacao "http://www.openmath.org/cd/arith1#times"
		formulas:possuiArgumento argMultiplicandoProfissional
		formulas:possuiArgumento argMultiplicadorProfissional
		formulas:formulaDe PA4.ME5
	]
	instance argMultiplicandoProfissional : formulas:argumento [
		base:id "arg_multiplicando_PA4.ME5_BIA"
		formulas:posicao "1"^^xsd:int
		formulas:nome "multiplicand"
		formulas:possuiValor valorFormulaDivProfissional
		formulas:argumentoDe formulaMultTaxaProfissional
	]
	instance argMultiplicadorProfissional : formulas:argumento [
		base:id "arg_multiplicador_PA4.ME5_BIA"
		formulas:posicao "2"^^xsd:int
		formulas:nome "multiplier"
		formulas:possuiValor valorCemProfissional
		formulas:argumentoDe formulaMultTaxaProfissional
	]
	instance valorFormulaDivProfissional : formulas:tipovalorFormula [
		base:id "valorFormulaDivisao_PA4.ME5_BIA"
		formulas:valorFormula formulaDivTaxaProfissional
	]
	instance valorCemProfissional : formulas:tipovalorLiteral [
		base:id "valorLiteral100_PA4.ME5_BIA"
		formulas:valorLiteral 100
	]
}

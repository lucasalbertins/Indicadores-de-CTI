description <http://secti.pe.gov.br/indicador_cti/description/programas/programasFormacaoFixacaoTalentos/BPP/BPP#> as BPP {


	extends <http://secti.pe.gov.br/indicador_cti/description/parceirosChave/parceirosGoverno#> as parceirosGoverno
	extends <http://secti.pe.gov.br/indicador_cti/description/parceirosChave/parceirosAgenciasFomento#> as parceirosAgenciasFomento
	extends <http://secti.pe.gov.br/indicador_cti/description/parceirosChave/parceirosAcademiaICTs#> as parceirosAcademiaICTs
	extends <http://secti.pe.gov.br/indicador_cti/description/fatoresExternos/fatoresCenarioEconomico#> as fatoresCenarioEconomico
	extends <http://secti.pe.gov.br/indicador_cti/description/fatoresExternos/fatoresCenarioInstitucionalLegal#> as fatoresCenarioInstitucionalLegal
	extends <http://secti.pe.gov.br/indicador_cti/description/fatoresExternos/fatoresCenarioSocialEducacional#> as fatoresCenarioSocialEducacional
	extends <http://secti.pe.gov.br/indicador_cti/description/fatoresExternos/fatoresDinamicaEcossistema#> as fatoresDinamicaEcossistema
	extends <http://secti.pe.gov.br/indicador_cti/description/entradas/entradasOrcamentoFinanciamento#> as entradasOrcamentoFinanciamento
	extends <http://secti.pe.gov.br/indicador_cti/description/entradas/entradasDadosSistemasPlataformas#> as entradasDadosSistemasPlataformas
	extends <http://secti.pe.gov.br/indicador_cti/description/entradas/entradasCapitalHumano#> as entradasCapitalHumano
	extends <http://secti.pe.gov.br/indicador_cti/description/entradas/entradasInstrumentosLegaisNormativos#> as entradasInstrumentosLegaisNormativos
	extends <http://secti.pe.gov.br/indicador_cti/description/atividadesChave#> as atividadeChave
	extends <http://secti.pe.gov.br/indicador_cti/description/saidas#> as saida
	extends <http://secti.pe.gov.br/indicador_cti/description/publicosAlvo/publicosAcademiaICTs#> as publicosAcademiaICTs
	extends <http://secti.pe.gov.br/indicador_cti/description/publicosAlvo/publicosGovernoInstituicoesPublicas#> as publicosGovernoInstituicoesPublicas
	extends <http://secti.pe.gov.br/indicador_cti/description/publicosAlvo/publicosEmpresasEmpreendedores#> as publicosEmpresasEmpreendedores
	extends <http://secti.pe.gov.br/indicador_cti/description/publicosAlvo/publicosAmbientesInovacao#> as publicosAmbientesInovacao
	extends <http://secti.pe.gov.br/indicador_cti/description/publicosAlvo/publicosSociedadeTerceiroSetor#> as publicosSociedadeTerceiroSetor
	uses <http://secti.pe.gov.br/indicador_cti/vocabulary/base#> as base
	uses <http://secti.pe.gov.br/indicador_cti/vocabulary/DesignAvaliacao/canvas#> as canvas
	uses <http://secti.pe.gov.br/indicador_cti/vocabulary/programa#> as programa

	instance PR8 : programa:programaCTI [
		base:nome "Bolsa Pernambucana de Produtividade"
		base:descricao "Programa de apoio a pesquisadores residentes e atuantes fora da Região Metropolitana do Recife que contribuam para o incremento da produção científica, tecnológica e inovadora de qualidade"
		base:id "PR8"
		programa:possuiParceiros parceirosGoverno:PC1.10, parceirosAgenciasFomento:PC2.5, parceirosAgenciasFomento:PC2.6, parceirosAgenciasFomento:PC2.7, parceirosAgenciasFomento:PC2.9, parceirosAcademiaICTs:PC3.1
		programa:condicionadoPor fatoresDinamicaEcossistema:FE5.OP1, fatoresDinamicaEcossistema:FE5.OP2, fatoresCenarioEconomico:FE1.AM1, fatoresCenarioInstitucionalLegal:FE2.AM1, fatoresCenarioSocialEducacional:FE4.AM1
		programa:recebeEntradas entradasOrcamentoFinanciamento:EN1.1, entradasCapitalHumano:EN3.5, entradasCapitalHumano:EN3.7, entradasCapitalHumano:EN3.1, entradasDadosSistemasPlataformas:EN2.1, entradasInstrumentosLegaisNormativos:EN5.1
		programa:executa atividadeChave:AC1, atividadeChave:AC2, atividadeChave:AC3, atividadeChave:AC4, atividadeChave:AC5, atividadeChave:AC6
		programa:geraSaidas saida:SA1, saida:SA2, saida:SA3, saida:SA4, saida:SA5, saida:SA6
		programa:produzResultados RE.CP1, RE.CP2, RE.CP3, RE.CP4, RE.CP5, RE.CP6, RE.CP7, RE.MP1, RE.MP2, RE.LP1, RE.LP2, RE.LP3, RE.LP4
		programa:buscaAtingirGeral OB.GE
		programa:buscaAtingirEspecifico OB.ES1, OB.ES2, OB.ES3, OB.ES4, OB.ES5, OB.ES6, OB.ES7, OB.ES8
		
	]

	// Relações BPP --> Público-Alvo
	relation instance PR8.direcionadoA.PU1.2 : programa:direcionadoA [
		from PR8
		to publicosAcademiaICTs:PU1.2
		base:tipo "direto"
	]
	relation instance PR8.direcionadoA.PU1.8 : programa:direcionadoA [
		from PR8
		to publicosAcademiaICTs:PU1.8
		base:tipo "indireto"
	]
	relation instance PR8.direcionadoA.PU1.14 : programa:direcionadoA [
		from PR8
		to publicosAcademiaICTs:PU1.14
		base:tipo "indireto"
	]
	relation instance PR8.direcionadoA.PU1.15 : programa:direcionadoA [
		from PR8
		to publicosAcademiaICTs:PU1.15
		base:tipo "indireto"
	]
	relation instance PR8.direcionadoA.PU2.2 : programa:direcionadoA [
		from PR8
		to publicosGovernoInstituicoesPublicas:PU2.2
		base:tipo "indireto"
	]
	relation instance PR8.direcionadoA.PU3.2 : programa:direcionadoA [
		from PR8
		to publicosEmpresasEmpreendedores:PU3.2
		base:tipo "indireto"
	]
	relation instance PR8.direcionadoA.PU4.9 : programa:direcionadoA [
		from PR8
		to publicosAmbientesInovacao:PU4.9
		base:tipo "indireto"
	]
	relation instance PR8.direcionadoA.PU5.1 : programa:direcionadoA [
		from PR8
		to publicosSociedadeTerceiroSetor:PU5.1
		base:tipo "indireto"
	]

	// Objetivo Geral
	instance OB.GE : canvas:ObjetivoGeral [
		base:nome "Apoiar pesquisadores residentes e atuantes fora da Região Metropolitana do Recife, que contribuam para o incremento da produção científica, tecnológica e inovadora de qualidade"
		base:id "OB.GE - BPP"
	]

	// Objetivos Específicos
	instance OB.ES1 : canvas:ObjetivoEspecifico [
		base:nome "Estimular a fixação de pesquisadores fora da Região Metropolitana do Recife"
		base:id "OB.ES1 - BPP"
		canvas:buscaAtingir RE.LP2
	]
	instance OB.ES2 : canvas:ObjetivoEspecifico [
		base:nome "Contribuir para fortalecer e/ou nuclear os grupos de pesquisa atuantes no estado fora da Região Metropolitana do Recife"
		base:id "OB.ES2 - BPP"
		canvas:buscaAtingir RE.CP4, RE.CP5, RE.CP7
	]
	instance OB.ES3 : canvas:ObjetivoEspecifico [
		base:nome "Estimular a produção e a disseminação de conhecimento de vanguarda, além da mão de obra de alto nível para o desenvolvimento competitivo e sustentável do Estado fora da Região Metropolitana do Recife"
		base:id "OB.ES3 - BPP"
		canvas:buscaAtingir RE.CP1, RE.CP3, RE.CP4, RE.CP7, RE.MP1, RE.LP1
	]
	instance OB.ES4 : canvas:ObjetivoEspecifico [
		base:nome "Contribuir para a formação de recursos humanos em nível técnico, de graduação e de pós-graduação no estado fora da Região Metropolitana do Recife"
		base:id "OB.ES4 - BPP"
		canvas:buscaAtingir RE.CP2, RE.CP7
	]
	instance OB.ES5 : canvas:ObjetivoEspecifico [
		base:nome "Estimular cooperações e transferências científicas e tecnológicas com organizações públicas e privadas, nacionais e internacionais"
		base:id "OB.ES5 - BPP"
		canvas:buscaAtingir RE.CP4, RE.CP7, RE.MP1, RE.MP2, RE.LP1
	]
	instance OB.ES6 : canvas:ObjetivoEspecifico [
		base:nome "Ampliar a competitividade do pesquisador para além do âmbito local"
		base:id "OB.ES6 - BPP"
		canvas:buscaAtingir RE.CP5, RE.CP7, RE.LP2
	]
	instance OB.ES7 : canvas:ObjetivoEspecifico [
		base:nome "Apoiar a criação e a consolidação de Programas de Pós-graduação fora da Região Metropolitana do Recife"
		base:id "OB.ES7 - BPP"
		canvas:buscaAtingir RE.CP7, RE.LP2, RE.LP3, RE.LP4
	]
	instance OB.ES8 : canvas:ObjetivoEspecifico [
		base:nome "Estimular a participação em sociedades científicas, conselhos e editoriais de periódicos no país e no exterior"
		base:id "OB.ES8 - BPP"
		canvas:buscaAtingir RE.CP6, RE.CP7
	]

	// Resultados Esperados

	// Curto Prazo
	instance RE.CP1 : canvas:ResultadoEsperado [
		base:nome "Aumento da produção científica qualificada e de alto impacto"
		base:id "RE.CP1 - BPP"
		canvas:prazo "curto"
	]
	instance RE.CP2 : canvas:ResultadoEsperado [
		base:nome "Aumento do número de orientações nos níveis técnico, de graduação e de pós-graduação em pesquisa e inovação nas ICTs fora da Região Metropolitana do Recife"
		base:id "RE.CP2 - BPP"
		canvas:prazo "curto"
	]
	instance RE.CP3 : canvas:ResultadoEsperado [
		base:nome "Aumento da proteção intelectual do conhecimento gerado por meio de patentes depositadas e programas de software registrados"
		base:id "RE.CP3 - BPP"
		canvas:prazo "curto"
	]
	instance RE.CP4 : canvas:ResultadoEsperado [
		base:nome "Aumento de cooperações e transferências científicas e tecnológicas com organizações públicas e privadas, nacionais e internacionais"
		base:id "RE.CP4 - BPP"
		canvas:prazo "curto"
	]
	instance RE.CP5 : canvas:ResultadoEsperado [
		base:nome "Aumento da captação de recursos por meio de editais de fomento, cooperações e convênios com ICTs e empresas"
		base:id "RE.CP5 - BPP"
		canvas:prazo "curto"
	]
	instance RE.CP6 : canvas:ResultadoEsperado [
		base:nome "Aumento da participação em sociedades científicas, conselhos e editoriais de periódicos no país e no exterior"
		base:id "RE.CP6 - BPP"
		canvas:prazo "curto"
	]
	instance RE.CP7 : canvas:ResultadoEsperado [
		base:nome "Aumento do número de bolsistas que não renovaram a bolsa para adquirir bolsa PQ ou DT do CNPq"
		base:id "RE.CP7 - BPP"
		canvas:prazo "curto"
	]

	// Médio Prazo
	instance RE.MP1 : canvas:ResultadoEsperado [
		base:nome "Aumento de startups de base científica e tecnológica e spin-offs acadêmicos fora da Região Metropolitana do Recife"
		base:id "RE.MP1 - BPP"
		canvas:prazo "médio"
	]
	instance RE.MP2 : canvas:ResultadoEsperado [
		base:nome "Geração de inovações para a Indústria, o Governo e a Sociedade"
		base:id "RE.MP2 - BPP"
		canvas:prazo "médio"
	]

	// Longo Prazo
	instance RE.LP1 : canvas:ResultadoEsperado [
		base:nome "Licenciamento da propriedade intelectual pela Indústria e pelo Governo"
		base:id "RE.LP1 - BPP"
		canvas:prazo "longo"
	]
	instance RE.LP2 : canvas:ResultadoEsperado [
		base:nome "Fortalecimento da permanência do pesquisador fora da Região Metropolitana do Recife"
		base:id "RE.LP2 - BPP"
		canvas:prazo "longo"
	]
	instance RE.LP3 : canvas:ResultadoEsperado [
		base:nome "Criação de novos Programas de Pós-graduação fora da Região Metropolitana do Recife com participação dos bolsistas BPP"
		base:id "RE.LP3 - BPP"
		canvas:prazo "longo"
	]
	instance RE.LP4 : canvas:ResultadoEsperado [
		base:nome "Aumento do conceito CAPES dos Programas de Pós-graduação fora da Região Metropolitana do Recife"
		base:id "RE.LP4 - BPP"
		canvas:prazo "longo"
	]
}